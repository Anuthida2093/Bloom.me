/* ═══════════════════════════════════════════════════════════════
   StatsOverlay.css — แผงสถิติของฉากแผนที่ Step Journey
   ═══════════════════════════════════════════════════════════════ */

.stats-overlay {
  width: 14.2rem;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px;
  border-radius: 16px;
  background: rgba(10, 22, 16, 0.6);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: var(--fixed-white);
  font-family: 'Nunito', sans-serif;
  box-sizing: border-box;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.stats-overlay__tile {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
}

.stats-overlay__tile-icon { font-size: 17px; line-height: 1; }

.stats-overlay__tile-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  flex: 1;
}
.stats-overlay__tile-label {
  font-size: 10.5px;
  font-weight: 700;
  opacity: 0.75;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stats-overlay__tile-value {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 16px;
  line-height: 1.2;
}
.stats-overlay__tile-goal { font-size: 11px; opacity: 0.7; font-family: 'Nunito', sans-serif; }

.stats-overlay__track {
  height: 6px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.16);
  margin-top: 4px;
  overflow: hidden;
}
.stats-overlay__fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, #74C69D, #52B788);
  transition: width 0.5s ease;
}
.stats-overlay__fill--trip { background: linear-gradient(90deg, #FFD166, #F4C430); }

/* [แก้ตามที่ระบุ] มือถือใช้แผงแนวตั้งด้านข้างแบบโน้ตบุ๊ก — กว้างเต็มแผง (แผงแคบลงตามจอ) */
@media (max-width: 520px) {
  .stats-overlay { width: 100%; }
}
</file>

<file path="src/components/quest/games/physical/StatsOverlay.tsx">
import './StatsOverlay.css'

/*============================================================================*\
  StatsOverlay.tsx — แผงสถิติของฉากแผนที่ Step Journey — ก้าววันนี้/เป้าหมาย, ความคืบหน้า
  ทั้งทริป, และ BMI
  ────────────────────────────────────────────────────────────────────────────
  [แก้รอบก่อน — ปรับ layout เต็มจอ] ไม่ตั้งตำแหน่งตัวเอง (position:absolute) อีกต่อไป — เดิมล็อก
  มุมขวาบนของกล่องแผนที่ตายตัว ตอนนี้ parent (StepJourneyGame.tsx) เป็นคนจัดตำแหน่งทั้งคอลัมน์
  ขวา (สถิติ+ปุ่มควบคุม) แทน เพื่อให้ย้ายไปเรียงเป็นแถวแนวนอนตอนจอแคบได้ (ดู
  .step-journey-game__side-panel ใน StepJourneyGame.css) — รวมแถว "ความคืบหน้าทั้งทริป" (เดิม
  เป็นบรรทัดแยกอยู่ใต้แผนที่) เข้ามาในแผงเดียวกัน

  [แก้รอบนี้ — feedback รอบ 2: โดน action menu bar บัง] ขนาด ~6x10cm ตายตัวจากรอบก่อนสูงเกินไป
  จนพื้นที่เหลือให้ปุ่มควบคุมด้านล่างไม่พอ — เปลี่ยนเป็น content-sized กระชับแทน (ดู
  StatsOverlay.css) ตัด tile--compact modifier ทิ้งด้วยเพราะทุก tile กระชับเท่ากันหมดแล้ว
  ไม่ต้องแยก modifier อีกต่อไป
\*============================================================================*/

interface StatsOverlayProps {
  todaySteps: number
  dailyStepTarget: number
  /** เป้าท้าทาย (ค่าสูงของช่วงตาม BMI — config/stepGoalByBmi.ts) */
  stretchStepTarget?: number
  /** โบนัสของระดับ BMI นี้ */
  bonusLabel?: string
  /** ระยะทางวันนี้ที่จัดรูปแบบแล้ว (utils/strideDistance.ts) — null = ไม่มีส่วนสูง ไม่แสดง */
  todayDistance?: string | null
  /** null = ผู้เล่นยังไม่กรอกส่วนสูง/น้ำหนัก (ดู fallback เดียวกับที่เคยอยู่ใน
   *  PhysicalStatsView.tsx เดิม — ไฟล์นั้นไม่มีจุดเรียกใช้จริงแล้ว แต่ logic fallback ยังถูกต้อง) */
  bmi: number | null
  mapName: string
  mapProgressPct: number
}

export default function StatsOverlay({ todaySteps, dailyStepTarget, stretchStepTarget, bonusLabel, todayDistance, bmi, mapName, mapProgressPct }: StatsOverlayProps) {
  const dailyPct = dailyStepTarget > 0 ? Math.min(100, (todaySteps / dailyStepTarget) * 100) : 0
  const clampedTripPct = Math.min(100, Math.max(0, mapProgressPct))

  return (
    <div className="stats-overlay">
      <div className="stats-overlay__tile">
        <span className="stats-overlay__tile-icon" aria-hidden="true">🦶</span>
        <div className="stats-overlay__tile-body">
          <span className="stats-overlay__tile-label">ก้าววันนี้</span>
          <span className="stats-overlay__tile-value">
            {todaySteps.toLocaleString()}<span className="stats-overlay__tile-goal"> / {dailyStepTarget.toLocaleString()}</span>
          </span>
          <div className="stats-overlay__track">
            <div className="stats-overlay__fill" style={{ width: `${dailyPct}%` }} />
          </div>
          {(todayDistance || stretchStepTarget) && (
            <span className="stats-overlay__tile-label">
              {todayDistance ? `≈ ${todayDistance}` : ''}
              {todayDistance && stretchStepTarget ? ' · ' : ''}
              {stretchStepTarget ? `เป้าท้าทาย ${stretchStepTarget.toLocaleString()}` : ''}
            </span>
          )}
          {bonusLabel && <span className="stats-overlay__tile-label">🎁 {bonusLabel}</span>}
        </div>
      </div>

      <div className="stats-overlay__tile">
        <span className="stats-overlay__tile-icon" aria-hidden="true">🗺️</span>
        <div className="stats-overlay__tile-body">
          <span className="stats-overlay__tile-label">{mapName}</span>
          <span className="stats-overlay__tile-value">{Math.round(clampedTripPct)}%</span>
          <div className="stats-overlay__track">
            <div className="stats-overlay__fill stats-overlay__fill--trip" style={{ width: `${clampedTripPct}%` }} />
          </div>
        </div>
      </div>

      <div className="stats-overlay__tile">
        <span className="stats-overlay__tile-icon" aria-hidden="true">⚖️</span>
        <div className="stats-overlay__tile-body">
          <span className="stats-overlay__tile-label">BMI</span>
          <span className="stats-overlay__tile-value">{bmi != null && Number.isFinite(bmi) ? bmi.toFixed(1) : '-'}</span>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/components/quest/games/physical/StepChest.css">
/* ═══════════════════════════════════════════════════════════════
   StepChest.css — หีบสมบัติที่เส้นชัย + ป็อปอัปผลรางวัล (StepChest.tsx)
   ═══════════════════════════════════════════════════════════════ */

/* [แก้ตามที่ระบุ] กล่องหีบที่เส้นชัย + แสงเรืองด้านหลัง (วงแสงนุ่ม + รัศมีแฉกหมุนช้าๆ) */
.step-chest-goal {
  position: absolute; z-index: 5;
  width: 0; height: 0;
  pointer-events: none;
}
.step-chest-goal > * { pointer-events: auto; }
.step-chest-goal__glow, .step-chest-goal__rays {
  /* กึ่งกลางหีบ: กล่อง 84px ที่เลื่อนขึ้น -230% → ศูนย์กลางอยู่ที่ -151px จากจุดสิ้นสุด */
  position: absolute; left: 0; top: -151px; pointer-events: none;
  border-radius: 50%; transform: translate(-50%, -50%);
}
.step-chest-goal__glow {
  width: 190px; height: 190px;
  background: radial-gradient(circle, rgba(255, 236, 160, .95) 0%, rgba(255, 200, 80, .55) 35%, rgba(255, 190, 60, 0) 70%);
  opacity: .55;
  animation: stepChestGlow 2.6s ease-in-out infinite;
}
.step-chest-goal__rays {
  width: 260px; height: 260px;
  background: repeating-conic-gradient(from 0deg, rgba(255, 231, 150, .55) 0deg 8deg, rgba(255, 231, 150, 0) 8deg 30deg);
  -webkit-mask: radial-gradient(circle, #000 20%, transparent 68%); mask: radial-gradient(circle, #000 20%, transparent 68%);
  opacity: .25;
  animation: stepChestRays 14s linear infinite;
}
.step-chest-goal--ready .step-chest-goal__glow { opacity: 1; width: 230px; height: 230px; }
.step-chest-goal--ready .step-chest-goal__rays { opacity: .8; animation-duration: 8s; }
@keyframes stepChestGlow { 0%, 100% { transform: translate(-50%, -50%) scale(.92); } 50% { transform: translate(-50%, -50%) scale(1.06); } }
@keyframes stepChestRays { to { transform: translate(-50%, -50%) rotate(360deg); } }

/* หีบบนแผนที่ — ลอยเหนือจุดสิ้นสุด เรืองแสงชวนแตะเมื่อถึงเป้า */
.step-chest-marker {
  position: absolute; z-index: 1; left: 0; top: 0;
  transform: translate(-50%, -230%);
  display: flex; align-items: center; justify-content: center;
  width: 84px; height: 84px; padding: 0; cursor: pointer;
  font-size: 54px; line-height: 1;
  border-radius: 20px; border: 3px solid #f5b301;
  background: linear-gradient(180deg, #fff7d6, #ffd36b);
  box-shadow: 0 4px 0 #c98a00, 0 8px 16px rgba(0, 0, 0, 0.35);
  animation: stepChestPulse 1.2s ease-in-out infinite;
}
.step-chest-marker:disabled { cursor: default; }
/* ยังไม่ถึงเป้า: หีบนิ่ง ไม่เด้ง (แสงด้านหลังยังเรืองนุ่มๆ ให้เห็นเป็นเป้าหมาย) */
.step-chest-goal:not(.step-chest-goal--ready) .step-chest-marker { animation: none; filter: saturate(.85); }
@keyframes stepChestPulse {
  0%, 100% { transform: translate(-50%, -230%) scale(1); box-shadow: 0 4px 0 #c98a00, 0 0 0 0 rgba(255, 209, 102, 0.9); }
  50% { transform: translate(-50%, -240%) scale(1.08); box-shadow: 0 4px 0 #c98a00, 0 0 0 22px rgba(255, 209, 102, 0); }
}

.step-chest-overlay {
  position: fixed; inset: 0; z-index: 900;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 16px; box-sizing: border-box; overflow-y: auto;
  background: rgba(8, 20, 14, 0.55);
  -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  animation: stepChestFade 0.2s ease both;
}
@keyframes stepChestFade { from { opacity: 0; } to { opacity: 1; } }

/* รอเซิร์ฟเวอร์ — หีบสั่นกลางจอ (ป็อปอัปขึ้นทันทีที่แตะ ไม่ต้องรอผล) */
.step-chest-loading { font-size: 120px; line-height: 1; filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.35)); animation: stepChestShake 0.8s ease-in-out infinite; }
@keyframes stepChestShake {
  0%, 100% { transform: rotate(0); } 20% { transform: rotate(-9deg); } 40% { transform: rotate(9deg); }
  60% { transform: rotate(-6deg); } 80% { transform: rotate(5deg); }
}

.step-chest-error { width: min(340px, 100%); padding: 20px; text-align: center; font-family: var(--font-display); }
.step-chest-error p { margin: 0 0 14px; }

/* ── การ์ดแลกซื้อไอเทม: การ์ดสี่เหลี่ยมจัตุรัสค่อนไปด้านบน + รัศมีด้านหลัง ไม่มีกรอบ ── */
.step-chest-overlay:has(.step-chest-card-stage) { justify-content: flex-start; padding-top: max(9vh, 48px); }
.step-chest-card-stage { position: relative; display: flex; flex-direction: column; align-items: center; gap: 28px; width: min(320px, 100%); }
.step-chest-burst {
  position: absolute; top: calc(min(240px, 66vw) / 2); left: 50%;
  width: min(560px, 150vw); aspect-ratio: 1; transform: translate(-50%, -50%);
  border-radius: 50%; pointer-events: none; z-index: 0;
  background:
    radial-gradient(circle, rgba(255, 244, 196, 0.95) 0%, rgba(255, 214, 102, 0.55) 22%, transparent 58%),
    repeating-conic-gradient(from 0deg, rgba(255, 223, 128, 0.55) 0deg 9deg, transparent 9deg 22.5deg);
  -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 70%);
  mask-image: radial-gradient(circle, #000 30%, transparent 70%);
  animation: stepChestBurstSpin 14s linear infinite, stepChestBurstIn 0.6s ease-out both;
}
@keyframes stepChestBurstSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }
@keyframes stepChestBurstIn { from { opacity: 0; } to { opacity: 1; } }

.step-chest-card {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 10px;
  width: min(240px, 66vw); aspect-ratio: 1; box-sizing: border-box; padding: 18px 14px 16px;
  border: none; border-radius: 22px;
  background: radial-gradient(circle at 50% 30%, #ffffff 0%, #fff6d8 55%, #ffe08a 100%);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35), 0 0 46px 10px rgba(255, 214, 102, 0.6);
  font-family: var(--font-display); color: #4A2C0A;
  animation: stepChestCardIn 0.55s cubic-bezier(.34, 1.56, .64, 1) both;
}
@keyframes stepChestCardIn { from { opacity: 0; transform: scale(0.3) rotate(-12deg); } to { opacity: 1; transform: none; } }
.step-chest-card__img { flex: 1; min-height: 0; width: 72%; object-fit: contain; filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.25)); }
.step-chest-card__emoji { flex: 1; display: flex; align-items: center; font-size: 96px; line-height: 1; }
.step-chest-card__label { font-size: 18px; font-weight: 800; text-align: center; }
.step-chest-card__actions { position: relative; z-index: 1; display: flex; gap: 12px; width: 100%; }

.step-chest-btn {
  flex: 1; padding: 12px 16px; border: none; border-radius: 16px; cursor: pointer;
  font-family: var(--font-display); font-size: 16px; color: #4A2C0A;
  background: linear-gradient(180deg, #ffe08a, #f5b301);
  box-shadow: 0 5px 0 #c98a00, 0 10px 18px rgba(0, 0, 0, 0.18), inset 0 2px 0 rgba(255, 255, 255, 0.75);
}
.step-chest-btn:active { transform: translateY(4px); box-shadow: 0 1px 0 #c98a00, inset 0 2px 0 rgba(255, 255, 255, 0.75); }
.step-chest-btn--ghost { background: rgba(255, 255, 255, 0.9); box-shadow: 0 5px 0 #b9a77a, 0 10px 18px rgba(0, 0, 0, 0.14); }

/* ── รางวัลอื่น: กระดาษม้วนค่อยๆ คลี่ลง (grid 0fr → 1fr) ── */
.chest-scroll { position: relative; width: min(340px, 100%); display: flex; flex-direction: column; align-items: center; animation: chestScrollRise 0.45s cubic-bezier(.22, 1, .36, 1) both; }
@keyframes chestScrollRise { from { transform: translateY(-30px) scale(0.85); opacity: 0; } to { transform: none; opacity: 1; } }
.chest-scroll__rod { width: calc(100% + 20px); height: 18px; border-radius: 10px; background: linear-gradient(180deg, #b07a43, #8B5A2B 55%, #5e3a17); box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.35); z-index: 1; }
.chest-scroll__paper {
  width: 100%; display: grid; grid-template-rows: 0fr; margin: -4px 0;
  background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.6), transparent 60%), #FFF3D6;
  border-left: 3px solid #F0C97A; border-right: 3px solid #F0C97A;
  box-shadow: inset 0 0 36px rgba(120, 90, 40, 0.16), 0 16px 30px rgba(0, 0, 0, 0.3);
  animation: chestScrollUnroll 1.1s cubic-bezier(.22, 1, .36, 1) 0.2s forwards;
}
@keyframes chestScrollUnroll { to { grid-template-rows: 1fr; } }
.chest-scroll__inner { overflow: hidden; min-height: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 0 18px; text-align: center; color: #4A2C0A; font-family: var(--font-display); }
.chest-scroll__inner > :first-child { margin-top: 20px; }
.chest-scroll__inner > :last-child { margin-bottom: 20px; }
.chest-scroll__visual { width: 104px; height: 104px; }
.chest-scroll__visual img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.25)); }
.chest-scroll__title { margin: 0; font-size: 22px; }
.chest-scroll__text { margin: 0; font-size: 14px; line-height: 1.5; opacity: 0.85; }
.chest-scroll__btn {
  width: 100%; margin-top: 6px; padding: 12px 16px; border: none; border-radius: 16px; cursor: pointer;
  font-family: var(--font-display); font-size: 16px; color: #4A2C0A;
  background: linear-gradient(180deg, #ffe08a, #f5b301);
  box-shadow: 0 5px 0 #c98a00, 0 10px 18px rgba(0, 0, 0, 0.18), inset 0 2px 0 rgba(255, 255, 255, 0.75);
}
.chest-scroll__btn:active { transform: translateY(4px); box-shadow: 0 1px 0 #c98a00, inset 0 2px 0 rgba(255, 255, 255, 0.75); }

@media (prefers-reduced-motion: reduce) {
  .step-chest-goal__glow, .step-chest-goal__rays,
  .step-chest-marker, .step-chest-loading, .step-chest-burst, .step-chest-card, .chest-scroll, .step-chest-overlay { animation: none; }
  .chest-scroll__paper { animation: none; grid-template-rows: 1fr; }
}

/* [แก้ตามที่ระบุ] ป้าย "กล่องสุ่ม" ใต้กล่องที่เส้นชัย */
.step-chest-goal__label {
  position: absolute; z-index: 1; left: 0; top: 0;
  transform: translate(-50%, -96px);
  padding: 3px 12px; border-radius: 99px; white-space: nowrap;
  font-family: var(--font-display); font-size: 16px; color: #4A2C0A;
  background: #fff7d6; border: 2px solid #f5b301;
  box-shadow: 0 2px 0 #c98a00;
  pointer-events: none;
}
