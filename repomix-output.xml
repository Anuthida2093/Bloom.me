}

.potion-actions { display: flex; gap: 8px; }
.potion-panel button.is-primary,
.potion-actions button {
  flex: 1;
  padding: 13px;
  border-radius: 99px;
  border: none;
  font-family: 'Fredoka One', 'Mali', sans-serif;
