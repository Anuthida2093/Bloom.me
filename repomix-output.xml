.tree-info-panel .tree-of-life__tooltip-sheet { max-height: none; overflow: visible; }  /* คอลัมน์ขวาเลื่อนเอง */
.tree-info-panel__extra { margin-top: 12px; }
@keyframes treeInfoPanelIn {
