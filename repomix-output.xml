}
.game-shell__claim:hover { transform: translateY(-2px); }

/* ── ยืนยันออกกลางคัน ── */
.game-shell__confirm {
  position: absolute;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  --lc-bg-4: rgba(5, 18, 13, 0.76);
  background: var(--lc-bg-4);
