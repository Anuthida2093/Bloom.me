.balanced-nutrients__meal-cam-btn:hover { background: rgba(255,255,255,0.2); }
.balanced-nutrients__meal-label { font-size: 12px; font-weight: 700; opacity: 0.9; }
.balanced-nutrients__meal-done-badge { font-size: 10px; color: #B7E4C7; font-weight: 700; }

.balanced-nutrients__verifying-spinner {
