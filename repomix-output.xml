<file path="src/utils/waterPrompt.ts">
/*============================================================================*\
  waterPrompt.ts — ธง "ได้หยดน้ำใหม่ที่ยังไม่ได้เห็น" (one-shot) สำหรับแอนิเมชันบัวรดน้ำหน้า Home
  ────────────────────────────────────────────────────────────────────────────
  ตั้งธงเมื่อเควสให้หยดน้ำเพิ่ม (UserContext.updateProfile เห็น waterDrops เพิ่มขึ้น) → กลับมาหน้า Home
  แล้วเล่นบัวรดน้ำครั้งเดียว + ล้างธง — ไม่เล่นทุกครั้งที่เข้าหน้า Home อีก
  [แก้บั๊ก] เดิมผูกกับ waterPulseKey/treeGrowthPulse ใน ProgressContext (อยู่ตลอด) แต่ตัวกันเล่นซ้ำอยู่ใน ref
  ของคอมโพเนนต์ — Dashboard mount ใหม่เมื่อไหร่ ref รีเซ็ต แอนิเมชันเล่นซ้ำทุกครั้ง
  หมายเหตุ: หยดน้ำมีแค่ฝั่งหน้าเว็บ (localStorage แยกตามบัญชี — ดู adapters.ts) backend ไม่มีแนวคิดนี้
\*============================================================================*/

const key = (userId: string) => `bloom:water-unseen:${userId}`

export function markNewWaterDrop(userId: string): void {
  if (!userId) return
  try { window.localStorage.setItem(key(userId), '1') } catch { /* storage ปิด */ }
}

/** คืน true ครั้งเดียวต่อหยดน้ำใหม่ แล้วล้างธงทันที */
export function takeNewWaterDrop(userId: string): boolean {
  if (!userId) return false
  try {
    if (window.localStorage.getItem(key(userId)) !== '1') return false
    window.localStorage.removeItem(key(userId))
    return true
  } catch { return false }
}

/** ดูว่ามีหยดน้ำใหม่ที่ยังไม่ได้เห็นไหม (ไม่ล้างธง) */
export function hasNewWaterDrop(userId: string): boolean {
  if (!userId) return false
  try { return window.localStorage.getItem(key(userId)) === '1' } catch { return false }
}

/** [แก้ตามที่ระบุ] ได้รางวัลหยดน้ำ → Dashboard ปิดทุกหน้าที่เปิดอยู่ กลับหน้า Home แล้วเล่นบัวรดน้ำต้นไม้ทันที */
export const HOME_WATERING_EVENT = 'bloom:home-watering'

export function requestHomeWatering(): void {
  window.dispatchEvent(new CustomEvent(HOME_WATERING_EVENT))
}
</file>

<file path="src/App.tsx">
import { lazy, Suspense } from 'react'
import { Routes, Route, Navigate } from 'react-router-dom'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { LazyMotion, domAnimation } from 'framer-motion'
import { AppProvider } from './context/AppContext'
import { AudioProvider } from './context/AudioContext'
import { LanguageProvider } from './context/LanguageContext'
import ErrorBoundary from './components/common/ErrorBoundary'
import RouteFallback from './components/common/RouteFallback'
import RequireSession from './components/common/RequireSession'
import RouteEffects from './components/common/RouteEffects'
import { ApiError } from './services/http'

/*============================================================================*\
  App — [แก้รอบนี้]
   1. แยก bundle ตาม route ด้วย React.lazy — เดิมทุก route โหลด bundle เดียวกันหมด
      หน้า Login จึงต้องดาวน์โหลด framer-motion + ต้นไม้ + ระบบเควสทั้งชุดก่อน
      ถึงจะแสดงช่องกรอกรหัสผ่านได้
   2. ครอบ ErrorBoundary — เดิมถ้าคอมโพเนนต์ไหน throw ระหว่างเรนเดอร์ ผู้ใช้เห็นจอขาว
   3. เพิ่ม QueryClientProvider — ชั้นจัดการข้อมูลจากเซิร์ฟเวอร์ (cache/refetch/retry)
   4. LazyMotion + domAnimation — โหลดเฉพาะฟีเจอร์ของ framer-motion ที่ใช้จริง
      ประหยัดประมาณ 25KB gzip โดยเปลี่ยนแค่ <motion.div> เป็น <m.div>

  ลำดับ Provider สำคัญและห้ามสลับ:
    QueryClient → LanguageProvider → AppProvider (User → Progress → UI) → AudioProvider
    AudioProvider ต้องอยู่ในสุดเพราะอ่าน settings.soundEnabled จาก UIContext
    LanguageProvider ไม่พึ่ง context อื่น — ครอบไว้นอก AppProvider ให้ทุกชั้นใช้ t() ได้
\*============================================================================*/

const WelcomeModal = lazy(() => import('./components/welcome/WelcomeModal'))
const Login = lazy(() => import('./pages/Login'))
const Register = lazy(() => import('./pages/Register'))
const ForgotPassword = lazy(() => import('./pages/ForgotPassword'))
const ResetPassword = lazy(() => import('./pages/ResetPassword'))
const MBTISelect = lazy(() => import('./pages/MBTISelect'))
const Dashboard = lazy(() => import('./components/dashboard/Dashboard'))
/** [experiment — dev only] ต้นไม้ procedural 3D — ผูกกับ import.meta.env.DEV ซึ่ง Vite แทนเป็น false
 *  ตอน build production แล้วตัดทิ้งทั้ง route + dynamic import (three.js ไม่ติดไปใน bundle จริง)
 *  เข้าได้ทาง URL ตรงๆ /dev/procedural-tree ตอน `npm run dev` เท่านั้น ไม่มีลิงก์จากเมนูไหน */
const ProceduralTreePage = import.meta.env.DEV
  ? lazy(() => import('./experiments/procedural-tree/ProceduralTreePage'))
  : null
// [ใหม่] เครื่องมือปักจุดเส้นทางเควสก้าว — เฉพาะตอน dev (ไม่ถูก bundle ใน build จริง)
const WaypointEditorPage = import.meta.env.DEV
  ? lazy(() => import('./experiments/waypoints/WaypointEditorPage'))
  : null
// [dev only] ตรวจแผนที่ 9 ที่วาดด้วยโค้ด (หลาย seed / โหมด debug / วัดเวลา) — ไม่ถูก bundle ใน build จริง
const GeneratedMapPage = import.meta.env.DEV
  ? lazy(() => import('./experiments/generated-map/GeneratedMapPage'))
  : null
// [dev only] แผ่นตัวอย่างต้นไม้ฉากประกอบ 2 สไตล์ (เลือกก่อนใช้กับทั้งป่า)
const TreeSheetPage = import.meta.env.DEV
  ? lazy(() => import('./experiments/tree-sheet/TreeSheetPage'))
  : null
// [dev only] โครงลำต้น+กิ่งจากข้อมูล 3 สายพันธุ์ (รออนุมัติ)
const SpeciesSheetPage = import.meta.env.DEV
  ? lazy(() => import('./experiments/species-sheet/SpeciesSheetPage'))
  : null
// [dev only] ฉากพื้นหลังหน้า Home ที่วาดด้วยโค้ด (ฉาก 3-5)
const HomeScenesPage = import.meta.env.DEV
  ? lazy(() => import('./experiments/home-scenes/HomeScenesPage'))
  : null

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 30_000,
      gcTime: 5 * 60_000,
      refetchOnWindowFocus: false,
      // ไม่ลองใหม่กับ error ที่ลองกี่ครั้งก็ได้ผลเดิม (401/403/404) — เสียเวลาผู้ใช้เปล่าๆ
      retry: (failureCount, error) => {
        if (error instanceof ApiError && [401, 403, 404].includes(error.status)) return false
        return failureCount < 2
      },
    },
    mutations: { retry: 0 },
  },
})

export default function App() {
  return (
    <QueryClientProvider client={queryClient}>
      <LanguageProvider>
        <AppProvider>
          <AudioProvider>
            <LazyMotion features={domAnimation}>
              <ErrorBoundary scope="แอปพลิเคชัน">
                <RouteEffects />
                <Suspense fallback={<RouteFallback />}>
                  <Routes>
                    <Route path="/" element={<WelcomeModal />} />
                    <Route path="/login" element={<Login />} />
                    <Route path="/register" element={<Register />} />
                    <Route path="/forgot-password" element={<ForgotPassword />} />
                    <Route path="/reset-password" element={<ResetPassword />} />
                    <Route path="/mbti" element={<MBTISelect />} />
                    <Route
                      path="/dashboard"
                      element={
                        <ErrorBoundary scope="หน้าหลัก">
                          <RequireSession>
                            <Dashboard />
                          </RequireSession>
                        </ErrorBoundary>
                      }
                    />
                    {ProceduralTreePage && <Route path="/dev/procedural-tree" element={<ProceduralTreePage />} />}
                    {WaypointEditorPage && <Route path="/dev/waypoints" element={<WaypointEditorPage />} />}
                    {GeneratedMapPage && <Route path="/dev/generated-map" element={<GeneratedMapPage />} />}
                    {TreeSheetPage && <Route path="/dev/tree-sheet" element={<TreeSheetPage />} />}
                    {SpeciesSheetPage && <Route path="/dev/species-sheet" element={<SpeciesSheetPage />} />}
                    {HomeScenesPage && <Route path="/dev/home-scenes" element={<HomeScenesPage />} />}
                    <Route path="*" element={<Navigate to="/" replace />} />
                  </Routes>
                </Suspense>
              </ErrorBoundary>
            </LazyMotion>
          </AudioProvider>
        </AppProvider>
      </LanguageProvider>
    </QueryClientProvider>
  )
}
</file>

<file path="src/index.css">
/* ════════════════════════════════════════════════════════════════════════════
   index.css — ชั้นโทเคนกลางของทั้งแอป
   ────────────────────────────────────────────────────────────────────────────
   [แก้รอบนี้]
     1. เปลี่ยนคู่ฟอนต์เป็น Mali (หัวเรื่อง) + IBM Plex Sans Thai (เนื้อหา)
        ของเดิม Fredoka One ไม่มีอักขระไทย → หัวข้อไทยตกไปใช้ฟอนต์ระบบทุกจุด
        และ Sarabun ที่เขียนไว้ใน stack ก็ไม่เคยถูก import จริง
     2. เพิ่มโทเคนตระกูล "Aether" สำหรับฉากเวทมนตร์ (กรอบเขียว/ไพ่ทิพย์/เตาเผา)
        ซึ่งเดิมไม่มีโทเคนของตัวเองเลย ต้องเขียนสีดิบทุกไฟล์ → สีม่วง/เขียวเรือง
        ในแต่ละหน้าเลยเป็นคนละเฉด
     3. เพิ่ม type scale, focus-visible กลาง, prefers-reduced-motion ระดับโกลบอล
     4. ถอด @import 'tailwindcss' ออก (ติดตั้งไว้แต่แทบไม่ได้ใช้จริง)
   คีย์เฟรม/utility เดิมทั้งหมดด้านล่างคงไว้ครบ ไม่มีการลบ
   ════════════════════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Mali:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap');

/* ─── Light Mode tokens ─── */
:root {
  /* เขียวแบรนด์ — [รีธีม 2026-09-27] เปลี่ยนจากเขียวอมฟ้า (hue ~153°) เป็นเขียวใบไม้สดอมเหลือง
     (hue 96°) ตามโทนใบของภาพอ้างอิงต้นมะฮอกกานี ทุกเฉดคง "ความสว่างสัมพัทธ์ (luminance)" เท่าเดิม
     เป๊ะ ตัวหนังสือขาว/ดำที่วางบนเขียวเฉดเดิมทั่วแอปจึงคอนทราสต์เท่าเดิมทุกจุด (ไม่ต้องไล่แก้ทีละหน้า)
     เดิม: 900 #0B2F1E · 800 #1B4332 · 700 #2D6A4F · 600 #40916C · 500 #52B788
           400 #74C69D · 300 #95D5B2 · 200 #B7E4C7 · 100 #D8F3DC · 50 #F0FBF4 */
  --g900: #192E0B; --g800: #2B421B; --g700: #44682C;
  --g600: #5F8F3F; --g500: #76B54D; --g400: #90C46E;
  --g300: #ABD390; --g200: #C6E2B3; --g100: #DFF2D3; --g50: #F3FBEE;

  /* เขียวใบไม้อ่อนมินิมอล — พื้นผิวสีเขียวอ่อน (แถบเมนูล่าง ActionMenuBar + กระดานจัดอันดับ)
     ตัวหนังสือ/ไอคอนบนพื้นนี้ใช้ --on-leaf-soft (เขียวเข้มเกือบดำ) ห้ามใช้ขาว — ขาวบน --g200
     คอนทราสต์แค่ 1.4:1 อ่านไม่ออก / --on-leaf-soft บน --leaf-soft ≈ 10:1, บน --leaf-soft-active ≈ 5.8:1 */
  --leaf-soft:        var(--g200);   /* พื้นหลัก */
  --leaf-soft-strong: var(--g300);   /* พื้นไล่เฉด / hover */
  --leaf-soft-edge:   var(--g400);   /* เส้นขอบ / วงรอบ */
  --leaf-soft-active: var(--g500);   /* สถานะที่เลือกอยู่ */
  --on-leaf-soft:     var(--g900);   /* ตัวหนังสือ/ไอคอนหลักบนพื้นเขียวอ่อน */
  --on-leaf-soft-sub: var(--g800);   /* ตัวหนังสือรอง (≈ 7.9:1 บน --leaf-soft) */

  --b900: #3B1F0A; --b700: #5C3D1E; --b500: #8B5E3C;
  --b300: #C4956A; --b100: #EDD9C0; --b50:  #FBF4EC;

  --n900: #1A1F1B; --n700: #2B3A2E; --n500: #5A6B5D;
  --n300: #9BAD9F; --n200: #C8D5CA; --n100: #E8EDE5;
  --n50:  #F4F7F2; --white: #FFFFFF;

  /* [ใหม่] --fixed-white ต่างจาก --white ตรงที่ "ไม่กลับสีตอน dark mode" (--white ใน
     dark mode กลายเป็นเกือบดำ เพราะทำหน้าที่เป็นโทเคนพื้นผิว/การ์ด ไม่ใช่ "สีขาว" ตรงตัว)
     ใช้ตัวนี้กับตัวหนังสือ/ไอคอน/เส้นขอบสีขาวที่วางทับพื้นมืดตายตัวเสมอ เช่น วิดีโอพื้นหลัง
     ฉากเวทมนตร์ (Aether) หรือปุ่มลอยกระจกดำ ที่ไม่เกี่ยวกับธีมสว่าง/มืดของแอปเลย */
  --fixed-white: #FFFFFF;
  /* ดำตายตัว ไม่กลับสีตอน dark mode (คู่กับ --fixed-white) — ตัวหนังสือบนการ์ดพื้นขาวตายตัว เช่น ชื่อไอเทมในร้าน */
  --fixed-black: #1A1F1B;

  --coin: #F4C430; --exp: #FFD60A;
  --blue: #4CC9F0; --pink: #FF85A1; --purple: #C77DFF;
  --orange: #F4845F; --red: #EF476F;

  /* Semantic */
  /* [แก้ตามที่ระบุ] พื้นหลังทุกหน้า = สีกรอบกระดานจัดอันดับ (เขียวอ่อน) — ธีมมืดใช้เขียวเข้มแบบกรอบธีมมืด */
  --bg:         var(--leaf-soft);
  --bg-card:    var(--white);
  --bg-sidebar: var(--white);
  --bg-modal:   rgba(0,0,0,.45);
  --text:       var(--n900);
  --text-sub:   var(--n500);
  --text-muted: var(--n300);
  --border:     var(--n100);
  --border-mid: var(--n200);
  --input-bg:   var(--white);

  --r-sm: 10px; --r-md: 16px; --r-lg: 24px; --r-xl: 32px; --r-pill: 999px;

  /* [ย้ายมาที่นี่ — เดิมประกาศเฉพาะใน .gameplay-frame (GameplayFrame.css) เท่านั้น]
     ระยะกันชนของ ActionMenuBar ที่ลอยอยู่ล่างจอเสมอ (z-index: 1000 สูงกว่าทุก modal
     ตั้งใจให้ลอยทับ เพื่อให้กดสลับหน้าได้แม้เปิด modal ค้างอยู่ — ดู ActionMenuBar.css)
     รวม --nav-height 70px + bottom 25px ของ .action-menu-container ≈ 100px (มือถือ
     54px + 15px ≈ 80px) ย้ายมาเป็นโทเคนกลางที่ :root เพื่อให้ "ทุกหน้าจอที่ scroll ได้
     เต็มจอ" (ไม่ใช่แค่หน้าเควส) อ้างอิงร่วมกันได้ เช่น SettingsModal ที่ปุ่มออกจากระบบ
     อยู่ล่างสุดของเนื้อหาที่ scroll ได้ */
  /* [แก้ตามที่ระบุ — 1.1] โทเคนกลางของแถบเมนูล่าง คำนวณจากขนาดจริงของแถบ (ActionMenuBar.css)
     แทนเลขตายตัวรายหน้า — เดิม 90px/72px(มือถือ) แต่บนมือถือแถบสูงจริง 25 + 56 = 81px > 72px
     ปุ่มล่างสุดของหลายหน้าจึงโดนแถบบัง (+ ไม่ได้รวม safe-area ของ iPhone เลย)
       --action-bar-offset  ระยะแถบจากขอบล่างจอ (ไม่รวม safe-area)
       --action-bar-height  ขอบบนของแถบวัดจากขอบล่างจอ (offset + ความสูงแถบ + safe-area)
       --gpf-safe-bottom    ระยะกันชนที่เนื้อหา/ปุ่มลอยต้องเว้น = ขอบบนของแถบ + ช่องว่าง 10px */
  --action-bar-offset: 25px;
  --action-bar-height: calc(var(--action-bar-offset) + var(--nav-height, 60px) + env(safe-area-inset-bottom, 0px));
  --gpf-safe-bottom: calc(var(--action-bar-height) + 10px);

  /* เงาอมเขียวอ้างอิงโทเคนเขียวแทนค่า rgba ดิบ (เดิมเป็นเขียวอมฟ้าชุดเก่าฝังตายตัว) */
  --sh-card:  0 2px 12px color-mix(in srgb, var(--g800) 9%, transparent), 0 1px 3px color-mix(in srgb, var(--g800) 5%, transparent);
  --sh-hover: 0 8px 28px color-mix(in srgb, var(--g800) 15%, transparent), 0 2px 6px color-mix(in srgb, var(--g800) 7%, transparent);
  --sh-btn:   0 4px 14px color-mix(in srgb, var(--g700) 35%, transparent);
  --sh-coin:  0 4px 14px rgba(244,196,48,.40);
  --sh-modal: 0 24px 64px rgba(0,0,0,.22);

  /* ═══ [ใหม่] Aether — โลกที่ 2: ฉากเวทมนตร์ (Ghibli ยามพลบ + แสงเรือง Sci-Fi) ═══
     ใช้กับ: กรอบเขียวเล่นเควส, หน้าไพ่ทิพย์, เตาเผาขยะความคิด, ฝึกหายใจ, ต้นไม้กลางคืน
     หลักคิด: ไม่มีสีดำสนิทและไม่มีสีจัดจ้าน — ฉากมืดของ Ghibli คือ "สีเข้มที่ยังมีสี"
     และครึ่ง Sci-Fi มาจากแสงเรืองสีหยก ซึ่งอยู่ในตระกูลเขียวของแบรนด์อยู่แล้ว
     จึงไม่ทำให้แอปแตกเป็นสองแอป                                                       */
  --ae-void:    #0A1714;   /* พื้นฉากลึกสุด — เขียวอมดำ */
  --ae-deep:    #0E2A22;   /* พื้นฉากหลัก */
  --ae-mist:    #1B3A34;   /* หมอกในป่า / พื้นการ์ดลอยในฉาก */
  --ae-glow:    #62D9C0;   /* แสงเวทมนตร์หลัก — เขียวหยกอมฟ้า */
  --ae-sun:     #F2C879;   /* แสงตะวันลอดใบไม้ — อำพัน */
  --ae-bloom:   #E9A6C9;   /* ดอกไม้ / หมวดจิตใจ — ชมพูหม่น */
  --ae-bark:    #C9A97E;   /* เปลือกไม้ / กระดาษพาร์ชเมนต์ */
  --ae-rune:    #9D8CF0;   /* วงเวทย์ / รูน — ใช้ที่เดียวเท่านั้น ห้ามใช้พร่ำเพรื่อ */

  /* [ใหม่] โทนม่วง/มืดของหน้าเควสสุขภาพจิต (QuestGateView หมวดจิตใจ + ไพ่ทิพย์) — เดิมแต่ละไฟล์
     ฮาร์ดโค้ดม่วงเข้มไล่ลงไปเกือบดำสนิทที่ขอบเอง (#0a0512 / #070414) คนละไฟล์ คนละเฉด ปรับทีต้อง
     ไล่แก้หลายจุด และความมืดจัดจนเกือบดำที่ขอบภาพรู้สึกกดดันเกินไปสำหรับแอปดูแลใจ รวมเป็นโทเคน
     เดียวที่นี่แทน ผสมเทา/น้ำเงินเข้าไปในความมืดแทนสีดำสนิท (ตัวหนังสือสีอ่อนบนพื้นนี้ยังผ่าน
     WCAG AA สบายๆ) — หมวดสุขภาพกายใช้ชุด --ae-void/--ae-deep/--ae-mist ด้านบนได้เลย (เขียวเทาเข้ม
     อยู่แล้วตามหลักการ Aether ที่ตั้งไว้ ไม่ต้องเพิ่มโทเคนใหม่ซ้ำ) */
  --ae-mental-glow: #423A5F;
  --ae-mental-mid:  #29233D;
  --ae-mental-deep: #191527;

  --ae-text:      #E8F5EE;
  --ae-text-sub:  rgba(232,245,238,.62);
  --ae-text-mute: rgba(232,245,238,.38);

  --ae-surface:      rgba(27,58,52,.58);
  --ae-surface-soft: rgba(255,255,255,.045);
  --ae-surface-edge: rgba(98,217,192,.22);
  --ae-blur:         blur(14px) saturate(1.15);

  --ae-glow-sm:   0 0 12px rgba(98,217,192,.35);
  --ae-glow-md:   0 0 28px rgba(98,217,192,.28), 0 0 8px rgba(98,217,192,.45);
  --ae-glow-warm: 0 0 24px rgba(242,200,121,.32);
  --ae-glow-rune: 0 0 30px rgba(157,140,240,.35);

  /* ระดับความเสี่ยงสุขภาพจิต — เดิมกระจายเป็นสีดิบอยู่หลายไฟล์ */
  --risk-low:      var(--ae-glow);
  --risk-moderate: #FBBF24;
  --risk-high:     #F87171;

  /* ═══ [ใหม่] Type scale + จังหวะบรรทัดสำหรับภาษาไทย ═══
     ตัวไทยมีสระบน-ล่าง ต้องการ line-height สูงกว่าละติน ของเดิมไม่ได้ตั้งไว้เลย */
  --font-display: 'Mali', 'Fredoka One', cursive;
  --font-body:    'IBM Plex Sans Thai', 'Nunito', system-ui, sans-serif;

  --lh-tight: 1.45;   /* หัวเรื่อง */
  --lh-body:  1.75;   /* เนื้อหา */

  /* [เพิ่มตามที่ระบุ — ข้อ 7] --g800 (#1B4332 เขียวเข้ม) ไม่ถูก redefine ตอน dark mode เลย
     (ดู [data-theme="dark"] ด้านล่าง — ไม่มีบรรทัด --g800 อยู่ในนั้น) ยังเป็นเขียวเข้มเท่าเดิม
     ทั้ง 2 โหมด ขณะที่หน้าโปรไฟล์/ตั้งค่าใช้สีนี้เป็นสีหัวเรื่องวางทับ .card (var(--bg-card))
     ซึ่งกลับเข้มขึ้นเป็นเขียวเกือบดำใน dark mode ผลคือหัวเรื่องเขียวเข้มซ้อนบนพื้นเขียวเกือบดำ
     อ่านแทบไม่ออก — เพิ่มโทเคนใหม่แยกต่างหาก (ไม่แก้ --g800 ตรงๆ เพราะมีที่อื่นในแอปอ้างอิงอยู่
     และยังไม่ได้ตรวจ/ทดสอบจุดเหล่านั้นในรอบนี้) ใช้เฉพาะหน้าโปรไฟล์/ตั้งค่าตามที่ระบุ */
  --heading-accent: var(--g800);

  --fs-xs: 11.5px; --fs-sm: 13px; --fs-md: 15px;
  --fs-lg: 18px;   --fs-xl: 22px; --fs-2xl: 28px; --fs-3xl: 36px;

  /* ═══ [ใหม่] จังหวะการเคลื่อนไหวกลาง — ให้ทุกที่ใช้ค่าชุดเดียวกัน ═══ */

  /* [ใหม่] Glass opacity scale — สีขาว/ดำโปร่งแสงที่ถูกใช้ซ้ำหลายไฟล์แบบ raw rgba()
     มาก่อนหน้านี้ (กระจกเมนู/การ์ด/เส้นขอบโปร่งแสงในฉากต่างๆ) แทนที่ด้วยชุดโทเคนนี้
     ค่า alpha คงเดิมทุกจุด (ไม่ merge ค่าใกล้เคียงกัน) เพื่อไม่ให้ภาพเปลี่ยน */
  --glass-w-5: rgba(255, 255, 255, 0.05);
  --glass-w-6: rgba(255, 255, 255, 0.06);
  --glass-w-7: rgba(255, 255, 255, 0.07);
  --glass-w-8: rgba(255, 255, 255, 0.08);
  --glass-w-9: rgba(255, 255, 255, 0.09);
  --glass-w-10: rgba(255, 255, 255, 0.1);
  --glass-w-12: rgba(255, 255, 255, 0.12);
  --glass-w-13: rgba(255, 255, 255, 0.13);
  --glass-w-14: rgba(255, 255, 255, 0.14);
  --glass-w-15: rgba(255, 255, 255, 0.15);
  --glass-w-16: rgba(255, 255, 255, 0.16);
  --glass-w-18: rgba(255, 255, 255, 0.18);
  --glass-w-20: rgba(255, 255, 255, 0.2);
  --glass-w-22: rgba(255, 255, 255, 0.22);
  --glass-w-25: rgba(255, 255, 255, 0.25);
  --glass-w-28: rgba(255, 255, 255, 0.28);
  --glass-w-30: rgba(255, 255, 255, 0.3);
  --glass-w-35: rgba(255, 255, 255, 0.35);
  --glass-w-40: rgba(255, 255, 255, 0.4);
  --glass-w-45: rgba(255, 255, 255, 0.45);
  --glass-w-50: rgba(255, 255, 255, 0.5);
  --glass-w-55: rgba(255, 255, 255, 0.55);
  --glass-w-60: rgba(255, 255, 255, 0.6);
  --glass-w-65: rgba(255, 255, 255, 0.65);
  --glass-w-70: rgba(255, 255, 255, 0.7);
  --glass-w-72: rgba(255, 255, 255, 0.72);
  --glass-w-75: rgba(255, 255, 255, 0.75);
  --glass-w-80: rgba(255, 255, 255, 0.8);
  --glass-w-85: rgba(255, 255, 255, 0.85);
  --glass-w-90: rgba(255, 255, 255, 0.9);
  --glass-w-92: rgba(255, 255, 255, 0.92);
  --glass-w-95: rgba(255, 255, 255, 0.95);
  --glass-w-96: rgba(255, 255, 255, 0.96);
  --glass-b-7: rgba(0, 0, 0, 0.07);
  --glass-b-8: rgba(0, 0, 0, 0.08);
  --glass-b-12: rgba(0, 0, 0, 0.12);
  --glass-b-15: rgba(0, 0, 0, 0.15);
  --glass-b-18: rgba(0, 0, 0, 0.18);
  --glass-b-20: rgba(0, 0, 0, 0.2);
  --glass-b-22: rgba(0, 0, 0, 0.22);
  --glass-b-24: rgba(0, 0, 0, 0.24);
  --glass-b-25: rgba(0, 0, 0, 0.25);
  --glass-b-28: rgba(0, 0, 0, 0.28);
  --glass-b-30: rgba(0, 0, 0, 0.3);
  --glass-b-32: rgba(0, 0, 0, 0.32);
  --glass-b-35: rgba(0, 0, 0, 0.35);
  --glass-b-40: rgba(0, 0, 0, 0.4);
  --glass-b-45: rgba(0, 0, 0, 0.45);
  --glass-b-50: rgba(0, 0, 0, 0.5);
  --glass-b-55: rgba(0, 0, 0, 0.55);
  --glass-b-60: rgba(0, 0, 0, 0.6);
  --glass-b-80: rgba(0, 0, 0, 0.8);

  --ease-out-soft: cubic-bezier(.22, 1, .36, 1);
  --ease-spring:   cubic-bezier(.34, 1.56, .64, 1);
  --dur-fast: .18s; --dur-mid: .32s; --dur-slow: .6s;
}

/* ≤360px แถบเลื่อนลงชิดขอบล่างกว่าเดิม (ActionMenuBar.css) — โทเคนตามเอง ไม่ต้องแก้รายหน้า */
@media (max-width: 360px) { :root { --action-bar-offset: 12px; } }
@media (max-width: 300px) { :root { --action-bar-offset: 6px; } }

/* ─── Dark Mode tokens ─── */
[data-theme="dark"] {
  --bg:         var(--g900);
  --bg-card:    #192A1E;
  --bg-sidebar: #162119;
  --bg-modal:   rgba(0,0,0,.65);
  --text:       #E8F5EC;
  --text-sub:   #7EAD8C;
  --text-muted: #4A6B52;
  --border:     rgba(255,255,255,.08);
  --border-mid: rgba(255,255,255,.13);
  --input-bg:   #1F3328;
  --white:      #192A1E;
  --n50:        #0F1A13;
  --n100:       rgba(255,255,255,.08);
  --n200:       rgba(255,255,255,.13);
  --n300:       #4A6B52;
  --n500:       #7EAD8C;
  --n700:       #B8D4C0;
  --n900:       #E8F5EC;
  --b50:        #1F1810;
  --b100:       #2E2014;
  --g50:        #0F1E15;
  --g100:       #152A1C;
  --sh-card:    0 2px 12px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.3);
  --sh-hover:   0 8px 28px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.3);
  /* [เพิ่มตามที่ระบุ — ข้อ 7] ใช้เฉด --g400 เดียวกับที่หน้าเควสมืด (ไพ่ทิพย์ ฯลฯ) ใช้เป็นสี
     หัวเรื่องบนพื้นเข้มอยู่แล้ว (ดู .oracle-page__title ใน OracleCardsPage.css) แทน --g800 เดิม
     ให้ผ่าน WCAG AA บน --bg-card มืด (#192A1E) สบายๆ โดยยังเป็นโทนเขียวแบรนด์เดิม */
  --heading-accent: var(--g400);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; touch-action: manipulation; overscroll-behavior: none; } /* [แก้ตามที่ระบุ] กันแตะสองครั้งแล้วซูมทั้งหน้า */

body {
  font-family: var(--font-body);
  font-size: var(--fs-md);
  line-height: var(--lh-body);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  transition: background .25s ease, color .25s ease;
}

h1, h2, h3, h4, .display {
  font-family: var(--font-display);
  line-height: var(--lh-tight);
  font-weight: 700;
}
h1 { font-size: var(--fs-3xl); }
h2 { font-size: var(--fs-2xl); }
h3 { font-size: var(--fs-xl); }
h4 { font-size: var(--fs-lg); }

button { font-family: var(--font-body); cursor: pointer; }
input, select, textarea { font-family: var(--font-body); }

/* [ใหม่] โฟกัสคีย์บอร์ดต้องมองเห็นได้เสมอ — เกณฑ์ขั้นต่ำก่อนขึ้นโปรดักชัน */
:focus-visible {
  outline: 2px solid var(--ae-glow);
  outline-offset: 2px;
  border-radius: 4px;
}

::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--g200); border-radius: 99px; }
.no-scroll::-webkit-scrollbar { display: none; }
.no-scroll { scrollbar-width: none; }

/* [ใหม่] ไอคอนรูปจริงแทนอีโมจิ (ดู src/config/iconAssets.ts) — .icon-img สำหรับใช้แทรกกลาง
   ข้อความแบบเดียวกับที่ emoji เคยทำ (ขนาดอิง em ให้สเกลตามฟอนต์รอบข้างอัตโนมัติ, เลื่อนลง
   เล็กน้อยด้วย vertical-align ให้จัดแนวกับข้อความพอดีเหมือน emoji) ส่วน .icon-img--lg สำหรับ
   ไอคอนขนาดคงที่ในปุ่ม/ป้ายที่ไม่ได้อยู่ในบรรทัดข้อความ (เช่น ไอคอนเควสบนปุ่มใหญ่) */
.icon-img {
  width: 1.1em;
  height: 1.1em;
  object-fit: contain;
  vertical-align: -0.15em;
  display: inline-block;
}
.icon-img--lg {
  width: 28px;
  height: 28px;
}

/* [ใหม่ — ตามที่ระบุ "รูปใหญ่ชัดเจน ไม่ใช่ไอคอนเล็กจิ๋วแบบ inline text"] ใช้เฉพาะจุดที่โชว์
   จำนวนรางวัลที่เพิ่งได้รับ (เควสสำเร็จ/ป๊อปอัพผลลัพธ์) — ใหญ่กว่า .icon-img ปกติชัดเจน
   แต่ยังพอดีกับ inline text รอบข้าง ไม่ล้นจนดีไซน์เพี้ยน */
.icon-img--reward {
  width: 22px;
  height: 22px;
  object-fit: contain;
  vertical-align: -5px;
  display: inline-block;
}

.card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  border: 1px solid var(--border);
}

.glass {
  background: rgba(255,255,255,.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
[data-theme="dark"] .glass {
  background: rgba(25,42,30,.82);
}

.tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 10px; border-radius: var(--r-pill);
  font-size: 11px; font-weight: 700;
}

/* Butterfly animation */
@keyframes flutter {
  0%   { transform: translate(0,0) rotate(-10deg); }
  25%  { transform: translate(12px,-8px) rotate(10deg); }
  50%  { transform: translate(24px,4px) rotate(-8deg); }
  75%  { transform: translate(12px,-12px) rotate(12deg); }
  100% { transform: translate(0,0) rotate(-10deg); }
}
.butterfly { animation: flutter 3s ease-in-out infinite; }

/* Post-it wobble */
@keyframes wobble {
  0%,100% { transform: rotate(-3deg); }
  50%      { transform: rotate(3deg); }
}

/* Coin bounce */
@keyframes coinPop {
  0%   { transform: scale(0) translateY(0); opacity:1; }
  70%  { transform: scale(1.2) translateY(-30px); opacity:1; }
  100% { transform: scale(1) translateY(-60px); opacity:0; }
}
.coin-pop { animation: coinPop .7s ease forwards; }

/* Responsive */
@media (max-width: 640px)  { .hide-mobile  { display: none !important; } }
@media (min-width: 641px)  { .show-mobile  { display: none !important; } }
@media (max-width: 900px)  { .hide-tablet  { display: none !important; } }
@media (min-width: 901px)  { .show-tablet  { display: none !important; } }

/* ─── V3 Micro-interaction keyframes ─── */

/* Floating reward text (+EXP / +Coin) */
@keyframes floatUp {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  60%  { opacity: 1; transform: translateY(-52px) scale(1.12); }
  100% { opacity: 0; transform: translateY(-80px) scale(.9); }
}
.float-up { animation: floatUp 1.4s cubic-bezier(.2,.8,.4,1) forwards; }

/* Confetti piece fall */
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg) scale(1);   opacity: 1; }
  100% { transform: translateY(90px) rotate(var(--cr,540deg)) scale(.5); opacity: 0; }
}

/* Sparkle placed-item burst */
@keyframes sparklePop {
  0%   { transform: scale(0) rotate(0deg);   opacity: 1; }
  55%  { transform: scale(1.3) rotate(180deg); opacity: 1; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}
.sparkle-dot { animation: sparklePop .7s ease forwards; }

/* Firefly float at night */
@keyframes fireflyFloat {
  0%,100% { opacity: 0;   transform: translate(0, 0); }
  40%     { opacity: .85; transform: translate(var(--ffx, 12px), var(--ffy, -16px)); }
  70%     { opacity: .6;  transform: translate(calc(var(--ffx, 12px)*.6), var(--ffy, -16px)); }
}

/* Star twinkle */
@keyframes twinkle {
  0%,100% { opacity: .25; transform: scale(.8); }
  50%     { opacity: 1;   transform: scale(1.3); }
}

/* Sun ray pulse */
@keyframes sunrayPulse {
  0%,100% { opacity: .18; }
  50%     { opacity: .32; }
}

/* Celebration modal pop-in */
@keyframes celebPop {
  0%  { transform: scale(0) rotate(-12deg); opacity: 0; }
  65% { transform: scale(1.08) rotate(3deg); opacity: 1; }
  82% { transform: scale(.96) rotate(-1deg); }
  100%{ transform: scale(1) rotate(0deg); opacity: 1; }
}

/* Slide up from bottom */
@keyframes slideUp {
  0%   { transform: translateY(30px); opacity: 0; }
  100% { transform: translateY(0);    opacity: 1; }
}
.slide-up { animation: slideUp .5s cubic-bezier(.2,.8,.4,1) forwards; }

/* Treasure chest lid open */
@keyframes chestLid {
  0%   { transform: rotateX(0deg) translateY(0); }
  100% { transform: rotateX(-110deg) translateY(-4px); }
}

/* Speaker icon bounce on change */
@keyframes speakerPulse {
  0%,100% { transform: scale(1); }
  40%     { transform: scale(1.45) rotate(-8deg); }
  70%     { transform: scale(.9)  rotate(5deg); }
}
.speaker-pulse { animation: speakerPulse .45s ease; }

/* Item sparkle ring */
@keyframes sparkleRing {
  0%   { transform: scale(.6); opacity: 1; }
  100% { transform: scale(2.2); opacity: 0; }
}
.sparkle-ring { animation: sparkleRing .65s ease-out forwards; }

/* Celebrate confetti rain (position randomly via --cx CSS var) */
@keyframes confettiRain {
  0%   { transform: translateX(var(--cx,0px)) translateY(-20px) rotate(0deg); opacity: 1; }
  100% { transform: translateX(calc(var(--cx,0px) + var(--csx,0px))) translateY(120px) rotate(var(--cr,420deg)); opacity: 0; }
}

/* ════════════════════════════════════════════════════════════════════════════
   [ใหม่] เคารพ prefers-reduced-motion ระดับโกลบอล
   ────────────────────────────────────────────────────────────────────────────
   เดิมทำไว้เฉพาะจุด (TreeOfLife.css กับทูลทิปบน Dashboard) แต่มีอนิเมชันอีกหลายสิบตัว
   ที่ยังวิ่งอยู่ สำหรับแอปสุขภาพจิตนี่ไม่ใช่แค่มารยาท — ผู้ใช้ที่เวียนศีรษะจากการเคลื่อนไหว
   คือกลุ่มที่ทับซ้อนกับกลุ่มเป้าหมายโดยตรง
   ════════════════════════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}

/* [แก้ตามที่ระบุ] หน้าเควส/หน้าเล่นเควส: ปุ่มกากบาท (Cross.png) และย้อนกลับ (Return.png) แสดงแค่รูป
   ไม่มีวงกลม/พื้นหลัง/ขอบ — ครอบทุกหน้าเควส (แต่ละหน้ามีคลาสปุ่มปิดของตัวเอง จึงจับจาก "ปุ่มที่มีแค่รูป
   กากบาท/ย้อนกลับรูปเดียว" แทนการไล่แก้ทีละคลาส) เงารอบตัวรูปแทนวงกลม ให้ยังเห็นชัดบนทุกพื้นหลัง */
:is(.quest-section-root, .game-shell, .camera-fullscreen-container) button:has(> img:only-child:is([src*="Cross."], [src*="Return."])) {
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  padding: 0;
}
:is(.quest-section-root, .game-shell, .camera-fullscreen-container) button:has(> img:only-child:is([src*="Cross."], [src*="Return."])) > img {
  width: 36px !important;
  height: 36px !important;
  object-fit: contain;
  filter: drop-shadow(0 2px 5px var(--glass-b-35));
  transition: transform .15s ease;
}
:is(.quest-section-root, .game-shell, .camera-fullscreen-container) button:has(> img:only-child:is([src*="Cross."], [src*="Return."])):hover > img { transform: scale(1.08); }

/* ═══════════════════════════════════════════════════════════════════════════
   ธีมกระดานจัดอันดับ (ใช้ซ้ำทั่วแอป) — การ์ด/ปุ่ม/ตัวหนังสือชุดเดียวกับกรอบ .lb-frame
   ────────────────────────────────────────────────────────────────────────────
   .lb-card  : ขอบทอง + วงในบาง + พื้นเขียวอ่อนไล่เฉด (มืด: เขียวเข้ม ตัวหนังสือขาว)
   .lb-btn   : ปุ่มแบบป้ายกระดาน (เขียวไล่เฉด ขอบทอง ขอบล่างหนาแบบปุ่มเกม) — ไม่มีอีโมจิ
   .lb-text / .lb-text-sub : ตัวหนังสือขาว-ดำเท่านั้น ไล่ความเข้ม 2 ระดับ (ไม่ใช้เหลือง/ส้ม/แดง)
   ═══════════════════════════════════════════════════════════════════════════ */
:root {
  --lb-gold-edge: color-mix(in srgb, var(--coin) 70%, var(--g600));
  --lb-card-bg: linear-gradient(180deg, color-mix(in srgb, var(--fixed-white) 55%, var(--leaf-soft)) 0%, var(--leaf-soft) 100%);
  --lb-card-text: var(--n900);
  --lb-card-text-sub: color-mix(in srgb, var(--n900) 72%, transparent);
  --lb-btn-bg: linear-gradient(180deg, var(--leaf-soft-strong) 0%, var(--leaf-soft-active) 100%);
  --lb-btn-text: var(--on-leaf-soft);
}
[data-theme="dark"] {
  --lb-card-bg: linear-gradient(180deg, var(--g700) 0%, var(--g800) 100%);
  --lb-card-text: var(--fixed-white);
  --lb-card-text-sub: color-mix(in srgb, var(--fixed-white) 78%, transparent);
  --lb-btn-bg: linear-gradient(180deg, var(--g600) 0%, var(--g800) 100%);
  --lb-btn-text: var(--fixed-white);
}
.lb-card {
  background: var(--lb-card-bg);
  border: 2px solid var(--lb-gold-edge);
  border-radius: 18px;
  box-shadow: 0 10px 28px var(--glass-b-25), inset 0 0 0 3px color-mix(in srgb, var(--fixed-white) 35%, transparent), inset 0 0 0 4px color-mix(in srgb, var(--coin) 25%, transparent);
  color: var(--lb-card-text);
  font-family: var(--font-display);
}
.lb-text { color: var(--lb-card-text) !important; }
.lb-text-sub { color: var(--lb-card-text-sub) !important; }
.lb-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 46px; padding: 10px 28px;
  border: 2px solid var(--lb-gold-edge); border-radius: 14px;
  background: var(--lb-btn-bg); color: var(--lb-btn-text);
  font-family: var(--font-display); font-size: var(--fs-md);
  box-shadow: 0 3px 0 color-mix(in srgb, var(--lb-gold-edge) 70%, var(--g800)), 0 6px 14px var(--glass-b-20);
  cursor: pointer; transition: transform .15s ease, filter .15s ease;
}
.lb-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
.lb-btn:active { transform: translateY(1px); }
.lb-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
.lb-btn--wide { width: 100%; }
.lb-btn--ghost { background: var(--lb-card-bg); color: var(--lb-card-text); }


/* ═══ [แก้ตามที่ระบุ] ป็อปอัพ "ทำภารกิจสำเร็จ" ของทุกเควส — การ์ดแบบกระดานจัดอันดับ ═══
   ใช้คู่กับ .lb-banner.quest-done-card__banner (ป้ายหัวการ์ด) และปุ่ม .lb-btn
   ตัวหนังสือ: ดำ (สว่าง) / ขาว (มืด) ไล่ 2 ระดับ ไม่ใช้เหลือง/ส้ม/แดง */
.quest-done-card {
  position: relative;
  width: 100%;
  max-width: 440px;
  margin: 0 auto;
  padding: 36px 22px 22px !important;
  border-radius: 22px !important;
  background: var(--lb-card-bg) !important;
  border: 2px solid var(--lb-gold-edge) !important;
  box-shadow: 0 4px 0 color-mix(in srgb, var(--lb-gold-edge) 60%, var(--g800)), 0 14px 32px var(--glass-b-30) !important;
  backdrop-filter: none !important;
  color: var(--lb-card-text) !important;
  font-family: var(--font-display);
  text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.quest-done-card :is(h1, h2, h3, strong) { color: var(--lb-card-text) !important; font-family: var(--font-display) !important; text-shadow: none !important; }
.quest-done-card :is(p, li, span:not(.lb-banner)) { color: var(--lb-card-text-sub) !important; text-shadow: none !important; }
.quest-done-card > div:not(.quest-done-card__banner) { color: var(--lb-card-text) !important; }
.quest-done-card .lb-btn { color: var(--lb-btn-text) !important; margin-top: 4px; }
.quest-done-card .lb-btn + .lb-btn { margin-top: 0; }
.quest-done-card__banner {
  position: absolute !important; top: -17px; left: 50%; transform: translateX(-50%);
  font-size: 15px; max-width: calc(100% - 40px);
}

/* ═══ [แก้ตามที่ระบุ] ปุ่มกากบาททั้งแอป (ตั้งค่า/ข้อมูลต้นไม้/ตั้งค่าโปรไฟล์/แจ้งเตือน/ความเป็นส่วนตัว/
   เปลี่ยนรหัสผ่าน/ลบบัญชี/เช็คอินอารมณ์/สตอรี่ ฯลฯ) — แสดงแค่รูปกากบาท ไม่มีวงกลม/พื้นหลัง/ขอบล้อมรอบ
   จับจาก "ปุ่มที่มีรูป Cross.png เป็น element ลูกตัวเดียว" จึงครอบทุกหน้าโดยไม่ต้องไล่แก้ทีละคลาส
   (!important เพื่อชนะ inline style/คลาสเดิมของแต่ละหน้า) — ขนาดรูปคงเดิมของแต่ละที่
   เงารอบตัวรูปแทนวงกลม ให้ยังมองเห็นชัดบนทุกพื้นหลัง ═══ */
button:has(> img:only-child[src*="Cross."]) {
  background: none !important;
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
  outline-offset: 2px;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}
button:has(> img:only-child[src*="Cross."])::before,
button:has(> img:only-child[src*="Cross."])::after { content: none !important; }
button:has(> img:only-child[src*="Cross."]) > img {
  filter: drop-shadow(0 2px 4px var(--glass-b-30));
  transition: transform .15s ease;
}
button:has(> img:only-child[src*="Cross."]):hover > img { transform: scale(1.08); }

/* ═══ [แก้ตามที่ระบุ] ขนาดปุ่มกากบาทมาตรฐานเดียวทั้งแอป ═══
   • หน้าเต็มจอ (ตั้งค่า/ร้านค้า/โปรไฟล์/สตอรี่/หน้าเควส/ประวัติ ฯลฯ) = 36px เท่าปุ่มกากบาทหน้าหลักเควสสุขภาพ
   • ป็อปอัพ (เช็คอินอารมณ์รายวัน/ข้อมูลต้นไม้/แจ้งเตือน/ป็อปอัพทุกอัน) = 28px เท่ากันหมด */
button:has(> img:only-child[src*="Cross."]) > img {
  width: 36px !important;
  height: 36px !important;
  object-fit: contain;
}
:is(.popup-close, .mood-checkin-close, .tree-of-life__tooltip-close, .medical-box-alert__close, .info-popup__close,
    .quest-feedback-prompt__dismiss, .balanced-nutrients__history-close, .food-picker__close):has(> img:only-child[src*="Cross."]) > img,
:is(.mood-checkin-card, .ui-overlay__panel, .story-modal-card, .player-detail-modal-card, .quest-confirm-card, .lb-card)
  button:has(> img:only-child[src*="Cross."]) > img {
  width: 28px !important;
  height: 28px !important;
}
/* ปุ่มลบเล็กๆ ในรายการ (ไม่ใช่ปุ่มปิดหน้า/ป็อปอัพ) */
:is(.story-search-row__remove, .story-image-preview button):has(> img:only-child[src*="Cross."]) > img {
  width: 20px !important;
  height: 20px !important;
}

/* ═══ [แก้ตามที่ระบุ] แถบกึ่งกลางด้านบนทุกหน้า = ขนาด/ฟอนต์เดียวกับป้ายหัวหน้าเควส (.quest-section-title-pill)
   ใช้กับ: ป้ายหน้าเควส · ป้ายชื่อเควสใน GameShell · ป้าย "ต้นไม้ของ…" · ป้ายหัวหน้าประวัติ/สร้างสตอรี่ ═══ */
:is(.quest-section-title-pill, .top-center-pill, .dashboard__viewing-name-pill,
    .journal-history__banner, .voice-history__banner, .postit-history__banner, .story-compose-page__banner).lb-banner {
  padding: 5px 18px !important;
  font-size: 16px !important;
  font-family: var(--font-display);
  line-height: 1.2;
}
@media (max-width: 480px) {
  :is(.quest-section-title-pill, .top-center-pill, .dashboard__viewing-name-pill,
      .journal-history__banner, .voice-history__banner, .postit-history__banner, .story-compose-page__banner).lb-banner {
    padding: 4px 14px !important;
    font-size: 14px !important;
  }
}

/* [แก้ตามที่ระบุ] การ์ดฟอร์มสมัครสมาชิก/เข้าสู่ระบบ — ไม่มีเอฟเฟกต์เคลื่อนไหวใดๆ (ไม่มีแสงวิ่ง/รัศมี/การขยับ) */
.auth-card :is(label, p, span, a) { text-shadow: none; }
.auth-card input::placeholder { color: color-mix(in srgb, #1a2e22 45%, transparent); }

/* [แก้ตามที่ระบุ] รูปท้ายข้อความแนะนำหน้า Welcome — ขยายแต่ไม่ดันความสูงบรรทัด */
/* [อัปเดต 2026-10-18] รูปหมวดเควสชุดใหม่เนื้อรูปเต็มไฟล์แล้ว — ไม่ต้องหักขอบโปร่งใสมากอย่างเดิม */
.welcome-msg-icon { display: inline-block; vertical-align: middle; margin: -.5em .05em -.4em .15em; line-height: 0; }
.welcome-msg-icon--logo { margin: -.55em .05em -.45em .2em; }
.welcome-msg-icon img { filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .45)); }
