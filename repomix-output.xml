        ซึ่งเดิมไม่มีโทเคนของตัวเองเลย ต้องเขียนสีดิบทุกไฟล์ → สีม่วง/เขียวเรือง
        ในแต่ละหน้าเลยเป็นคนละเฉด
     3. เพิ่ม type scale, focus-visible กลาง, prefers-reduced-motion ระดับโกลบอล
     4. ถอด @import 'tailwindcss' ออก (ติดตั้งไว้แต่แทบไม่ได้ใช้จริง)
   คีย์เฟรม/utility เดิมทั้งหมดด้านล่างคงไว้ครบ ไม่มีการลบ
   ════════════════════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Mali:wght@400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap');

/* ─── Light Mode tokens ─── */
:root {
  --g900: #0B2F1E; --g800: #1B4332; --g700: #2D6A4F;
  --g600: #40916C; --g500: #52B788; --g400: #74C69D;
  --g300: #95D5B2; --g200: #B7E4C7; --g100: #D8F3DC; --g50: #F0FBF4;

  --b900: #3B1F0A; --b700: #5C3D1E; --b500: #8B5E3C;
  --b300: #C4956A; --b100: #EDD9C0; --b50:  #FBF4EC;

  --n900: #1A1F1B; --n700: #2B3A2E; --n500: #5A6B5D;
  --n300: #9BAD9F; --n200: #C8D5CA; --n100: #E8EDE5;
  --n50:  #F4F7F2; --white: #FFFFFF;

  /* [ใหม่] --fixed-white ต่างจาก --white ตรงที่ "ไม่กลับสีตอน dark mode" (--white ใน
     dark mode กลายเป็นเกือบดำ เพราะทำหน้าที่เป็นโทเคนพื้นผิว/การ์ด ไม่ใช่ "สีขาว" ตรงตัว)
     ใช้ตัวนี้กับตัวหนังสือ/ไอคอน/เส้นขอบสีขาวที่วางทับพื้นมืดตายตัวเสมอ เช่น วิดีโอพื้นหลัง
     ฉากเวทมนตร์ (Aether) หรือปุ่มลอยกระจกดำ ที่ไม่เกี่ยวกับธีมสว่าง/มืดของแอปเลย */
  --fixed-white: #FFFFFF;

  --coin: #F4C430; --exp: #FFD60A;
  --blue: #4CC9F0; --pink: #FF85A1; --purple: #C77DFF;
  --orange: #F4845F; --red: #EF476F;

  /* Semantic */
  --bg:         var(--n50);
  --bg-card:    var(--white);
  --bg-sidebar: var(--white);
  --bg-modal:   rgba(0,0,0,.45);
  --text:       var(--n900);
  --text-sub:   var(--n500);
  --text-muted: var(--n300);
  --border:     var(--n100);
  --border-mid: var(--n200);
  --input-bg:   var(--white);

  --r-sm: 10px; --r-md: 16px; --r-lg: 24px; --r-xl: 32px; --r-pill: 999px;

  /* [ย้ายมาที่นี่ — เดิมประกาศเฉพาะใน .gameplay-frame (GameplayFrame.css) เท่านั้น]
     ระยะกันชนของ ActionMenuBar ที่ลอยอยู่ล่างจอเสมอ (z-index: 1000 สูงกว่าทุก modal
     ตั้งใจให้ลอยทับ เพื่อให้กดสลับหน้าได้แม้เปิด modal ค้างอยู่ — ดู ActionMenuBar.css)
     รวม --nav-height 70px + bottom 25px ของ .action-menu-container ≈ 100px (มือถือ
     54px + 15px ≈ 80px) ย้ายมาเป็นโทเคนกลางที่ :root เพื่อให้ "ทุกหน้าจอที่ scroll ได้
     เต็มจอ" (ไม่ใช่แค่หน้าเควส) อ้างอิงร่วมกันได้ เช่น SettingsModal ที่ปุ่มออกจากระบบ
     อยู่ล่างสุดของเนื้อหาที่ scroll ได้ */
  --gpf-safe-bottom: 100px;

  --sh-card:  0 2px 12px rgba(27,67,50,.09), 0 1px 3px rgba(27,67,50,.05);
  --sh-hover: 0 8px 28px rgba(27,67,50,.15), 0 2px 6px rgba(27,67,50,.07);
  --sh-btn:   0 4px 14px rgba(45,106,79,.35);
  --sh-coin:  0 4px 14px rgba(244,196,48,.40);
  --sh-modal: 0 24px 64px rgba(0,0,0,.22);

  /* ═══ [ใหม่] Aether — โลกที่ 2: ฉากเวทมนตร์ (Ghibli ยามพลบ + แสงเรือง Sci-Fi) ═══
     ใช้กับ: กรอบเขียวเล่นเควส, หน้าไพ่ทิพย์, เตาเผาขยะความคิด, ฝึกหายใจ, ต้นไม้กลางคืน
     หลักคิด: ไม่มีสีดำสนิทและไม่มีสีจัดจ้าน — ฉากมืดของ Ghibli คือ "สีเข้มที่ยังมีสี"
     และครึ่ง Sci-Fi มาจากแสงเรืองสีหยก ซึ่งอยู่ในตระกูลเขียวของแบรนด์อยู่แล้ว
     จึงไม่ทำให้แอปแตกเป็นสองแอป                                                       */
  --ae-void:    #0A1714;   /* พื้นฉากลึกสุด — เขียวอมดำ */
  --ae-deep:    #0E2A22;   /* พื้นฉากหลัก */
  --ae-mist:    #1B3A34;   /* หมอกในป่า / พื้นการ์ดลอยในฉาก */
  --ae-glow:    #62D9C0;   /* แสงเวทมนตร์หลัก — เขียวหยกอมฟ้า */
  --ae-sun:     #F2C879;   /* แสงตะวันลอดใบไม้ — อำพัน */
  --ae-bloom:   #E9A6C9;   /* ดอกไม้ / หมวดจิตใจ — ชมพูหม่น */
  --ae-bark:    #C9A97E;   /* เปลือกไม้ / กระดาษพาร์ชเมนต์ */
  --ae-rune:    #9D8CF0;   /* วงเวทย์ / รูน — ใช้ที่เดียวเท่านั้น ห้ามใช้พร่ำเพรื่อ */

  /* [ใหม่] โทนม่วง/มืดของหน้าเควสสุขภาพจิต (QuestGateView หมวดจิตใจ + ไพ่ทิพย์) — เดิมแต่ละไฟล์
     ฮาร์ดโค้ดม่วงเข้มไล่ลงไปเกือบดำสนิทที่ขอบเอง (#0a0512 / #070414) คนละไฟล์ คนละเฉด ปรับทีต้อง
     ไล่แก้หลายจุด และความมืดจัดจนเกือบดำที่ขอบภาพรู้สึกกดดันเกินไปสำหรับแอปดูแลใจ รวมเป็นโทเคน
     เดียวที่นี่แทน ผสมเทา/น้ำเงินเข้าไปในความมืดแทนสีดำสนิท (ตัวหนังสือสีอ่อนบนพื้นนี้ยังผ่าน
     WCAG AA สบายๆ) — หมวดสุขภาพกายใช้ชุด --ae-void/--ae-deep/--ae-mist ด้านบนได้เลย (เขียวเทาเข้ม
     อยู่แล้วตามหลักการ Aether ที่ตั้งไว้ ไม่ต้องเพิ่มโทเคนใหม่ซ้ำ) */
  --ae-mental-glow: #423A5F;
  --ae-mental-mid:  #29233D;
  --ae-mental-deep: #191527;

  --ae-text:      #E8F5EE;
  --ae-text-sub:  rgba(232,245,238,.62);
  --ae-text-mute: rgba(232,245,238,.38);

  --ae-surface:      rgba(27,58,52,.58);
  --ae-surface-soft: rgba(255,255,255,.045);
  --ae-surface-edge: rgba(98,217,192,.22);
  --ae-blur:         blur(14px) saturate(1.15);

  --ae-glow-sm:   0 0 12px rgba(98,217,192,.35);
  --ae-glow-md:   0 0 28px rgba(98,217,192,.28), 0 0 8px rgba(98,217,192,.45);
  --ae-glow-warm: 0 0 24px rgba(242,200,121,.32);
  --ae-glow-rune: 0 0 30px rgba(157,140,240,.35);

  /* ระดับความเสี่ยงสุขภาพจิต — เดิมกระจายเป็นสีดิบอยู่หลายไฟล์ */
  --risk-low:      var(--ae-glow);
  --risk-moderate: #FBBF24;
  --risk-high:     #F87171;

  /* ═══ [ใหม่] Type scale + จังหวะบรรทัดสำหรับภาษาไทย ═══
     ตัวไทยมีสระบน-ล่าง ต้องการ line-height สูงกว่าละติน ของเดิมไม่ได้ตั้งไว้เลย */
  --font-display: 'Mali', 'Fredoka One', cursive;
  --font-body:    'IBM Plex Sans Thai', 'Nunito', system-ui, sans-serif;

  --lh-tight: 1.45;   /* หัวเรื่อง */
  --lh-body:  1.75;   /* เนื้อหา */

  /* [เพิ่มตามที่ระบุ — ข้อ 7] --g800 (#1B4332 เขียวเข้ม) ไม่ถูก redefine ตอน dark mode เลย
     (ดู [data-theme="dark"] ด้านล่าง — ไม่มีบรรทัด --g800 อยู่ในนั้น) ยังเป็นเขียวเข้มเท่าเดิม
     ทั้ง 2 โหมด ขณะที่หน้าโปรไฟล์/ตั้งค่าใช้สีนี้เป็นสีหัวเรื่องวางทับ .card (var(--bg-card))
     ซึ่งกลับเข้มขึ้นเป็นเขียวเกือบดำใน dark mode ผลคือหัวเรื่องเขียวเข้มซ้อนบนพื้นเขียวเกือบดำ
     อ่านแทบไม่ออก — เพิ่มโทเคนใหม่แยกต่างหาก (ไม่แก้ --g800 ตรงๆ เพราะมีที่อื่นในแอปอ้างอิงอยู่
     และยังไม่ได้ตรวจ/ทดสอบจุดเหล่านั้นในรอบนี้) ใช้เฉพาะหน้าโปรไฟล์/ตั้งค่าตามที่ระบุ */
  --heading-accent: var(--g800);

  --fs-xs: 11.5px; --fs-sm: 13px; --fs-md: 15px;
  --fs-lg: 18px;   --fs-xl: 22px; --fs-2xl: 28px; --fs-3xl: 36px;

  /* ═══ [ใหม่] จังหวะการเคลื่อนไหวกลาง — ให้ทุกที่ใช้ค่าชุดเดียวกัน ═══ */

  /* [ใหม่] Glass opacity scale — สีขาว/ดำโปร่งแสงที่ถูกใช้ซ้ำหลายไฟล์แบบ raw rgba()
     มาก่อนหน้านี้ (กระจกเมนู/การ์ด/เส้นขอบโปร่งแสงในฉากต่างๆ) แทนที่ด้วยชุดโทเคนนี้
     ค่า alpha คงเดิมทุกจุด (ไม่ merge ค่าใกล้เคียงกัน) เพื่อไม่ให้ภาพเปลี่ยน */
  --glass-w-5: rgba(255, 255, 255, 0.05);
  --glass-w-6: rgba(255, 255, 255, 0.06);
  --glass-w-7: rgba(255, 255, 255, 0.07);
  --glass-w-8: rgba(255, 255, 255, 0.08);
  --glass-w-9: rgba(255, 255, 255, 0.09);
  --glass-w-10: rgba(255, 255, 255, 0.1);
  --glass-w-12: rgba(255, 255, 255, 0.12);
  --glass-w-13: rgba(255, 255, 255, 0.13);
  --glass-w-14: rgba(255, 255, 255, 0.14);
  --glass-w-15: rgba(255, 255, 255, 0.15);
  --glass-w-16: rgba(255, 255, 255, 0.16);
  --glass-w-18: rgba(255, 255, 255, 0.18);
  --glass-w-20: rgba(255, 255, 255, 0.2);
  --glass-w-22: rgba(255, 255, 255, 0.22);
  --glass-w-25: rgba(255, 255, 255, 0.25);
  --glass-w-28: rgba(255, 255, 255, 0.28);
  --glass-w-30: rgba(255, 255, 255, 0.3);
  --glass-w-35: rgba(255, 255, 255, 0.35);
  --glass-w-40: rgba(255, 255, 255, 0.4);
  --glass-w-45: rgba(255, 255, 255, 0.45);
  --glass-w-50: rgba(255, 255, 255, 0.5);
  --glass-w-55: rgba(255, 255, 255, 0.55);
  --glass-w-60: rgba(255, 255, 255, 0.6);
  --glass-w-65: rgba(255, 255, 255, 0.65);
  --glass-w-70: rgba(255, 255, 255, 0.7);
  --glass-w-72: rgba(255, 255, 255, 0.72);
  --glass-w-75: rgba(255, 255, 255, 0.75);
  --glass-w-80: rgba(255, 255, 255, 0.8);
  --glass-w-85: rgba(255, 255, 255, 0.85);
  --glass-w-90: rgba(255, 255, 255, 0.9);
  --glass-w-92: rgba(255, 255, 255, 0.92);
  --glass-w-95: rgba(255, 255, 255, 0.95);
  --glass-w-96: rgba(255, 255, 255, 0.96);
  --glass-b-7: rgba(0, 0, 0, 0.07);
  --glass-b-8: rgba(0, 0, 0, 0.08);
  --glass-b-12: rgba(0, 0, 0, 0.12);
  --glass-b-15: rgba(0, 0, 0, 0.15);
  --glass-b-18: rgba(0, 0, 0, 0.18);
  --glass-b-20: rgba(0, 0, 0, 0.2);
  --glass-b-22: rgba(0, 0, 0, 0.22);
  --glass-b-24: rgba(0, 0, 0, 0.24);
  --glass-b-25: rgba(0, 0, 0, 0.25);
  --glass-b-28: rgba(0, 0, 0, 0.28);
  --glass-b-30: rgba(0, 0, 0, 0.3);
  --glass-b-32: rgba(0, 0, 0, 0.32);
  --glass-b-35: rgba(0, 0, 0, 0.35);
  --glass-b-40: rgba(0, 0, 0, 0.4);
  --glass-b-45: rgba(0, 0, 0, 0.45);
