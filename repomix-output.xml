}

.gratitude-shield-done {
  width: 100%;
  max-width: 400px;
  padding: 40px 32px;
  border-radius: 28px;
  background: var(--bg-card);
  box-shadow: 0 24px 60px var(--glass-b-40);
  text-align: center;
}

.gratitude-shield-done__icon {
  font-size: 64px;
