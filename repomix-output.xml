<file path="src/utils/restLog.ts">
/*============================================================================*\
  restLog.ts — เวลาพักผ่อนของ "ผู้พิทักษ์การพักผ่อน" (เก็บในเครื่องแยกตามบัญชี)
  ────────────────────────────────────────────────────────────────────────────
  ทำงานเบื้องหลังคู่กับ "หยั่งรากลึก": จดจ่อครบ 90 นาที → startRest() เริ่มจับเวลาพัก 15 นาทีอัตโนมัติ
  ใช้เวลาจริง (timestamp) ไม่ใช่ตัวนับในหน้าจอ — พักต่อได้แม้ปิดหน้าเควส และตัวจับเวลาของ
  หยั่งรากลึกยังเดินต่อตามปกติ ไม่ถูกขัด · ครบเวลาแล้วนับเป็น "เวลาพักที่ทำได้" ทันที
\*============================================================================*/

export interface RestSession {
  startedAt: string
  minutes: number
}

export const REST_LOG_CHANGED_EVENT = 'bloom:rest-log-changed'

const key = (userId: string) => `bloom:rest-log:${userId}`
const MAX_SESSIONS = 200

export function loadRestSessions(userId: string): RestSession[] {
  try {
    const raw = window.localStorage.getItem(key(userId))
    return raw ? (JSON.parse(raw) as RestSession[]) : []
  } catch { return [] }
}

/** เริ่มพัก (เรียกตอนหยั่งรากลึกครบช่วงจดจ่อ) — ถ้ายังมีรอบพักค้างอยู่ ไม่เริ่มซ้อน */
export function startRest(userId: string, minutes: number, now: Date = new Date()): void {
  if (!userId) return
  const list = loadRestSessions(userId)
  if (activeRest(list, now.getTime())) return
  try {
    window.localStorage.setItem(key(userId), JSON.stringify([...list, { startedAt: now.toISOString(), minutes }].slice(-MAX_SESSIONS)))
    window.dispatchEvent(new CustomEvent(REST_LOG_CHANGED_EVENT))
  } catch { /* storage ปิด */ }
}

const endOf = (s: RestSession) => new Date(s.startedAt).getTime() + s.minutes * 60_000

/** รอบพักที่กำลังนับอยู่ (null = ไม่ได้พัก) */
export function activeRest(list: RestSession[], nowMs: number): RestSession | null {
  return list.find((s) => new Date(s.startedAt).getTime() <= nowMs && endOf(s) > nowMs) ?? null
}

/** เวลาพักที่ทำได้ (นาที) — นับเฉพาะรอบที่พักครบแล้ว · วันนี้ / ทั้งหมด */
/** [แก้ตามที่ระบุ — ผู้พิทักษ์การพักผ่อน] วันนี้มีรอบพักที่ "จบครบ 15 นาทีเต็ม" แล้วหรือยัง */
export const FULL_REST_MINUTES = 15
export function completedFullRestToday(list: RestSession[], nowMs: number): boolean {
  const today = new Date(nowMs).toDateString()
  return list.some((s) => s.minutes >= FULL_REST_MINUTES && endOf(s) <= nowMs && new Date(endOf(s)).toDateString() === today)
}

export function restTotals(list: RestSession[], nowMs: number): { todayMinutes: number; totalMinutes: number; sessionsToday: number } {
  const today = new Date(nowMs).toDateString()
  let todayMinutes = 0, totalMinutes = 0, sessionsToday = 0
  for (const s of list) {
    if (endOf(s) > nowMs) continue
    totalMinutes += s.minutes
    if (new Date(s.startedAt).toDateString() === today) { todayMinutes += s.minutes; sessionsToday++ }
  }
  return { todayMinutes, totalMinutes, sessionsToday }
}
</file>

<file path="src/utils/savedPosts.ts">
import { useCallback, useEffect, useState } from 'react'

/*============================================================================*\
  savedPosts.ts — [ใหม่ตามที่ระบุ] "บันทึกโพสต์" (ไอคอนบุ๊กมาร์กขวาสุดของแถวไอคอน แบบ IG)
  เก็บในเครื่องแยกตามบัญชี — backend ยังไม่มีตาราง saved posts (ข้อเสนอ: POST/DELETE
  /api/posts/:id/save · GET /api/posts/saved) เปลี่ยนเครื่องแล้วรายการที่บันทึกไม่ตามไป
\*============================================================================*/

const KEY = (userId: string) => `bloom:saved-posts:${userId}`
const CHANGED = 'bloom:saved-posts-changed'

function load(userId: string): string[] {
  try {
    const raw = localStorage.getItem(KEY(userId))
    return raw ? (JSON.parse(raw) as string[]) : []
  } catch { return [] }
}

/** [ใหม่ตามที่ระบุ] รายการ id โพสต์ที่บันทึกไว้ทั้งหมด (ล่าสุดก่อน) — หน้า "บันทึก" ในเมนูสามขีดของสตอรี่ */
export function useSavedPostIds(userId: string): string[] {
  const [ids, setIds] = useState(() => load(userId))
  useEffect(() => {
    const sync = () => setIds(load(userId))
    window.addEventListener(CHANGED, sync)
    return () => window.removeEventListener(CHANGED, sync)
  }, [userId])
  return ids
}

/** สถานะบันทึกของโพสต์หนึ่งโพสต์ + สลับบันทึก/เลิกบันทึก (ทุกการ์ดของโพสต์เดียวกันอัปเดตพร้อมกัน) */
export function useSavedPost(userId: string, postId: string): [boolean, () => void] {
  const [saved, setSaved] = useState(() => load(userId).includes(postId))

  useEffect(() => {
    const sync = () => setSaved(load(userId).includes(postId))
    window.addEventListener(CHANGED, sync)
    return () => window.removeEventListener(CHANGED, sync)
  }, [userId, postId])

  const toggle = useCallback(() => {
    const list = load(userId)
    const next = list.includes(postId) ? list.filter((id) => id !== postId) : [postId, ...list]
    try { localStorage.setItem(KEY(userId), JSON.stringify(next)) } catch { /* storage ปิด — สลับแค่บนจอ */ }
    setSaved(next.includes(postId))
    window.dispatchEvent(new CustomEvent(CHANGED))
  }, [userId, postId])

  return [saved, toggle]
}
</file>

<file path="src/utils/seededRandom.ts">
/**
 * hashSeed / mulberry32 — แปลง string ใดๆ ให้เป็นตัวเลข seed แล้วสร้างฟังก์ชันสุ่ม
 * ที่ deterministic (ใส่ seed เดิม ได้ลำดับตัวเลขเดิมเป๊ะทุกครั้ง)
 *
 * ใช้กับระบบ "ปั๊มใบไม้" ใน TreeOfLife.tsx — seed มาจาก `${mbtiType}-${level}`
 * ทำให้ต้นไม้ของผู้เล่นคนเดิมที่ level เดิม มีการจัดวางใบเหมือนเดิมทุกครั้งที่ re-render
 * (ไม่กระพริบ/สลับตำแหน่งใบไปมาเวลา React re-render โดยไม่มี level เปลี่ยนจริง)
 * แต่พอ level เปลี่ยน seed จะเปลี่ยนตาม ได้ลาย pattern ใบใหม่ที่ดู "งอกเพิ่ม" ขึ้นมาจริง
 */
export function hashSeed(str: string): number {
  let h = 1779033703 ^ str.length
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353)
    h = (h << 13) | (h >>> 19)
  }
  h = Math.imul(h ^ (h >>> 16), 2246822507)
  h = Math.imul(h ^ (h >>> 13), 3266489909)
  return (h ^ (h >>> 16)) >>> 0
}

export function mulberry32(seed: number): () => number {
  let s = seed
  return function random() {
    s |= 0
    s = (s + 0x6d2b79f5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

/** สร้างฟังก์ชันสุ่มแบบ deterministic ตรงจาก string seed เดียว (ย่อ 2 ฟังก์ชันข้างบนไว้ที่เดียว) */
export function seededRandom(seedString: string): () => number {
  return mulberry32(hashSeed(seedString))
}
</file>

