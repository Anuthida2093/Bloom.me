<file path="src/components/quest/games/physical/DestinationPicker.tsx">
import { useState, useRef } from 'react'
import { isMapUnlocked, JOURNEY_MAPS } from '../../../../config/journeyMaps'
import MapArtImage from './MapArtImage'
import './DestinationPicker.css'

interface DestinationPickerProps {
  onPicked: (mapId: string) => void
  /** เลเวลผู้เล่น — แผนที่ที่ยังไม่ถึงเลเวลปลดล็อกแสดงกุญแจและเลือกไม่ได้ */
  playerLevel: number
}

export default function DestinationPicker({ onPicked, playerLevel }: DestinationPickerProps) {
  const [pickingId, setPickingId] = useState<string | null>(null)
  
  // ตัวแปรสำหรับทำระบบลากด้วยเมาส์ (Mouse Drag to Scroll)
  const sliderRef = useRef<HTMLDivElement>(null)
  const isDragging = useRef(false)
  const startX = useRef(0)
  const scrollLeft = useRef(0)
  const dragDistance = useRef(0)

  const handlePointerDown = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!sliderRef.current) return
    isDragging.current = true
    dragDistance.current = 0
    startX.current = e.pageX - sliderRef.current.offsetLeft
    scrollLeft.current = sliderRef.current.scrollLeft
    sliderRef.current.style.scrollSnapType = 'none' // ปิด snap ตอนลากให้สมูท
  }

  const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
    if (!isDragging.current || !sliderRef.current) return
    e.preventDefault()
    const x = e.pageX - sliderRef.current.offsetLeft
    const walk = (x - startX.current) * 1.5 // ความเร็วตอนปัด
    sliderRef.current.scrollLeft = scrollLeft.current - walk
    dragDistance.current += Math.abs(walk)
  }

  const handlePointerUp = () => {
    isDragging.current = false
    if (sliderRef.current) {
      sliderRef.current.style.scrollSnapType = 'x mandatory' // เปิด snap กลับมาเมื่อปล่อยนิ้ว
    }
  }

  const handlePick = (id: string) => {
    // ถ้ายกนิ้ว/เมาส์แล้วพบว่าเป็นการลาก (ไม่ได้ตั้งใจคลิก) ให้ข้ามการเลือกไป
    if (dragDistance.current > 10) return
    
    setPickingId(id)
    onPicked(id)
  }

  return (
    <div className="destination-picker">
      <div className="destination-picker__header">
        <h2>เลือกแผนที่เดินวันนี้</h2>
        <p>1 วัน = 1 ทริป เดินให้ถึงเป้าก้าววันนี้ เปิดกล่องสมบัติระหว่างทาง แล้วรับรางวัลประจำวัน</p>
      </div>
      
      <div 
        className="destination-picker__slider"
        ref={sliderRef}
        onPointerDown={handlePointerDown}
        onPointerMove={handlePointerMove}
        onPointerUp={handlePointerUp}
        onPointerLeave={handlePointerUp}
      >
        <div className="destination-picker__track">
          {JOURNEY_MAPS.map((m) => {
            const locked = !isMapUnlocked(m, playerLevel)
            return (
            <button
              key={m.id}
              className={`destination-picker__item ${pickingId === m.id ? 'destination-picker__item--picking' : ''}${locked ? ' destination-picker__item--locked' : ''}`}
              onClick={() => { if (!locked) handlePick(m.id) }}
              disabled={pickingId !== null || locked}
              aria-label={locked ? `${m.name} — ปลดล็อกที่ Lv.${m.unlockLevel}` : undefined}
            >
              <div className="destination-picker__img-wrapper">
                <MapArtImage mapDef={m} className="destination-picker__img" variant="thumb" />
                {locked && (
                  <div className="destination-picker__lock">
                    <span className="destination-picker__lock-icon" aria-hidden="true">🔒</span>
                    <span>ปลดล็อกที่ Lv.{m.unlockLevel}</span>
                  </div>
                )}
              </div>
              <div className="destination-picker__info">
                <span className="destination-picker__order">แผนที่ {m.order}</span>
                <span className="destination-picker__name">{m.name}</span>
              </div>
            </button>
            )
          })}
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/components/quest/games/physical/DiaryRewardScroll.css">
/* ═══════════════════════════════════════════════════════════════
   DiaryRewardScroll.css — กระดาษไดอะรี่ (โทนเดียวกับ "ไดอะรี่ของฉัน" ธีม golden)
   ม้วนกระดาษคลี่จากบนลงล่าง แล้วบรรทัดรางวัลค่อยๆ ปรากฏ
   ═══════════════════════════════════════════════════════════════ */

.diary-scroll-overlay {
  position: absolute; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  /* เว้นล่างเท่าแถบเมนูล่าง (ActionMenuBar) — เลื่อนดูบรรทัดสุดท้าย/ปุ่มได้จนสุดโดยไม่ถูกบัง */
  padding: 16px 16px calc(var(--gpf-safe-bottom, 90px) + 24px);
  overflow-y: auto;
  background: rgba(20, 14, 6, 0.45);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
}

.diary-scroll {
  --paper: #FFF3D6;
  --paper-edge: #F0C97A;
  --ink: #4A2C0A;
  --rod: #8B5A2B;
  position: relative;
  width: min(400px, 100%);
  margin: auto;
  display: flex; flex-direction: column; align-items: center;
  filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.35));
}

.diary-scroll__rod {
  position: relative; z-index: 2;
  width: calc(100% + 24px); height: 22px; border-radius: 12px;
  background: linear-gradient(180deg, #b07a43 0%, var(--rod) 55%, #5e3a17 100%);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.35), 0 3px 6px rgba(0, 0, 0, 0.3);
}
.diary-scroll__rod::before, .diary-scroll__rod::after {
  content: ''; position: absolute; top: 50%; width: 16px; height: 30px; border-radius: 8px;
  transform: translateY(-50%); background: #5e3a17;
}
.diary-scroll__rod::before { left: -8px; }
.diary-scroll__rod::after { right: -8px; }

/* กระดาษ: เริ่มม้วนอยู่ (สูง 0) แล้วคลี่ลงด้วย grid-template-rows 0fr → 1fr */
.diary-scroll__paper {
  width: 100%;
  display: grid; grid-template-rows: 0fr;
  margin: -6px 0;
  background:
    repeating-linear-gradient(180deg, transparent 0 31px, rgba(122, 74, 18, 0.12) 31px 32px),
    radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.6), transparent 60%),
    var(--paper);
  border-left: 3px solid var(--paper-edge);
  border-right: 3px solid var(--paper-edge);
  box-shadow: inset 0 0 40px rgba(120, 90, 40, 0.18);
  animation: diaryUnroll 1.1s cubic-bezier(.22, 1, .36, 1) forwards;
}
@keyframes diaryUnroll { to { grid-template-rows: 1fr; } }
.diary-scroll__inner { overflow: hidden; min-height: 0; padding: 0 22px; }
.diary-scroll--open .diary-scroll__inner { padding: 22px 22px 20px; transition: padding .2s ease; }

.diary-scroll__date { margin: 0; font-size: 12px; color: var(--ink); opacity: 0.7; text-align: right; font-style: italic; }
.diary-scroll__title {
  margin: 4px 0 12px; text-align: center;
  font-family: var(--font-display); font-size: 21px; color: var(--ink);
}

.diary-scroll__lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.diary-scroll__line {
  display: flex; align-items: center; gap: 10px;
  min-height: 32px; color: var(--ink);
  font-family: var(--font-display); font-size: 15px; line-height: 1.4;
  opacity: 0; transform: translateX(-8px);
  animation: diaryInk 0.45s ease-out forwards;
}
.diary-scroll__line b { font-weight: 700; }
.diary-scroll__line--special {
  padding: 8px 10px; border-radius: 12px;
  background: linear-gradient(90deg, rgba(255, 209, 102, 0.55), rgba(255, 243, 214, 0));
  box-shadow: inset 0 0 0 2px rgba(240, 201, 122, 0.9);
}
@keyframes diaryInk { to { opacity: 1; transform: none; } }
.diary-scroll__icon {
  flex-shrink: 0; width: 30px; height: 30px;
  display: inline-flex; align-items: center; justify-content: center; font-size: 22px;
}
.diary-scroll__icon img { width: 30px; height: 30px; object-fit: contain; }
.diary-scroll__line--special .diary-scroll__icon, .diary-scroll__line--special .diary-scroll__icon img { width: 42px; height: 42px; }
.diary-scroll__x2 {
  margin-left: 6px; padding: 0 6px; border-radius: 99px;
  background: #e85d2a; color: #fff; font-size: 12px;
}

/* ปุ่มแบบนูนนุ่ม (soft-shaded) ให้ดูกดได้ */
.diary-scroll__btn {
  display: block; width: 100%; margin-top: 16px; padding: 13px 18px;
  border: none; border-radius: 16px; cursor: pointer;
  font-family: var(--font-display); font-size: 17px; color: #4A2C0A;
  background: linear-gradient(180deg, #ffe08a 0%, #f5b301 100%);
  box-shadow: 0 5px 0 #c98a00, 0 10px 18px rgba(0, 0, 0, 0.2), inset 0 2px 0 rgba(255, 255, 255, 0.7);
  opacity: 0; animation: diaryInk 0.45s ease-out forwards;
  transition: transform .12s ease, box-shadow .12s ease;
}
.diary-scroll__btn:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 1px 0 #c98a00, 0 4px 8px rgba(0, 0, 0, 0.2), inset 0 2px 0 rgba(255, 255, 255, 0.7); }
.diary-scroll__btn:disabled { cursor: wait; filter: saturate(0.6); }

@media (max-width: 360px), (max-height: 560px) {
  .diary-scroll-overlay { align-items: flex-start; padding: 10px; }
  .diary-scroll--open .diary-scroll__inner { padding: 14px 14px 14px; }
  .diary-scroll__title { font-size: 18px; }
  .diary-scroll__line { font-size: 13px; }
}
@media (max-width: 300px) {
  .diary-scroll__rod { height: 16px; }
  .diary-scroll__icon, .diary-scroll__icon img { width: 22px; height: 22px; font-size: 16px; }
}
@media (prefers-reduced-motion: reduce) {
  .diary-scroll__paper { animation: none; grid-template-rows: 1fr; }
  .diary-scroll__line, .diary-scroll__btn { animation: none; opacity: 1; transform: none; }
}

/* ปุ่ม "ดูแผนที่" — ปุ่มรองแบบนูนนุ่มสีเขียว */
.diary-scroll__map-btn {
  display: block; width: 100%; margin-top: 16px; padding: 11px 18px;
  border: none; border-radius: 16px; cursor: pointer;
  font-family: var(--font-display); font-size: 16px; color: #1b4332;
  background: linear-gradient(180deg, #e9f9ee 0%, #95d5b2 100%);
  box-shadow: 0 5px 0 #52b788, 0 10px 18px rgba(0, 0, 0, 0.15), inset 0 2px 0 rgba(255, 255, 255, 0.8);
  opacity: 0; animation: diaryInk 0.45s ease-out forwards;
}
.diary-scroll__map-btn:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 1px 0 #52b788, inset 0 2px 0 rgba(255, 255, 255, 0.8); }
.diary-scroll__map-btn + .diary-scroll__btn { margin-top: 10px; }
@media (prefers-reduced-motion: reduce) { .diary-scroll__map-btn { animation: none; opacity: 1; } }
</file>

<file path="src/components/quest/games/physical/DiaryRewardScroll.tsx">
import { useEffect, useState } from 'react'
import { BADGE_ICONS, ITEM_ICONS } from '../../../../config/iconAssets'
import { describeStepChest, type StepChestReward, SPECIAL_DUST_ICON, DOUBLE_CARD_ICON } from '../../../../config/stepChest'
import { playSfx } from '../../../../utils/audioPlayer'
import './DiaryRewardScroll.css'

/*============================================================================*\
  DiaryRewardScroll — หน้ารางวัลประจำวันของเควสก้าวเพื่อสุขภาพ แบบ "กระดาษไดอะรี่ของฉัน"
  ────────────────────────────────────────────────────────────────────────────
  ม้วนกระดาษค่อยๆ คลี่ลงมา (ไม้ม้วนบน-ล่าง) → รายการรางวัลที่ได้วันนี้ค่อยๆ เขียนขึ้นทีละบรรทัด
  ตัวเลขทั้งหมดมาจากเซิร์ฟเวอร์/สูตรเดียวกับ backend (StepJourneyGame ส่งมา) — ไม่สุ่มเองที่นี่
\*============================================================================*/

const UNROLL_MS = 1100
const LINE_STAGGER_MS = 260

export interface DiaryRewardScrollProps {
  reachedGoal: boolean
  steps: number
  goal: number
  exp: number
  coins: number
  /** null = ไม่แสดงบรรทัดหยดน้ำ (โหมด live ยังไม่ให้หยดน้ำตามสัดส่วนทริป) */
  waterDrops: number | null
  /** วันนี้มีบัฟคูณสองจากกล่อง → EXP/เหรียญที่แสดงคูณแล้ว */
  doubled: boolean
  /** ผลหีบสมบัติที่เส้นชัยวันนี้ (null = ไม่ถึงเป้า ไม่มีหีบ) */
  chest: StepChestReward | null
  sfx: { volume: number; enabled: boolean }
  onClaim: () => void
  /** เปิดแผนที่ทริปของวันนี้ขนาดใหญ่ (เส้นทางที่เดินสำเร็จ) */
  onViewMap?: () => void
}

function chestIcon(c: StepChestReward): React.ReactNode {
  if (c.kind === 'EXCHANGE_CARD') return c.cardItemCode && ITEM_ICONS[c.cardItemCode] ? <img src={ITEM_ICONS[c.cardItemCode]} alt="" /> : '🎴'
  return <img src={c.kind === 'BONUS_COINS' ? BADGE_ICONS.coins : c.kind === 'WATER_DROPS' ? BADGE_ICONS.water : c.kind === 'SPECIAL_DUST' ? SPECIAL_DUST_ICON : c.kind === 'DOUBLE_CARD' ? DOUBLE_CARD_ICON : BADGE_ICONS.exp} alt="" />
}

export default function DiaryRewardScroll(props: DiaryRewardScrollProps) {
  const { reachedGoal, steps, goal, exp, coins, waterDrops, doubled, chest, sfx, onClaim, onViewMap } = props
  const [unrolled, setUnrolled] = useState(false)

  useEffect(() => {
    playSfx('PAPER_CRUMPLE', sfx)
    const id = window.setTimeout(() => setUnrolled(true), UNROLL_MS)
    return () => window.clearTimeout(id)
    // eslint-disable-next-line react-hooks/exhaustive-deps -- เล่นเสียงคลี่กระดาษครั้งเดียวตอนเปิด
  }, [])

  const today = new Date().toLocaleDateString('th-TH', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })

  const lines: { key: string; icon: React.ReactNode; text: React.ReactNode; highlight?: boolean }[] = [
    { key: 'steps', icon: '🦶', text: <>เดินได้ <b>{steps.toLocaleString()}</b> / {goal.toLocaleString()} ก้าว {reachedGoal ? ' ถึงเป้าแล้ว!' : ''}</> },
    { key: 'exp', icon: <img src={BADGE_ICONS.exp} alt="" />, text: <>EXP <b>+{exp}</b>{doubled && <span className="diary-scroll__x2">×2</span>}</> },
    { key: 'coins', icon: <img src={BADGE_ICONS.coins} alt="" />, text: <>เหรียญ <b>+{coins}</b>{doubled && <span className="diary-scroll__x2">×2</span>}</> },
    ...(waterDrops !== null ? [{ key: 'water', icon: <img src={BADGE_ICONS.water} alt="" />, text: <>หยดน้ำ <b>+{waterDrops}</b></> }] : []),
    ...(chest ? [{ key: 'chest', icon: chestIcon(chest), text: describeStepChest(chest), highlight: chest.kind === 'EXCHANGE_CARD' }] : []),
  ]

  return (
    <div className="diary-scroll-overlay" role="dialog" aria-modal="true" aria-labelledby="diary-scroll-title">
      <div className={`diary-scroll${unrolled ? ' diary-scroll--open' : ''}`}>
        <div className="diary-scroll__rod diary-scroll__rod--top" aria-hidden="true" />
        <div className="diary-scroll__paper">
          <div className="diary-scroll__inner">
            <p className="diary-scroll__date">{today}</p>
            <h2 id="diary-scroll-title" className="diary-scroll__title">{reachedGoal ? 'บันทึกการเดินทางวันนี้' : 'หมดวันแล้ว บันทึกการเดินทาง'}</h2>
            <ul className="diary-scroll__lines">
              {lines.map((l, i) => (
                <li
                  key={l.key}
                  className={`diary-scroll__line${l.highlight ? ' diary-scroll__line--special' : ''}`}
                  style={{ animationDelay: `${UNROLL_MS + i * LINE_STAGGER_MS}ms` }}
                >
                  <span className="diary-scroll__icon" aria-hidden="true">{l.icon}</span>
                  <span>{l.text}</span>
                </li>
              ))}
            </ul>
            {onViewMap && (
              <button
                type="button"
                className="diary-scroll__map-btn"
                onClick={onViewMap}
                disabled={!unrolled}
                style={{ animationDelay: `${UNROLL_MS + lines.length * LINE_STAGGER_MS}ms` }}
              >
                🗺️ ดูแผนที่
              </button>
            )}
            <button
              type="button"
              className="diary-scroll__btn"
              onClick={onClaim}
              disabled={!unrolled}
              style={{ animationDelay: `${UNROLL_MS + lines.length * LINE_STAGGER_MS}ms` }}
            >
              รับรางวัลวันนี้
            </button>
          </div>
        </div>
        <div className="diary-scroll__rod diary-scroll__rod--bottom" aria-hidden="true" />
      </div>
    </div>
  )
}
</file>

<file path="src/components/quest/games/physical/GreenVisionGame.css">
/* เควส Green Vision — จอหรี่ลงระหว่างพักสายตา */
.green-vision { position: relative; }
.green-vision__veil {
  position: absolute;
  inset: -40px;
  border-radius: 24px;
  --lc-bg-2: #04120C;
  background: var(--lc-bg-2);
  opacity: 0;
  transition: opacity 1.4s ease;
  pointer-events: none;
}
.green-vision--resting .green-vision__veil { opacity: 0.88; }

.green-vision__content { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 12px; }

