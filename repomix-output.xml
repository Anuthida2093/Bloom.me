  line-height: 1.7;
  opacity: 0.88;
  max-width: 340px;
  margin: 0 auto 18px;
}

/* [เพิ่มรอบนี้ — ตามสเปกใหม่] รูป body type ล้อมด้วยวงแหวนแคลอรี่ (SVG circular progress) */
.balanced-nutrients__ring-wrap {
  position: relative;
  width: 150px;
  height: 150px;
  margin: 0 auto 14px;
}
.balanced-nutrients__ring-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.balanced-nutrients__ring-track {
  fill: none;
  stroke: rgba(255,255,255,0.18);
  stroke-width: 8;
}
.balanced-nutrients__ring-fill {
  fill: none;
  stroke: #B7E4C7;
  stroke-width: 8;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.6s cubic-bezier(.22,1,.36,1);
}
.balanced-nutrients__body-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
