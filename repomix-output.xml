.oracle-card--large.lb-card .oracle-card__mission-label { color: var(--lb-card-text-sub); font-family: var(--font-display); }
.oracle-card--large.lb-card .oracle-card__mission-block {
  background: color-mix(in srgb, var(--fixed-white) 35%, transparent);
  border-color: color-mix(in srgb, var(--lb-gold-edge) 50%, transparent);
}
[data-theme="dark"] .oracle-card--large.lb-card .oracle-card__mission-block { background: color-mix(in srgb, var(--g900) 40%, transparent); }
.oracle-card--large.lb-card .oracle-page__caret { color: var(--lb-card-text-sub); }


/* [แก้ตามที่ระบุ] ป้าย "วันนี้คุณรู้สึก…" กรอบแบบกระดานจัดอันดับ ห่างขอบบน ~90px
   และเว้นระยะจากป็อปอัพไพ่มากขึ้น — ป็อปอัพไพ่เลื่อนดูได้แต่ไม่แสดงแถบเลื่อน */
.oracle-page__content {
  padding-top: 90px;
  /* [แก้ตามที่ระบุ] ท้ายป็อปอัพไพ่เคยโดน ActionMenuBar บัง — เว้นล่างให้พ้นแถบเมนู แล้วเลื่อนดูได้ */
  padding-bottom: calc(var(--gpf-safe-bottom, 90px) + 24px);
  scrollbar-width: none;
}
.oracle-page__reading-view { flex-shrink: 0; }
.oracle-page__content::-webkit-scrollbar { display: none; }
/* [แก้ตามที่ระบุ] ป้าย "วันนี้คุณรู้สึก…" เป็นสีม่วง (.lb-banner--purple ใน leaderboardRow.css) */
.oracle-page__mood-recap.lb-banner {
  padding: 10px 22px;
  border-radius: 14px;
  font-size: 16px;
  margin-bottom: 26px;
  font-family: var(--font-display);
}

/* ═══ กระดาษข้อความไพ่: ม้วนคลี่ลง (grid 0fr → 1fr) กระดาษเรียบ ไม่มีเส้นขอบ/บรรทัด ═══ */
.oracle-scroll { width: 100%; display: flex; flex-direction: column; align-items: center; filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.3)); }
.oracle-scroll__rod {
  position: relative; z-index: 1; width: calc(100% + 16px); height: 16px; border-radius: 10px;
  background: linear-gradient(180deg, #b07a43, #8B5A2B 55%, #5e3a17);
  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.35);
}
.oracle-scroll__paper {
  width: 100%; display: grid; grid-template-rows: 0fr; margin: -4px 0;
  background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.55), transparent 60%), #FFF6E0;
  animation: oracleUnroll 1.1s cubic-bezier(.22, 1, .36, 1) forwards;
}
@keyframes oracleUnroll { to { grid-template-rows: 1fr; } }
.oracle-scroll__inner { overflow: hidden; min-height: 0; padding: 0 18px; }
.oracle-scroll__inner > :first-child { margin-top: 18px; }
.oracle-scroll__inner > :last-child { margin-bottom: 18px; }
.oracle-scroll__text {
  margin: 0; white-space: pre-line; text-align: left;
  font-family: var(--font-display); font-size: 16px; line-height: 1.75; color: #4A2C0A;
}
.oracle-scroll__mission { margin-top: 14px; padding-top: 10px; animation: oracleInk .45s ease-out both; }
.oracle-scroll__mission-label { display: block; font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #7a4a12; margin-bottom: 4px; }
.oracle-scroll__mission-text { margin: 0; font-family: var(--font-display); font-size: 15px; line-height: 1.6; color: #4A2C0A; }
@keyframes oracleInk { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {
  .oracle-scroll__paper { animation: none; grid-template-rows: 1fr; }
  .oracle-scroll__mission { animation: none; }
}

/* [แก้ตามที่ระบุ] รูปหลังไพ่ (Oracle Activation.png) แทนอีโมจิ 🔮 */
.oracle-card__back-img { width: 78%; height: 78%; object-fit: contain; pointer-events: none; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .4)); }

/* [แก้ตามที่ระบุ] รูปบนกองไพ่ (ก่อนกาง) แทนอีโมจิ 🔮 */
.oracle-page__deck-img { position: relative; width: 82%; height: 82%; object-fit: contain; pointer-events: none; filter: drop-shadow(0 3px 8px rgba(0, 0, 0, .45)); }
