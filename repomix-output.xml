import { useLayoutEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import type { StepDayRecord } from '../../../../services/api/progression.api'
import { JOURNEY_MAPS } from '../../../../config/journeyMaps'
import { useEscapeKey } from '../../../../hooks/useEscapeKey'
import { mapNativeSize } from './journeyPathMath'
import MapPathRenderer from './MapPathRenderer'
import CatCompanion from './CatCompanion'
import '../../../shop/ShopItemDialog.css'
import './CompletedJourneyMap.css'

/*============================================================================*\
  CompletedJourneyMap — ดูแผนที่ทริปที่เดินสำเร็จของ "วันนั้น" (เส้นทางเต็ม + ตัวละครที่ปลายทาง) เปิดจากสถานะ "✅ … ก้าว · สำเร็จ" ในรายการเควส / ปฏิทินโปรไฟล์
\*============================================================================*/

function formatDay(date: string): string {
  return new Date(`${date}T00:00:00`).toLocaleDateString('th-TH', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
}

export default function CompletedJourneyMap({ day, onClose }: { day: StepDayRecord; onClose: () => void }) {
  useEscapeKey(onClose)
  const mapDef = JOURNEY_MAPS.find((m) => m.id === day.mapId) ?? null
  const routePct = day.goalMet ? 100 : Math.min(100, (day.steps / Math.max(1, day.goal)) * 100)
  const frameRef = useRef<HTMLDivElement | null>(null)
  const [scale, setScale] = useState(0.4)

  // ย่อแผนที่ขนาดจริง 1024px ให้พอดีกรอบ (กรอบกว้างตามจอ)
  useLayoutEffect(() => {
    const el = frameRef.current
    if (!el) return
    const update = () => setScale(el.clientWidth / mapNativeSize(mapDef).width)
    update()
    const ro = new ResizeObserver(update)
    ro.observe(el)
    return () => ro.disconnect()
  }, [mapDef])

  return createPortal(
    <div className="shop-dialog" role="dialog" aria-modal="true" aria-labelledby="completed-journey-title" onClick={onClose}>
      <div className="shop-dialog__card completed-journey" onClick={(e) => e.stopPropagation()}>
        <h2 id="completed-journey-title" className="shop-dialog__title">{mapDef?.name ?? 'ทริปการเดิน'}</h2>
        <p className="shop-dialog__sub">{formatDay(day.date)}</p>
        <div className={`completed-journey__status${day.goalMet ? '' : ' completed-journey__status--partial'}`}>
          <span aria-hidden="true">{day.goalMet ? '✅' : '🦶'}</span>
          <span>
            {/* ก้าวจริงที่เดินได้ (ไม่ใช่ตัวเลขเป้า) */}
            <b>{day.steps.toLocaleString()} ก้าว</b> · {day.goalMet ? 'สำเร็จ' : `เป้า ${day.goal.toLocaleString()} ก้าว`}
          </span>
        </div>
        <div ref={frameRef} className="completed-journey__frame">
          {mapDef ? (
            <div
              className="completed-journey__canvas"
              style={{ width: mapNativeSize(mapDef).width, height: mapNativeSize(mapDef).height, transform: `scale(${scale})` }}
            >
              <MapPathRenderer mapDef={mapDef} progressPct={routePct} />
              <CatCompanion mapDef={mapDef} progressPct={routePct} />
            </div>
          ) : (
            <p className="shop-dialog__hint">ไม่มีข้อมูลแผนที่ของวันนี้</p>
          )}
        </div>
        <div className="shop-dialog__actions">
          <button type="button" className="soft-btn soft-btn--gold" onClick={onClose}>ปิด</button>
        </div>
      </div>
    </div>,
    document.body,
  )
}
</file>

<file path="src/components/quest/games/physical/CompletedTripView.tsx">
import { useCallback, useRef, useState } from 'react'
import { JOURNEY_MAPS } from '../../../../config/journeyMaps'
import { BADGE_ICONS } from '../../../../config/iconAssets'
import { recordStepDay, type StepDayRecord } from '../../../../services/api/progression.api'
import { mapFrameInset, useBottomReserve, useMapPanZoom } from '../../../../hooks/useMapPanZoom'
import { useStepChest } from '../../../../hooks/useStepChest'
import { MAP_NATIVE_SIZE, mapNativeSize } from './journeyPathMath'
import MapPathRenderer from './MapPathRenderer'
import { StepChestMarker, StepChestPopup } from './StepChest'
import MapFrame, { MapStars } from './MapFrame'
import CatCompanion from './CatCompanion'
import './StepJourneyGame.css'

/*============================================================================*\
  CompletedTripView — เปิดเควสก้าวเพื่อสุขภาพอีกครั้งหลังเดินถึงเป้าวันนี้แล้ว
  ────────────────────────────────────────────────────────────────────────────
  แสดง "แผนที่เดิมที่ผู้เล่นเลือกไว้" ย่อพอดีจอทั้งแผ่นในกรอบ เส้นทางเรืองทองเดินครบถึงเส้นชัย
  ตัวละครยืนที่ปลายทาง + ก้าวจริงทั้งหมดของวันนี้ (ไม่ตัดที่เป้า — เดินเกินก็เห็นตัวเลขจริง)
  [แก้ตามที่ระบุ] แถบล่างไม่มีช่องกรอกก้าวแล้ว — ปุ่ม [กลับ] (ปิดเควส) กับ [ดูแผนที่] (แผนที่ใหญ่เต็มจอ ลาก/ซูมได้)
\*============================================================================*/

export default function CompletedTripView({ day, onClose }: { day: StepDayRecord; onClose: () => void }) {
  const mapDef = JOURNEY_MAPS.find((m) => m.id === day.mapId) ?? null
  /** ดูแผนที่ใหญ่: เต็มจอ (cover) ไม่มีกรอบ/การ์ด */
  const [bigMap, setBigMap] = useState(false)
  // แผนที่ย่อพอดีพื้นที่เหนือการ์ดล่าง (วัดความสูงการ์ดจริง) — การ์ดไม่บังแผนที่
  const cardRef = useRef<HTMLDivElement | null>(null)
  const bottomReserve = useBottomReserve(cardRef, [bigMap])
  const nativeSize = mapNativeSize(mapDef)
  const { containerRef, scale, pan, handlers } = useMapPanZoom(nativeSize, { fit: !bigMap, fitInset: mapFrameInset(bottomReserve), coverSize: MAP_NATIVE_SIZE })

  // หีบของวันนี้ยังไม่ได้เปิด (เช่นปิดเควสก่อนแตะหีบ) — เปิดต่อที่นี่ได้ 1 ครั้ง
  const confirmDay = useCallback(() => recordStepDay(day.date, day.steps, day.goal), [day.date, day.steps, day.goal])
  const chest = useStepChest(day.date, day.goalMet, confirmDay)
  const over = Math.max(0, day.steps - day.goal)

  return (
    <div
      className={`step-journey-game is-route-complete${bigMap ? '' : ' is-map-framed'}`}
      ref={containerRef}
      onPointerDown={handlers.onPointerDown}
      onPointerMove={handlers.onPointerMove}
      onPointerUp={handlers.onPointerUp}
      onPointerCancel={handlers.onPointerUp}
    >
      {!bigMap && <MapStars />}
      {mapDef && (
        <div
          className="step-journey-game__map-canvas"
          style={{
            width: nativeSize.width, height: nativeSize.height, transform: `translate(${pan.x}px, ${pan.y}px) scale(${scale})`,
            '--mf-radius': `${16 / Math.max(scale, 0.01)}px`,
          } as React.CSSProperties}
        >
          <div className="sjg-map-layer">
            <MapPathRenderer mapDef={mapDef} progressPct={100} />
            <CatCompanion mapDef={mapDef} progressPct={100} />
            {chest.ready && <StepChestMarker mapDef={mapDef} onOpen={() => { void chest.open() }} disabled={chest.popupOpen} />}
          </div>
        </div>
      )}

      {mapDef && !bigMap && <MapFrame pan={pan} scale={scale} size={nativeSize} title={mapDef.name} />}

      {bigMap ? (
        <button type="button" className="sjg-bigmap-back" onPointerDown={(e) => e.stopPropagation()} onClick={() => setBigMap(false)}>‹ กลับ</button>
      ) : (
        <div ref={cardRef} className="sjg-done-card" onPointerDown={(e) => e.stopPropagation()}>
          <div className="sjg-done-card__title">✅ เดินถึงเส้นชัยแล้ว{mapDef ? ` · ${mapDef.name}` : ''}</div>
          <div className="sjg-done-card__steps">
            {/* ก้าวจริงทั้งหมดของวันนี้ ไม่ใช่ตัวเลขเป้า */}
            <b>{day.steps.toLocaleString()}</b> ก้าว
            {over > 0 && <span className="sjg-done-card__over">เกินเป้า +{over.toLocaleString()}</span>}
          </div>
          <div className="sjg-done-card__goal">เป้าวันนี้ {day.goal.toLocaleString()} ก้าว · พรุ่งนี้มาเลือกแผนที่ใหม่กันนะ</div>
          <div className="sjg-done-card__actions">
            <button type="button" className="sjg-done-card__btn sjg-done-card__btn--ghost" onClick={onClose}>กลับ</button>
            <button type="button" className="sjg-done-card__btn" onClick={() => setBigMap(true)} disabled={!mapDef}>🗺️ ดูแผนที่</button>
          </div>
        </div>
      )}

      {chest.popupOpen && (
        <StepChestPopup reward={chest.popupReward} error={chest.error} onClose={chest.closePopup} onRetry={() => { void chest.open() }} />
      )}

      <button className="step-journey-game__close-btn" onClick={onClose} title="ปิด" aria-label="ปิด"><img src={BADGE_ICONS.close} className="icon-img" alt="" /></button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/physical/DestinationPicker.css">
/* ═══════════════════════════════════════════════════════════════
   DestinationPicker.css
   ═══════════════════════════════════════════════════════════════ */

.destination-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  width: 100%;
  height: 100%;
  /* [แก้ตามที่ระบุ] เดิม overflow:hidden + จัดกึ่งกลางแนวตั้ง → การ์ดแผนที่ตกลงไปชนแถบเมนูล่างบนมือถือ
     ตอนนี้เลื่อนขึ้นลงได้ และเว้นล่างพ้นแถบเมนู (--gpf-safe-bottom) เสมอ */
  overflow-x: hidden;
  overflow-y: auto;
  padding: 40px 0 calc(var(--gpf-safe-bottom, 90px) + 12px);
  box-sizing: border-box;
  /* [แก้ตามที่ระบุ — iPhone 13 ขอบล่างโดนตัด] ฉากแม่ (.step-journey-game) ปิด touch-action ไว้สำหรับลากแผนที่
     → นิ้วเลื่อนหน้านี้ขึ้นลงไม่ได้ · เปิดให้เลื่อนแนวตั้ง (การ์ดเลื่อนแนวนอนในแถบ slider ของมันเอง) */
  touch-action: pan-x pan-y;
  /* ความสูงรูปการ์ดคิดจากความสูงจริงของหน้านี้ (cqh) ไม่ใช่ทั้งจอ — กรอบเกม/แถบบนกินที่ไปแล้ว */
  container-type: size;
}
/* [แก้ตามที่ระบุ] ลูกของ flex column ห้ามหด — slider มี overflow จึงหดได้ถึง 0 แล้วตัดท้ายการ์ด (ชื่อแผนที่) ทิ้ง
   ปล่อยให้สูงตามเนื้อหา แล้วให้ทั้งหน้าเลื่อนแทน */
.destination-picker > * { flex-shrink: 0; }
/* จอเตี้ย/มือถือ: วางชิดบน (ไม่จัดกึ่งกลาง) การ์ดจึงอยู่สูงขึ้น ไม่ไปชนแถบเมนู */
@media (max-width: 768px), (max-height: 900px) {
  .destination-picker { justify-content: flex-start; gap: 6px; padding-top: 64px; }
  .destination-picker__header h2 { font-size: 24px; margin-bottom: 4px; }
  .destination-picker__header p { font-size: 14px; line-height: 1.45; }
  .destination-picker__slider { padding-top: 8px; padding-bottom: 8px; }
}

.destination-picker__header {
  text-align: center;
  padding: 0 20px;
}

.destination-picker__header h2 {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 28px;
  color: var(--fixed-white);
  margin: 0 0 8px 0;
  text-shadow: 0 2px 8px rgba(0,0,0,0.5);
}

.destination-picker__header p {
  font-family: 'Nunito', 'Mali', sans-serif;
  font-size: 18px;
  /* [แก้] เดิม --g200 (เขียวอ่อน) บนพื้นเขียวอ่อน → มองไม่เห็นแต่กินที่ว่าง ดันการ์ดแผนที่ลงไปชนแถบเมนู */
  color: var(--g800);
  margin: 0;
}

.destination-picker__slider {
  width: 100%;
  max-width: 1200px;
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  padding: 20px;
  box-sizing: border-box;
  cursor: grab; /* เพิ่มรูปมือเพื่อให้รู้ว่าลากได้ */
}

.destination-picker__slider:active {
  cursor: grabbing; /* รูปมือกำตอนกำลังลาก */
}

.destination-picker__slider::-webkit-scrollbar {
  display: none;
}
.destination-picker__slider {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.destination-picker__track {
  display: flex;
  gap: 24px;
  padding: 0 24px;
  /* นำ width: max-content และ margin: 0 auto ออก เพื่อให้เลื่อนขวาได้สุด */
}

.destination-picker__item {
  scroll-snap-align: center;
  flex: 0 0 auto;
  width: 280px;
  background: var(--glass-b-40);
  border: 2px solid var(--glass-w-20);
  border-radius: 20px;
  padding: 12px;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-align: center;
  user-select: none; /* ห้ามคลุมดำข้อความเวลาลาก */
}

.destination-picker__item:hover:not(:disabled) {
  transform: translateY(-8px);
  border-color: var(--g400);
  background: var(--glass-b-60);
  box-shadow: 0 12px 32px rgba(0,0,0,0.5);
}

.destination-picker__item:active:not(:disabled) {
  transform: translateY(-2px) scale(0.98);
}

.destination-picker__item--picking {
  border-color: var(--g400);
  background: var(--glass-b-60);
  box-shadow: 0 0 0 4px rgba(82, 183, 136, 0.4);
  transform: scale(0.95);
  opacity: 0.8;
}

.destination-picker__img-wrapper {
  width: 100%;
  /* สูงตามจอ: จอเตี้ยรูปเตี้ยลง การ์ดทั้งใบ (รูป + ชื่อแผนที่) จึงพ้นแถบเมนูล่าง */
  height: clamp(180px, calc(100dvh - 480px), 360px);
  border-radius: 12px;
  overflow: hidden;
  position: relative; /* ป้ายกุญแจของแผนที่ที่ยังล็อกวางทับรูปนี้ */
  background: var(--glass-b-60);
  pointer-events: none; /* ห้ามลากเฉพาะตัวรูปภาพ */
}

.destination-picker__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
  user-select: none;
  -webkit-user-drag: none; /* ป้องกันเบราว์เซอร์พยายามเซฟรูปตอนลาก */
}

.destination-picker__item:hover:not(:disabled) .destination-picker__img {
  transform: scale(1.05);
}

.destination-picker__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 0;
  pointer-events: none;
}

.destination-picker__order {
  font-family: 'Nunito', 'Mali', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--g300);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.destination-picker__name {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 22px;
  color: var(--fixed-white);
  margin: 0;
}
/* มีป้ายแจ้งเตือนเหนือหน้าเลือกแผนที่ → หน้าเลือกแผนที่กินเฉพาะที่เหลือ ไม่ล้นกรอบจนขอบบน/ล่างหาย */
.step-journey-game--center > .destination-picker { flex: 1 1 0; min-height: 0; height: auto; }

/* [แก้ตามที่ระบุ] มือถือ (เช่น iPhone 13) เท่านั้น: รูปการ์ดคิดจากความสูงจริงของหน้านี้ (cqh) ให้การ์ดพอดีจอ ไม่โดนตัดขอบล่าง
   ส่วนที่ไม่ใช่รูป (หัวข้อ ชื่อแผนที่ ขอบการ์ด แถบเมนูล่าง+safe-area) ≈ 420px
   โน้ตบุ๊ก/iPad คงการ์ดแนวตั้งสูงแบบเดิม (สูตร dvh ด้านบน สูงสุด 360px) ไม่บีบจนเป็นสี่เหลี่ยมจัตุรัส */
@media (max-width: 640px) {
  .destination-picker__img-wrapper { height: clamp(140px, calc(100cqh - 420px), 360px); }
}

/* [ใหม่] แผนที่ที่ยังไม่ถึงเลเวลปลดล็อก (แผนที่ 9 = Lv.50) — ภาพจาง + กุญแจ + ป้ายเลเวล · กดไม่ได้ */
.destination-picker__item--locked { cursor: not-allowed; }
.destination-picker__item--locked .destination-picker__img { filter: grayscale(0.7) brightness(0.6); }
.destination-picker__lock {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: var(--fixed-white);
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 18px;
