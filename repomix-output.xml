<file path="src/config/journeyRules.ts">
/*============================================================================*\
  journeyRules.ts — logic คำนวณของเควส "ก้าวเพื่อสุขภาพ" โฉมใหม่ (Step Journey)
\*============================================================================*/
import type { JourneyRecord, JourneyStatus } from '../types.journey'

const BASE_DAILY_STEP_TARGET = 8000
const HIGH_BMI_THRESHOLD = 23
const HIGH_BMI_EXTRA_STEPS = 1500

/** เป้าหมายก้าวต่อวัน ปรับเพิ่มอัตโนมัติถ้า BMI สูงกว่าเกณฑ์ (>=23 ตามหลักการเดิมของเควสนี้
 *  ก่อนเปลี่ยนมาใช้ระบบแผนที่) — bmi ที่เป็น NaN/ค่าผิดปกติ (ยังไม่กรอกส่วนสูง/น้ำหนัก) ถือเป็น
 *  เป้าหมายฐานเฉยๆ ไม่ปรับเพิ่ม — ใช้แสดงผลใน StatsOverlay.tsx เท่านั้น ไม่ใช่เงื่อนไขจบทริป
 *  (จบทริปเมื่อเดินถึง exitPct ของแผนที่ ไม่ใช่เมื่อครบก้าวต่อวัน) */
export function calcDailyStepTarget(bmi: number): number {
  if (!Number.isFinite(bmi) || bmi < HIGH_BMI_THRESHOLD) return BASE_DAILY_STEP_TARGET
  return BASE_DAILY_STEP_TARGET + HIGH_BMI_EXTRA_STEPS
}

/** [ยังไม่ได้ตัดสินใจแน่ชัด — ดูสรุปท้ายบทสนทนา] จำนวนวันที่ให้ต่อ 1 ทริปก่อนถือว่า failed —
 *  ค่านี้เป็นแค่จุดเริ่มต้นที่สมเหตุสมผล ไม่ใช่ค่าที่ยืนยันแล้วจากเจ้าของโปรเจกต์ */
export const DEFAULT_JOURNEY_DEADLINE_DAYS = 3

/** [placeholder] จำนวนก้าวสะสม "ทั้งแผนที่" ที่ต้องเดินให้ถึง exitPct — ยังไม่มีหน่วยระยะทางจริง
 *  ผูกกับภาพแผนที่แต่ละใบ จึงประมาณจาก "เดินเฉลี่ยเท่าเป้าหมายรายวันทุกวันตลอด deadline พอดี"
 *  (bmi ใช้คำนวณ dailyStepTarget เดียวกับ StatsOverlay) — รอวัดระยะทางจริงจากภาพแผนที่ในเฟสหลัง
 *  แล้วอาจต้องปรับสูตรนี้ใหม่ทั้งหมด */
export function calcMapTotalStepsTarget(bmi: number): number {
  return calcDailyStepTarget(bmi) * DEFAULT_JOURNEY_DEADLINE_DAYS
}

/** สถานะทริปตอนนี้ ณ เวลา `now` — ยังไม่ถึง exitPct (progressPct < 100) แล้วเลย deadline ไปแล้ว
 *  ถือว่า FAILED, ถึง exitPct แล้ว (progressPct >= 100) แบ่งตามว่าใช้เวลาไปกี่ % ของ deadline:
 *  ถึงก่อน 70% ของเวลาที่ให้ = เร็ว (COMPLETED_EARLY), ถึงภายในเวลา = ตรงเวลา (COMPLETED_ON_TIME),
 *  ถึงหลัง deadline แต่ progressPct >= 100 พอดี (เพิ่งมาคำนวณตอนนี้) = ช้า (COMPLETED_LATE) */
const EARLY_ARRIVAL_TIME_RATIO = 0.7

export function resolveJourneyStatus(journey: JourneyRecord, progressPct: number, now: Date): JourneyStatus {
  if (journey.status !== 'IN_PROGRESS') return journey.status

  const deadline = new Date(journey.deadlineAt).getTime()
  const started = new Date(journey.startedAt).getTime()
  const totalMs = Math.max(1, deadline - started)
  const elapsedMs = now.getTime() - started
  const elapsedRatio = elapsedMs / totalMs

  if (progressPct >= 100) {
    if (elapsedRatio <= EARLY_ARRIVAL_TIME_RATIO) return 'COMPLETED_EARLY'
    if (elapsedRatio <= 1) return 'COMPLETED_ON_TIME'
    return 'COMPLETED_LATE'
  }

  if (now.getTime() > deadline) return 'FAILED'
  return 'IN_PROGRESS'
}
