<file path="src/components/layout/ActionMenuBar.css">
:root {
  /* [รีธีมเขียวอ่อนมินิมอล] พื้นแถบใช้โทเคนกลาง --leaf-soft (index.css) แทน --g700 เข้มเดิม
     ตัวหนังสือ/ไอคอนบนแถบจึงเปลี่ยนจากขาวเป็น --on-leaf-soft ด้วย (ขาวบนเขียวอ่อนอ่านไม่ออก) */
  --nav-cutout-color: color-mix(in srgb, var(--leaf-soft-edge) 55%, transparent);
  --nav-bg: var(--g500);   /* [แก้ตามที่ระบุ] เข้มขึ้นจาก --leaf-soft (g200) — ตัวหนังสือ --on-leaf-soft ≈ 5.9:1 */
  --nav-fg: var(--on-leaf-soft);   /* สีตัวหนังสือ/ไอคอนบนแถบ (ธีมมืดสลับเป็นสีอ่อน ดูท้ายไฟล์) */
  --nav-item-bg: color-mix(in srgb, var(--fixed-white) 40%, transparent);
  --nav-indicator: var(--fixed-white);/* [แก้ตามที่ระบุ] เดิมใช้ var(--lc-c-4) แต่ผู้ใช้บอกว่าไม่ค่อยเห็น เลยเปลี่ยนเป็นสีขาวให้เด่นชัดขึ้น */
  /* [Part E — ย่อแถบเมนูล่าง] แถบ 400×80 → 288×60, ไอคอน 125×130 (ใหญ่กว่าตัวแถบ และไม่ได้
     อ่านตัวแปรนี้เลย) → 62px ผูกกับ --nav-icon-size จริงแล้ว ภาพ PNG มีขอบโปร่งใสรอบตัวจึงตั้ง
     ใหญ่กว่าความสูงแถบเล็กน้อย ช่องกดต่อปุ่ม 72×60 ยังเกินขั้นต่ำ ~44px ของมือถือ */
  --nav-icon-size: 62px;
  --nav-height: 60px;
  --btn-width: 72px;
}

.action-menu-container {
  position: fixed;
  /* [1.1] อ่านจากโทเคนกลาง (index.css) + safe-area ของ iPhone — ทุกหน้าเว้นที่ด้วยค่าชุดเดียวกัน */
  bottom: calc(var(--action-bar-offset, 25px) + env(safe-area-inset-bottom, 0px));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: flex-start;   /* [แก้] ไม่ centered แล้ว — ให้ quest-floating-menu อิงตำแหน่งปุ่มแรก (เควส) */
  z-index: 1000;
}

.quest-floating-menu {
  position: absolute;
  bottom: calc(var(--nav-height) + 8px);
  left: 0;                   /* [แก้] ตรงกับปุ่ม "เควส" ซึ่งเป็นปุ่มซ้ายสุดของแถบพอดี */
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;
  border-radius: var(--r-md);/* [แก้ตามที่ระบุ] ปรับ border-radius ให้กลมขึ้นเล็กน้อยจากเดิม var(--r-sm) */
  background: color-mix(in srgb, var(--nav-bg) 92%, transparent);/* สีเดียวกับแถบเมนูล่างหลัก (--nav-bg) */
  backdrop-filter: var(--ae-blur);
  -webkit-backdrop-filter: var(--ae-blur);
  /* [แก้ตามที่ระบุ] เมนูเลือกหมวดเควส 3 ตัวเลือก — เส้นขอบสีทอง */
  border: 2px solid color-mix(in srgb, var(--coin) 70%, var(--g600));
  box-shadow: var(--sh-modal);
  animation: popUp .2s ease-out;
}
.quest-floating-menu button {
  border: 1.5px solid color-mix(in srgb, var(--coin) 55%, transparent) !important;
  background: var(--nav-item-bg);
  border: none;
  color: var(--nav-fg);
  padding: 4px 8px;
  border-radius: var(--r-sm);
  cursor: pointer;
  white-space: nowrap;
  text-align: left;
  font-family: var(--font-display);   /* ฟอนต์เดียวกับหน้า Welcome */
  font-weight: 300;
  font-size: var(--fs-sm);
  display: flex;
  align-items: center;
  gap: 2px;
  transition: background .16s ease, transform .18s ease;
}
/* ไอคอนหมวดเควสในเมนูลอย (เป็นรายการข้อความ ไม่ต้องใหญ่เท่าไอคอนแถบหลัก) */
.quest-floating-menu .icon-img {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
}
.quest-floating-menu button:hover {
  background: var(--leaf-soft-strong);
  color: var(--on-leaf-soft);
  transform: translateX(4px);
}

.liquid-nav-bar {
  position: relative;
  width: calc(var(--btn-width) * 5); /* [แก้ตามที่ระบุ] 5 ปุ่ม (เพิ่มสตอรี่) */
  height: var(--nav-height);
  background: var(--nav-bg);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-modal);
  display: flex;
  align-items: center;
  justify-content: center;
}
.liquid-nav-bar ul { display: flex; width: 100%; list-style: none; }
.liquid-nav-bar ul li { position: relative; width: var(--btn-width); height: var(--nav-height); z-index: 1; }
.liquid-nav-bar ul li a {
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 100%; height: 100%; cursor: pointer;
}
/* [แก้บั๊ก — ตามที่ระบุ] ไอคอนกลายเป็นสีขาวโล่งดูเหมือนรูปพัง — ตรวจแล้วไม่ใช่ 404 (เช็ค
   DevTools Network เห็น status 200 ทุกไฟล์ทั้ง 4 ปุ่ม + เช็ค naturalWidth/Height ของ <img>
   จริงในเบราว์เซอร์ ได้ค่ามาถูกต้องไม่ใช่ 0x0) ต้นเหตุจริงคือ filter: grayscale(1)
   brightness(1.5) ด้านล่าง ซึ่งเดิมออกแบบไว้ตอนไอคอนยังเป็น emoji/font glyph สีเดียว
   (ใช้กลบสีให้ดูเข้ากับพื้นหลังเข้มตอนไม่ active) — พอเปลี่ยนเป็นรูปภาพจริงที่มีสีสัน/แสงเงา
   หลายเฉด grayscale+brightness(1.5) จะกดสีทุกอย่างให้ล้นสว่างจนแทบขาวโล่งดูเหมือนรูปพัง
   (โดยเฉพาะไอคอนที่พื้นแหล่งเป็นโทนอ่อนอยู่แล้วอย่าง Store.png/profile.png) ตัดออกทั้งคู่
   เหลือแค่ opacity ลดหน่อยตอนไม่ active พอ (ตำแหน่ง/วงกลมยกขึ้นก็บอกสถานะ active ชัดอยู่แล้ว) */
.liquid-nav-bar ul li a .nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--nav-fg);
  opacity: .82;
  transition: .5s var(--ease-spring);
}
.liquid-nav-bar ul li.active a .nav-icon { opacity: 1; }
/* ไอคอนแถบเมนูล่าง — ผูกกับ --nav-icon-size (เดิม fix ไว้ 125×130px ไม่ย่อตามจอ) */
.liquid-nav-bar ul li a .nav-icon .icon-img {
  width: var(--nav-icon-size);
  height: var(--nav-icon-size);
  object-fit: contain;
}
.liquid-nav-bar ul li a .nav-text {
  position: absolute;
  color: var(--nav-fg);
  font-weight: 500;
  font-size: var(--fs-xs, 12px);
  font-family: var(--font-display);   /* ฟอนต์เดียวกับหน้า Welcome */
  opacity: 0;
  transform: translateY(20px);
  transition: .5s var(--ease-spring);
}
/* [แก้ตามที่ระบุ] คำนวณจาก --nav-height แทนเลขคงที่ เพราะ nav-height เปลี่ยนตามขนาดไอคอนใหม่
   (เดิม -34px คำนวณจาก nav-height:70px เดิม ผูกตายตัวไว้จะพังทันทีที่ nav-height เปลี่ยน) */
.liquid-nav-bar ul li.active a .nav-icon { transform: translateY(calc(var(--nav-height) / -2)); }
.liquid-nav-bar ul li.active a .nav-text { opacity: 1; transform: translateY(12px); }

.nav-badge {
  position: absolute;
  top: -2px;
  right: 12px;
  background: linear-gradient(135deg, var(--exp), var(--coin));
  --lc-text-1: #4A2C0A;
  color: var(--lc-text-1);
  font-size: 10px;
  font-family: var(--font-display);   /* ฟอนต์เดียวกับหน้า Welcome */
  font-weight: 500;
  border-radius: var(--r-pill);
  min-width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 3px;
  --lc-shadow-2: rgba(255, 214, 10, .7);
  box-shadow: 0 0 8px var(--lc-shadow-2);
}

.nav-indicator {
  position: absolute;
  top: calc(var(--nav-height) * -0.5);
  left: calc((var(--btn-width) - var(--nav-height)) / 2);
  width: var(--nav-height);
  height: var(--nav-height);
  background: var(--nav-indicator);
  border-radius: 50%;
  border: 6px solid var(--nav-cutout-color);
  box-sizing: border-box;
  transform: translateX(calc(var(--btn-width) * var(--active-index)));
  transition: .5s var(--ease-spring);
}
.nav-indicator::before, .nav-indicator::after {
  content: ''; position: absolute; top: 50%; width: 20px; height: 20px; background: transparent;
}
.nav-indicator::before { left: -22px; border-top-right-radius: 20px; box-shadow: 1px -10px 0 0 var(--nav-cutout-color); }
.nav-indicator::after { right: -22px; border-top-left-radius: 20px; box-shadow: -1px -10px 0 0 var(--nav-cutout-color); }

@keyframes popUp { from { opacity: 0; transform: translateY(15px) scale(.9); } to { opacity: 1; transform: translateY(0) scale(1); } }

@media (max-width: 768px) {
  /* จอเล็ก: แถบ 256×56 ช่องกดต่อปุ่ม 64×56 (ยังเกินขั้นต่ำ ~44px) */
  :root { --nav-icon-size: 54px; --nav-height: 56px; --btn-width: 64px; }
}
@media (max-width: 360px) {
  :root { --nav-icon-size: 48px; --btn-width: 58px; }
  .liquid-nav-bar ul li.active a .nav-text { transform: translateY(12px); }
}

@media (prefers-reduced-motion: reduce) {
  .liquid-nav-bar ul li a .nav-icon,
  .liquid-nav-bar ul li a .nav-text,
  .nav-indicator { transition: none; }
}

/* [แก้ตามที่ระบุ] ธีมมืด: แถบเมนูเป็นเขียวเข้มชุดเดียวกับหน้าการตั้งค่า (--bg-card ธีมมืด)
   ตัวหนังสือ/ไอคอนสลับเป็น --text (สีอ่อนในธีมมืด) — ประกาศบน <html> ตัวเดียวกับ index.css */
[data-theme="dark"] {
  --nav-bg: var(--bg-card);
  --nav-fg: var(--text);
  --nav-item-bg: var(--glass-w-8);
  --nav-cutout-color: var(--border-mid);
}
[data-theme="dark"] .liquid-nav-bar { box-shadow: var(--sh-modal), inset 0 0 0 1px var(--border-mid); }

/* ═══ [แก้ตามที่ระบุ] แถบเมนูล่าง — กรอบแบบกระดานจัดอันดับ: พื้นเขียวไล่เฉด + ขอบทอง + เส้นในบางๆ
   วงกลมปุ่มที่เลือกอยู่ก็มีขอบทองรอบวงด้วย (ช่องเว้าใต้วงกลมคงสีเดิมไว้ให้กลืนกับพื้น) ═══ */
.liquid-nav-bar {
  background: linear-gradient(180deg, color-mix(in srgb, var(--nav-bg) 88%, var(--fixed-white)) 0%, var(--nav-bg) 100%);
  border: 2px solid var(--lb-gold-edge);
  box-shadow:
    0 4px 0 color-mix(in srgb, var(--lb-gold-edge) 55%, var(--g800)),
    0 10px 24px var(--glass-b-30),
    inset 0 0 0 2px color-mix(in srgb, var(--fixed-white) 30%, transparent),
    inset 0 0 0 3px color-mix(in srgb, var(--coin) 22%, transparent);
}
[data-theme="dark"] .liquid-nav-bar {
  background: linear-gradient(180deg, var(--g700) 0%, var(--g800) 100%);
  box-shadow:
    0 4px 0 color-mix(in srgb, var(--lb-gold-edge) 45%, var(--g900)),
    0 10px 24px var(--glass-b-40),
    inset 0 0 0 2px color-mix(in srgb, var(--fixed-white) 10%, transparent);
}
.nav-indicator {
  box-shadow: 0 0 0 2px var(--lb-gold-edge), 0 6px 14px var(--glass-b-25);
}

/* [แก้ตามที่ระบุ] ปุ่มสตอรี่ยังไม่มีไฟล์รูป — ใช้อีโมจิ 📖 ขนาดใกล้เคียงไอคอนรูปอื่น */
.liquid-nav-bar .nav-icon-emoji {
  display: inline-flex; align-items: center; justify-content: center;
  width: var(--nav-icon-size); height: var(--nav-icon-size);
  font-size: calc(var(--nav-icon-size) * .55); line-height: 1;
}

/* สมาร์ทวอทช์/จอเล็กมาก (≤ 300px): 5 ปุ่ม × 58px = 290px ล้นจอนาฬิกา (~240–280px) — ย่อให้พอดี
   ช่องกดยังเหลือ ~46×46px ใกล้ขั้นต่ำ 44px */
@media (max-width: 300px) {
  :root { --nav-icon-size: 38px; --nav-height: 46px; --btn-width: 46px; }
  .liquid-nav-bar { border-radius: var(--r-md); }
  .nav-indicator { border-width: 4px; }
  .nav-indicator::before, .nav-indicator::after { display: none; }
  .liquid-nav-bar ul li.active a .nav-text { display: none; }
  .quest-floating-menu { padding: 8px; }
  .quest-floating-menu .icon-img { width: 28px; height: 28px; }
}

/* [แก้ตามที่ระบุ] ไอคอนเควส (Quest Icon) เป็นรูปทรงสูงเกือบเต็มกรอบ จึงดูใหญ่กว่าปุ่มอื่น — ย่อให้เล็กลง */
.liquid-nav-bar ul li a .nav-icon--quests .icon-img {
  width: calc(var(--nav-icon-size) * .8);
  height: calc(var(--nav-icon-size) * .8);
}
