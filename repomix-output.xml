import { DECORATION_ITEM_META } from '../../config/decorationItems'
import { fitTree, healthPlot } from './procedural/drawTree2D'
import type { TreeModel } from './procedural/buildTreeModel'

/*============================================================================*\
  decorationPlacement.ts — [แก้ตามที่ระบุ — 2.4] กฎการวางไอเทมตกแต่งบนหน้า Home
  ────────────────────────────────────────────────────────────────────────────
    รูปปั้นกระถาง (statues)            → บนพื้นดินเท่านั้น (ตรงไหนของพื้นก็ได้)
    ของแขวนกิ่งไม้ (hangings)          → บนต้นไม้เท่านั้น (ทรงพุ่ม + ลำต้น)
    ลายโพสอิทสะสม (postits) / ของพิเศษ → บนต้นไม้หรือพื้นหลังได้ แต่ห้ามลงพื้นดิน (กันพื้นรก)
  พื้นดิน/ต้นไม้คำนวณจากเรขาคณิตชุดเดียวกับที่ ProceduralTreeCanvas วาดจริง (fitTree + healthPlot)
  จึงตรงกับภาพบนจอทุกสายพันธุ์/ทุกขนาดจอ — พิกัดทั้งหมดเป็น % ของแถบต้นไม้ (.tree-of-life__band)
  ใช้ตอนลาก (ไอเทมเลื่อนออกนอกโซนไม่ได้) และตอนแสดงตำแหน่งที่เคยเซฟไว้ (ตำแหน่งเก่าที่ผิดกฎถูกดึงกลับ)
  ตำแหน่งเก็บในเครื่องเท่านั้น (UIContext → localStorage) — ไม่มีเซิร์ฟเวอร์ให้ตรวจซ้ำ
\*============================================================================*/

export type PlacementRule = 'ground' | 'tree' | 'not-ground'

export function placementRuleOf(itemId: string): PlacementRule {
  const category = DECORATION_ITEM_META[itemId]?.category
  if (category === 'statues') return 'ground'
  if (category === 'hangings') return 'tree'
  return 'not-ground'
}

export interface PlacementGeometry {
  /** วงรีแปลงหญ้า (% ของแถบ) — ขอบบนของวงรีคือเส้นพื้นดิน */
  plot: { cx: number; cy: number; rx: number; ry: number }
  /** วงรีทรงพุ่ม (% ของแถบ) */
  crown: { cx: number; cy: number; rx: number; ry: number }
  /** กรอบลำต้นจากใต้พุ่มลงถึงโคน (% ของแถบ) */
  trunk: { x0: number; x1: number; y0: number; y1: number }
}

/** viewW = ความกว้างแถบ (= จอ), worldW = ความกว้างฉากที่เลื่อนได้ (แปลงหญ้ากว้างตามฉาก), h = ความสูงแถบ */
export function buildPlacementGeometry(model: TreeModel, viewW: number, worldW: number, h: number): PlacementGeometry | null {
  if (viewW < 2 || h < 2) return null
  const fit = fitTree(model, viewW, h)
  const plot = healthPlot({ ...fit, baseX: worldW / 2 }, worldW, h)
  const toX = (px: number) => (px / viewW) * 100
  const toY = (px: number) => (px / h) * 100
  const cxPx = viewW / 2 + model.crown.cx * fit.scale
  const cyPx = fit.baseY - model.crown.cy * fit.scale
  const rxPx = model.crown.rx * fit.scale
  const ryPx = model.crown.ry * fit.scale
  const trunkHalf = Math.max(12, rxPx * 0.08)
  return {
    // แปลงหญ้าในพิกัดแถบ: จุดกลางตรงกลางแถบเสมอ (ฉากกว้างกว่าแถบเท่ากันทั้งสองข้าง)
    plot: { cx: 50, cy: toY(plot.cy), rx: toX(plot.rx), ry: toY(plot.ry) },
    crown: { cx: toX(cxPx), cy: toY(cyPx), rx: toX(rxPx), ry: toY(ryPx) },
    trunk: { x0: toX(viewW / 2 - trunkHalf), x1: toX(viewW / 2 + trunkHalf), y0: toY(cyPx), y1: toY(fit.baseY) },
  }
}

/** ระยะเผื่อจากเส้นพื้นดิน (% ความสูงแถบ) — กันไอเทมคร่อมเส้นพอดี */
const GROUND_MARGIN = 1.5

/** y ของเส้นพื้นดิน (ขอบบนวงรีแปลงหญ้า) ที่ตำแหน่ง x — นอกวงรีถือว่าพื้นอยู่ที่ระดับจุดกลางวงรี */
export function groundTopAt(geo: PlacementGeometry, xPct: number): number {
  const { cx, cy, rx, ry } = geo.plot
  const t = Math.min(1, Math.abs(xPct - cx) / rx)
  return cy - ry * Math.sqrt(1 - t * t)
}

function inCrown(geo: PlacementGeometry, x: number, y: number): boolean {
  const { cx, cy, rx, ry } = geo.crown
  return ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1
}

function inTrunk(geo: PlacementGeometry, x: number, y: number): boolean {
  const t = geo.trunk
  return x >= t.x0 && x <= t.x1 && y >= t.y0 && y <= t.y1
}

/** จุดที่ใกล้ที่สุดบนต้นไม้: ดึงเข้าวงรีพุ่ม (ทิศเดิมจากจุดกลาง) หรือหนีบเข้ากรอบลำต้น เลือกที่ใกล้กว่า */
function nearestOnTree(geo: PlacementGeometry, x: number, y: number): { xPct: number; yPct: number } {
  const { cx, cy, rx, ry } = geo.crown
  const dx = x - cx, dy = y - cy
  const e = Math.sqrt((dx / rx) ** 2 + (dy / ry) ** 2) || 1
  const k = 0.95 / e
  const crownPt = { xPct: cx + dx * k, yPct: cy + dy * k }
  const t = geo.trunk
  const trunkPt = { xPct: Math.min(t.x1, Math.max(t.x0, x)), yPct: Math.min(t.y1, Math.max(t.y0, y)) }
  const d = (p: { xPct: number; yPct: number }) => (p.xPct - x) ** 2 + (p.yPct - y) ** 2
  return d(trunkPt) < d(crownPt) ? trunkPt : crownPt
}

/** ปรับตำแหน่งให้อยู่ในโซนที่อนุญาตของไอเทมนั้น — maxYPct = ขอบล่างสุดที่ไม่โดนแถบเมนูบัง */
export function constrainPlacement(
  rule: PlacementRule,
  pos: { xPct: number; yPct: number },
  geo: PlacementGeometry | null,
  maxYPct = 96,
): { xPct: number; yPct: number } {
  if (!geo) return pos
  const { xPct: x, yPct: y } = pos
  if (rule === 'tree') {
    return inCrown(geo, x, y) || inTrunk(geo, x, y) ? pos : nearestOnTree(geo, x, y)
  }
  const ground = groundTopAt(geo, x)
  if (rule === 'ground') {
    const minY = ground + GROUND_MARGIN
    // จอเตี้ยมาก: พื้นอาจต่ำกว่าเส้นแถบเมนู — ยึด "อยู่บนพื้น" ไว้ก่อน
    return { xPct: x, yPct: Math.min(Math.max(y, minY), Math.max(minY, maxYPct)) }
  }
  return { xPct: x, yPct: Math.min(y, ground - GROUND_MARGIN) }
}
</file>

<file path="src/components/tree/MiniTree.css">
.mini-tree-wrap {
  display: inline-block;
  line-height: 0;
}

/* "หายใจ" เบาๆ ทั้งต้น — scale ขึ้นลงช้าๆ ผูกกับขอบล่างเป็นจุดหมุน (ต้นไม้ไม่ลอยขึ้นจากพื้น) */
.mini-tree-wrap--breathing {
  transform-origin: center bottom;
  animation: miniTreeBreathe 3.6s ease-in-out infinite;
}

@keyframes miniTreeBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

/* ใบไม้ไหวเบาๆ (แค่ทรงพุ่ม ลำต้นไม่ขยับ) — คนละจังหวะเวลากับ breathing ข้างบน
   (คาบเวลา/easing ต่างกัน) เพื่อให้ดูเป็นธรรมชาติ ไม่ใช่ล็อกจังหวะเดียวกันทื่อๆ */
.mini-tree__crown--swaying {
  animation: miniTreeSway 2.8s ease-in-out infinite;
}

@keyframes miniTreeSway {
  0%, 100% { transform: rotate(-1.4deg); }
  50% { transform: rotate(1.4deg); }
}

/* เคารพ prefers-reduced-motion — ปิดแอนิเมชันให้คนที่ตั้งค่านี้ไว้ในระบบ */
@media (prefers-reduced-motion: reduce) {
  .mini-tree-wrap--breathing,
  .mini-tree__crown--swaying {
    animation: none;
  }
}
</file>

<file path="src/components/tree/MiniTree.tsx">
import { MBTI_TREE_THEME, type MbtiTreeTheme } from '../../types'
import './MiniTree.css'

interface MiniTreeProps {
  theme?: MbtiTreeTheme
  size?: number
  full?: boolean
  /** เปิด idle animation (หายใจ/ใบไม้ไหวเบาๆ) — ปิดได้ถ้าต้องโชว์หลายสิบต้นพร้อมกันแล้วกลัวหนักเครื่อง */
  animated?: boolean
}

export default function MiniTree({ theme = MBTI_TREE_THEME.INFP, size = 80, full = false, animated = true }: MiniTreeProps) {
  const s = size;
  const h = full ? s * 1.3 : s;
  const cx = s / 2;

  const r1 = s * 0.36;
  const r2 = s * 0.28;
  const r3 = s * 0.22;

  const trunkW = s * 0.12;
  const trunkH = s * 0.28;
  const ty = h * 0.55;

  // จุดหมุน/สเกลของทรงพุ่ม (crown) — ใช้พิกัด px จริงแทนคำว่า "center" เพราะ
  // transform-origin แบบเปอร์เซ็นต์บน SVG element มีพฤติกรรมไม่ตรงกันระหว่างเบราว์เซอร์
  // เก่าๆ (ต้องพึ่ง transform-box: fill-box เพิ่ม) พิกัด px ตรงๆ ชัวร์กว่าและเข้าใจง่ายกว่า
  const crownOriginX = cx;
  const crownOriginY = ty - r1 * 0.6;

  return (
    // wrapper div ทำหน้าที่ "หายใจ" (scale ทั้งต้นเบาๆ) — แยกจาก <g> ใน SVG ที่ทำหน้าที่
    // "ใบไม้ไหว" (rotate เฉพาะทรงพุ่ม) เพื่อให้ 2 แอนิเมชันซ้อนกันแบบเป็นธรรมชาติ ไม่ล็อกจังหวะเดียวกัน
    <div className={`mini-tree-wrap ${animated ? 'mini-tree-wrap--breathing' : ''}`} style={{ width: s, height: h }}>
      <svg
        viewBox={`0 0 ${s} ${h}`}
        width={s}
        height={h}
        xmlns="http://www.w3.org/2000/svg"
      >
        <radialGradient
          id={`lg${s}`}
          cx="40%"
          cy="35%"
          r="60%"
        >
          <stop
            offset="0%"
            stopColor={
              theme.leaves[2] ?? theme.leaves[0]
            }
            stopOpacity="1"
          />
        </radialGradient>

        {/* Shadow */}
        <ellipse
          cx={cx}
          cy={h - 4}
          rx={s * 0.3}
          ry={4}
          fill="var(--glass-b-12)"
        />

        {/* Pot */}
        {full && (
          <>
            <path
              d={`
                M${cx - s * 0.18} ${ty + trunkH * 0.4}
                Q${cx - s * 0.22} ${ty + trunkH * 0.8}
                ${cx} ${ty + trunkH * 0.9}
                Q${cx + s * 0.22} ${ty + trunkH * 0.8}
                ${cx + s * 0.18} ${ty + trunkH * 0.4}
                Z
              `}
              fill={theme.pot}
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill={theme.pot}
              opacity=".8"
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill="var(--glass-b-15)"
            />
          </>
        )}

        {/* Trunk — ไม่ขยับ (ลำต้นควรนิ่ง มีแต่ทรงพุ่มที่ไหว) */}
        <rect
          x={cx - trunkW / 2}
          y={ty - trunkH * 0.1}
          width={trunkW}
          height={trunkH}
          rx={trunkW / 2}
          fill={theme.trunk}
        />

        {/* Trunk highlight */}
        <rect
          x={cx - trunkW * 0.2}
          y={ty}
          width={trunkW * 0.3}
          height={trunkH * 0.7}
          rx={trunkW * 0.15}
          fill="var(--glass-w-22)"
        />

        {/* ── ทรงพุ่ม (ใบ+ดอก) ทั้งหมดอยู่ใน <g> เดียว ให้ไหวไปด้วยกันเป็นก้อนเดียว ── */}
        <g
          className={animated ? 'mini-tree__crown mini-tree__crown--swaying' : 'mini-tree__crown'}
          style={{ transformOrigin: `${crownOriginX}px ${crownOriginY}px` }}
        >
          {/* Leaves — layered circles for depth */}
          <circle
            cx={cx}
            cy={ty - r1 * 0.6}
            r={r1}
            fill={`url(#lg${s})`}
          />

          <circle
            cx={cx - r2 * 0.5}
            cy={ty - r1 * 0.2}
            r={r2}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".9"
          />

          <circle
            cx={cx + r2 * 0.5}
            cy={ty - r1 * 0.25}
            r={r2 * 0.85}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".85"
          />

          {/* Crown highlight */}
          <circle
            cx={cx - r3 * 0.3}
            cy={ty - r1 * 0.8}
            r={r3 * 0.7}
            fill={theme.leaves[2] ?? theme.leaves[0]}
            opacity=".55"
          />

          <circle
            cx={cx - r3 * 0.4}
            cy={ty - r1 * 0.85}
            r={r3 * 0.35}
            fill="var(--glass-w-30)"
          />

          {/* Flowers */}
          {theme.flowers.slice(0, 3).map((fc, i) => {
            const fx =
              cx + [-r1 * 0.4, r1 * 0.3, r1 * 0.05][i];

            const fy =
              ty - r1 * [0.95, 0.75, 1.15][i];

            return (
              <g key={i}>
                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.055}
                  fill={fc}
                />

                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.025}
                  fill="var(--glass-w-70)"
                />
              </g>
            );
          })}
        </g>
      </svg>
    </div>
  );
}
</file>

<file path="src/components/tree/treeHealth.ts">
/* [ใหม่ — ตามที่ระบุรอบนี้ ข้อ 3+4] "state overlay" (healthy/wilting/dying) ผูกกับ "จำนวนวันที่ไม่ได้ทำ
 * เควสสำเร็จในหมวดนั้นๆ ล่าสุด" (คำนวณจาก questLogs ใน Dashboard.tsx) N=5 เริ่ม wilting,
 * N=10 เริ่ม dying — ใบไม้ผูกกับหมวดจิตใจ (EMOTION), พื้นดิน/หญ้าผูกกับหมวดสุขภาพกาย (HEALTH)
 * ใช้ร่วมกันระหว่างตัวต้นไม้ (TreeOfLife.tsx) กับแผงข้อมูลต้นไม้ (TreeInfoPanel.tsx) */
export type HealthPhase = 'healthy' | 'wilting' | 'dying'

export function toHealthPhase(daysSinceLastQuest: number | null): HealthPhase {
  if (daysSinceLastQuest === null) return 'healthy'
  if (daysSinceLastQuest >= 10) return 'dying'
  if (daysSinceLastQuest >= 5) return 'wilting'
  return 'healthy'
}
</file>

<file path="src/components/tree/TreeInfoPanel.tsx">
import { useMemo, type ReactNode } from 'react'
import { BADGE_ICONS } from '../../config/iconAssets'
import { MBTI_TREE_THEME, type MbtiType, type RiskLevel } from '../../types'
import { MAX_VISUAL_LEVEL } from '../../utils/progression'
import { crossPenalty } from '../../config/crossGrowth'
import { groundDryness, groundStage, knowledgeGrowthMultiplier } from '../../config/groundFertility'
import { useIsSmallScreen } from '../../hooks/useMediaQuery'
import InfoFramePanel from '../common/InfoFramePanel'
import { buildTreeModel } from './procedural/buildTreeModel'
import MiniTree from './MiniTree'
import { speciesOf } from './procedural/species'
import { toHealthPhase } from './treeHealth'
import FadeInText from '../welcome/FadeInText'
import { useLanguage } from '../../context/LanguageContext'
import { useAppContext } from '../../context/AppContext'

interface TreeInfoPanelProps {
  mbtiType: MbtiType | null
  trunkBranchLevel: number
  leafFlowerLevel: number
  grassSoilLevel: number
  riskLevel: RiskLevel
  daysSinceLastMentalQuest: number | null
  daysSinceLastPhysicalQuest: number | null
  /** วันที่ไม่ได้ทำเควสการเรียนรู้ — คำเตือนลำต้นแห้ง */
  daysSinceLastKnowledgeQuest?: number | null
  onClose: () => void
  /** เนื้อหาเพิ่มต่อท้ายข้อมูลต้นไม้ในกรอบเดียวกัน (สถิติ/EXP/ปุ่มเช็คอิน จาก TreeStatsPanel) */
  children?: ReactNode
}

/**
 * TreeInfoPanel — แผง "ข้อมูลต้นไม้" เปิดจากปุ่มต้นไม้มุมขวาบนของหน้า Home
 * ────────────────────────────────────────────────────────────────────────────
 * [ย้ายตามที่ระบุ] เดิมเป็นป็อบอัพที่เปิดจากการกดโคนต้นไม้ (TreeOfLife.tsx) — ย้ายมาเปิดจาก
 * ปุ่มขวาบนแทน และรวมกับแผงสถานะต้นไม้เดิมไว้ในกรอบเดียว (children)
 *  - กรอบแบบกระดานจัดอันดับ (.lb-frame) พื้นทึบเขียวอ่อน/ตัวหนังสือดำ — ธีมมืดเขียวเข้ม/ขาว
 *  - ฟอนต์หน้า Welcome, รายละเอียดค่อยๆ ขึ้นมาทีละแถว (FadeInText)
 *  - จอกว้าง: อยู่ในคอลัมน์ขวา (.dashboard__panel--right) / จอเล็ก ≤768px: เต็มจอแบบหน้าตั้งค่า
 *    (portal ไป body, z-index 500 ต่ำกว่าแถบเมนูล่าง)
 */
export default function TreeInfoPanel({
  mbtiType, trunkBranchLevel, leafFlowerLevel, grassSoilLevel, riskLevel,
  daysSinceLastMentalQuest: mentalDaysProp, daysSinceLastPhysicalQuest: physicalDaysProp, daysSinceLastKnowledgeQuest: knowledgeDaysProp = null,
  onClose, children,
}: TreeInfoPanelProps) {
  const { t, tv, language } = useLanguage()
  const compact = useIsSmallScreen()
  const folder = mbtiType ?? 'BALANCED'
  const theme = MBTI_TREE_THEME[mbtiType as MbtiType] ?? MBTI_TREE_THEME.INFP
  const accent = theme.accent
  const species = speciesOf(mbtiType)
  // ข้อมูลชุดเดียวกับที่ต้นไม้บนหน้า Home วาดอยู่ (จำนวนใบ/ดอก/ขั้นภาพ)
  const treeModel = useMemo(
    () => buildTreeModel({ mbtiType, trunkBranchLevel, leafFlowerLevel, compact }),
    [mbtiType, trunkBranchLevel, leafFlowerLevel, compact],
  )
  // [แก้ตามที่ระบุ] โหมดปกติไม่มีการเหี่ยว/ลดคะแนน → ไม่มีคำเตือน (ดู TreeOfLife.tsx)
  const { settings } = useAppContext()
  const daysSinceLastMentalQuest = settings.strictMode ? mentalDaysProp : null
  const daysSinceLastPhysicalQuest = settings.strictMode ? physicalDaysProp : null
  const daysSinceLastKnowledgeQuest = settings.strictMode ? knowledgeDaysProp : null
  const leafHealthPhase = toHealthPhase(daysSinceLastMentalQuest)
  const trunkHealthPhase = toHealthPhase(daysSinceLastKnowledgeQuest)
  /** [แก้ตามที่ระบุ: 100 เลเวล] Lv.x/100 — ครบ 100 ขึ้นป้าย "เต็มแล้ว" (ยังทำเควสได้ต่อ คะแนนยังสะสม) */
  /** ทั้ง 3 ด้านมีผลต่อกัน (config/crossGrowth.ts): ลำต้นเหี่ยว → จิตใจได้คะแนนน้อยลง, ใบเหี่ยว → สุขภาพได้น้อยลง */
  const crossNote = (days: number | null, part: string) => {
    const n = Math.round(crossPenalty(days) * 100)
    return n > 0 ? ` · ${tv('treeInfo.crossPenalty', { part, n })}` : ''
  }
  const lv = (n: number) => `Lv.${n}/${MAX_VISUAL_LEVEL}${n >= MAX_VISUAL_LEVEL ? ` ${t('treeInfo.max')}` : ''}`
  const groundDry = groundDryness(daysSinceLastPhysicalQuest)
  const groundStg = groundStage(groundDry)

  return (
    <InfoFramePanel banner={<><img src={BADGE_ICONS.tree} className="icon-img icon-img--lg" alt="" style={{ verticalAlign: 'middle' }} /> {t('treeInfo.title')}</>} onClose={onClose}>
        {/* [แก้ตามที่ระบุ] ต้นไม้ประจำ MBTI แบบเดียวกับในตารางจัดอันดับ/หน้าเลือก MBTI (MiniTree)
            ขึ้นก่อน แล้วค่อยเป็นข้อความ "ต้นไม้ของ ..." */}
        <FadeInText className="tree-info-panel__tree">
          <MiniTree theme={theme} size={96} />
        </FadeInText>
        <div style={{ textAlign: 'center', marginBottom: 12 }}>
          <FadeInText delayMs={120} className="tree-of-life__tooltip-sub">{tv('treeInfo.treeOf', { name: folder })}</FadeInText>
          <FadeInText delayMs={180} className="tree-of-life__tooltip-title" style={{ color: accent }}>
            {language === 'en'
              ? species.nameEn
              : <>{treeModel.speciesName} <span className="tree-of-life__tooltip-sub">({species.nameEn})</span></>}
          </FadeInText>
        </div>

        <div className="tree-of-life__tooltip-rows">
          <FadeInText className="tree-of-life__tooltip-row" delayMs={200}>
            <span aria-hidden="true">🪵</span>
            <div><b>{t('treeInfo.trunk')}</b> {lv(trunkBranchLevel)}</div>
          </FadeInText>
          <FadeInText className="tree-of-life__tooltip-row" delayMs={350}>
            <span aria-hidden="true">🌸</span>
            <div><b>{t('treeInfo.flowers')}</b> {lv(leafFlowerLevel)} · {treeModel.leaves.length > 0 ? tv('treeInfo.leavesCount', { n: treeModel.leaves.length }) : t('treeInfo.noLeaves')} · {tv('treeInfo.flowersCount', { n: treeModel.flowers.length })}</div>
          </FadeInText>
          <FadeInText className="tree-of-life__tooltip-row" delayMs={500}>
            <span aria-hidden="true">🌱</span>
            <div><b>{t('treeInfo.grass')}</b> {lv(grassSoilLevel)} · {t(`treeInfo.ground.${groundStg}`)}</div>
          </FadeInText>
          {trunkHealthPhase !== 'healthy' && (
            <div className="tree-of-life__tooltip-warn">🪵 {trunkHealthPhase === 'dying' ? t('treeInfo.trunkDying') : t('treeInfo.trunkWilting')}{crossNote(daysSinceLastKnowledgeQuest, t('stats.mental'))}</div>
          )}
          {leafHealthPhase !== 'healthy' && (
            <div className="tree-of-life__tooltip-warn">🍂 {leafHealthPhase === 'dying' ? t('treeInfo.leafDying') : t('treeInfo.leafWilting')}{crossNote(daysSinceLastMentalQuest, t('stats.physical'))}</div>
          )}
          {groundDry > 0 && (
            <div className="tree-of-life__tooltip-warn">
              🌾 {tv('treeInfo.dryGround', { n: Math.round(knowledgeGrowthMultiplier(groundDry) * 100) })}
            </div>
          )}
          {riskLevel !== 'LOW' && (
            <div className="tree-of-life__tooltip-warn">⚠️ {riskLevel === 'HIGH' ? t('treeInfo.riskHigh') : t('treeInfo.riskModerate')}</div>
          )}
        </div>

        {children && <FadeInText delayMs={650} className="tree-info-panel__extra">{children}</FadeInText>}
    </InfoFramePanel>
  )
}
</file>

<file path="src/components/tree/TreeOfLife.css">
.tree-of-life {
  position: relative;
  width: 100%;
  height: 100%;
}

/* ฉาก (กว้างเท่าจอ หรือกว้างกว่าเมื่อ pannable) — เลื่อนซ้าย-ขวาด้วย transform จาก useHorizontalPan */
.tree-of-life__world {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  will-change: transform;
}
/* แถบกว้างเท่าจอกึ่งกลางฉาก — เอฟเฟกต์/ไอเทม/hotspot อ้างพิกัด % จากแถบนี้ */
.tree-of-life__band {
  position: absolute;
  top: 0;
  height: 100%;
}
/* ลากแนวนอนเป็นของเรา (เลื่อนฉาก) — แนวตั้งยังให้เบราว์เซอร์จัดการตามปกติ */
.tree-of-life--pannable {
  overflow: hidden;
  touch-action: pan-y;
}

/* [ใหม่] containment — บอกเบราว์เซอร์ว่าการเปลี่ยนแปลงข้างในเลเยอร์นี้
   ไม่กระทบ layout ของส่วนอื่นในหน้า ทำให้ข้ามการคำนวณส่วนที่เหลือได้ทั้งหมด
   สำคัญมากกับเลเยอร์ที่มีลูกหลายสิบตัว animate พร้อมกันแบบนี้ */
.tree-of-life__stack {
  contain: layout paint;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ต้นไม้ procedural (ProceduralTreeCanvas.tsx) — canvas 3 ชั้นเต็มกล่อง: ทุ่งหญ้า / กิ่ง / ใบ+ดอก
   วาดใหม่เฉพาะตอนเลเวลหรือขนาดกล่องเปลี่ยน (อนิเมชันโตหมุนรอบโคนต้น 50% 84% — ตรงกับ
   TREE_BASE_Y_RATIO ใน drawTree2D.ts) — ใบไม่ไหวทั้งก้อนแล้ว (ดูแข็ง) มีแค่หญ้าที่ไหวตามลม */
.tree-of-life__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  /* โผล่/โตขึ้นทุกครั้งที่ขึ้นขั้น (canvas ถูก remount ด้วย key = visual level) */
  animation: treeOfLifeLayerGrow 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  transform-origin: 50% 84%;
}
/* ชั้นทุ่งหญ้า + หญ้าหลังต้น อยู่ใต้ลำต้น / หญ้าหน้าต้นทับโคนต้น (ใต้ชั้นใบ) — ไม่เล่นอนิเมชันโต
   (พื้นไม่ควรขยายตามต้นตอนขึ้นขั้น) หญ้าไหวเพราะวาดใหม่ทุกเฟรมใน ProceduralTreeCanvas ไม่ใช่ CSS */
.tree-of-life__canvas--ground,
.tree-of-life__canvas--meadow {
  z-index: 1;
  animation: none;
}
.tree-of-life__canvas--meadow-front {
  z-index: 2;
  animation: none;
}
/* ลำต้น/กิ่งค่อยๆ แห้งซีด/ฟื้น (เควสการเรียนรู้) ไม่ตัดภาพ */
.tree-of-life__canvas--branches { transition: filter 3s ease; }
.tree-of-life__canvas--foliage {
  z-index: 3;
  filter: drop-shadow(0 3px 4px var(--glass-b-15));
  transition: filter 3s ease, opacity 3s ease; /* ใบค่อยๆ เหี่ยว/ฟื้น ไม่ตัดภาพ */
}

@keyframes treeOfLifeLayerGrow {
  from {
    opacity: 0;
    transform: scale(0.86);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ไอเทมตกแต่งที่สวมใส่อยู่ (จาก InventoryModal)
   [แก้บั๊ก — ไอเทมโซน "กระถาง" (pot, top:85% ดู DECORATION_ZONE_POSITION) ลากไม่ได้]
   เดิม z-index:5 ต่ำกว่า .tree-of-life__hint-hotspot (z-index:6 ด้านล่าง ซึ่งวางอยู่แถว
   โคนต้น bottom:2% สูง 10% = ครอบคลุมพื้นที่ y ~88-98% ที่ทับกับตำแหน่งไอเทมโซนกระถางพอดี)
   สอง element นี้เป็น sibling ในบริบทซ้อนทับเดียวกัน hint-hotspot ที่ z-index สูงกว่าจึง
   ดักจับ pointerdown ของไอเทมกระถางที่อยู่ข้างใต้ไปหมด ทั้งที่ไม่มีการล็อกตำแหน่งไอเทม
   กระถางไว้จริงในโค้ดที่ไหนเลย (handlePointerDown ใน TreeOfLife.tsx ไม่มีเงื่อนไขแยกตาม
   zone/category) — เป็นบั๊กจาก z-index ชนกันล้วนๆ ไม่ใช่การออกแบบตั้งใจ แก้โดยยกเลเยอร์นี้
   ขึ้นเหนือ hint-hotspot แทน (ไอเทมตกแต่งควรมีสิทธิ์เหนือ tooltip hotspot อยู่แล้วเพราะเป็น
   UI ที่ผู้ใช้ต้องโต้ตอบด้วยมือโดยตรง) */
.tree-of-life__decorations {
  position: absolute;
  inset: 0;
  z-index: 7;
  pointer-events: none;
}

/* [แก้บั๊ก — ตามที่ระบุ] เดิมกำหนดแค่ font-size (ไว้คุมขนาด emoji ตัวอักษร) ไม่เคยกำหนด
   width/height จริงเลย — ตอนนี้ span นี้ไม่มีรูปจริงโหลดสำเร็จมาก่อน (getDecorationImage()
   404 เสมอ ดู commit ก่อนหน้า) จึงไม่มีใครเคยสังเกตเห็นปัญหานี้ พอเปลี่ยนมาใช้ ITEM_ICONS
   (รูปจริงโหลดสำเร็จ) แล้ว .tree-of-life__decoration-img ที่ตั้ง width/height:100% ไว้
   (ดูด้านล่าง) ไม่มี % ของอะไรให้อ้างอิง เพราะ span นี้ position:absolute ไม่มี width/height
   ของตัวเอง (shrink-to-fit) — เบราว์เซอร์จึงเรนเดอร์ตามขนาดไฟล์จริง (บางไฟล์ใหญ่เป็นพันพิกเซล
   เช่น Magic Staff.png 1150x866) ทำให้ไอเทมตกแต่งใหญ่จนบังต้นไม้ทั้งต้น — แก้โดยกำหนด
   width/height ตรงๆ เท่ากับขนาดที่ font-size เคยคุม emoji ไว้ (กล่องขนาดเท่าเดิม รูปจริงจึง
   เล็กพอดีเหมือน emoji เดิมทันที ไม่ต้องแก้ที่อื่น) */
.tree-of-life__decoration-item {
  position: absolute;
  transform: translate(-50%, -50%);
  width: clamp(100px, 100vw, 150px);
  height: clamp(100px, 100vw, 150px);
  font-size: clamp(20px, 6vw, 34px);
  filter: drop-shadow(0 3px 6px var(--glass-b-30));
  animation: treeOfLifeDecorationPop 0.5s cubic-bezier(0.2, 0.8, 0.4, 1) both;
}

@keyframes treeOfLifeDecorationPop {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.15);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}


.tree-of-life__tooltip {
  /* หน้าตากรอบมาจาก .lb-frame (leaderboard/leaderboardRow.css) — ที่นี่คุมตำแหน่ง/ขนาด/ฟอนต์ */
  position: absolute;
  bottom: 110%;
  left: 50%;
  transform: translateX(-50%);
  width: min(340px, calc(100vw - 32px));
  max-height: 62vh;
  font-family: var(--font-display);   /* ฟอนต์เดียวกับกระดานจัดอันดับ */
  font-size: 12.5px;
  line-height: 1.6;
  white-space: normal;
  text-align: left;
  cursor: default;
  z-index: 20;
  animation: treeOfLifeTooltipIn 0.24s cubic-bezier(.22,1,.36,1) both;
}

/* [แก้ตามที่ระบุ] พื้นทึบเขียวอ่อนสีเดียวกับกระดานจัดอันดับ (ไม่โปร่งใส) ตัวหนังสือดำ —
   ธีมมืด: พื้นเขียวเข้ม ตัวหนังสือขาว */
.tree-of-life__tooltip {
  --ti-bg: var(--leaf-soft);
  --ti-row: var(--leaf-soft-strong);
  --ti-text: var(--n900);
}
[data-theme="dark"] .tree-of-life__tooltip {
  --ti-bg: var(--g800);
  --ti-row: var(--g700);
  --ti-text: var(--fixed-white);
}
.tree-of-life__tooltip .tree-of-life__tooltip-sheet {
  padding: 14px 12px 12px;
  overflow-y: auto;
  background: var(--ti-bg);
  color: var(--ti-text);
}
.tree-of-life__tooltip-sub { font-size: 13px; color: var(--ti-text); opacity: .75; }
.tree-of-life__tooltip-title { font-size: 20px; margin-top: 2px; color: var(--ti-text); }

.tree-of-life__tooltip-close {
  position: absolute;
  top: 6px;
  right: 6px;
  z-index: 2;
  width: 30px;
  height: 30px;
  border-radius: 99px;
  border: none;
  background: var(--glass-b-15);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* จอเล็ก: เต็มจอแบบหน้าตั้งค่า (SettingsModal Overlay) — อยู่ใต้ ActionMenuBar (z-index 1000)
   เว้นล่างด้วย --gpf-safe-bottom ไม่ให้แถบเมนูบังเนื้อหาท้ายสุด */
.tree-of-life__tooltip-screen {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: var(--leaf-soft);
  overflow-y: auto;
  padding: 40px 16px calc(var(--gpf-safe-bottom, 100px) + 24px);
  font-family: var(--font-display);
}
[data-theme="dark"] .tree-of-life__tooltip-screen { background: var(--g900); }
.tree-of-life__tooltip-screen .tree-of-life__tooltip {
  position: relative;
  bottom: auto;
  left: auto;
  transform: none;
  width: 100%;
  max-width: 760px;
  max-height: none;
  margin: 14px auto 0;
  font-size: 14px;
  animation: treeOfLifeTooltipScreenIn .32s cubic-bezier(.22,1,.36,1) both;
}
@keyframes treeOfLifeTooltipScreenIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.tree-of-life__tooltip-rows {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.tree-of-life__tooltip-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 8px 10px;
  border-radius: 14px;
  background: var(--ti-row);
  border: 1px solid color-mix(in srgb, var(--ti-text) 12%, transparent);
  color: var(--ti-text);
}
.tree-of-life__tooltip-row b { color: var(--ti-text); margin-right: 4px; }

@keyframes treeOfLifeTooltipIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.tree-of-life__tooltip-warn {
  padding: 8px 10px;
  border-radius: 14px;
  background: color-mix(in srgb, var(--orange) 14%, transparent);
  color: var(--b700);
  font-weight: 700;
}

@media (prefers-reduced-motion: reduce) {
  .tree-of-life__tooltip,
  .tree-of-life__tooltip-screen .tree-of-life__tooltip { animation: none; }
}

/* ═══════════════════════════════════════════════════════════════
   Draggable decorations [ข้อกำหนดข้อ 3]
   ═══════════════════════════════════════════════════════════════ */
.tree-of-life__decoration-item--draggable {
  cursor: grab;
  pointer-events: auto;
  touch-action: none;
}

.tree-of-life__decoration-item--dragging {
  cursor: grabbing;
  filter: drop-shadow(0 6px 14px var(--glass-b-45));
  z-index: 50;
  transition: none !important;
}

/* [ใหม่ — ตามที่ระบุ] handle ปรับขนาด — โผล่มุมขวาล่างของไอเทมเฉพาะตอนถูกเลือก (คลิก/แตะ
   ครั้งแรก) ขนาดคงที่ไม่ผูกกับ scale ของไอเทม (อยู่นอกกล่องที่ scale ตามขนาดจริงที่คำนวณ
   เป็น width/height ตรงๆ ใน TreeOfLife.tsx ไม่ใช่ CSS transform:scale จึงไม่กระทบ handle) */
.tree-of-life__decoration-resize-handle {
  position: absolute;
  right: -9px;
  bottom: -9px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--g600, #40916C);
  border: 2px solid var(--fixed-white);
  color: var(--fixed-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  line-height: 1;
  cursor: nwse-resize;
  touch-action: none;
  pointer-events: auto;
  box-shadow: 0 2px 8px var(--glass-b-35);
  z-index: 60;
}

/* พื้นที่ให้วางไอเทมตกแต่งได้อิสระ — โผล่เป็นกรอบจางๆ ตอนกำลังลากเท่านั้น */
.tree-of-life__drop-zone-hint {
  position: absolute;
  inset: 4%;
  border: 2px dashed var(--glass-w-50);
  border-radius: 24px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.tree-of-life__drop-zone-hint--visible {
  opacity: 1;
}

/* ═══════════════════════════════════════════════════════════════
   Growth Pulse — เควสสำเร็จ ต้นไม้ตอบสนองทันที [ใหม่]
   ═══════════════════════════════════════════════════════════════ */

/* ต้นไม้เด้งตัวเบาๆ ทั้งต้นตอน pulse (ใช้ผ่าน inline style ของ root div ไม่ใช่ selector
   นี้ — ประกาศ keyframe ไว้ที่นี่เพื่อให้ทุกไฟล์ที่ import CSS นี้เห็น keyframe เดียวกัน) */
@keyframes treeOfLifeGrowBounce {
  0% { transform: scale(1); }
  35% { transform: scale(1.06); }
  60% { transform: scale(0.98); }
  100% { transform: scale(1); }
}

.tree-of-life__growth-pulse {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* แสงพวยพุ่งออกจากศูนย์กลาง (conic-gradient หมุน + จางหาย) สีเปลี่ยนตามหมวดเควส */
.tree-of-life__growth-pulse-rays {
  position: absolute;
  width: 140%;
  height: 140%;
  border-radius: 50%;
  animation: treeGrowthRaysBurst 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.tree-of-life__growth-pulse--knowledge .tree-of-life__growth-pulse-rays {
  --lc-bg-16: rgba(212, 165, 74, 0.45);
  --lc-bg-17: rgba(212, 165, 74, 0.45);
  --lc-bg-18: rgba(212, 165, 74, 0.45);
  background: conic-gradient(from 0deg, transparent, var(--lc-bg-16), transparent 20%, var(--lc-bg-17) 40%, transparent 60%, var(--lc-bg-18) 80%, transparent);
}
.tree-of-life__growth-pulse--emotion .tree-of-life__growth-pulse-rays {
  --lc-bg-13: rgba(199, 125, 255, 0.45);
  --lc-bg-14: rgba(255, 133, 161, 0.45);
  --lc-bg-15: rgba(199, 125, 255, 0.45);
  background: conic-gradient(from 0deg, transparent, var(--lc-bg-13), transparent 20%, var(--lc-bg-14) 40%, transparent 60%, var(--lc-bg-15) 80%, transparent);
}
.tree-of-life__growth-pulse--health .tree-of-life__growth-pulse-rays {
  --lc-bg-10: rgba(64, 145, 108, 0.5);
  --lc-bg-11: rgba(116, 198, 157, 0.5);
  --lc-bg-12: rgba(64, 145, 108, 0.5);
  background: conic-gradient(from 0deg, transparent, var(--lc-bg-10), transparent 20%, var(--lc-bg-11) 40%, transparent 60%, var(--lc-bg-12) 80%, transparent);
}

@keyframes treeGrowthRaysBurst {
  0% { opacity: 0; transform: scale(0.3) rotate(0deg); }
  40% { opacity: 1; }
  100% { opacity: 0; transform: scale(1.15) rotate(35deg); }
}

/* ประกายไฟกระจายออกรอบทิศ (ใช้ --spark-angle ที่ตั้งมาจาก inline style ต่อจุด) */
.tree-of-life__growth-pulse-spark {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  animation: treeGrowthSparkFly 0.9s ease-out both;
  transform-origin: center;
}
.tree-of-life__growth-pulse--knowledge .tree-of-life__growth-pulse-spark {
  --lc-bg-8: #d4a54a;
  background: var(--lc-bg-8);
  --lc-shadow-9: #d4a54a;
  box-shadow: 0 0 8px var(--lc-shadow-9);
}
.tree-of-life__growth-pulse--emotion .tree-of-life__growth-pulse-spark { background: var(--pink); box-shadow: 0 0 8px var(--pink); }
.tree-of-life__growth-pulse--health .tree-of-life__growth-pulse-spark { background: var(--g400); box-shadow: 0 0 8px var(--g400); }

@keyframes treeGrowthSparkFly {
  0% { opacity: 1; transform: translate(-50%, -50%) rotate(var(--spark-angle)) translateX(0) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -50%) rotate(var(--spark-angle)) translateX(120px) scale(0.3); }
}

@media (prefers-reduced-motion: reduce) {
  .tree-of-life__growth-pulse-rays,
  .tree-of-life__growth-pulse-spark {
    animation: none;
    display: none;
  }
}

/* ═══════════════════════════════════════════════════════════════
   Soot (เตาเผาขยะความคิดยังไม่สำเร็จ) + Falling Petals (ไม่ได้สุ่มไพ่ทิพย์ ≥2 วัน) [ใหม่]
   ═══════════════════════════════════════════════════════════════ */
.tree-of-life__soot {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}
/* [เปลี่ยน] เดิมเป็น emoji 💨 ที่หน้าตาต่างกันทุก OS — ตอนนี้วาดด้วย CSS ล้วน */
.tree-of-life__soot-wisp {
  position: absolute;
  top: 30%;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  --lc-bg-6: rgba(120, 130, 125, .55);
  --lc-bg-7: rgba(120, 130, 125, 0);
  background: radial-gradient(circle at 40% 40%, var(--lc-bg-6), var(--lc-bg-7) 70%);
  filter: blur(2px);
  opacity: 0;
  animation: treeOfLifeSootRise 4.5s ease-in infinite;
}
@keyframes treeOfLifeSootRise {
  0% { transform: translateY(0) scale(0.8); opacity: 0; }
  20% { opacity: 0.5; }
  80% { opacity: 0.35; }
  100% { transform: translateY(-70px) scale(1.3); opacity: 0; }
}

.tree-of-life__falling-petals {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  overflow: hidden;
}
/* [เปลี่ยน] เดิมเป็น emoji 🍂 / 🌸 — ตอนนี้เป็นกลีบที่วาดด้วย CSS
   ทรงกลีบเกิดจาก border-radius ที่ไม่เท่ากันสี่มุม สีอ้างอิงโทเคน Aether
   จึงเข้ากับฉากเสมอ ไม่ว่าธีมจะเปลี่ยนไปทางไหน */
.tree-of-life__falling-petal {
  position: absolute;
  top: -8%;
  width: 11px;
  height: 14px;
