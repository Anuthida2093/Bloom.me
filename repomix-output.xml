  'time-capsule': TimeCapsuleGame,
  'strategic-delay': StrategicDelayGame,
  'mirror-of-truth': MirrorOfTruthGame,
  'guardian-of-rest': GuardianOfRestGame,
  'ten-year-forest': TenYearForestGame,

  // หมวดสุขภาพกาย
