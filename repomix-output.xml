.shop-dialog__actions { display: flex; gap: 10px; width: 100%; margin-top: 8px; }
.shop-dialog__actions .soft-btn { flex: 1; }

/* ปุ่มนูนนุ่ม — ใช้ซ้ำได้ทุกป็อปอัพใหม่ */
.soft-btn {
  min-height: 46px; padding: 10px 16px;
  border: none; border-radius: 16px; cursor: pointer;
  font-family: var(--font-display); font-size: 16px;
  transition: transform .12s ease, box-shadow .12s ease, filter .15s ease;
}
.soft-btn:disabled { cursor: not-allowed; filter: saturate(0.5) opacity(0.8); }
.soft-btn--gold {
  color: #4A2C0A;
  background: linear-gradient(180deg, #ffe08a 0%, #f5b301 100%);
  box-shadow: 0 5px 0 #c98a00, 0 10px 18px rgba(0, 0, 0, 0.18), inset 0 2px 0 rgba(255, 255, 255, 0.75);
}
.soft-btn--gold:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 1px 0 #c98a00, 0 4px 8px rgba(0, 0, 0, 0.18), inset 0 2px 0 rgba(255, 255, 255, 0.75); }
.soft-btn--ghost {
  color: #2d3a31;
  background: linear-gradient(180deg, #ffffff 0%, #e9efe9 100%);
  box-shadow: 0 5px 0 #b9c4bb, 0 10px 18px rgba(0, 0, 0, 0.12), inset 0 2px 0 #fff;
}
.soft-btn--ghost:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 1px 0 #b9c4bb, 0 4px 8px rgba(0, 0, 0, 0.12), inset 0 2px 0 #fff; }

/* ฉากยินดีด้วย: ไอเทมลอยขึ้น + แสงวาบ แล้วข้อความค่อยขึ้น */
.shop-dialog__rise { position: relative; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; }
.shop-dialog__glow {
  position: absolute; inset: 10px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 224, 138, 0.95), rgba(255, 224, 138, 0) 70%);
  animation: shopGlow 1.6s ease-out both;
}
.shop-dialog__hero--rise { position: relative; animation: shopItemRise 1.2s cubic-bezier(.22, 1, .36, 1) both; }
.shop-dialog__congrats { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; opacity: 0; transform: translateY(12px); transition: opacity .4s ease, transform .4s ease; }
.shop-dialog__congrats--show { opacity: 1; transform: none; }

@keyframes shopDialogFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes shopDialogPop { from { opacity: 0; transform: scale(.85) translateY(16px); } to { opacity: 1; transform: none; } }
@keyframes shopItemRise {
  0% { opacity: 0; transform: translateY(90px) scale(.5); }
  60% { opacity: 1; transform: translateY(-14px) scale(1.08); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes shopGlow { 0% { opacity: 0; transform: scale(.4); } 50% { opacity: 1; transform: scale(1.15); } 100% { opacity: .75; transform: scale(1); } }
@keyframes shopTokenWobble { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg) translateY(-4px); } }

@media (max-width: 360px) {
  .shop-dialog__card { padding: 22px 14px 16px; border-radius: 20px; }
  .shop-dialog__hero { width: 128px; height: 128px; }
  .shop-dialog__emoji { font-size: 96px; }
  .shop-dialog__rise { width: 160px; height: 160px; }
}
@media (max-width: 300px) {
  .shop-dialog { padding: 8px; }
  .shop-dialog__hero, .shop-dialog__token-hero { width: 96px; height: 96px; }
  .shop-dialog__title { font-size: 17px; }
  .shop-dialog__actions { flex-direction: column-reverse; }
}
@media (prefers-reduced-motion: reduce) {
  .shop-dialog, .shop-dialog__card, .shop-dialog__hero--rise, .shop-dialog__glow, .shop-dialog__token-hero { animation: none; }
}
