}

.potion-result-emoji { font-size: 46px; }
.potion-result-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 19px;
  color: var(--fixed-white);
}

.potion-warning {
  width: 100%;
  border-radius: 14px;
  --lc-border-2: rgba(255, 214, 150, 0.4);
  border: 1px solid var(--lc-border-2);
  --lc-bg-3: rgba(255, 196, 100, 0.12);
  background: var(--lc-bg-3);
  --lc-text-4: #FFD9A8;
  color: var(--lc-text-4);
  font-size: 12.5px;
  line-height: 1.75;
  padding: 12px 14px;
