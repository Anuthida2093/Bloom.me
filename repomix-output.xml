import { http, API_MODE, mockDelay } from '../http'
import { getDb, updateDb } from '../mock/mockDb'
import { DEFAULT_JOURNEY_DEADLINE_DAYS, resolveJourneyStatus, calcMapTotalStepsTarget } from '../../config/journeyRules'
import type { JourneyRecord } from '../../types.journey'

/*============================================================================*\
  journey.api.ts — คำขอเกี่ยวกับเควส "ก้าวเพื่อสุขภาพ" โฉมใหม่ (Step Journey) — เลือกแผนที่
  ปลายทาง 1 ใบจาก 8 ใบ แล้วเดินข้ามแผนที่ใบนั้นใบเดียวจนถึง exitPct
  ────────────────────────────────────────────────────────────────────────────
  ยึด pattern เดียวกับ quest.api.ts/shop.api.ts ทุกจุด (API_MODE check, mockDelay,
  getDb()/updateDb() จาก mockDb.ts) โหมด live ยังไม่มี backend จริงรองรับ — ดู
  docs/DB_CHANGES.md หัวข้อ journeys สำหรับสเปกตาราง/endpoint ที่ต้องเพิ่ม
\*============================================================================*/

function createMockJourney(destinationMapId: string, userId: string): JourneyRecord {
  const now = new Date()
  const deadline = new Date(now.getTime() + DEFAULT_JOURNEY_DEADLINE_DAYS * 24 * 60 * 60 * 1000)
  return {
    id: `local-journey-${Date.now()}`,
    userId,
    destinationMapId,
    // [เฟสนี้] currentMapId เท่ากับ destinationMapId เสมอ — เลือกปลายทางเดียวแล้วเดินข้ามแผนที่
    // ใบนั้นใบเดียวจบ ไม่มีกลไกไล่เดินข้ามหลายแผนที่ตามลำดับ (ดู types.journey.ts)
    currentMapId: destinationMapId,
    progressOnCurrentMapSteps: 0,
    startedAt: now.toISOString(),
    deadlineAt: deadline.toISOString(),
    status: 'IN_PROGRESS',
  }
}

/** อ่าน progressPct (0-100) ของ journey หนึ่งอัน — ใช้ mapTotalStepsTarget แบบเดียวกับที่
 *  StepJourneyGame.tsx ใช้แสดงผล เพื่อให้ตัดสิน FAILED/COMPLETED_* สอดคล้องกับสิ่งที่ผู้เล่นเห็น */
function calcProgressPct(journey: JourneyRecord, bmi: number): number {
  const target = calcMapTotalStepsTarget(bmi)
  return target > 0 ? Math.min(100, (journey.progressOnCurrentMapSteps / target) * 100) : 0
}

/** [เฉพาะโหมด mock] อัปเดต status ให้ตรงกับความเป็นจริง ณ ตอนนี้ก่อนคืนค่าออกไปทุกครั้ง — journey
 *  ที่เลย deadline ไปแล้วโดยยังไม่มีใครมาเช็ค (ไม่ได้เปิดแอปหลายวัน) ต้องกลายเป็น FAILED ทันทีที่
 *  อ่านค่า ไม่ใช่ค้างเป็น IN_PROGRESS เงียบๆ */
function refreshStatus(journey: JourneyRecord, bmi: number): JourneyRecord {
  const progressPct = calcProgressPct(journey, bmi)
  const status = resolveJourneyStatus(journey, progressPct, new Date())
  return status === journey.status ? journey : { ...journey, status }
}

export async function getActiveJourney(): Promise<JourneyRecord | null> {
  if (API_MODE === 'mock') {
    await mockDelay(120)
    const db = getDb()
    if (!db.activeJourney) return null
    const refreshed = refreshStatus(db.activeJourney, db.user.bmi ?? 0)
    // ทริปที่ไม่ได้อยู่ระหว่างทางแล้ว (จบ/ล้มเหลว) ไม่ถือว่า "active" อีกต่อไป — คืน null ให้
    // StepJourneyGame.tsx กลับไปโชว์ DestinationPicker ให้เริ่มทริปใหม่ได้
    return refreshed.status === 'IN_PROGRESS' ? refreshed : null
  }
  return http.get<JourneyRecord | null>('/journeys/active')
}

export async function startJourney(destinationMapId: string): Promise<JourneyRecord> {
  if (API_MODE === 'mock') {
    await mockDelay()
    const db = updateDb((d) => {
      d.activeJourney = createMockJourney(destinationMapId, d.user.id)
    })
    return db.activeJourney as JourneyRecord
  }
  return http.post<JourneyRecord>('/journeys', { destinationMapId })
}

export async function addSteps(journeyId: string, steps: number): Promise<JourneyRecord> {
  if (API_MODE === 'mock') {
    await mockDelay()
    const db = updateDb((d) => {
      // [เฉพาะโหมด mock] journeyId ไม่ตรงกับ journey ที่กำลังเดินอยู่ตอนนี้ (เช่น เรียกซ้ำหลังจบ
      // ทริปไปแล้ว) — ไม่แก้อะไร ปล่อยให้ค่าที่คืนกลับไปเป็นของเดิม (เหมือน buyItem ใน shop.api.ts)
      if (!d.activeJourney || d.activeJourney.id !== journeyId) return
      const updated: JourneyRecord = {
        ...d.activeJourney,
        progressOnCurrentMapSteps: d.activeJourney.progressOnCurrentMapSteps + steps,
      }
      d.activeJourney = refreshStatus(updated, d.user.bmi ?? 0)
    })
    return db.activeJourney as JourneyRecord
  }
  return http.patch<JourneyRecord>(`/journeys/${journeyId}/steps`, { steps })
}
