  --ease-out-soft: cubic-bezier(.22, 1, .36, 1);
  --ease-spring:   cubic-bezier(.34, 1.56, .64, 1);
  --dur-fast: .18s; --dur-mid: .32s; --dur-slow: .6s;
}

@media (max-width: 768px) {
  :root { --gpf-safe-bottom: 80px; }
}

/* ─── Dark Mode tokens ─── */
[data-theme="dark"] {
  --bg:         #0F1A13;
  --bg-card:    #192A1E;
  --bg-sidebar: #162119;
  --bg-modal:   rgba(0,0,0,.65);
  --text:       #E8F5EC;
  --text-sub:   #7EAD8C;
  --text-muted: #4A6B52;
  --border:     rgba(255,255,255,.08);
  --border-mid: rgba(255,255,255,.13);
  --input-bg:   #1F3328;
  --white:      #192A1E;
  --n50:        #0F1A13;
  --n100:       rgba(255,255,255,.08);
  --n200:       rgba(255,255,255,.13);
  --n300:       #4A6B52;
  --n500:       #7EAD8C;
  --n700:       #B8D4C0;
  --n900:       #E8F5EC;
  --b50:        #1F1810;
  --b100:       #2E2014;
  --g50:        #0F1E15;
  --g100:       #152A1C;
  --sh-card:    0 2px 12px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.3);
  --sh-hover:   0 8px 28px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.3);
  /* [เพิ่มตามที่ระบุ — ข้อ 7] ใช้เฉด --g400 เดียวกับที่หน้าเควสมืด (ไพ่ทิพย์ ฯลฯ) ใช้เป็นสี
     หัวเรื่องบนพื้นเข้มอยู่แล้ว (ดู .oracle-page__title ใน OracleCardsPage.css) แทน --g800 เดิม
     ให้ผ่าน WCAG AA บน --bg-card มืด (#192A1E) สบายๆ โดยยังเป็นโทนเขียวแบรนด์เดิม */
  --heading-accent: var(--g400);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  font-size: var(--fs-md);
  line-height: var(--lh-body);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  transition: background .25s ease, color .25s ease;
}

h1, h2, h3, h4, .display {
  font-family: var(--font-display);
  line-height: var(--lh-tight);
  font-weight: 700;
}
h1 { font-size: var(--fs-3xl); }
h2 { font-size: var(--fs-2xl); }
h3 { font-size: var(--fs-xl); }
h4 { font-size: var(--fs-lg); }

button { font-family: var(--font-body); cursor: pointer; }
input, select, textarea { font-family: var(--font-body); }

/* [ใหม่] โฟกัสคีย์บอร์ดต้องมองเห็นได้เสมอ — เกณฑ์ขั้นต่ำก่อนขึ้นโปรดักชัน */
:focus-visible {
  outline: 2px solid var(--ae-glow);
  outline-offset: 2px;
  border-radius: 4px;
}

::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--g200); border-radius: 99px; }
.no-scroll::-webkit-scrollbar { display: none; }
.no-scroll { scrollbar-width: none; }

/* [ใหม่] ไอคอนรูปจริงแทนอีโมจิ (ดู src/config/iconAssets.ts) — .icon-img สำหรับใช้แทรกกลาง
   ข้อความแบบเดียวกับที่ emoji เคยทำ (ขนาดอิง em ให้สเกลตามฟอนต์รอบข้างอัตโนมัติ, เลื่อนลง
   เล็กน้อยด้วย vertical-align ให้จัดแนวกับข้อความพอดีเหมือน emoji) ส่วน .icon-img--lg สำหรับ
   ไอคอนขนาดคงที่ในปุ่ม/ป้ายที่ไม่ได้อยู่ในบรรทัดข้อความ (เช่น ไอคอนเควสบนปุ่มใหญ่) */
.icon-img {
  width: 1.1em;
  height: 1.1em;
  object-fit: contain;
  vertical-align: -0.15em;
  display: inline-block;
}
.icon-img--lg {
  width: 28px;
  height: 28px;
}

/* [ใหม่ — ตามที่ระบุ "รูปใหญ่ชัดเจน ไม่ใช่ไอคอนเล็กจิ๋วแบบ inline text"] ใช้เฉพาะจุดที่โชว์
   จำนวนรางวัลที่เพิ่งได้รับ (เควสสำเร็จ/ป๊อปอัพผลลัพธ์) — ใหญ่กว่า .icon-img ปกติชัดเจน
   แต่ยังพอดีกับ inline text รอบข้าง ไม่ล้นจนดีไซน์เพี้ยน */
.icon-img--reward {
  width: 22px;
  height: 22px;
  object-fit: contain;
  vertical-align: -5px;
  display: inline-block;
}

.card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  border: 1px solid var(--border);
}

.glass {
  background: rgba(255,255,255,.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
[data-theme="dark"] .glass {
  background: rgba(25,42,30,.82);
}

.tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 10px; border-radius: var(--r-pill);
  font-size: 11px; font-weight: 700;
}

/* Butterfly animation */
@keyframes flutter {
  0%   { transform: translate(0,0) rotate(-10deg); }
  25%  { transform: translate(12px,-8px) rotate(10deg); }
  50%  { transform: translate(24px,4px) rotate(-8deg); }
  75%  { transform: translate(12px,-12px) rotate(12deg); }
  100% { transform: translate(0,0) rotate(-10deg); }
}
.butterfly { animation: flutter 3s ease-in-out infinite; }

/* Post-it wobble */
@keyframes wobble {
  0%,100% { transform: rotate(-3deg); }
  50%      { transform: rotate(3deg); }
}

/* Coin bounce */
@keyframes coinPop {
  0%   { transform: scale(0) translateY(0); opacity:1; }
  70%  { transform: scale(1.2) translateY(-30px); opacity:1; }
  100% { transform: scale(1) translateY(-60px); opacity:0; }
}
.coin-pop { animation: coinPop .7s ease forwards; }

/* Responsive */
@media (max-width: 640px)  { .hide-mobile  { display: none !important; } }
@media (min-width: 641px)  { .show-mobile  { display: none !important; } }
@media (max-width: 900px)  { .hide-tablet  { display: none !important; } }
@media (min-width: 901px)  { .show-tablet  { display: none !important; } }

/* ─── V3 Micro-interaction keyframes ─── */

/* Floating reward text (+EXP / +Coin) */
@keyframes floatUp {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  60%  { opacity: 1; transform: translateY(-52px) scale(1.12); }
  100% { opacity: 0; transform: translateY(-80px) scale(.9); }
}
.float-up { animation: floatUp 1.4s cubic-bezier(.2,.8,.4,1) forwards; }

/* Confetti piece fall */
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg) scale(1);   opacity: 1; }
  100% { transform: translateY(90px) rotate(var(--cr,540deg)) scale(.5); opacity: 0; }
}

/* Sparkle placed-item burst */
@keyframes sparklePop {
  0%   { transform: scale(0) rotate(0deg);   opacity: 1; }
  55%  { transform: scale(1.3) rotate(180deg); opacity: 1; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}
.sparkle-dot { animation: sparklePop .7s ease forwards; }

/* Firefly float at night */
@keyframes fireflyFloat {
  0%,100% { opacity: 0;   transform: translate(0, 0); }
  40%     { opacity: .85; transform: translate(var(--ffx, 12px), var(--ffy, -16px)); }
  70%     { opacity: .6;  transform: translate(calc(var(--ffx, 12px)*.6), var(--ffy, -16px)); }
}

/* Star twinkle */
@keyframes twinkle {
  0%,100% { opacity: .25; transform: scale(.8); }
  50%     { opacity: 1;   transform: scale(1.3); }
}

/* Sun ray pulse */
@keyframes sunrayPulse {
  0%,100% { opacity: .18; }
  50%     { opacity: .32; }
}

/* Celebration modal pop-in */
@keyframes celebPop {
  0%  { transform: scale(0) rotate(-12deg); opacity: 0; }
  65% { transform: scale(1.08) rotate(3deg); opacity: 1; }
  82% { transform: scale(.96) rotate(-1deg); }
  100%{ transform: scale(1) rotate(0deg); opacity: 1; }
}

/* Slide up from bottom */
@keyframes slideUp {
  0%   { transform: translateY(30px); opacity: 0; }
  100% { transform: translateY(0);    opacity: 1; }
}
.slide-up { animation: slideUp .5s cubic-bezier(.2,.8,.4,1) forwards; }

/* Treasure chest lid open */
@keyframes chestLid {
  0%   { transform: rotateX(0deg) translateY(0); }
  100% { transform: rotateX(-110deg) translateY(-4px); }
}

/* Speaker icon bounce on change */
@keyframes speakerPulse {
  0%,100% { transform: scale(1); }
  40%     { transform: scale(1.45) rotate(-8deg); }
  70%     { transform: scale(.9)  rotate(5deg); }
}
.speaker-pulse { animation: speakerPulse .45s ease; }

/* Item sparkle ring */
@keyframes sparkleRing {
  0%   { transform: scale(.6); opacity: 1; }
  100% { transform: scale(2.2); opacity: 0; }
}
.sparkle-ring { animation: sparkleRing .65s ease-out forwards; }

/* Celebrate confetti rain (position randomly via --cx CSS var) */
@keyframes confettiRain {
  0%   { transform: translateX(var(--cx,0px)) translateY(-20px) rotate(0deg); opacity: 1; }
  100% { transform: translateX(calc(var(--cx,0px) + var(--csx,0px))) translateY(120px) rotate(var(--cr,420deg)); opacity: 0; }
}

/* ════════════════════════════════════════════════════════════════════════════
   [ใหม่] เคารพ prefers-reduced-motion ระดับโกลบอล
   ────────────────────────────────────────────────────────────────────────────
   เดิมทำไว้เฉพาะจุด (TreeOfLife.css กับทูลทิปบน Dashboard) แต่มีอนิเมชันอีกหลายสิบตัว
   ที่ยังวิ่งอยู่ สำหรับแอปสุขภาพจิตนี่ไม่ใช่แค่มารยาท — ผู้ใช้ที่เวียนศีรษะจากการเคลื่อนไหว
   คือกลุ่มที่ทับซ้อนกับกลุ่มเป้าหมายโดยตรง
   ════════════════════════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
</file>

<file path="src/components/dashboard/Dashboard.css">
/*============================================================================*\
  Dashboard.css — [ไฟล์ใหม่] ย้ายมาจาก <style>{...} ที่เคยฝังอยู่ใน Dashboard.tsx
  ────────────────────────────────────────────────────────────────────────────
  ใช้โทเคนจาก index.css ทั้งหมด ไม่มีสีดิบเหลือในไฟล์นี้
\*============================================================================*/

.dashboard {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;   /* กันแถบ URL ของเบราว์เซอร์มือถือกินพื้นที่ */
  padding-bottom: 90px;
}

/* ── พื้นหลัง ── */
.dashboard__bg-video,
.dashboard__bg-still {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.dashboard__bg-video { object-fit: cover; }
.dashboard__bg-still {
  --lc-bg-7: rgba(98, 217, 192, .10);
  background: radial-gradient(90% 60% at 50% 10%, var(--lc-bg-7), transparent 70%),
    linear-gradient(180deg, var(--ae-deep) 0%, var(--ae-void) 100%);
}

/* ── ต้นไม้ ── */
.dashboard__tree-layer {
  position: fixed;
  inset: 0;
  z-index: 1;
}

/* [เพิ่มรอบนี้ — เควส "แคลอรี่ตาม BMI"] แอนิเมชันบัวรดน้ำบินเข้ามาที่โคนต้นไม้ (ดู
   WateringCanFx.tsx) — วางไว้ค่อนไปทางล่างขวาของ .dashboard__tree-layer ใกล้กระถาง/โคนต้น */
.watering-can-fx {
  position: absolute;
  right: 12%;
  bottom: 22%;
  z-index: 6;
  width: 90px;
  height: 90px;
  pointer-events: none;
}
.watering-can-fx__can {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 8px 14px var(--glass-b-35));
}
.watering-can-fx__drops {
  position: absolute;
  bottom: 6px;
  left: 8px;
}
.watering-can-fx__drop {
  position: absolute;
  top: 0;
  width: 14px;
  height: 14px;
}

/* [ใหม่ — ข้อ C] ตัวครอบต้นไม้ของตัวเอง ใช้เป็นเป้าหมายของ html-to-image ตอนกดแชร์
   (ดู treeCaptureRef ใน Dashboard.tsx) — ต้อง position:absolute;inset:0 เอง เพราะ
   TreeOfLife.tsx สูง/กว้าง 100% ของพาเรนต์ตรง (.tree-of-life { width/height:100% }
   ไม่ได้ fixed เอง) ถ้าไม่กำหนดตรงนี้ div ธรรมดาจะสูง 0 ตามค่า default (height:auto ไม่มี
   เนื้อหาที่ดันความสูง) แล้วต้นไม้จะยุบหายไปทันที */
.dashboard__tree-capture-target {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ── ทูลทิปชวนสุ่มไพ่ทิพย์ ──
   [เปลี่ยนจากเดิม] ตัดอนิเมชันลอยขึ้น-ลงตลอดเวลาออก เหลือแค่ปรากฏขึ้นครั้งเดียว
   การเคลื่อนไหวที่วนไม่จบและไม่ได้เกิดจากการกระทำของผู้ใช้ เป็นสิ่งรบกวนสายตา
   มากกว่าเป็นสิ่งดึงดูด โดยเฉพาะในแอปที่ตั้งใจให้รู้สึกสงบ */
.dashboard__oracle-nudge {
  position: absolute;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  max-width: min(80vw, 340px);
  padding: 10px 18px;
  border-radius: var(--r-pill);
  border: 1px solid var(--ae-surface-edge);
  background: var(--ae-surface);
  backdrop-filter: var(--ae-blur);
  -webkit-backdrop-filter: var(--ae-blur);
  color: var(--ae-text);
  font-family: var(--font-display);
  font-size: var(--fs-sm);
  line-height: 1.5;
  box-shadow: var(--ae-glow-sm);
  animation: dashboardNudgeIn .5s var(--ease-out-soft) both;
  transition: transform var(--dur-fast) var(--ease-out-soft), box-shadow var(--dur-fast) ease;
}
.dashboard__oracle-nudge:hover { transform: translateX(-50%) scale(1.03); box-shadow: var(--ae-glow-md); }
.dashboard__oracle-nudge:active { transform: translateX(-50%) scale(.97); }

@keyframes dashboardNudgeIn {
  from { opacity: 0; transform: translateX(-50%) translateY(8px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ── แถบนำทาง ── */
.dashboard__navbar { position: relative; z-index: 100; }

/* ── แผงลอยข้างจอ ── */
.dashboard__panel {
  position: fixed;
  top: 95px;
  z-index: 50;
  pointer-events: none;   /* ตัวกรอบไม่รับคลิก จะได้ไม่บังต้นไม้ */
}
.dashboard__panel > * { pointer-events: auto; }

.dashboard__panel--left {
  left: 16px;
  overflow: visible;      /* ห้ามใส่ overflow:hidden — จะบังปุ่มย่อ/ขยาย */
}
.dashboard__panel--right {
  right: 16px;
  max-height: calc(100vh - 190px);/* [แก้ตามที่ระบุ] เดิมใช้ 100vh - 160px แต่บนมือถือมีแถบ URL ของเบราว์เซอร์กินพื้นที่
     ทำให้แผงขวาเลยล้นจอออกไปนิดหน่อย เปลี่ยนเป็น 100vh - 190px ให้เหลือพื้นที่ว่าง
     ด้านบน/ล่างเท่ากัน (95px) */
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  --lc-c-6: rgba(45, 106, 79, .25);
  scrollbar-color: var(--lc-c-6) transparent;
}
.dashboard__panel--right::-webkit-scrollbar { width: 4px; }
.dashboard__panel--right::-webkit-scrollbar-track { background: transparent; }
.dashboard__panel--right::-webkit-scrollbar-thumb {
  --lc-bg-5: rgba(45, 106, 79, .25);
  background-color: var(--lc-bg-5);
  border-radius: var(--r-pill);
}

/* ── ชั้นของโมดัล ── */
.dashboard__modal-layer { position: relative; z-index: 500; }

/* ── จอกลาง ── */
@media (max-width: 768px) {
  .dashboard__panel--left  { left: 6px; }
  .dashboard__panel--right { right: 6px; }
}

/* ── มือถือ ──
   [เปลี่ยนจากเดิม] เดิมใช้ transform: scale(.88) ย่อทั้งแผง ซึ่งทำให้ตัวอักษร
   เบลอเล็กน้อยและกล่องรับคลิกเลื่อนไม่ตรงกับสิ่งที่ตาเห็น เปลี่ยนมาย่อด้วย
   font-size + ความกว้างจริงแทน */
@media (max-width: 480px) {
  .dashboard__panel { top: 80px; }
  .dashboard__panel--left,
  .dashboard__panel--right { font-size: var(--fs-xs); max-width: 44vw; }
  .dashboard__panel--right { max-height: calc(100vh - 190px); }
  .dashboard__oracle-nudge { font-size: var(--fs-xs); padding: 8px 14px; }
}
/* ═══════════════════════════════════════════
   [เพิ่มใหม่] HUD กลางจอใต้ Navbar แบบ V1
   ═══════════════════════════════════════════ */
.game-top-hud {
  position: fixed;
  top: 92px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 90;
  width: 95%;/* [แก้ตามที่ระบุ] เดิมใช้ 100% แต่บนมือถือมีแถบ URL ของเบราว์เซอร์กินพื้นที่ ทำให้ HUD ล้นจอออกไปนิดหน่อย
     เปลี่ยนเป็น 95% ให้เหลือพื้นที่ว่างด้านซ้าย/ขวาเท่ากัน */
  max-width: 600px;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  pointer-events: none;
}
.game-top-hud > * { pointer-events: auto; }

.hud-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: var(--r-pill);
  --lc-bg-4: rgba(20, 30, 25, .6);
  background: var(--lc-bg-4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1.5px solid var(--glass-w-20);
  color: var(--fixed-white);
  font-family: var(--font-display);
  /* [แก้ตามที่ระบุ] ตัวอักษร HUD (INTJ Lv.1 / เหรียญ / streak) เล็กไป ขยายจาก --fs-sm (13px)
     เป็น --fs-lg (18px) — ยังใช้ design token เดิมตามที่เคยระบุห้ามใส่ค่า px มั่ว */
  font-size: var(--fs-lg);
  box-shadow: var(--sh-card);
}
.hud-icon { font-size: 20px; line-height: 1; }
.hud-bar-container { display: flex; align-items: center; gap: 6px; }
.hud-bar-bg {
  width: 60px; height: 8px; border-radius: var(--r-pill);
  background: var(--glass-b-50); overflow: hidden;
}
.hud-bar-fill { height: 100%; background: linear-gradient(90deg, var(--exp), var(--coin)); border-radius: var(--r-pill); }
/* [แก้ตามที่ระบุ] เลข "99/100" ก็ขยายตาม — จาก --fs-xs (11.5px) เป็น --fs-sm (13px) */
.hud-bar-text {
  font-size: var(--fs-sm);/* 13px */
  --lc-text-3: #E2E8F0;
  color: var(--lc-text-3);
  font-family: var(--font-body);
}

@media (max-width: 768px) {
  .game-top-hud { top: 68px; gap: 6px; }
  .hud-pill { padding: 5px 10px; font-size: var(--fs-md); }
  .hud-icon { font-size: 18px; }
}

/* ═══════════════════════════════════════════
   [เพิ่มใหม่] คลัสเตอร์ปุ่มขวา: Tree Stats / Mood / Sound
   ═══════════════════════════════════════════ */
.dashboard__right-cluster {
  position: fixed;
  top: 95px;
  right: 16px;
  z-index: 60;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.dashboard__right-cluster .dashboard__panel--right {
  position: static;
  top: auto; right: auto;
}

.right-action-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;/* [แก้ตามที่ระบุ] เดิมใช้ 8px แต่บนมือถือมีแถบ URL ของเบราว์เซอร์กินพื้นที่ ทำให้ปุ่มล้นจอออกไปนิดหน่อย
     เปลี่ยนเป็น 12px ให้เหลือพื้นที่ว่างด้านบน/ล่างเท่ากัน */
  flex-shrink: 0;
}

/* [แก้ตามที่ระบุ — เปลี่ยนจากวงกลม 3cm เป็นขนาดตามรูป 2cm] เอา background/border/
   box-shadow/border-radius วงกลมออกทั้งหมด ให้ปุ่มมีขนาดเท่ารูป/ไอคอนจริงตรงๆ (2cm) แทน —
   .icon-img (1.1em ใน index.css) overrride เป็น 2cm ตรงๆ ในนี้ ส่วน emoji ล้วน (🌳/🔊/📖)
   ที่ยังไม่มีไฟล์รูปจริงก็ใช้ font-size 2cm ให้ขนาดสายตาใกล้เคียงกันในกลุ่มปุ่มเดียวกัน */
.game-icon-btn {
  width: 2cm;
  height: 2cm;
  cursor: pointer;
  background: none;
  border: none;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5cm; /* ขนาดตัวอักษรของ emoji ล้วน (🌳/🔊/📖) ให้ใกล้เคียงกับขนาดรูปจริงในปุ่มเดียวกัน*/
  transition: transform var(--dur-fast) var(--ease-spring);
}
/* [แก้บั๊ก — พบระหว่างตรวจตามที่ระบุ] เดิม 4cm ทั้งที่คอมเมนต์ด้านบนบอกเจตนาไว้เองว่า
   "ให้ปุ่มมีขนาดเท่ารูป/ไอคอนจริงตรงๆ (2cm)" — ค่าจริงกลับเป็น 2 เท่าของปุ่ม (4cm ในปุ่ม 2cm)
   วัดจริงในเบราว์เซอร์แล้วยืนยัน: รูปเรนเดอร์ 151px ในปุ่ม 75.6px ทุกปุ่มที่มีรูป (เช็คอิน/
   แจ้งเตือน/แชร์/เพื่อน) ล้นออกนอกปุ่มเป็นวงกว้าง (overflow ของปุ่มเป็น visible ไม่ถูกตัด)
   แก้เป็น 2.4cm (ใหญ่กว่าปุ่มเล็กน้อย ~20% ไม่ใช่ 100%) ชดเชยที่ไฟล์ภาพ PNG มีขอบโปร่งใส
   รอบตัวอยู่แล้ว (เทียบกับอีโมจิที่ตัวอักษรมักเต็มกรอบ font-size มากกว่า) ให้ขนาดที่ "ตา
   มองเห็น" ของรูปกับอีโมจิใกล้เคียงกันในกลุ่มปุ่มเดียวกัน ไม่ใช่แค่ขนาดกรอบเท่ากันเฉยๆ */
.game-icon-btn .icon-img { width: 2.4cm; height: 2.4cm; }
.game-icon-btn:hover { transform: scale(1.08); }
.game-icon-btn:active { transform: scale(.94); }

@media (max-width: 768px) {
  .dashboard__right-cluster { top: 80px; right: 2px; gap: 2px; }/* [แก้ตามที่ระบุ] เดิมใช้ 8px แต่บนมือถือมีแถบ URL ของเบราว์เซอร์กินพื้นที่ ทำให้ปุ่มล้นจอออกไปนิดหน่อย
     เปลี่ยนเป็น 2px ให้เหลือพื้นที่ว่างด้านบน/ล่างเท่ากัน */
  /* [แก้ตามที่ระบุ] เดิม font-size 1.2cm (< ปุ่ม 1.5cm) ทำให้อีโมจิดูเล็กกว่ารูปเล็กน้อย ตอนนี้
     ขยับขึ้นมาเกือบเท่าปุ่ม (1.4cm) ให้ทุกปุ่มในกลุ่มนี้ (ต้นไม้/เช็คอิน/แจ้งเตือน/ปิดเสียง/
     แชร์/เพื่อน) ดูใหญ่สม่ำเสมอกันบนจอมือถือ ไม่มีปุ่มไหนดูเด่นเล็กกว่าเพื่อน */
  .game-icon-btn { width: 1.5cm; height: 1.5cm; font-size: 1.4cm; }/* ขนาดปุ่มย่อเหลือ 1.5cm บนจอเล็ก */
  .game-icon-btn .icon-img { width: 1.9cm; height: 1.9cm; }/* [แก้] เดิม 1.5cm เท่าปุ่มเป๊ะ (ดูเล็กกว่าอีโมจิ) ขยายสัดส่วนเดียวกับ desktop (~1.27x ปุ่ม) */
}

/* ═══════════════════════════════════════════
   [เพิ่มใหม่] ปุ่มลอยมุมล่างจอ: แชร์/เพื่อน (ขวา) + โพสต์ (ซ้าย)
   ตั้งใจให้อยู่คนละแนวตั้งกับ ActionMenuBar (ซึ่งลอยกึ่งกลางล่างจอเท่านั้น กว้างไม่เต็มจอ)
   จึงไม่ชนกัน ใช้ .game-icon-btn ตัวเดียวกับคลัสเตอร์ขวาบนเพื่อความสม่ำเสมอของดีไซน์
   ═══════════════════════════════════════════ */
.dashboard__corner-actions {
  position: fixed;
  bottom: 25px;
  z-index: 90;
  display: flex;
  flex-direction: column;/* [แก้ตามที่ระบุ] เดิมใช้ 8px แต่บนมือถือมีแถบ URL ของเบราว์เซอร์กินพื้นที่ ทำให้ปุ่มล้นจอออกไปนิดหน่อย
     เปลี่ยนเป็น 2px ให้เหลือพื้นที่ว่างด้านบน/ล่างเท่ากัน */
  gap: 2px;
}
.dashboard__corner-actions--left { left: 16px; }
.dashboard__corner-actions--right { right: 16px; }

@media (max-width: 768px) {
  .dashboard__corner-actions { bottom: 15px; gap: 8px; }
  .dashboard__corner-actions--left { left: 6px; }
  .dashboard__corner-actions--right { right: 6px; }
  /* ขนาดปุ่ม .game-icon-btn ย่อเหลือ 1.5cm บนจอเล็กแล้วที่ media query ของ .game-icon-btn เอง */
}

/* ═══════════════════════════════════════════
   [เพิ่มใหม่] โหมดดูต้นไม้ของผู้เล่นคนอื่น (แทน PlayerDetailModal เดิม)
   ═══════════════════════════════════════════ */
.dashboard__back-btn {
  position: fixed;
  top: 95px;
  left: 16px;
  z-index: 60;
  padding: 10px 18px;
  border-radius: var(--r-pill);
  background: var(--bg-card);
  border: 1.5px solid var(--border-mid);
  box-shadow: var(--sh-card);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--text);
  cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-out-soft);
}
.dashboard__back-btn:hover { transform: translateX(-3px); }

