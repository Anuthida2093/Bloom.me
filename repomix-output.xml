  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 30;
  width: 36px;
  height: 36px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-18);
  color: var(--fixed-white);
  cursor: pointer;
  font-size: 18px;
}

/* ปุ่มดูประวัติย้อนหลัง (มุมซ้ายบน) สไตล์ Frosted Glass */
