}

const THEME = {
  mental: {
    bg: `radial-gradient(circle at 50% 50%, ${C_1} 0%, ${C_2} 60%, ${C_3} 100%)`,
    icon: '🦉',
    quote: '"วันนี้เหนื่อยไหม... มาพักผ่อนจิตใจกันเถอะ"',
    fabFrom: 'var(--purple)', fabTo: C_4,
    itemBorder: BORDER_5, itemBg: C_6,
  },
  physical: {
    bg: `radial-gradient(circle at 50% 50%, ${C_7} 0%, ${C_8} 60%, ${C_9} 100%)`,
    icon: '🌿',
    quote: '"วันนี้ขยับร่างกายกันหรือยัง? ออกไปสูดอากาศกันเถอะ"',
    fabFrom: 'var(--g400)', fabTo: 'var(--g700)',
    itemBorder: 'var(--g300)', itemBg: C_10,
  },
}

/**
 * QuestGateView — หน้าหลักของหมวดสุขภาพกาย/สุขภาพจิต แบบ V1 (โลโก้กลางจอ + คำคม +
 * ปุ่มลอย FAB มุมซ้ายล่างที่กางออกเป็นไอคอนเควสแต่ละอัน) ใช้ร่วมกันได้ทั้ง 2 หมวด
 * เพียงสลับธีม — กดไอคอนเควสแล้วเรียก onSelectQuest ตัวเดียวกับที่ QuestSection ใช้อยู่แล้ว
 * (ผ่านด่านล็อก/คัดกรองความเสี่ยงเดิมทุกจุด ไม่ได้ข้ามระบบใดๆ ของ V2)
 */
export default function QuestGateView({
  category, quests, isCompleted, isLocked, onSelectQuest, accent, onOpenSafetyNet,
}: QuestGateViewProps) {
  const [isMenuOpen, setIsMenuOpen] = useState(false)
  const theme = THEME[category]

  const handlePick = (q: QuestDef) => {
    setIsMenuOpen(false)
    onSelectQuest(q)
  }

  return (
    <div className="quest-gate-view" style={{ background: theme.bg }}>
      <div className="quest-gate-view__center">
        <div className="quest-gate-view__icon">{theme.icon}</div>
        <div className="quest-gate-view__shadow" />
        <p className="quest-gate-view__quote">{theme.quote}</p>

        {category === 'mental' && onOpenSafetyNet && (
          <button className="quest-gate-view__safety-link" onClick={onOpenSafetyNet}>
