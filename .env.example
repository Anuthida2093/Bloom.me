# ═══════════════════════════════════════════════════════════════════════════
#  .env.example — คัดลอกเป็น .env แล้วแก้ค่าตามสภาพแวดล้อมของคุณ
#  (Vite อ่านเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ เท่านั้น)
# ═══════════════════════════════════════════════════════════════════════════

# ที่อยู่ของ API — ระหว่างพัฒนาให้ตั้ง proxy ใน vite.config.ts ชี้ไป backend
VITE_API_BASE_URL=/api

# mock = ใช้ข้อมูลจำลองใน src/services/mock/ (ทำงานได้โดยไม่ต้องมี backend)
# live = ยิงไปที่ VITE_API_BASE_URL จริง
#
# วันที่ backend พร้อม: เปลี่ยนบรรทัดนี้เป็น live เท่านั้น
# ไม่ต้องแก้คอมโพเนนต์แม้แต่ไฟล์เดียว
VITE_API_MODE=mock