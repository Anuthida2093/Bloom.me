<file path="src/components/tree/MiniTree.tsx">
import { MBTI_TREE_THEME, type MbtiTreeTheme } from '../../types'
import './MiniTree.css'

interface MiniTreeProps {
  theme?: MbtiTreeTheme
  size?: number
  full?: boolean
  /** เปิด idle animation (หายใจ/ใบไม้ไหวเบาๆ) — ปิดได้ถ้าต้องโชว์หลายสิบต้นพร้อมกันแล้วกลัวหนักเครื่อง */
  animated?: boolean
}

export default function MiniTree({ theme = MBTI_TREE_THEME.INFP, size = 80, full = false, animated = true }: MiniTreeProps) {
  const s = size;
  const h = full ? s * 1.3 : s;
  const cx = s / 2;

  const r1 = s * 0.36;
  const r2 = s * 0.28;
  const r3 = s * 0.22;

  const trunkW = s * 0.12;
  const trunkH = s * 0.28;
  const ty = h * 0.55;

  // จุดหมุน/สเกลของทรงพุ่ม (crown) — ใช้พิกัด px จริงแทนคำว่า "center" เพราะ
  // transform-origin แบบเปอร์เซ็นต์บน SVG element มีพฤติกรรมไม่ตรงกันระหว่างเบราว์เซอร์
  // เก่าๆ (ต้องพึ่ง transform-box: fill-box เพิ่ม) พิกัด px ตรงๆ ชัวร์กว่าและเข้าใจง่ายกว่า
  const crownOriginX = cx;
  const crownOriginY = ty - r1 * 0.6;

  return (
    // wrapper div ทำหน้าที่ "หายใจ" (scale ทั้งต้นเบาๆ) — แยกจาก <g> ใน SVG ที่ทำหน้าที่
    // "ใบไม้ไหว" (rotate เฉพาะทรงพุ่ม) เพื่อให้ 2 แอนิเมชันซ้อนกันแบบเป็นธรรมชาติ ไม่ล็อกจังหวะเดียวกัน
    <div className={`mini-tree-wrap ${animated ? 'mini-tree-wrap--breathing' : ''}`} style={{ width: s, height: h }}>
      <svg
        viewBox={`0 0 ${s} ${h}`}
        width={s}
        height={h}
        xmlns="http://www.w3.org/2000/svg"
      >
        <radialGradient
          id={`lg${s}`}
          cx="40%"
          cy="35%"
          r="60%"
        >
          <stop
            offset="0%"
            stopColor={
              theme.leaves[2] ?? theme.leaves[0]
            }
            stopOpacity="1"
          />
        </radialGradient>

        {/* Shadow */}
        <ellipse
          cx={cx}
          cy={h - 4}
          rx={s * 0.3}
          ry={4}
          fill="var(--glass-b-12)"
        />

        {/* Pot */}
        {full && (
          <>
            <path
              d={`
                M${cx - s * 0.18} ${ty + trunkH * 0.4}
                Q${cx - s * 0.22} ${ty + trunkH * 0.8}
                ${cx} ${ty + trunkH * 0.9}
                Q${cx + s * 0.22} ${ty + trunkH * 0.8}
                ${cx + s * 0.18} ${ty + trunkH * 0.4}
                Z
              `}
              fill={theme.pot}
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill={theme.pot}
              opacity=".8"
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill="var(--glass-b-15)"
            />
          </>
        )}

        {/* Trunk — ไม่ขยับ (ลำต้นควรนิ่ง มีแต่ทรงพุ่มที่ไหว) */}
        <rect
          x={cx - trunkW / 2}
          y={ty - trunkH * 0.1}
          width={trunkW}
          height={trunkH}
          rx={trunkW / 2}
          fill={theme.trunk}
        />

        {/* Trunk highlight */}
        <rect
          x={cx - trunkW * 0.2}
          y={ty}
          width={trunkW * 0.3}
          height={trunkH * 0.7}
          rx={trunkW * 0.15}
          fill="var(--glass-w-22)"
        />

        {/* ── ทรงพุ่ม (ใบ+ดอก) ทั้งหมดอยู่ใน <g> เดียว ให้ไหวไปด้วยกันเป็นก้อนเดียว ── */}
        <g
          className={animated ? 'mini-tree__crown mini-tree__crown--swaying' : 'mini-tree__crown'}
          style={{ transformOrigin: `${crownOriginX}px ${crownOriginY}px` }}
        >
          {/* Leaves — layered circles for depth */}
          <circle
            cx={cx}
            cy={ty - r1 * 0.6}
            r={r1}
            fill={`url(#lg${s})`}
          />

          <circle
            cx={cx - r2 * 0.5}
            cy={ty - r1 * 0.2}
            r={r2}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".9"
          />

          <circle
            cx={cx + r2 * 0.5}
            cy={ty - r1 * 0.25}
            r={r2 * 0.85}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".85"
          />

          {/* Crown highlight */}
          <circle
            cx={cx - r3 * 0.3}
            cy={ty - r1 * 0.8}
            r={r3 * 0.7}
            fill={theme.leaves[2] ?? theme.leaves[0]}
            opacity=".55"
          />

          <circle
            cx={cx - r3 * 0.4}
            cy={ty - r1 * 0.85}
            r={r3 * 0.35}
            fill="var(--glass-w-30)"
          />

          {/* Flowers */}
          {theme.flowers.slice(0, 3).map((fc, i) => {
            const fx =
              cx + [-r1 * 0.4, r1 * 0.3, r1 * 0.05][i];

            const fy =
              ty - r1 * [0.95, 0.75, 1.15][i];

            return (
              <g key={i}>
                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.055}
                  fill={fc}
                />

                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.025}
                  fill="var(--glass-w-70)"
                />
              </g>
            );
          })}
        </g>
      </svg>
    </div>
  );
}
</file>

<file path="src/components/tree/TreeOfLife.css">
.tree-of-life {
  position: relative;
  width: 100%;
  height: 100%;
}

/* [ใหม่] containment — บอกเบราว์เซอร์ว่าการเปลี่ยนแปลงข้างในเลเยอร์นี้
   ไม่กระทบ layout ของส่วนอื่นในหน้า ทำให้ข้ามการคำนวณส่วนที่เหลือได้ทั้งหมด
   สำคัญมากกับเลเยอร์ที่มีลูกหลายสิบตัว animate พร้อมกันแบบนี้ */
.tree-of-life__stack {
  contain: layout paint;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ทั้ง 3 layer วางซ้อนเต็มพื้นที่เดียวกันแบบ absolute — ลำดับ z-index กำหนดที่ inline
   style (zIndex prop ของ TreeLayer) ตามลำดับภาพจริง: หญ้า(1) < ลำต้น(2) < ใบ/ดอก(3) */
.tree-of-life__layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center bottom;
  pointer-events: none;
  user-select: none;

  /* [ข้อกำหนดข้อ 5] แอนิเมชันตอน level เปลี่ยน — เล่นทุกครั้งที่ <img> ถูก remount
     ใหม่ (จาก key={url} ใน TreeOfLife.tsx) ทำให้ดูเหมือนต้นไม้ "โตขึ้น" แบบนุ่มนวล */
  animation: treeOfLifeLayerGrow 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes treeOfLifeLayerGrow {
  from {
    opacity: 0;
    transform: scale(0.86);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.tree-of-life__layer--placeholder {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8%;
  font-size: clamp(24px, 8vw, 48px);
  opacity: 0.4;
}

/* container เต็มพื้นที่ที่ "ปั๊ม" ใบ/ดอกลงไป — ตัว container เองไม่มีขนาด/รูปร่างอะไร
   เป็นแค่กรอบอ้างอิง % สำหรับ .tree-of-life__stamp แต่ละจุดข้างใน */
.tree-of-life__foliage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* จุด "ปั๊ม" เดี่ยวๆ (ใบหรือดอก 1 คลัสเตอร์เล็ก) — ตำแหน่ง (left/top), ขนาด (width),
   และมุมหมุน (rotate) ทั้งหมดคำนวณมาจาก TreeOfLife.tsx (generateFoliageStamps) แล้ว
   ส่งมาเป็น inline style ทีละจุด คลาสนี้จึงกำหนดแค่พฤติกรรมร่วมของทุกจุด */
.tree-of-life__stamp {
  position: absolute;
  height: auto;
  object-fit: contain;
  pointer-events: none;
  user-select: none;
  transform-origin: center center;

  /* เล่นแอนิเมชัน "โผล่ขึ้นมา" เดียวกับ layer หลัก แต่ตัว key ของแต่ละจุดผูกกับ level
     อยู่แล้ว (ดู generateFoliageStamps ใน .tsx) เวลา level เปลี่ยน ทุกจุดจะถูก remount
     ใหม่หมดพร้อมกัน ดูเหมือนพุ่มทั้งต้น "แตกใบใหม่" เป็นชุดเดียวกัน ไม่ใช่โผล่ทีละใบ */
  animation: treeOfLifeLayerGrow 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.tree-of-life__stamp--flower {
  filter: drop-shadow(0 1px 3px var(--glass-b-18));
}

/* ไอเทมตกแต่งที่สวมใส่อยู่ (จาก InventoryModal) */
.tree-of-life__decorations {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}

.tree-of-life__decoration-item {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: clamp(20px, 6vw, 34px);
  filter: drop-shadow(0 3px 6px var(--glass-b-30));
  animation: treeOfLifeDecorationPop 0.5s cubic-bezier(0.2, 0.8, 0.4, 1) both;
}

@keyframes treeOfLifeDecorationPop {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.15);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

/* Hotspot โชว์ tooltip เลเวล — วางไว้แถวโคนต้น (ล่างกึ่งกลาง) */
.tree-of-life__hint-hotspot {
  position: absolute;
  left: 50%;
  bottom: 2%;
  transform: translateX(-50%);
  width: 38%;
  height: 10%;
  min-width: 90px;
  min-height: 36px;
  cursor: pointer;
  z-index: 6;
}

.tree-of-life__tooltip {
  position: absolute;
  bottom: 110%;
  left: 50%;
  transform: translateX(-50%);
  --lc-bg-20: rgba(20, 30, 25, 0.88);
  background: var(--lc-bg-20);
  color: var(--fixed-white);
  border-radius: 12px;
  padding: 10px 14px;
  font-size: 11.5px;
  font-family: 'Nunito', 'Sarabun', sans-serif;
  white-space: nowrap;
  box-shadow: 0 6px 18px var(--glass-b-35);
  display: flex;
  flex-direction: column;
  gap: 4px;
  animation: treeOfLifeTooltipIn 0.18s ease both;
}

@keyframes treeOfLifeTooltipIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.tree-of-life__tooltip-title {
  font-weight: 800;
  margin-bottom: 2px;
}

.tree-of-life__tooltip-warn {
  --lc-text-19: #ffd6a0;
  color: var(--lc-text-19);
  font-weight: 700;
}

/* ═══════════════════════════════════════════════════════════════
   GroundScene — หญ้า/ดอกไม้แบบมีมิติ [ข้อกำหนดข้อ 4]
   ═══════════════════════════════════════════════════════════════ */
.ground-scene {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2%;
  height: 18%;
  z-index: 1; /* เท่ากับ/ทับเบาๆ บนภาพพื้นหญ้า (grass layer z-index 1) */
  pointer-events: none;
}

.ground-scene__blade {
  position: absolute;
  bottom: 0;
  width: 10px;
  transform-origin: bottom center;
  animation-name: groundSceneSway;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  filter: drop-shadow(0 1px 1px var(--glass-b-12));
}

@keyframes groundSceneSway {
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}

.ground-scene__flower {
  position: absolute;
  bottom: 2%;
  width: 16px;
  height: 16px;
  animation: groundSceneFlowerPop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both,
    groundSceneFlowerBob 3s ease-in-out infinite;
  filter: drop-shadow(0 2px 3px var(--glass-b-15));
}

@keyframes groundSceneFlowerPop {
