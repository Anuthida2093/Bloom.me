  justify-content: center;
  align-items: center;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
}

.camera-shutter-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.6);
}

.camera-shutter-btn {
