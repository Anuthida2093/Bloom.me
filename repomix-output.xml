<file path="src/components/ui/Surface.tsx">
import type { CSSProperties, ReactNode } from 'react'
import './ui.css'

/*============================================================================*\
  Surface — [ไฟล์ใหม่] พื้นผิวลอยมาตรฐานของทั้งแอป
  ────────────────────────────────────────────────────────────────────────────
  เดิมแต่ละไฟล์เขียนพื้นผิวของตัวเอง: บางที่ใช้คลาส .card, บางที่ .glass,
  บางที่เขียน background/backdrop-filter/border เป็น inline style สดๆ
  ผลคือความโปร่ง เงา และความมนของขอบ ไม่ตรงกันสักหน้า

  variant:
    chrome  — โลก UI สว่าง (NavBar, ร้านค้า, ตั้งค่า, leaderboard)
    glass   — chrome แบบโปร่งลอยเหนือพื้นหลัง (แผงลอยข้างจอบน Dashboard)
    aether  — โลกฉากเวทมนตร์ (กรอบเขียว, ไพ่ทิพย์, แดชบอร์ดสุขภาพใจ)
    rune    — aether ที่มีขอบเรืองแสง ใช้เน้นจุดเดียวในหน้า ห้ามใช้พร่ำเพรื่อ
\*============================================================================*/

export type SurfaceVariant = 'chrome' | 'glass' | 'aether' | 'rune'
export type SurfaceRadius = 'sm' | 'md' | 'lg' | 'xl' | 'pill'

interface SurfaceProps {
  children: ReactNode
  variant?: SurfaceVariant
  radius?: SurfaceRadius
  /** ระยะขอบใน (padding) — 0 = ไม่ใส่ padding ให้เลย จัดการเอง */
  pad?: 0 | 'sm' | 'md' | 'lg'
  glow?: boolean
  className?: string
  style?: CSSProperties
  as?: 'div' | 'section' | 'article' | 'aside'
}

export default function Surface({
  children,
  variant = 'chrome',
  radius = 'lg',
  pad = 'md',
  glow = false,
  className = '',
  style,
  as: Tag = 'div',
}: SurfaceProps) {
  const classes = [
    'ui-surface',
    `ui-surface--${variant}`,
    `ui-surface--r-${radius}`,
    pad !== 0 ? `ui-surface--pad-${pad}` : '',
    glow ? 'ui-surface--glow' : '',
    className,
  ].filter(Boolean).join(' ')

  return <Tag className={classes} style={style}>{children}</Tag>
}
</file>

<file path="src/components/ui/ui.css">
/*============================================================================*\
  ui.css — [ไฟล์ใหม่] สไตล์ของชั้น primitive ทั้งหมด
  ใช้โทเคนจาก index.css ล้วน ไม่มีสีดิบสักตัวเดียวในไฟล์นี้
\*============================================================================*/

/* ═══ Surface ═══ */
.ui-surface { position: relative; }

.ui-surface--r-sm   { border-radius: var(--r-sm); }
.ui-surface--r-md   { border-radius: var(--r-md); }
.ui-surface--r-lg   { border-radius: var(--r-lg); }
.ui-surface--r-xl   { border-radius: var(--r-xl); }
.ui-surface--r-pill { border-radius: var(--r-pill); }

.ui-surface--pad-sm { padding: 12px; }
.ui-surface--pad-md { padding: 16px; }
.ui-surface--pad-lg { padding: 24px; }

.ui-surface--chrome {
  background: var(--bg-card);
  border: 1px solid var(--border);
  box-shadow: var(--sh-card);
  color: var(--text);
}

.ui-surface--glass {
  background: var(--glass-w-72);
  backdrop-filter: blur(14px) saturate(1.1);
  -webkit-backdrop-filter: blur(14px) saturate(1.1);
  border: 1px solid var(--border);
  box-shadow: var(--sh-card);
  color: var(--text);
}
[data-theme="dark"] .ui-surface--glass {
  --lc-bg-4: rgba(25, 42, 30, .82);
  background: var(--lc-bg-4);
}

.ui-surface--aether {
  background: var(--ae-surface);
  backdrop-filter: var(--ae-blur);
  -webkit-backdrop-filter: var(--ae-blur);
  border: 1px solid var(--glass-w-9);
  color: var(--ae-text);
}

.ui-surface--rune {
  background: var(--ae-surface);
  backdrop-filter: var(--ae-blur);
  -webkit-backdrop-filter: var(--ae-blur);
  border: 1px solid var(--ae-surface-edge);
  color: var(--ae-text);
  box-shadow: var(--ae-glow-sm);
}

.ui-surface--glow { box-shadow: var(--ae-glow-md); }

/* ═══ Button ═══ */
.ui-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  border: 1px solid transparent;
  border-radius: var(--r-pill);
  font-family: var(--font-body);
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-out-soft),
              background var(--dur-fast) ease,
              border-color var(--dur-fast) ease,
              box-shadow var(--dur-fast) ease,
              opacity var(--dur-fast) ease;
  /* transform เป็น property เดียวที่ animate — composited ล้วน ไม่ทำให้ layout คำนวณใหม่ */
  will-change: transform;
}
.ui-btn:active:not(:disabled) { transform: scale(.96); }
.ui-btn:disabled { opacity: .45; cursor: not-allowed; }
.ui-btn__leading { display: inline-flex; align-items: center; }

.ui-btn--sm { padding: 7px 14px; font-size: var(--fs-xs); }
.ui-btn--md { padding: 10px 18px; font-size: var(--fs-sm); }
.ui-btn--lg { padding: 14px 26px; font-size: var(--fs-md); }
.ui-btn--block { width: 100%; }

.ui-btn--primary {
  background: linear-gradient(135deg, var(--g600), var(--g700));
  color: var(--fixed-white);
  box-shadow: var(--sh-btn);
}
.ui-btn--primary:hover:not(:disabled) { filter: brightness(1.07); }

.ui-btn--soft {
  background: var(--g50);
  color: var(--g700);
  border-color: var(--border);
}
.ui-btn--soft:hover:not(:disabled) { background: var(--g100); }

.ui-btn--ghost {
  background: transparent;
  color: var(--text-sub);
  border-color: var(--border-mid);
}
.ui-btn--ghost:hover:not(:disabled) { background: var(--n100); color: var(--text); }

.ui-btn--rune {
  --lc-bg-3: rgba(98, 217, 192, .12);
  background: var(--lc-bg-3);
  color: var(--ae-glow);
  border-color: var(--ae-surface-edge);
}
.ui-btn--rune:hover:not(:disabled) {
  --lc-bg-2: rgba(98, 217, 192, .2);
  background: var(--lc-bg-2);
  box-shadow: var(--ae-glow-sm);
}

.ui-btn--danger {
  background: var(--risk-high);
  color: var(--fixed-white);
}
.ui-btn--danger:hover:not(:disabled) { filter: brightness(1.06); }

/* ═══ Overlay ═══ */
.ui-overlay {
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
  background: var(--bg-modal);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
}
.ui-overlay--screen { position: fixed; inset: 0; z-index: 700; }
/* ครอบเฉพาะพาเรนต์ที่เป็น position:relative — ป๊อปอัพในกรอบเขียวใช้ตัวนี้ */
.ui-overlay--parent { position: absolute; inset: 0; z-index: 800; }

.ui-overlay__panel {
  max-width: 100%;
  max-height: 100%;
  overflow-y: auto;
  outline: none;
}

/* ═══ SceneFrame ═══ */
.ui-scene-frame {
  position: relative;   /* containing block ของป๊อปอัพลูกทุกตัว — ห้ามลบบรรทัดนี้ */
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.ui-scene-frame--forest {
  background: linear-gradient(160deg, var(--g700) 0%, var(--g800) 60%, var(--g900) 100%);
}
.ui-scene-frame--dusk {
  --lc-bg-1: rgba(98, 217, 192, .14);
  background: radial-gradient(120% 80% at 50% 0%, var(--lc-bg-1), transparent 62%),
    linear-gradient(180deg, var(--ae-deep) 0%, var(--ae-void) 100%);
}

@media (max-width: 640px) {
  .ui-overlay { padding: 12px; }
  .ui-surface--pad-lg { padding: 16px; }
}
</file>

