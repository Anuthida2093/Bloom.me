import { useQuery } from '@tanstack/react-query'
import { getProgression, getStepHistory, type ProgressionSummary, type StepDayRecord } from '../services/api/progression.api'
import { queryKeys } from '../services/queryKeys'
import { useUser } from '../context/UserContext'

const EMPTY: ProgressionSummary = {
  exchangeCards: {}, doubleRewardActive: false, doubleRewardUntil: null, doubleCards: 0, goalStreakDays: 0, specialDust: 0,
}

/** การ์ดแลกซื้อ / บัฟคูณสอง / สตรีคเดินครบเป้า — ร้านค้า คลังไอเทม และเควสใช้ข้อมูลชุดเดียวกัน
 *  เปลี่ยนค่าแล้วเรียก invalidateQueries({ queryKey: queryKeys.progression }) ให้ทุกจุดอัปเดต */
export function useProgression(): ProgressionSummary & { isLoading: boolean } {
  const { isLoggedIn } = useUser()
  const { data, isLoading } = useQuery({
    queryKey: [...queryKeys.progression],
    queryFn: getProgression,
    enabled: isLoggedIn,
    staleTime: 15_000,
    retry: false,
  })
  return { ...(data ?? EMPTY), isLoading }
}

/** ประวัติก้าวรายวัน (ใหม่สุดก่อน) — โชว์สถานะสำเร็จ + เปิดแผนที่ของวันนั้น */
export function useStepHistory(): StepDayRecord[] {
  const { isLoggedIn } = useUser()
  const { data } = useQuery({
    queryKey: [...queryKeys.progression, 'step-days'],
    queryFn: getStepHistory,
    enabled: isLoggedIn,
    staleTime: 15_000,
    retry: false,
  })
  return data ?? []
}
</file>

<file path="src/hooks/useStepChest.ts">
import { useCallback, useEffect, useRef, useState } from 'react'
import { useQueryClient } from '@tanstack/react-query'
import type { StepChestReward } from '../config/stepChest'
import { getStepHistory, openStepChest } from '../services/api/progression.api'
import { queryKeys } from '../services/queryKeys'
import { API_MODE } from '../services/http'
import { useAppContext } from '../context/AppContext'
import { markNewWaterDrop } from '../utils/waterPrompt'

/*============================================================================*\
  useStepChest — หีบสมบัติของวันที่เดินถึงเป้า (1 ใบ/วัน) ผูกกับ "วันที่ของทริป"
  ────────────────────────────────────────────────────────────────────────────
  - โหลดสถานะจากเซิร์ฟเวอร์ (getStepHistory → chest) ว่าเปิดไปแล้วหรือยัง
  - open(): ป็อปอัปขึ้นทันที (popupOpen) แล้วค่อยรอผลจากเซิร์ฟเวอร์ — ผลสุ่ม/การให้รางวัลทำที่เซิร์ฟเวอร์
    หยดน้ำ: โหมด live เซิร์ฟเวอร์บวกให้เอง → รีเฟรช user จากเซิร์ฟเวอร์ · โหมด mock บวกผ่าน updateProfile
    เมื่อเปิดครั้งแรก (!alreadyOpened) เหมือนเดิม
  - beforeOpen: ให้ผู้เรียกยืนยันก้าวของวันนั้นเข้าบัญชีก่อน (กันกรณีเซิร์ฟเวอร์ยังไม่เห็นว่าถึงเป้า)
\*============================================================================*/

export function useStepChest(date: string | null, eligible: boolean, beforeOpen?: () => Promise<unknown>) {
  const queryClient = useQueryClient()
  const { userData, updateProfile } = useAppContext()
  /** undefined = ยังโหลดไม่เสร็จ · null = ยังไม่เปิด · reward = เปิดแล้ว */
  const [opened, setOpened] = useState<StepChestReward | null | undefined>(undefined)
  const [loadedFor, setLoadedFor] = useState<string | null>(null)
  const [popupOpen, setPopupOpen] = useState(false)
  const [popupReward, setPopupReward] = useState<StepChestReward | null>(null)
  const [error, setError] = useState<string | null>(null)
  const busy = useRef(false)

  useEffect(() => {
    if (!date || !eligible) return
    let cancelled = false
    getStepHistory()
      .then((list) => { if (!cancelled) { setOpened(list.find((d) => d.date === date)?.chest ?? null); setLoadedFor(date) } })
      // โหลดไม่ได้ → แสดงหีบไว้ก่อน (เปิดซ้ำเซิร์ฟเวอร์คืนผลเดิม ไม่ได้รางวัลซ้ำ)
      .catch(() => { if (!cancelled) { setOpened(null); setLoadedFor(date) } })
    return () => { cancelled = true }
  }, [date, eligible])

  const loaded = !eligible || (!!date && loadedFor === date)
  /** มีหีบรอเปิดอยู่ */
  const ready = eligible && loaded && opened === null

  const open = useCallback(async () => {
    if (!date || busy.current) return
    busy.current = true
    setError(null)
    setPopupReward(null)
    setPopupOpen(true)
    try {
      await beforeOpen?.().catch(() => { /* เซิร์ฟเวอร์ตัดสินเองว่าถึงเป้าหรือยัง */ })
      const res = await openStepChest(date)
      if (!res.alreadyOpened && res.reward.kind === 'WATER_DROPS') {
        if (API_MODE === 'mock') updateProfile({ waterDrops: (userData.waterDrops ?? 0) + res.reward.amount })
        else markNewWaterDrop(userData.id) // หน้า Home เล่นบัวรดน้ำ — ยอดจริงมากับ GET /users/me ด้านล่าง
      }
      setOpened(res.reward)
      setPopupReward(res.reward)
      void queryClient.invalidateQueries({ queryKey: queryKeys.me })
      void queryClient.invalidateQueries({ queryKey: queryKeys.progression })
    } catch {
      setError('เปิดหีบไม่สำเร็จ ตรวจสอบอินเทอร์เน็ตแล้วลองอีกครั้ง')
    } finally {
      busy.current = false
    }
  }, [date, beforeOpen, updateProfile, userData.waterDrops, userData.id, queryClient])

  const closePopup = useCallback(() => { setPopupOpen(false); setError(null) }, [])

  return {
    loaded, ready, opened: opened ?? null,
    popupOpen, popupReward, error, open, closePopup,
  }
}
</file>

<file path="src/hooks/useStepSettlement.ts">
import { useEffect, useRef } from 'react'
import { useQueryClient } from '@tanstack/react-query'
import { useAppContext } from '../context/AppContext'
import { settlePreviousStepDay } from '../services/stepSettlement'
import { queryKeys } from '../services/queryKeys'
import { API_MODE } from '../services/http'
import { markNewWaterDrop } from '../utils/waterPrompt'

/*============================================================================*\
  useStepSettlement — เรียกปิดรอบเควสก้าวของวันก่อนหน้า (services/stepSettlement.ts) ตอนเปิดแอป
  และทุกครั้งที่กลับมาที่แอป (แท็บ/แอปกลับมาแสดง) — เปิดค้างข้ามเที่ยงคืนก็ปิดรอบได้โดยไม่ต้องรีเฟรช
\*============================================================================*/

export function useStepSettlement(enabled: boolean) {
  const { userData, updateProfile } = useAppContext()
  const queryClient = useQueryClient()
  // ค่าล่าสุดสำหรับงาน async (หยดน้ำต้องบวกจากยอดปัจจุบัน ไม่ใช่ยอดตอนเริ่ม)
  const latest = useRef({ userData, updateProfile })
  useEffect(() => { latest.current = { userData, updateProfile } })

  const userId = userData.id
  const bmi = userData.bmi ?? 0

  useEffect(() => {
    if (!enabled || !userId || bmi <= 0) return
    let cancelled = false
    const settle = () => {
      settlePreviousStepDay({
        userId, bmi,
        addWaterDrops: (n) => {
          const { userData: u, updateProfile: update } = latest.current
          update({ waterDrops: (u.waterDrops ?? 0) + n })
        },
      })
        .then((record) => {
          if (!record || cancelled) return
          // โหมด live หยดน้ำ (จากหีบ) เซิร์ฟเวอร์บวกให้แล้ว — ยอดจริงมากับการรีเฟรช me ด้านล่าง
          if (API_MODE === 'live' && record.waterDrops > 0) markNewWaterDrop(userId)
          void queryClient.invalidateQueries({ queryKey: queryKeys.questLogs() })
          void queryClient.invalidateQueries({ queryKey: queryKeys.me })
          void queryClient.invalidateQueries({ queryKey: queryKeys.progression })
        })
        .catch(() => { /* ทริปยังค้างเป็น pending — ลองใหม่รอบหน้า */ })
    }
    settle()
    const onVisible = () => { if (document.visibilityState === 'visible') settle() }
    document.addEventListener('visibilitychange', onVisible)
    return () => { cancelled = true; document.removeEventListener('visibilitychange', onVisible) }
  }, [enabled, userId, bmi, queryClient])
}
</file>

<file path="src/hooks/useStepTracker.ts">
import { useCallback, useState } from 'react'
import { Capacitor } from '@capacitor/core'
import { HealthFitness } from '@capacitor/health-fitness'
import type { StepReading } from '../services/stepTracking'

/*============================================================================*\
  useStepTracker.ts — [ไฟล์ใหม่ — เฟส 3] อ่านก้าวเดินจริงจาก Health Connect (Android) /
  Apple HealthKit (iOS) ผ่าน @capacitor/health-fitness — ใช้ได้เฉพาะตอนรันเป็นแอป native
  ผ่าน Capacitor เท่านั้น (Capacitor.isNativePlatform() === false เสมอตอนรันบนเว็บเบราว์เซอร์
  ปกติ ณ localhost/production เว็บ — ฟังก์ชันในไฟล์นี้จะไม่ถูกเรียกเลยในกรณีนั้น ปล่อยให้ฝั่งที่
  เรียกใช้ (StepJourneyGame.tsx) ตกไปที่ DeviceMotion/กรอกมือเดิมตามลำดับ fallback)
  ────────────────────────────────────────────────────────────────────────────
  [สำคัญ — อ่านจาก .d.ts จริงของแพ็กเกจที่ลงไปจริง ไม่ใช่เดา] API ของปลั๊กอินนี้ไม่มี
  requestAuthorization({ read: [...] }) หรือ aggregate function ตรงๆ แบบที่มักเดากันแบบง่ายๆ
  — ของจริงคือ requestHealthPermissions() รับ object ที่ทุกฟิลด์เป็น "JSON-encoded string"
  ซ้อนอีกชั้น (ดู node_modules/@capacitor/health-fitness/dist/esm/definitions.d.ts และ
  README.md หัวข้อ "Requesting permissions"/"Querying data" ของแพ็กเกจที่ลงจริง) และ getData()
  เป็น "advanced query" ทั่วไปที่ต้องประกอบ query blob เอง ไม่มี endpoint เฉพาะสำหรับ "ก้าววันนี้"

  [ข้อจำกัดที่ต้องรู้ก่อนใช้จริง] รูปแบบ JSON ที่แท้จริงภายใน `results` (ผลลัพธ์ของ getData())
  ไม่ได้ระบุไว้ใน .d.ts/README ของแพ็กเกจเลยเกินกว่าคำว่า "raw result blocks" — โค้ดที่มา
  ประมวลผลจริงอยู่ฝั่ง native (Kotlin/Swift) ผ่าน dependency ที่ compile แล้ว ไม่มี source ให้
  อ่านจากที่นี่ parseStepsFromRawResult() ด้านล่างจึงเป็นการ parse แบบ defensive (ลองหลายชื่อ
  ฟิลด์ที่เป็นไปได้) ต้อง**ทดสอบกับอุปกรณ์จริง**ก่อนเชื่อว่าพาร์สถูก ถ้า parse ไม่ได้จะถือว่า
  "ไม่พร้อมใช้งาน" (คืน null) ไม่ throw ให้แอป crash
\*============================================================================*/

export type NativeHealthPlatform = 'health-connect' | 'healthkit'

interface RawResultBlock {
  Value?: number
  value?: number
  StepCount?: number
  stepCount?: number
  Steps?: number
  steps?: number
  Count?: number
  count?: number
}

/** [ดูคำเตือนหัวไฟล์] พยายามรวมยอดก้าวจาก "raw result blocks" ที่ shape จริงไม่ได้ระบุไว้ที่ไหน
 *  เลย — ลองอ่านหลายชื่อฟิลด์ที่เป็นไปได้ตามชื่อ field อื่นๆ ที่ plugin นี้ใช้จริง (PascalCase
 *  เป็นหลักตามตัวอย่างใน README เช่น Variable/StartDate/EndDate) พร้อม fallback เป็น
 *  camelCase เผื่อ native ฝั่งใดฝั่งหนึ่ง serialize ต่างออกไป — คืน null ถ้าพาร์สไม่ได้เลย
 *  (ไม่เดาว่าเป็น 0 ก้าว เพราะ 0 กับ "อ่านไม่ได้" มีความหมายต่างกันมาก) */
function parseStepsFromRawResult(resultsJson: string | undefined): number | null {
  if (!resultsJson) return null
  let parsed: unknown
  try {
    parsed = JSON.parse(resultsJson)
  } catch {
    return null
  }

  const blocks: RawResultBlock[] = Array.isArray(parsed) ? parsed : [parsed as RawResultBlock]
  let total = 0
  let foundAny = false

  for (const block of blocks) {
    if (!block || typeof block !== 'object') continue
    const value = block.Value ?? block.value ?? block.StepCount ?? block.stepCount
      ?? block.Steps ?? block.steps ?? block.Count ?? block.count
    if (typeof value === 'number' && Number.isFinite(value)) {
      total += value
      foundAny = true
    }
  }

  return foundAny ? Math.round(total) : null
}

/** ช่วง "วันนี้" แบบไม่มีมิลลิวินาที — native date parser ของปลั๊กอินนี้รับเฉพาะรูปแบบ
 *  "yyyy-MM-dd'T'HH:mm:ssZ" เท่านั้น (ระบุไว้ใน README ของแพ็กเกจ) toISOString() ปกติมี
 *  ส่วนมิลลิวินาทีต่อท้ายต้องตัดออกก่อน */
function isoDateNoMillis(d: Date): string {
  return d.toISOString().split('.')[0] + 'Z'
}

function todayRangeIso(): { start: string; end: string } {
  const now = new Date()
  const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate())
  const tomorrow = new Date(startOfDay.getTime() + 24 * 60 * 60 * 1000)
  return { start: isoDateNoMillis(startOfDay), end: isoDateNoMillis(tomorrow) }
}

/** ขอ permission แค่ตัวแปร STEPS อย่างเดียวผ่าน customPermissions (แคบสุดเท่าที่ทำได้ ไม่ขอ
 *  fitnessVariables/allVariables ทั้งกลุ่มซึ่งจะพ่วง CALORIES_BURNED/DISTANCE/WALKING_SPEED
 *  มาโดยไม่จำเป็น) ทุกฟิลด์อื่นต้องส่งไปด้วยเสมอตาม type จริง (RequestHealthPermissionsOptions
 *  ไม่มีฟิลด์ optional เลยสักตัว) จึงตั้ง IsActive: false ให้หมด */
function buildStepsOnlyPermissionRequest() {
  const inactive = JSON.stringify({ IsActive: false, AccessType: 'READ' })
  return {
    customPermissions: JSON.stringify([{ Variable: 'STEPS', AccessType: 'READ' }]),
    allVariables: inactive,
    fitnessVariables: inactive,
    healthVariables: inactive,
    profileVariables: inactive,
    workoutVariables: inactive,
  }
}

export interface UseStepTrackerResult {
  /** true = กำลังรันเป็นแอป native ผ่าน Capacitor (iOS/Android) — เช็คแบบ static ครั้งเดียว
   *  ไม่ได้แปลว่า permission ผ่านแล้ว แค่บอกว่า "มีให้ลองใช้" */
  isNativeHealthAvailable: boolean
  /** 'health-connect' บน Android / 'healthkit' บน iOS / null ถ้าไม่ใช่ native platform —
   *  ให้ฝั่งเรียกใช้ (StepJourneyGame.tsx) ใช้ตัดสินใจ dataSource เริ่มต้นโดยไม่ต้อง import
   *  Capacitor เองซ้ำ */
  nativePlatform: NativeHealthPlatform | null
  isRequesting: boolean
  /** ขอ permission + query ก้าววันนี้ในครั้งเดียว (ต้องเรียกจาก user gesture ตรงๆ เหมือน
   *  Google Fit OAuth/DeviceMotion permission — ดู stepTracking.ts) คืน null = ไม่พร้อมใช้งาน
   *  (ไม่ใช่ native platform / permission ถูกปฏิเสธ / query ล้มเหลว / parse ผลลัพธ์ไม่ได้) —
   *  ไม่ throw ไม่ว่ากรณีไหน ให้ฝั่งเรียกใช้ (StepJourneyGame.tsx) ตกไป fallback ถัดไปเองแทน */
  requestNativeSteps: () => Promise<StepReading | null>
}

export function useStepTracker(): UseStepTrackerResult {
  // [ตามที่ระบุ] เช็ค Capacitor.isNativePlatform() ก่อนเสมอ — ค่าคงที่ตลอดอายุแอป (ไม่เปลี่ยน
  // ระหว่างรัน) จึงใช้ lazy initializer ของ useState อ่านครั้งเดียวตอน mount แทนการเช็คซ้ำทุก
  // ครั้งที่ render (ทำตาม pattern เดียวกับ useMediaQuery.ts — ห้ามอ่านค่า ref.current ระหว่าง
  // render ตาม eslint react-hooks/refs ของโปรเจกต์นี้)
  const [isNative] = useState(() => Capacitor.isNativePlatform())
  const [nativePlatform] = useState<NativeHealthPlatform | null>(() =>
    Capacitor.isNativePlatform() ? (Capacitor.getPlatform() === 'ios' ? 'healthkit' : 'health-connect') : null,
  )
  const [isRequesting, setIsRequesting] = useState(false)

  const requestNativeSteps = useCallback(async (): Promise<StepReading | null> => {
    if (!isNative) return null

    setIsRequesting(true)
    try {
      await HealthFitness.requestHealthPermissions(buildStepsOnlyPermissionRequest())

      const { start, end } = todayRangeIso()
      const { results } = await HealthFitness.getData({
        parameters: JSON.stringify({
          Variable: 'STEPS',
          StartDate: start,
          EndDate: end,
          TimeUnit: 'DAY',
          OperationType: 'SUM',
          TimeUnitLength: 1,
          AdvancedQueryReturnType: 'ALL_DATA',
          AdvancedQueryResultType: 'RAW_DATA',
        }),
      })

      const steps = parseStepsFromRawResult(results)
      if (steps === null || !nativePlatform) return null

      return { steps, source: nativePlatform }
    } catch {
      // [ตามที่ระบุ] permission ถูกปฏิเสธ/ query ล้มเหลว → ไม่ throw ทำแอป crash คืน null
      // เฉยๆ ให้ฝั่งเรียกใช้ตัดสินใจ fallback เอง (ดู describeStepSyncError ใน stepTracking.ts
      // สำหรับข้อความอธิบายให้ผู้ใช้เห็นตอนเรียกจาก StepJourneyGame.tsx)
      return null
    } finally {
      setIsRequesting(false)
    }
  }, [isNative, nativePlatform])

  // [ลบออก] เดิมมี effect ตอน mount ที่ addSteps(ก้าวทั้งวันจาก Health Connect/HealthKit) เข้าทริปตรงๆ
  // — ข้ามเพดานก้าวรายวัน (recordJourneySteps) และนับซ้ำทุกครั้งที่เปิดเควส ชนกับการซิงค์ใน
  // StepJourneyGame.tsx ตอนนี้ StepJourneyGame ซิงค์อัตโนมัติครั้งเดียวตอนเปิดเองผ่านเส้นทางเดียวกับปุ่ม 🔄

  return { isNativeHealthAvailable: isNative, nativePlatform, isRequesting, requestNativeSteps }
}
</file>

