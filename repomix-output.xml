import { useRef, useState } from 'react'
import { motion, type PanInfo } from 'framer-motion'
import { useAppContext } from '../../../context/AppContext'
import { useLockBodyScroll } from '../../../hooks/useLockBodyScroll'
import { useEscapeKey } from '../../../hooks/useEscapeKey'
import { playSfx } from '../../../utils/audioPlayer'
import { MOOD_POTION_COLORS, findMoodColor } from '../../../config/moodPotion'
import type { MoodColorCode } from '../../../types.mental'
import './DailyPotionPage.css'

const C_1 = '#6FCF97'
const C_2 = '#C6F1D6'

/*============================================================================*\
  DailyPotionPage — เควส "ปรุงน้ำยาสำรวจใจ" (Daily Potion Check-in)  [ไฟล์ใหม่]
  ────────────────────────────────────────────────────────────────────────────
  วิธีเล่นตามเอกสาร: ลากขวดยาสีที่ตรงกับความรู้สึกเทลงหม้อ กวนผสมกันเพื่อให้
  หยาดน้ำค้างและแสงแดดตกลงไปรดดอกไม้

  ทฤษฎีรองรับ: Affect Labeling — งานวิจัย "Putting Feelings into Words"
  (Dr. Matthew Lieberman, UCLA) การเรียกชื่ออารมณ์ที่กำลังเกิดขึ้นลดการทำงานของ
  Amygdala และเพิ่มการทำงานของ Prefrontal Cortex ทำให้สงบลงได้ทันที

  [เชื่อมกับระบบคัดกรองจริง] ผลที่ปรุงถูกบันทึกผ่าน submitMoodPotion() ซึ่งจะ:
    1. เขียนลง mood_entries (พร้อม colorCode + logDate — ดู docs/DB_CHANGES.md ข้อ 2)
    2. นับย้อนหลังทันทีว่าสีน้ำเงิน/เทาติดกันกี่วัน
    3. ครบ 3 วัน → ตั้ง pendingScreening แบบ EMERGENCY ให้เด้งแบบประเมินต่อทันที
\*============================================================================*/

interface DailyPotionPageProps {
  onComplete: () => void
  onClose: () => void
}

type Stage = 'pour' | 'intensity' | 'stir' | 'done'

const INTENSITY_LABELS = ['เบามาก', 'เบาๆ', 'ปานกลาง', 'ค่อนข้างมาก', 'ท่วมท้น']

export default function DailyPotionPage({ onComplete, onClose }: DailyPotionPageProps) {
  useLockBodyScroll()
  useEscapeKey(onClose)

  const { settings, submitMoodPotion, consecutiveNegativeDays } = useAppContext()
  const sfxOpts = { volume: settings.sfxVolume, enabled: settings.soundEnabled }

  const [stage, setStage] = useState<Stage>('pour')
  const [picked, setPicked] = useState<MoodColorCode | null>(null)
  const [intensity, setIntensity] = useState(3)
  const [note, setNote] = useState('')
  const [stirring, setStirring] = useState(false)
  const cauldronRef = useRef<HTMLDivElement | null>(null)

  const color = picked ? findMoodColor(picked) : null

  const pour = (code: MoodColorCode) => {
    setPicked(code)
    playSfx('WATER_DROP', sfxOpts)
    window.setTimeout(() => setStage('intensity'), 650)
  }

  /** ปล่อยขวดยาเหนือหม้อ = เทลงหม้อ (ถ้าปล่อยนอกหม้อ ขวดจะเด้งกลับที่เดิมเอง) */
  const handleDragEnd = (code: MoodColorCode, _e: unknown, info: PanInfo) => {
    const box = cauldronRef.current?.getBoundingClientRect()
    if (!box) return
    const { x, y } = info.point
    if (x >= box.left && x <= box.right && y >= box.top && y <= box.bottom) pour(code)
  }

  const stir = () => {
    if (!picked) return
    setStirring(true)
    playSfx('SPARKLE_CHIME', sfxOpts)
    window.setTimeout(() => {
      setStirring(false)
      setStage('done')
    }, 1800)
  }

  const handleSave = () => {
    if (!picked) return
    submitMoodPotion({ colorCode: picked, moodScore: intensity, note: note.trim() || null })
    playSfx('REWARD_CLAIM', sfxOpts)
    onComplete()
    onClose()
  }

  return (
    <div
      className="potion-page"
      style={{ '--potion-color': color?.hex ?? C_1, '--potion-glow': color?.glow ?? C_2 } as React.CSSProperties}
    >
      <div className="potion-page__ambient" aria-hidden="true" />
      <button className="potion-page__close" onClick={onClose} title="ปิด" aria-label="ปิดเควสปรุงน้ำยา">✕</button>

      <div className="potion-page__inner">
        <header className="potion-page__header">
          <h1>ปรุงน้ำยาสำรวจใจ</h1>
          <p>{stage === 'pour' ? 'ลากขวดยาสีที่ตรงกับความรู้สึกวันนี้ ลงไปในหม้อ' : color?.label}</p>
        </header>

        {/* ── หม้อปรุงยา ── */}
        <div className={`potion-cauldron${picked ? ' potion-cauldron--filled' : ''}${stirring ? ' potion-cauldron--stirring' : ''}`} ref={cauldronRef}>
          <div className="potion-cauldron__liquid" style={{ opacity: picked ? 0.35 + intensity * 0.13 : 0 }} />
          <div className="potion-cauldron__rim" />
          <span className="potion-cauldron__emoji">{stirring ? '🥄' : '🍯'}</span>
          {picked && (
            <div className="potion-cauldron__bubbles" aria-hidden="true">
              {Array.from({ length: 6 }).map((_, i) => (
                <span key={i} style={{ left: `${18 + i * 12}%`, animationDelay: `${i * 0.35}s` }} />
              ))}
            </div>
          )}
        </div>

        {/* ── ขั้นที่ 1: เลือก/ลากขวดยา ── */}
        {stage === 'pour' && (
          <div className="potion-bottles">
            {MOOD_POTION_COLORS.map((c) => (
              <motion.button
                key={c.code}
                className="potion-bottle"
                style={{ '--bottle-color': c.hex, '--bottle-glow': c.glow } as React.CSSProperties}
                drag
                dragSnapToOrigin
                dragElastic={0.2}
                whileDrag={{ scale: 1.12, zIndex: 20 }}
                onDragEnd={(e, info) => handleDragEnd(c.code, e, info)}
                onClick={() => pour(c.code)}
                title={`${c.label} — ${c.sublabel}`}
              >
                <span className="potion-bottle__glass"><span className="potion-bottle__liquid" /></span>
                <span className="potion-bottle__label">{c.emoji} {c.label}</span>
                <span className="potion-bottle__sub">{c.sublabel}</span>
              </motion.button>
            ))}
          </div>
        )}

        {/* ── ขั้นที่ 2: ความเข้มของอารมณ์ ── */}
        {stage === 'intensity' && (
          <div className="potion-panel">
            <span className="potion-panel__label">วันนี้รู้สึกแบบนี้เข้มข้นแค่ไหน</span>
            <div className="potion-chips">
              {INTENSITY_LABELS.map((label, i) => (
                <button key={label} className={intensity === i + 1 ? 'is-active' : ''} onClick={() => setIntensity(i + 1)}>
                  {label}
                </button>
              ))}
            </div>
            <textarea
              className="potion-note"
              value={note}
              onChange={(e) => setNote(e.target.value)}
              placeholder="อยากเล่าอะไรเพิ่มไหม (ไม่บังคับ)"
              rows={2}
            />
            <div className="potion-actions">
              <button className="is-ghost" onClick={() => { setPicked(null); setStage('pour') }}>เปลี่ยนสี</button>
              <button className="is-primary" onClick={() => setStage('stir')}>เทเสร็จแล้ว</button>
            </div>
          </div>
        )}

        {/* ── ขั้นที่ 3: กวนหม้อ ── */}
        {stage === 'stir' && (
          <div className="potion-panel potion-panel--center">
            <p>กวนให้เข้ากัน เพื่อให้หยาดน้ำค้างและแสงแดดตกลงไปรดดอกไม้</p>
            <button className="is-primary" onClick={stir} disabled={stirring}>
              {stirring ? 'กำลังกวน...' : 'กวนหม้อ'}
            </button>
          </div>
        )}

        {/* ── ขั้นที่ 4: สรุปผล ── */}
        {stage === 'done' && color && (
          <div className="potion-panel potion-panel--center">
            <div className="potion-result-emoji">{color.emoji}</div>
            <div className="potion-result-title">วันนี้ใจคุณเป็นสี{color.label}</div>
            <p>
              การเรียกชื่อความรู้สึกได้ตรงตัว ช่วยให้สมองส่วนตรรกะกลับมาทำงานแทนสมองส่วนอารมณ์
              — แค่บอกออกมาได้ ก็สงบลงแล้วส่วนหนึ่ง
            </p>

            {color.isNegative && consecutiveNegativeDays >= 1 && (
              <div className="potion-warning">
                คุณรู้สึกแบบนี้ติดกันมา {consecutiveNegativeDays + 1} วันแล้ว
                {consecutiveNegativeDays + 1 >= 3
                  ? ' — หลังจากนี้ระบบจะชวนคุยด้วยคำถามสั้นๆ 5 ข้อ เพื่อดูว่าเราจะช่วยอะไรได้บ้าง'
                  : ' — ถ้าพรุ่งนี้ยังรู้สึกแบบนี้อยู่ ระบบจะชวนทำแบบสำรวจสั้นๆ ให้นะ'}
              </div>
            )}

            <button className="is-primary" onClick={handleSave}>รดดอกไม้ด้วยน้ำยานี้</button>
          </div>
        )}

        <p className="potion-page__theory">
          อ้างอิง Affect Labeling — "Putting Feelings into Words", Dr. Matthew Lieberman (UCLA)
        </p>
      </div>
    </div>
  )
}
</file>

