import type { QuestCategory, QuestControlType } from '../types'

/**
 * questCatalog.ts
 * ────────────────
 * แคตตาล็อกเควสทั้งหมด อ้างอิงเอกสาร "ภาพรวมโปรเจกต์" + เอกสารเควส 3 ไฟล์
 *
 * [แก้รอบนี้ล่าสุด — เก็บกวาดเควสซ้ำซ้อน/ไม่ได้ใช้ตามที่ระบุ]
