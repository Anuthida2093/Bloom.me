.shop-dialog__tier--rare { background: #F5EDFF; color: #7B2FBE; box-shadow: inset 0 0 0 1.5px #b785f5; }

.shop-dialog__hero { width: 168px; height: 168px; object-fit: contain; filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.25)); }
.shop-dialog__emoji { display: inline-flex; align-items: center; justify-content: center; font-size: 128px; line-height: 1; }
