  border: 1.5px solid var(--fixed-white);
}

        /* [ใหม่] ป้าย "เล่นซ้ำได้" มุมล่างซ้ายของตราวงกลม (ตรงข้ามกับเลขลำดับด่านที่มุมขวาบน) */
        .learning-quest-map__node-repeat {
