<file path="src/components/dashboard/Dashboard.css">
/*============================================================================*\
  Dashboard.css — [ไฟล์ใหม่] ย้ายมาจาก <style>{...} ที่เคยฝังอยู่ใน Dashboard.tsx
  ────────────────────────────────────────────────────────────────────────────
  ใช้โทเคนจาก index.css ทั้งหมด ไม่มีสีดิบเหลือในไฟล์นี้
\*============================================================================*/

.dashboard {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;   /* กันแถบ URL ของเบราว์เซอร์มือถือกินพื้นที่ */
  padding-bottom: 90px;
}

/* ── พื้นหลัง ── */
.dashboard__bg-video,
.dashboard__bg-still {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.dashboard__bg-video { object-fit: cover; }
.dashboard__bg-still {
  --lc-bg-7: rgba(98, 217, 192, .10);
  background: radial-gradient(90% 60% at 50% 10%, var(--lc-bg-7), transparent 70%),
    linear-gradient(180deg, var(--ae-deep) 0%, var(--ae-void) 100%);
}

/* ── ต้นไม้ ── */
.dashboard__tree-layer {
  position: fixed;
  inset: 0;
  z-index: 1;
}

/* ── ทูลทิปชวนสุ่มไพ่ทิพย์ ──
   [เปลี่ยนจากเดิม] ตัดอนิเมชันลอยขึ้น-ลงตลอดเวลาออก เหลือแค่ปรากฏขึ้นครั้งเดียว
   การเคลื่อนไหวที่วนไม่จบและไม่ได้เกิดจากการกระทำของผู้ใช้ เป็นสิ่งรบกวนสายตา
   มากกว่าเป็นสิ่งดึงดูด โดยเฉพาะในแอปที่ตั้งใจให้รู้สึกสงบ */
.dashboard__oracle-nudge {
  position: absolute;
  top: 28%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  max-width: min(80vw, 340px);
  padding: 10px 18px;
  border-radius: var(--r-pill);
  border: 1px solid var(--ae-surface-edge);
  background: var(--ae-surface);
  backdrop-filter: var(--ae-blur);
  -webkit-backdrop-filter: var(--ae-blur);
  color: var(--ae-text);
  font-family: var(--font-display);
  font-size: var(--fs-sm);
  line-height: 1.5;
  box-shadow: var(--ae-glow-sm);
  animation: dashboardNudgeIn .5s var(--ease-out-soft) both;
  transition: transform var(--dur-fast) var(--ease-out-soft), box-shadow var(--dur-fast) ease;
}
.dashboard__oracle-nudge:hover { transform: translateX(-50%) scale(1.03); box-shadow: var(--ae-glow-md); }
.dashboard__oracle-nudge:active { transform: translateX(-50%) scale(.97); }

@keyframes dashboardNudgeIn {
  from { opacity: 0; transform: translateX(-50%) translateY(8px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ── แถบนำทาง ── */
.dashboard__navbar { position: relative; z-index: 100; }

/* ── แผงลอยข้างจอ ── */
.dashboard__panel {
  position: fixed;
  top: 95px;
  z-index: 50;
  pointer-events: none;   /* ตัวกรอบไม่รับคลิก จะได้ไม่บังต้นไม้ */
}
.dashboard__panel > * { pointer-events: auto; }

.dashboard__panel--left {
  left: 16px;
  overflow: visible;      /* ห้ามใส่ overflow:hidden — จะบังปุ่มย่อ/ขยาย */
}
.dashboard__panel--right {
  right: 16px;
  max-height: calc(100vh - 160px);
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  --lc-c-6: rgba(45, 106, 79, .25);
  scrollbar-color: var(--lc-c-6) transparent;
}
.dashboard__panel--right::-webkit-scrollbar { width: 4px; }
.dashboard__panel--right::-webkit-scrollbar-track { background: transparent; }
.dashboard__panel--right::-webkit-scrollbar-thumb {
  --lc-bg-5: rgba(45, 106, 79, .25);
  background-color: var(--lc-bg-5);
  border-radius: var(--r-pill);
}

/* ── ชั้นของโมดัล ── */
.dashboard__modal-layer { position: relative; z-index: 500; }

/* ── จอกลาง ── */
@media (max-width: 768px) {
  .dashboard__panel--left  { left: 8px; }
  .dashboard__panel--right { right: 8px; }
}

/* ── มือถือ ──
   [เปลี่ยนจากเดิม] เดิมใช้ transform: scale(.88) ย่อทั้งแผง ซึ่งทำให้ตัวอักษร
   เบลอเล็กน้อยและกล่องรับคลิกเลื่อนไม่ตรงกับสิ่งที่ตาเห็น เปลี่ยนมาย่อด้วย
   font-size + ความกว้างจริงแทน */
@media (max-width: 480px) {
  .dashboard__panel { top: 80px; }
  .dashboard__panel--left,
  .dashboard__panel--right { font-size: var(--fs-xs); max-width: 44vw; }
  .dashboard__panel--right { max-height: calc(100vh - 190px); }
  .dashboard__oracle-nudge { font-size: var(--fs-xs); padding: 8px 14px; }
}
/* ═══════════════════════════════════════════
   [เพิ่มใหม่] HUD กลางจอใต้ Navbar แบบ V1
   ═══════════════════════════════════════════ */
.game-top-hud {
  position: fixed;
  top: 92px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 90;
  width: 95%;
  max-width: 600px;
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  pointer-events: none;
}
.game-top-hud > * { pointer-events: auto; }

.hud-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: var(--r-pill);
  --lc-bg-4: rgba(20, 30, 25, .6);
  background: var(--lc-bg-4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1.5px solid var(--glass-w-20);
  color: var(--fixed-white);
  font-family: var(--font-display);
  font-size: var(--fs-sm);
  box-shadow: var(--sh-card);
}
.hud-icon { font-size: 16px; line-height: 1; }
.hud-bar-container { display: flex; align-items: center; gap: 6px; }
.hud-bar-bg {
  width: 60px; height: 8px; border-radius: var(--r-pill);
  background: var(--glass-b-50); overflow: hidden;
}
.hud-bar-fill { height: 100%; background: linear-gradient(90deg, var(--exp), var(--coin)); border-radius: var(--r-pill); }
.hud-bar-text {
  font-size: var(--fs-xs);
  --lc-text-3: #E2E8F0;
  color: var(--lc-text-3);
  font-family: var(--font-body);
}

@media (max-width: 768px) {
  .game-top-hud { top: 68px; gap: 6px; }
  .hud-pill { padding: 5px 10px; font-size: var(--fs-xs); }
}

/* ═══════════════════════════════════════════
   [เพิ่มใหม่] คลัสเตอร์ปุ่มขวา: Tree Stats / Mood / Sound
   ═══════════════════════════════════════════ */
.dashboard__right-cluster {
  position: fixed;
  top: 95px;
  right: 16px;
  z-index: 60;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.dashboard__right-cluster .dashboard__panel--right {
  position: static;
  top: auto; right: auto;
}

.right-action-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex-shrink: 0;
}

.game-icon-btn {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 3px solid var(--g200);
  box-shadow: var(--sh-card);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  transition: transform var(--dur-fast) var(--ease-spring), border-color var(--dur-fast) ease;
}
.game-icon-btn:hover { transform: scale(1.08); border-color: var(--g500); }
.game-icon-btn:active { transform: scale(.94); }
.game-icon-btn.mood-btn {
  --lc-bg-1: #E0FBFC;
  background: var(--lc-bg-1);
  --lc-border-2: #90E0EF;
  border-color: var(--lc-border-2);
}
.game-icon-btn.sound-btn { background: var(--g100); border-color: var(--g400); }

@media (max-width: 768px) {
  .dashboard__right-cluster { top: 80px; right: 8px; gap: 8px; }
  .game-icon-btn { width: 46px; height: 46px; font-size: 20px; }
}

/* ═══════════════════════════════════════════
   [เพิ่มใหม่] โหมดดูต้นไม้ของผู้เล่นคนอื่น (แทน PlayerDetailModal เดิม)
   ═══════════════════════════════════════════ */
.dashboard__back-btn {
  position: fixed;
  top: 95px;
  left: 16px;
  z-index: 60;
  padding: 10px 18px;
  border-radius: var(--r-pill);
  background: var(--bg-card);
  border: 1.5px solid var(--border-mid);
  box-shadow: var(--sh-card);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--text);
  cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-out-soft);
}
.dashboard__back-btn:hover { transform: translateX(-3px); }

.dashboard__viewing-name-pill {
  position: fixed;
  top: 95px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  padding: 10px 28px;
  border-radius: var(--r-pill);
  background: var(--bg-card);
  border: 1.5px solid var(--g200);
  box-shadow: var(--sh-card);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-md);
  color: var(--g700);
  white-space: nowrap;
}

@media (max-width: 768px) {
  .dashboard__back-btn { top: 80px; left: 8px; padding: 8px 14px; font-size: var(--fs-xs); }
  .dashboard__viewing-name-pill { top: 80px; padding: 8px 18px; font-size: var(--fs-sm); }
}
