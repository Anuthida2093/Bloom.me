/* ═══════════════════════════════════════════════════════════════
   DailyPotionPage.css — เควสปรุงน้ำยาสำรวจใจ
   absolute + inset:0 → อยู่ในกรอบเขียวเท่านั้น
   ═══════════════════════════════════════════════════════════════ */

.potion-page {
  position: absolute;
  inset: 0;
  z-index: 800;
  overflow-y: auto;
  --lc-bg-19: #3B2456;
  --lc-bg-20: #241639;
  --lc-bg-21: #120B1F;
  background: radial-gradient(110% 80% at 50% 0%, var(--lc-bg-19) 0%, var(--lc-bg-20) 48%, var(--lc-bg-21) 100%);
  --lc-text-22: #F0E9FA;
  color: var(--lc-text-22);
  font-family: 'Nunito', 'Mali', sans-serif;
  --lc-c-23: #6FCF97;
  --potion-color: var(--lc-c-23);
  --lc-c-24: #C6F1D6;
  --potion-glow: var(--lc-c-24);
}

.potion-page__ambient {
  position: absolute;
  inset: -20%;
  background: radial-gradient(45% 40% at 50% 55%, var(--potion-glow), transparent 70%);
  opacity: 0.28;
  filter: blur(50px);
  transition: background 1s ease;
  pointer-events: none;
}

.potion-page__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 30;
  width: 36px;
  height: 36px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-16);
  color: var(--fixed-white);
  font-size: 15px;
  cursor: pointer;
}
.potion-page__close:hover { background: var(--glass-w-30); }

.potion-page__inner {
  position: relative;
  z-index: 5;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 46px 20px 28px;
  gap: 16px;
}

.potion-page__header { text-align: center; }
.potion-page__header h1 {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 24px;
  color: var(--fixed-white);
}
.potion-page__header p {
  font-size: 13px;
  --lc-text-18: rgba(240, 233, 250, 0.68);
  color: var(--lc-text-18);
  margin-top: 4px;
}

/* ── หม้อปรุงยา ── */
.potion-cauldron {
  position: relative;
  width: 168px;
  height: 130px;
  border-radius: 14px 14px 84px 84px;
  --lc-bg-16: #2A1B3D;
  --lc-bg-17: #170E26;
  background: linear-gradient(180deg, var(--lc-bg-16), var(--lc-bg-17));
  border: 2px solid var(--glass-w-16);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 18px 44px var(--glass-b-45);
  transition: box-shadow 0.5s ease;
}
.potion-cauldron--filled { box-shadow: 0 18px 44px var(--glass-b-45), 0 0 44px var(--potion-glow); }
.potion-cauldron__liquid {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 68%;
  --lc-bg-15: #000;
  background: linear-gradient(180deg, var(--potion-color), color-mix(in srgb, var(--potion-color) 55%, var(--lc-bg-15)));
  transition: opacity 0.7s ease, background 0.7s ease;
}
.potion-cauldron__rim {
  position: absolute;
  top: 6px;
  left: 8px;
  right: 8px;
  height: 8px;
  border-radius: 99px;
  background: var(--glass-w-14);
}
.potion-cauldron__emoji { position: relative; font-size: 40px; filter: drop-shadow(0 4px 10px var(--glass-b-40)); }
.potion-cauldron--stirring .potion-cauldron__emoji { animation: potionStir 1.1s ease-in-out infinite; }
@keyframes potionStir {
  0%, 100% { transform: translateX(-14px) rotate(-16deg); }
  50%      { transform: translateX(14px) rotate(16deg); }
}

.potion-cauldron__bubbles { position: absolute; inset: 0; pointer-events: none; }
.potion-cauldron__bubbles span {
  position: absolute;
  bottom: 12px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--glass-w-50);
  animation: potionBubble 2.6s ease-in infinite;
}
@keyframes potionBubble {
  0%   { transform: translateY(0) scale(0.5); opacity: 0; }
  25%  { opacity: 0.8; }
  100% { transform: translateY(-70px) scale(1.1); opacity: 0; }
}

/* ── ขวดยา 5 สี ── */
.potion-bottles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
  gap: 10px;
  width: 100%;
  max-width: 520px;
}
.potion-bottle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 14px 10px;
  border-radius: 18px;
  border: 1.5px solid var(--glass-w-16);
  background: var(--glass-w-6);
  --lc-text-12: #F0E9FA;
  color: var(--lc-text-12);
  font-family: inherit;
  cursor: grab;
  touch-action: none;
  transition: background 0.18s ease, border-color 0.18s ease;
  --lc-c-13: #6FCF97;
  --bottle-color: var(--lc-c-13);
  --lc-c-14: #C6F1D6;
  --bottle-glow: var(--lc-c-14);
}
.potion-bottle:hover { background: var(--glass-w-12); border-color: var(--bottle-color); }
.potion-bottle:active { cursor: grabbing; }
.potion-bottle__glass {
  position: relative;
  width: 26px;
  height: 40px;
  border-radius: 6px 6px 12px 12px;
  border: 1.5px solid var(--glass-w-40);
  overflow: hidden;
  margin-bottom: 4px;
}
.potion-bottle__liquid {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 68%;
  background: var(--bottle-color);
  box-shadow: 0 0 16px var(--bottle-glow);
}
.potion-bottle__label { font-size: 12.5px; font-weight: 800; }
.potion-bottle__sub {
  font-size: 10.5px;
  --lc-text-11: rgba(240, 233, 250, 0.55);
  color: var(--lc-text-11);
  text-align: center;
  line-height: 1.5;
}

/* ── แผงขั้นตอน ── */
.potion-panel {
  width: 100%;
  max-width: 460px;
  border-radius: 22px;
  background: var(--glass-w-7);
  border: 1px solid var(--glass-w-14);
  padding: 18px;
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.potion-panel--center { align-items: center; text-align: center; }
.potion-panel p {
  font-size: 13px;
  line-height: 1.8;
  --lc-text-10: rgba(240, 233, 250, 0.82);
  color: var(--lc-text-10);
}
.potion-panel__label {
  font-size: 12px;
  font-weight: 800;
  --lc-text-9: rgba(240, 233, 250, 0.72);
  color: var(--lc-text-9);
}

.potion-chips { display: flex; flex-wrap: wrap; gap: 7px; }
.potion-chips button {
  padding: 8px 13px;
  border-radius: 99px;
  border: 1.5px solid var(--glass-w-20);
  background: var(--glass-w-6);
  --lc-text-8: rgba(240, 233, 250, 0.78);
  color: var(--lc-text-8);
  font-family: inherit;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}
.potion-chips button.is-active {
  background: var(--potion-color);
