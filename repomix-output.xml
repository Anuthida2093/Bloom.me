/* ── ผลคัดกรอง ── */
.mh-dash__screening-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.mh-dash__screening-row strong { font-size: 1.15rem; }
.mh-dash__screening-row span {
  display: block;
  font-size: 0.7rem;
  --lc-text-2: rgba(232,245,238,0.5);
  color: var(--lc-text-2);
}
.mh-dash__screening-risk { font-size: 0.78rem !important; color: var(--risk-accent) !important; font-weight: 600; }

.mh-dash__ghost-btn {
