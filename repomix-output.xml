}
.potion-panel button.is-primary {
  min-width: 200px;
  background: linear-gradient(135deg, var(--fixed-white), var(--potion-glow));
  --lc-text-6: #170E26;
  color: var(--lc-text-6);
  box-shadow: 0 10px 26px var(--glass-b-32);
}
.potion-panel button.is-primary:disabled { opacity: 0.5; cursor: default; }
.potion-actions .is-ghost {
  background: var(--glass-w-8);
  --lc-text-5: rgba(240, 233, 250, 0.8);
  color: var(--lc-text-5);
  border: 1px solid var(--glass-w-20);
