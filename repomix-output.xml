import { useNavigate } from 'react-router-dom'
import { DEFAULT_USER_DATA, type UserData } from '../../types'
import { BADGE_ICONS } from '../../config/iconAssets'
import './NavBar.css'

interface NavBarProps {
  userData?: UserData
  isLoggedIn?: boolean
  isGuest?: boolean
  /** [ใหม่] ย้ายมาจาก ActionMenuBar เดิม (ปุ่ม ⚙️ ในแถบ 5 ปุ่มล่างจอ) — ตอนนี้แถบล่างเหลือ
   *  4 ปุ่ม (Home/เควส/ร้านค้า/โปรไฟล์) เท่านั้น ปุ่มตั้งค่าย้ายมาเป็นวงกลมมุมขวาบนแทน */
  onOpenSettings?: () => void
  /** [แก้ตามที่ระบุ] ปุ่มวงกลมมุมขวาบน (profile-btn) เดิมกด "ครั้งเดียว" ทำหน้าที่ออกจาก
   *  ระบบตรงๆ (เรียก onLogout แล้ว navigate('/')) — ตอนนี้เปลี่ยนหน้าที่เป็นเปิดหน้าตั้งค่า
   *  โปรไฟล์แทน (ปุ่มออกจากระบบยังอยู่ในหน้าตั้งค่าหลักตามเดิม ไม่เกี่ยวกับปุ่มนี้อีกต่อไป
   *  จึงตัด onLogout prop ทิ้งจากไฟล์นี้ทั้งหมด — ไม่มีใครเรียกใช้แล้ว) */
  onOpenProfileSettings?: () => void
}

/**
 * NavBar — กลับไปเรียบง่ายแบบ V1: โลโก้ซ้าย + ปุ่มตั้งค่า/โปรไฟล์ขวา
 * HUD (MBTI/EXP/Coins/Streak) ย้ายไป .game-top-hud ใน Dashboard.tsx
 * คลังไอเทม ย้ายไปอยู่ในหน้าโปรไฟล์ (เปิดผ่าน ActionMenuBar ปุ่ม "โปรไฟล์") แทน
 */
export default function NavBar({
  userData = DEFAULT_USER_DATA,
  isLoggedIn = false,
  isGuest = false,
  onOpenSettings = () => {},
  onOpenProfileSettings = () => {},
}: NavBarProps) {
  const navigate = useNavigate()

  return (
    <nav className="top-navbar">
      <div className="navbar-logo">
        <span>🌱</span>
        <span className="hide-mobile">ARBOR HORIZON</span>
      </div>

      <div className="navbar-right-cluster">
        {(isLoggedIn || isGuest) && (
          <button className="navbar-settings-btn" title="ตั้งค่า" onClick={onOpenSettings}>
            ⚙️
          </button>
        )}

        {/* [แก้ตามที่ระบุ] ปุ่มวงกลมนี้ชื่อ class ว่า profile-btn มาแต่เดิม (ก่อนมีหน้าโปรไฟล์จริง)
            เดิมทำหน้าที่ "ออกจากระบบ" — ตอนนี้เปลี่ยนเป็นเปิดหน้าตั้งค่าโปรไฟล์โดยตรง (ผ่าน
            SettingsModal ที่มี initialSubModal='profile' อยู่แล้วจากงานก่อนหน้า — ดู
            Dashboard.tsx onOpenProfileSettings) ปุ่มออกจากระบบยังอยู่ในหน้าตั้งค่าหลักเหมือนเดิม
            ไม่ได้เปลี่ยนชื่อ class ในรอบนี้เพื่อลด diff ที่ไม่จำเป็น */}
        {/* [แก้ตามที่ระบุ] ปุ่มนี้เคยโชว์ตัวอักษรแรกของชื่อผู้ใช้/🔑 เป็นวงกลม — ตอนนี้ใช้รูป
            profile.png จริงแทนทั้ง 2 สถานะ (ไม่มีไฟล์แยกสำหรับ "กดเพื่อเข้าสู่ระบบ" ในตาราง
            ไอคอนที่มี จึงใช้รูปเดียวกัน แยกความหมายด้วย title/onClick แทน) */}
        {isLoggedIn || isGuest ? (
          <button
            className="profile-btn"
            title="ตั้งค่าโปรไฟล์"
            onClick={onOpenProfileSettings}
          >
            <img src={BADGE_ICONS.profile} alt={userData.username || 'โปรไฟล์'} />
          </button>
        ) : (
          <button className="profile-btn profile-btn--login" title="เข้าสู่ระบบ" onClick={() => navigate('/')}>
            <img src={BADGE_ICONS.profile} alt="เข้าสู่ระบบ" />
          </button>
        )}
      </div>
    </nav>
  )
}
</file>

<file path="src/components/quest/games/GameShell.css">
/* ═══════════════════════════════════════════════════════════════
   GameShell.css — ห้องเล่นเควสเต็มกรอบเขียว
   [กติกาสำคัญ] absolute + inset:0 → ครอบเฉพาะ .gameplay-frame
   (ซึ่งเป็น position:relative) ไม่ทะลุออกนอกกรอบเขียวเด็ดขาด
   ═══════════════════════════════════════════════════════════════ */

.game-shell {
  position: absolute;
  inset: 0;
  z-index: 800;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  --lc-bg-11: #123528;
  --lc-bg-12: #0C2A20;
  --lc-bg-13: #071A14;
  background: linear-gradient(165deg, var(--lc-bg-11) 0%, var(--lc-bg-12) 55%, var(--lc-bg-13) 100%);
  --lc-text-14: #EAF4EE;
  color: var(--lc-text-14);
  font-family: 'Nunito', 'Mali', sans-serif;
  --game-accent: var(--g600);
  --lc-c-15: #D8F3DC;
  --game-accent-bg: var(--lc-c-15);
}

.game-shell__scenery {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(60% 45% at 22% 12%, color-mix(in srgb, var(--game-accent) 40%, transparent), transparent 70%),
    radial-gradient(55% 45% at 82% 88%, color-mix(in srgb, var(--game-accent) 28%, transparent), transparent 72%);
  opacity: 0.55;
  filter: blur(30px);
  pointer-events: none;
}

/* ── หัวเรื่อง ── */
.game-shell__header {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px 12px 58px; /* เว้นซ้าย 58px ให้ปุ่มเต็มจอของ GameplayFrame */
  border-bottom: 1px solid var(--glass-w-10);
}
.game-shell__heading { display: flex; align-items: center; gap: 12px; min-width: 0; }
.game-shell__icon {
  font-size: 30px;
  filter: drop-shadow(0 4px 10px var(--glass-b-35));
  flex-shrink: 0;
}
.game-shell__title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 18px;
  color: var(--fixed-white);
  line-height: 1.25;
}
.game-shell__subtitle {
  font-size: 11px;
  --lc-text-10: rgba(234, 244, 238, 0.55);
  color: var(--lc-text-10);
}
.game-shell__close {
  /* [แก้] มาตรฐานปุ่มปิดทั้งระบบ: วงกลม อย่างน้อย 44x44px (ในนี้วางในแถบหัวด้วย flex
     แทน position:absolute เพราะไฟล์นี้ใช้ header bar อยู่แล้ว ยังอยู่มุมขวาบนของกรอบเควส
     เหมือนเดิม แค่ implementation คนละแบบ ไม่ได้ตั้งใจให้ต่างจากหน้าอื่น) */
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-14);
  color: var(--fixed-white);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, transform 0.18s ease;
}
.game-shell__close:hover { background: var(--glass-w-28); transform: scale(1.08); }
.game-shell__close:focus-visible { outline: 2px solid var(--game-accent); outline-offset: 2px; }

/* ── ปุ่ม pill ลอย (fullscreenGame) — [แก้รอบนี้ — feedback รอบ 2] แทนที่แถบหัวบาง 95px เดิม
   ที่กินพื้นที่ layout เต็มความกว้างจอ — รอบนี้ทำเป็น "ปุ่ม pill ลอยขนาดพอดีตัว" สไตล์เดียวกับ
   ปุ่ม "เควสด้านการเรียนรู้" (.quest-section-title-pill ใน QuestSection.tsx: พื้นหลังโปร่งแสง
   ขอบโค้งมนเต็ม ไอคอนเล็กหน้าข้อความ) ตามที่ระบุ — สีพื้นหลัง/เงาที่นี่ใช้โทนกระจกเข้ม
   (--glass-w-14, เหมือน .game-shell__close ด้านบน) แทน var(--bg-card)/var(--sh-card) ต้นแบบ
   ตรงๆ เพราะต้นแบบเป็นโทเค็นตามธีมสว่าง/มืดของทั้งแอป ส่วน .game-shell พื้นหลังเข้มตายตัวเสมอ
   ไม่ผูกกับธีมแอป (ใช้ var(--bg-card) ตรงๆ จะกลายเป็นสีขาวทึบตอนแอปอยู่โหมดสว่าง ขัดกับพื้นหลัง
   เข้มของ .game-shell) — ปุ่มปิด (✕) แยกเป็นอีกปุ่มต่างหากลอยขวาบน ไม่รวมเข้าไปใน pill เดียวกัน
   (ตามที่ระบุ) ทั้งสองไม่กินพื้นที่ layout เลย (position:absolute ลอยทับ .game-shell__body ที่
   ขยายเต็มความสูงจริงด้านล่างนี้แล้ว) */
.game-shell__pill-header {
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: calc(100% - 120px);
  padding: 8px 18px;
  border-radius: 99px;
  background: var(--glass-w-14);
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
}
.game-shell__pill-icon { font-size: 16px; flex-shrink: 0; }
.game-shell__pill-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 15px;
  color: var(--fixed-white);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-shell__close--floating {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 20;
}

/* ── เนื้อหา ── */
.game-shell__body {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  /* [แก้บั๊ก — เช็คอินรายวันเลื่อนไม่พ้น ActionMenuBar] เดิม padding-bottom ตายตัว 26px น้อยกว่า
     ความสูงจริงของแถบเมนูลอย (~100px/~80px มือถือ, z-index:1000 ลอยทับทุกอย่างเสมอ) ปุ่มยืนยัน
     ล่างสุดของเกมที่เนื้อหายาว (เช่น DailyCheckinGame 5 คำถาม) เลยโดนบังเลื่อนไม่พ้น — ใช้
     --gpf-safe-bottom (โทเคนกลางใน index.css) แบบเดียวกับ SettingsModal.tsx ที่แก้บั๊กเดียวกัน
     ไปแล้ว เพิ่ม padding ที่ "เนื้อหาที่ scroll ได้เอง" ตัวนี้โดยตรง (ไม่ลดขนาด .game-shell
     กล่องนอก ซึ่งจะโชว์พื้นหลังผิดสีที่ขอบล่างแทน เพราะพื้นหลังจริงอยู่ที่ .game-shell เท่านั้น
     — .game-shell__body โปร่งใส ไม่มีสีพื้นหลังของตัวเอง เพิ่ม padding ตรงนี้จึงยังเห็นพื้นหลัง
     ไล่สีเขียวเข้มเดิมถูกต้อง ไม่เกิดบั๊กแถบขาวแบบที่เคยเจอกับ .quest-section-root) */
  padding: 16px 18px calc(var(--gpf-safe-bottom, 100px) + 24px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}
.game-shell__brief {
  width: 100%;
  max-width: 620px;
  border-radius: 16px;
  border: 1px dashed var(--glass-w-22);
  background: var(--glass-w-5);
  padding: 12px 16px;
}
.game-shell__howto {
  font-size: 12.5px;
  line-height: 1.8;
  --lc-text-9: rgba(234, 244, 238, 0.85);
  color: var(--lc-text-9);
}
.game-shell__theory {
  margin-top: 6px;
  font-size: 10.5px;
  --lc-text-8: rgba(234, 244, 238, 0.45);
  color: var(--lc-text-8);
  line-height: 1.6;
}

.game-shell__stage { width: 100%; max-width: 620px; flex: 1; }

/* ── เนื้อหาแบบเต็มจอ (fullscreenGame) — ไม่มี max-width/padding/gap ให้ .game-shell__stage
   เต็มพื้นที่ที่เหลือทั้งหมดจริง (compound selector กันปัญหาลำดับ CSS กับ .game-shell__body
   ปกติด้านบนที่ specificity เท่ากัน) ── */
.game-shell__body.game-shell__body--fullscreen {
  padding: 0;
  gap: 0;
  align-items: stretch;
  /* auto ไม่ใช่ hidden — จอกว้างแผนที่เต็มพอดีไม่มีอะไรเกิน แต่จอแคบ (breakpoint 520px ใน
     StepJourneyGame.css) เนื้อหาเรียงต่อกันแนวตั้งอาจสูงเกิน .game-shell__stage ได้ ต้อง scroll
     ได้แทนที่จะโดนตัดจนกดปุ่มด้านล่างไม่ถึง */
  overflow-y: auto;
}
.game-shell__body--fullscreen .game-shell__stage {
  max-width: none;
  /* min-height ไม่ใช่ height ตายตัว — ปล่อยให้สูงเกิน 100% ได้บนจอแคบที่เนื้อหาเรียงต่อกันแนวตั้ง
     (ดู breakpoint 520px ใน StepJourneyGame.css) แล้วให้ .game-shell__body--fullscreen
     (overflow-y:auto) เป็นคน scroll แทนการตัดเนื้อหาทิ้ง */
  min-height: 100%;
}

/* ── ฉากรับรางวัล ── */
.game-shell__reward {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px 22px;
}
.game-shell__reward-drops { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.game-shell__reward-drops img {
  position: absolute;
  top: -30px;
  width: 18px;
  height: 18px;
  object-fit: contain;
  animation: gameShellDrop 1.6s ease-in both;
}
@keyframes gameShellDrop {
  0%   { transform: translateY(0) rotate(0); opacity: 0; }
  15%  { opacity: 1; }
  100% { transform: translateY(70vh) rotate(220deg); opacity: 0; }
}
.game-shell__reward-icon { font-size: 54px; }
.game-shell__reward-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 24px;
  color: var(--fixed-white);
  margin: 6px 0 4px;
}
.game-shell__reward-text {
  font-size: 13px;
  --lc-text-7: rgba(234, 244, 238, 0.72);
  color: var(--lc-text-7);
  margin-bottom: 22px;
  max-width: 340px;
  line-height: 1.7;
}
.game-shell__reward-cards { display: flex; gap: 12px; margin-bottom: 24px; }
.game-shell__reward-cards div {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 110px;
  padding: 14px 18px;
  border-radius: 18px;
  background: var(--glass-w-10);
  border: 1px solid var(--glass-w-16);
  font-size: 10.5px;
  --lc-text-6: rgba(234, 244, 238, 0.6);
  color: var(--lc-text-6);
  animation: gameShellCardPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.game-shell__reward-cards div:nth-child(2) { animation-delay: 0.12s; }
.game-shell__reward-cards span { font-size: 24px; }
.game-shell__reward-cards strong {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-weight: 400;
  font-size: 20px;
  color: var(--fixed-white);
}
@keyframes gameShellCardPop {
  from { opacity: 0; transform: translateY(12px) scale(0.8); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.game-shell__claim {
  min-width: 220px;
  padding: 15px 28px;
  border: none;
  border-radius: 99px;
  background: linear-gradient(135deg, var(--fixed-white), var(--game-accent-bg));
  --lc-text-5: #0B241B;
  color: var(--lc-text-5);
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 16px;
  cursor: pointer;
  box-shadow: 0 12px 30px var(--glass-b-35);
