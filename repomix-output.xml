.safety-net__contacts { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
.safety-net__contact {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 15px 17px;
  border-radius: 18px;
  border: 1px solid var(--glass-w-15);
  background: var(--glass-w-7);
  text-decoration: none;
  color: inherit;
