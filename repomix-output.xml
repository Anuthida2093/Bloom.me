import { mulberry32 } from '../../../utils/seededRandom'
import type { HomeSceneKind, HomeSceneSpec } from '../../../config/homeScenes'

/*============================================================================*\
  generateHomeScene — ผังฉากพื้นหลังหน้า Home (ฟังก์ชันล้วน ไม่แตะ canvas · seed + ขนาดจอเดิม = ผลเดิมเป๊ะ)
  ────────────────────────────────────────────────────────────────────────────
  หน่วย = CSS px ของจอขนาด w×h · แกน x รวมขอบเผื่อ (over) ซ้าย-ขวาไว้เลื่อนแบบพารัลแลกซ์ (W = w + 2·over)
  ชั้น (หลัง → หน้า): ฟ้า/ดวงอาทิตย์/เมฆ · ภูเขาไกล-ใกล้ · เนินเขา + ต้นไม้ไกล · ของกลางฉาก (หน้าผาน้ำตก / ลำต้น /
  พุ่มรั้ว ซุ้ม) · พื้นทุ่ง · แถวหญ้า (ไกล → ใกล้) · หมอก · กอหญ้าหน้าสุด
  "คอลัมน์ต้นไม้" กลางจอ (35-65% ของความกว้าง) ห้ามมีของคอนทราสต์สูง — boxes ใช้ตรวจในเทสต์
\*============================================================================*/

export type Vec2 = [number, number]

export interface Blade { x: number; y: number; h: number; lean: number; w: number; tone: number }
export interface Flower { x: number; y: number; r: number; color: number; kind: 'dot' | 'daisy' | 'tulip'; stem: number }
export interface GrassRow {
  /** 0 = ไกลสุด → 1 = ใกล้สุด */
  depth: number
  /** ขอบบนของแถบโคนหญ้า / ขอบล่าง (โคนหญ้าทุกต้นอยู่ในช่วงนี้) */
  rootTop: number
  rootBottom: number
  maxH: number
  /** ความแรงการไหว (ใกล้มากกว่าไกล) */
  amp: number
  blades: Blade[]
  flowers: Flower[]
}

export type MidProp =
  | { type: 'cliff'; tiers: { x0: number; x1: number; top: number; bottom: number; bumps: number[] }[] }
  | { type: 'rock'; x: number; y: number; rx: number; ry: number }
  | { type: 'bush'; x: number; y: number; r: number; tone: number }
  | { type: 'trunk'; x: number; top: number; bottom: number; w: number; layer: 0 | 1 | 2; lean: number }
  | { type: 'canopy'; bottom: number; scallops: number[]; holes: { x: number; y: number; r: number }[] }
  | { type: 'log'; x: number; y: number; len: number; r: number }
  | { type: 'mushroom'; x: number; y: number; s: number }
  | { type: 'hedge'; x0: number; x1: number; y: number; h: number; bumps: number[]; tone: number }
  | { type: 'topiary'; x: number; y: number; r: number }
  | { type: 'arch'; x: number; y: number; w: number; h: number }

export interface Falls {
  ribbons: { x: number; yTop: number; yBot: number; wTop: number; wBot: number; speed: number }[]
  ledge: Vec2
  pool: { x: number; y: number; rx: number; ry: number }
}

export interface SceneBox { id: string; x0: number; x1: number; y0: number; y1: number; contrast: 'high' | 'low' }

export interface HomeSceneLayout {
  kind: HomeSceneKind
  seed: number
  w: number
  h: number
  over: number
  W: number
  sun: { x: number; y: number; r: number }
  clouds: { x: number; y: number; s: number; speed: number }[]
  ridges: { pts: Vec2[]; tone: number }[]
  hills: { pts: Vec2[]; tone: number }[]
  farTrees: { x: number; y: number; r: number; tone: number; accent: boolean }[]
  mid: MidProp[]
  /** ของบนพื้นใกล้ (ขอนไม้ เห็ด ลำต้นริมจอ ซุ้ม) — ประกอบแทรกระหว่างแถวหญ้าที่เส้น foreLine */
  fore: MidProp[]
  foreLine: number
  falls: Falls | null
  groundTop: number
  rows: GrassRow[]
  mistY: number
  boxes: SceneBox[]
}

/** สัดส่วนคอลัมน์กลางที่สงวนให้ต้นไม้ */
export const TREE_COLUMN = { from: 0.35, to: 0.65 } as const
/** ขอบเผื่อซ้าย-ขวา (สัดส่วนของความกว้างจอ) สำหรับพารัลแลกซ์ */
export const OVERSCAN = 0.08

const lerp = (a: number, b: number, t: number) => a + (b - a) * t

/** เส้นสันเขาเรียบจากผลรวมคลื่นไซน์เฟสสุ่ม */
function ridgeLine(rnd: () => number, W: number, base: number, amp: number, waves: number, step: number): Vec2[] {
  const ph = Array.from({ length: 3 }, () => rnd() * Math.PI * 2)
  const pts: Vec2[] = []
  for (let x = 0; x <= W + step; x += step) {
    const u = x / W
    const y = base
      - amp * (0.55 * Math.sin(u * Math.PI * waves + ph[0]) + 0.3 * Math.sin(u * Math.PI * waves * 2.3 + ph[1]) + 0.15 * Math.sin(u * Math.PI * waves * 5.1 + ph[2]))
    pts.push([x, y])
  }
  return pts
}

function yOn(pts: Vec2[], x: number): number {
  for (let i = 1; i < pts.length; i++) {
    if (pts[i][0] >= x) {
      const [x0, y0] = pts[i - 1], [x1, y1] = pts[i]
      return lerp(y0, y1, (x - x0) / (x1 - x0 || 1))
    }
  }
  return pts[pts.length - 1][1]
}

interface RowOpts { count: number; density: number; flowerRate: number; flowerKinds: Flower['kind'][]; flowerColors: number; patchy: boolean; edgeOnly?: boolean }

function buildRows(rnd: () => number, L: { w: number; h: number; W: number; over: number }, groundTop: number, o: RowOpts): GrassRow[] {
  const rows: GrassRow[] = []
  const span = L.h - groundTop + L.h * 0.03
  const s = Math.min(L.w, L.h) / 800 + 0.35 // สเกลขนาดหญ้าตามจอ
  const colAt = (x: number) => {
    // ดอกไม้เป็นหย่อมสี (สวน) หรือคละสี (ทุ่ง)
    if (!o.patchy) return Math.floor(rnd() * o.flowerColors)
    const band = Math.floor((x / L.W) * 7 + Math.sin(x * 0.013) * 0.8)
    return ((band % o.flowerColors) + o.flowerColors) % o.flowerColors
  }
  for (let i = 0; i < o.count; i++) {
    const d = i / (o.count - 1)
    const rootBottom = groundTop + span * Math.pow((i + 1) / o.count, 1.55)
    const rootTop = groundTop + span * Math.pow(i / o.count, 1.55)
    const maxH = lerp(L.h * 0.014, L.h * 0.07, Math.pow(d, 1.25)) * Math.min(1.25, s)
    const blades: Blade[] = []
    const n = Math.round(L.W * o.density * lerp(1.1, 0.42, d))
    for (let k = 0; k < n; k++) {
      const x = rnd() * L.W
      blades.push({
        x, y: lerp(rootTop, rootBottom, rnd()), h: maxH * (0.55 + 0.45 * rnd()),
        lean: (rnd() - 0.5) * 0.5, w: lerp(1, 3.4, d) * (0.7 + 0.5 * rnd()) * Math.min(1.3, s), tone: rnd(),
      })
    }
    const flowers: Flower[] = []
    const nf = Math.round(L.W * o.flowerRate * lerp(0.9, 0.5, d))
    for (let k = 0; k < nf; k++) {
      const x = rnd() * L.W
      flowers.push({
        x, y: lerp(rootTop, rootBottom, rnd()), r: lerp(1.3, 4.6, d) * Math.min(1.3, s) * (0.8 + 0.4 * rnd()),
        color: colAt(x), kind: o.flowerKinds[Math.floor(rnd() * o.flowerKinds.length)], stem: maxH * (0.45 + 0.4 * rnd()),
      })
    }
    rows.push({ depth: d, rootTop, rootBottom, maxH, amp: lerp(0.05, 0.42, Math.pow(d, 1.2)), blades, flowers })
  }
  // กอหญ้าหน้าสุด — เฉพาะริมซ้าย/ขวา (ไม่บังโคนต้นไม้กลางจอ)
  const fg: Blade[] = []
  const fgH = L.h * 0.12 * Math.min(1.25, s)
  for (let k = 0; k < L.W * 0.5; k++) {
    const u = rnd()
    const x = u < 0.5 ? rnd() * (L.over + L.w * 0.24) : L.W - rnd() * (L.over + L.w * 0.24)
    fg.push({ x, y: L.h - rnd() * L.h * 0.02, h: fgH * (0.4 + 0.6 * rnd()), lean: (rnd() - 0.5) * 0.6, w: 3.4 * Math.min(1.3, s) * (0.7 + 0.6 * rnd()), tone: rnd() })
  }
  rows.push({ depth: 1, rootTop: L.h - L.h * 0.02, rootBottom: L.h + 2, maxH: fgH, amp: 0.5, blades: fg, flowers: [] })
  return rows
}

export function generateHomeScene(spec: Pick<HomeSceneSpec, 'kind' | 'seed'>, w: number, h: number): HomeSceneLayout {
  const rnd = mulberry32((spec.seed * 2654435761) >>> 0)
  const over = Math.round(w * OVERSCAN)
  const W = w + over * 2
  const L = { w, h, W, over }
  const X = (u: number) => over + u * w // สัดส่วนของจอที่มองเห็น → พิกัดฉาก
  const portrait = h > w
  const groundTop = h * (portrait ? 0.585 : 0.6)
  const sun = { x: X(0.16), y: h * 0.11, r: Math.max(w, h) * 0.32 }
  const clouds = Array.from({ length: 5 }, () => ({ x: rnd() * W, y: h * (0.06 + rnd() * 0.22), s: Math.max(w, h) * (0.07 + rnd() * 0.06), speed: 0.4 + rnd() * 0.6 }))
  const boxes: SceneBox[] = []
  const mid: MidProp[] = []
  const fore: MidProp[] = []
  let foreLine = h
  let falls: Falls | null = null

  const ridges = [
    { pts: ridgeLine(rnd, W, h * 0.42, h * 0.11, 3.2, 8), tone: 0 },
    { pts: ridgeLine(rnd, W, h * 0.47, h * 0.075, 4.4, 8), tone: 1 },
  ]
  const hills = [
    { pts: ridgeLine(rnd, W, groundTop - h * 0.045, h * 0.03, 2.4, 8), tone: 0 },
    { pts: ridgeLine(rnd, W, groundTop - h * 0.012, h * 0.022, 3.1, 8), tone: 1 },
  ]
  const farTrees: HomeSceneLayout['farTrees'] = []
  const treeScale = Math.min(w, h) / 900 + 0.4
  // [แก้ตามที่ระบุ] ฉาก 3 (ทุ่งหญ้าน้ำตก): ต้นไกลเป็นสายพันธุ์เดียวกับต้นของผู้เล่น — ใหญ่ขึ้น ห่างขึ้น ให้เห็นทรง/รายละเอียด
  const bigFar = spec.kind === 'meadow-falls'
  for (let x = rnd() * 14; x < W; x += bigFar ? 34 + rnd() * 46 : 10 + rnd() * 22) {
    const hill = hills[rnd() < 0.6 ? 0 : 1]
    farTrees.push({ x, y: yOn(hill.pts, x) + 2, r: (bigFar ? 9 + rnd() * 7 : 4 + rnd() * 6) * treeScale, tone: Math.floor(rnd() * 3), accent: rnd() < 0.1 })
  }

  let rowOpts: RowOpts = { count: 9, density: 0.95, flowerRate: 0.05, flowerKinds: ['dot', 'daisy'], flowerColors: 4, patchy: false }

  if (spec.kind === 'meadow-falls') {
    // ── หน้าผาขั้นบันไดฝั่งขวา + น้ำตก 3 สาย + แอ่งน้ำที่ฐาน (ไม่มีลำธารไหลข้ามทุ่ง) ──
    const bumps = () => Array.from({ length: 6 }, () => rnd())
    const tiers = [
      { x0: X(0.76), x1: W + 4, top: groundTop - h * 0.115, bottom: groundTop + h * 0.02, bumps: bumps() },
      { x0: X(0.8), x1: W + 4, top: groundTop - h * 0.215, bottom: groundTop - h * 0.08, bumps: bumps() },
      { x0: X(0.85), x1: W + 4, top: groundTop - h * 0.3, bottom: groundTop - h * 0.18, bumps: bumps() },
    ]
    mid.push({ type: 'cliff', tiers })
    const fx = X(0.895)
    const ledgeY = tiers[2].top + h * 0.025
    const poolY = groundTop + h * 0.008
    const rw = Math.max(6, w * 0.016)
    falls = {
      ribbons: [
        // [แก้ตามที่ระบุ] 3 สายซ้อนกันเป็นม่านน้ำผืนเดียว (เดิมห่างกันเป็นแท่งๆ)
        { x: fx - rw * 1.15, yTop: ledgeY + 1, yBot: poolY, wTop: rw * 1.5, wBot: rw * 1.8, speed: 1 },
        { x: fx + rw * 0.15, yTop: ledgeY - 2, yBot: poolY, wTop: rw * 1.8, wBot: rw * 2.15, speed: 1.2 },
        { x: fx + rw * 1.35, yTop: ledgeY + 2, yBot: poolY, wTop: rw * 1.3, wBot: rw * 1.55, speed: 0.9 },
      ],
      ledge: [fx, ledgeY],
      pool: { x: fx, y: poolY, rx: Math.max(w * 0.075, 26), ry: Math.max(h * 0.012, 5) },
    }
    for (const t of tiers) {
      for (let x = t.x0 + 10; x < t.x1; x += 22 + rnd() * 30) mid.push({ type: 'bush', x, y: t.top + 4, r: (6 + rnd() * 7) * treeScale, tone: Math.floor(rnd() * 2) })
    }
    // ก้อนหินบังแอ่งน้ำด้านหน้า
    for (let k = 0; k < 6; k++) mid.push({ type: 'rock', x: fx + (k - 2.5) * w * 0.028 + (rnd() - 0.5) * 8, y: poolY + h * 0.012 + rnd() * h * 0.01, rx: (9 + rnd() * 9) * treeScale, ry: (6 + rnd() * 5) * treeScale })
    boxes.push({ id: 'cliff', x0: tiers[0].x0, x1: W, y0: tiers[2].top, y1: tiers[0].bottom, contrast: 'high' })
    boxes.push({ id: 'falls', x0: fx - rw * 3, x1: fx + rw * 3, y0: ledgeY, y1: poolY, contrast: 'high' })
    rowOpts = { ...rowOpts, flowerRate: 0.045 }
  } else if (spec.kind === 'forest-glade') {
    // ── ลำต้น 3 ชั้น (ไกลจาง → ใกล้เข้ม · ชั้นใกล้อยู่ริมจอเท่านั้น) + เรือนยอดด้านบน + ขอนไม้/เห็ดริมข้าง ──
    for (let x = rnd() * 20; x < W; x += 26 + rnd() * 30) mid.push({ type: 'trunk', x, top: -10, bottom: groundTop - h * 0.01 + rnd() * 6, w: (6 + rnd() * 6) * treeScale, layer: 0, lean: (rnd() - 0.5) * 0.04 })
    for (let x = rnd() * 40; x < W; x += 60 + rnd() * 70) mid.push({ type: 'trunk', x, top: -10, bottom: groundTop + h * 0.02, w: (14 + rnd() * 10) * treeScale, layer: 1, lean: (rnd() - 0.5) * 0.05 })
    const nearXs = [X(0.02), X(0.14), X(0.88), X(1.0)]
    for (const x of nearXs) {
      const tw = (34 + rnd() * 22) * treeScale
      const bottom = groundTop + h * (0.085 + rnd() * 0.02)
      fore.push({ type: 'trunk', x, top: -10, bottom, w: tw, layer: 2, lean: (rnd() - 0.5) * 0.03 })
      boxes.push({ id: `trunk-${Math.round(x)}`, x0: x - tw / 2, x1: x + tw / 2, y0: 0, y1: bottom, contrast: 'high' })
    }
    const scallops = Array.from({ length: Math.ceil(W / 40) + 1 }, () => rnd())
    const holes = Array.from({ length: 9 }, () => ({ x: rnd() * W, y: h * (0.02 + rnd() * 0.1), r: Math.max(w, h) * (0.02 + rnd() * 0.03) }))
    mid.push({ type: 'canopy', bottom: h * (portrait ? 0.17 : 0.2), scallops, holes })
    foreLine = groundTop + h * 0.15
    fore.push({ type: 'log', x: X(0.1), y: groundTop + h * 0.14, len: w * 0.17, r: Math.max(10, h * 0.02) })
    fore.push({ type: 'log', x: X(0.85), y: groundTop + h * 0.145, len: w * 0.15, r: Math.max(9, h * 0.018) })
    for (const side of [0.06, 0.12, 0.8, 0.9]) {
      for (let k = 0; k < 3; k++) fore.push({ type: 'mushroom', x: X(side) + (rnd() - 0.5) * w * 0.05, y: groundTop + h * (0.08 + rnd() * 0.03), s: (6 + rnd() * 6) * treeScale })
    }
    for (let x = rnd() * 30; x < W; x += 30 + rnd() * 40) mid.push({ type: 'bush', x, y: groundTop + 2, r: (9 + rnd() * 9) * treeScale, tone: Math.floor(rnd() * 2) })
    rowOpts = { count: 9, density: 1.05, flowerRate: 0.02, flowerKinds: ['dot'], flowerColors: 3, patchy: false }
  } else {
    // ── สวน: แนวรั้วพุ่มไม้ตามขอบฟ้า · ต้นไม้ดัดทรงกลม · ซุ้มกุหลาบซ้าย · แปลงดอกไม้เป็นหย่อมสี ──
    mid.push({ type: 'hedge', x0: -4, x1: W + 4, y: groundTop + h * 0.005, h: h * 0.035, bumps: Array.from({ length: Math.ceil(W / 26) + 1 }, () => rnd()), tone: 0 })
    for (const u of [0.04, 0.24, 0.76, 0.96]) mid.push({ type: 'topiary', x: X(u), y: groundTop + h * 0.01, r: (13 + rnd() * 6) * treeScale })
    const aw = Math.min(Math.max(84, w * 0.17), w * 0.28), ah = Math.max(150, h * 0.27)
    const ax = X(Math.max(0.1, aw / 2 / w + 0.02)), ay = groundTop + h * 0.1
    foreLine = ay + 2
    fore.push({ type: 'arch', x: ax, y: ay, w: aw, h: ah })
    boxes.push({ id: 'arch', x0: ax - aw / 2 - 12, x1: ax + aw / 2 + 12, y0: ay - ah, y1: ay, contrast: 'high' })
    for (let x = rnd() * 30; x < W; x += 34 + rnd() * 40) {
      if (x > X(0.3) && x < X(0.7)) continue
      mid.push({ type: 'bush', x, y: groundTop + h * 0.012, r: (8 + rnd() * 7) * treeScale, tone: Math.floor(rnd() * 2) })
    }
    rowOpts = { count: 9, density: 0.75, flowerRate: 0.2, flowerKinds: ['tulip', 'daisy', 'dot'], flowerColors: 6, patchy: true }
  }

  const rows = buildRows(rnd, L, groundTop, rowOpts)
  fore.sort((a, b) => ('y' in a ? a.y : 'bottom' in a ? a.bottom : 0) - ('y' in b ? b.y : 'bottom' in b ? b.bottom : 0))
  return { kind: spec.kind, seed: spec.seed, w, h, over, W, sun, clouds, ridges, hills, farTrees, mid, fore, foreLine, falls, groundTop, rows, mistY: groundTop, boxes }
}
</file>

<file path="src/components/scenery/homeScenes/HomeSceneRenderer.tsx">
import { useEffect, useRef, useState } from 'react'
import { WIND_PRESETS, type HomeSceneSpec, type SceneWeather } from '../../../config/homeScenes'
import { usePrefersReducedMotion, useIsLowPowerMode } from '../../../hooks/useMediaQuery'
import { generateHomeScene } from './generateHomeScene'
import { paintStatic, type StaticLayers } from './paintHomeScene'
import { composeFrame, createFrameState } from './composeHomeScene'
import type { WindParams } from './wind'
import type { MbtiType } from '../../../types'
import { speciesOf } from '../../tree/procedural/species'

/*============================================================================*\
  HomeSceneRenderer — ฉากพื้นหลังหน้า Home ที่วาดด้วยโค้ด (ฉาก 3-5)
  ────────────────────────────────────────────────────────────────────────────
  • แสดงพื้นไล่สีของฟ้าทันที (ไม่เคยจอว่าง) → วาดชั้นนิ่งตอนเครื่องว่าง → เริ่มแอนิเมชัน
  • หยุดเมื่อซ่อนแท็บ · จำกัด 30 fps บนเครื่องประหยัดพลังงาน · dpr ไม่เกิน 2 (ประหยัดพลังงาน 1.5)
  • prefers-reduced-motion หรือ animate=false → วาดเฟรมนิ่งเฟรมเดียว (หญ้าเอนนิดเดียว ไม่มีกลีบร่วง/สายน้ำวิ่ง)
  • pointer-events: none · อยู่ใต้ UI ทุกชั้น (ผู้ใช้วางเองตาม z-index ของหน้า)
\*============================================================================*/

export interface HomeSceneStats { buildMs: number; firstFrameMs: number; frameMs: number; fps: number; bytes: number; dpr: number }

interface Props {
  spec: HomeSceneSpec
  weather?: SceneWeather
  /** ทับความแรงลมของสภาพอากาศ (0-1.5) */
  windStrength?: number
  windDirection?: 1 | -1
  pan?: number
  /** ค่าเลื่อนฉากที่เปลี่ยนบ่อย (ลากต้นไม้) — อ่านทุกเฟรมโดยไม่ต้อง re-render (มีแล้วใช้แทน pan) */
  panRef?: { readonly current: number }
  /** false = ภาพนิ่ง (ตั้งค่าในแอป/เทสต์ screenshot) */
  animate?: boolean
  /** เวลาคงที่สำหรับเทสต์ (วินาที) — ใส่แล้ววาดเฟรมเดียวที่เวลานี้ */
  frozenT?: number
  className?: string
  onStats?: (s: HomeSceneStats) => void
  /** [ใหม่] MBTI ของผู้เล่น — ต้นไม้ไกลในฉาก 3 (ทุ่งหญ้าน้ำตก) เป็นสายพันธุ์/สีเดียวกับต้นของผู้เล่น */
  mbti?: MbtiType | null
}

const idle = (fn: () => void) => {
  if (typeof requestIdleCallback === 'function') { const id = requestIdleCallback(fn, { timeout: 60 }); return () => cancelIdleCallback(id) }
  const id = window.setTimeout(fn, 0); return () => window.clearTimeout(id)
}

export default function HomeSceneRenderer({ spec, weather = 'clear', windStrength, windDirection = 1, pan = 0, panRef, animate = true, frozenT, className, onStats, mbti = null }: Props) {
  const boxRef = useRef<HTMLDivElement | null>(null)
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const [size, setSize] = useState<{ w: number; h: number } | null>(null)
  const [layers, setLayers] = useState<{ key: string; S: StaticLayers; L: ReturnType<typeof generateHomeScene> } | null>(null)
  const reduced = usePrefersReducedMotion()
  const lowPower = useIsLowPowerMode()
  const live = useRef({ weather, windStrength, windDirection, pan, panRef, onStats })
  const buildRef = useRef(0)
  const startRef = useRef(0)
  useEffect(() => { live.current = { weather, windStrength, windDirection, pan, panRef, onStats } })

  useEffect(() => {
    const el = boxRef.current
    if (!el) return
    const ro = new ResizeObserver(() => setSize({ w: Math.max(1, Math.round(el.clientWidth)), h: Math.max(1, Math.round(el.clientHeight)) }))
    ro.observe(el)
    return () => ro.disconnect()
  }, [])

  // ชั้นนิ่ง: สร้างใหม่เมื่อขนาดจอ/ฉากเปลี่ยนเท่านั้น
  const dpr = Math.min(typeof window === 'undefined' ? 1 : window.devicePixelRatio || 1, lowPower ? 1.5 : 2)
  const key = size ? `${spec.id}:${size.w}x${size.h}@${dpr}:${mbti ?? '-'}` : null
  useEffect(() => {
    if (!size || !key) return
    return idle(() => {
      const t0 = performance.now()
      const L = generateHomeScene(spec, size.w, size.h)
      const S = paintStatic(L, spec.palette, dpr, (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c }, speciesOf(mbti))
      setLayers({ key, S, L })
      buildRef.current = performance.now() - t0
      startRef.current = t0
    })
  }, [key, size, spec, dpr, mbti])

  const still = reduced || !animate || frozenT !== undefined
  // ภาพนิ่ง: เปลี่ยนอากาศ/ลม/เลื่อนฉาก → วาดเฟรมใหม่
  const stillKey = still ? `${weather}:${windStrength}:${windDirection}:${pan}` : ''
  useEffect(() => {
    const cv = canvasRef.current
    const ctx = cv?.getContext('2d')
    if (!cv || !ctx || !layers || layers.key !== key) return
    const { S, L } = layers
    cv.width = Math.round(L.w * S.dpr); cv.height = Math.round(L.h * S.dpr)
    const st = createFrameState(L)
    const windOf = (): WindParams => {
      const p = WIND_PRESETS[live.current.weather]
      return { strength: live.current.windStrength ?? p.strength, gustSpeed: p.gustSpeed, direction: live.current.windDirection }
    }
    const frame = (t: number, dt: number) => composeFrame(ctx, S, L, spec.palette, { t, dt, pan: live.current.panRef?.current ?? live.current.pan, weather: live.current.weather, wind: windOf(), reducedMotion: reduced }, st)
    const tf = performance.now()
    frame(frozenT ?? 0, 0)
    const firstFrameMs = performance.now() - startRef.current
    const report = (frameMs: number, fps: number) => live.current.onStats?.({ buildMs: buildRef.current, firstFrameMs, frameMs, fps, bytes: S.bytes, dpr: S.dpr })
    report(performance.now() - tf, 0)
    if (still) return

    const minGap = lowPower ? 1000 / 30 - 2 : 0
    let raf = 0, last = performance.now(), lastDraw = 0, acc = 0, n = 0, fpsT = last, frames = 0
    const t0 = last
    const tick = (now: number) => {
      raf = requestAnimationFrame(tick)
      if (document.hidden || now - lastDraw < minGap) return
      const dt = Math.min(0.05, (now - last) / 1000)
      last = now; lastDraw = now
      const s = performance.now()
      frame((now - t0) / 1000, dt)
      acc += performance.now() - s; n++; frames++
      if (now - fpsT > 1000) { report(acc / n, (frames * 1000) / (now - fpsT)); acc = 0; n = 0; frames = 0; fpsT = now }
    }
    raf = requestAnimationFrame(tick)
    return () => cancelAnimationFrame(raf)
  }, [layers, key, still, stillKey, reduced, lowPower, frozenT, spec.palette])

  const P = spec.palette
  return (
    <div
      ref={boxRef}
      className={className}
      aria-hidden="true"
      data-scene={spec.id}
      data-ready={layers?.key === key ? '1' : '0'}
      style={{ position: 'absolute', inset: 0, overflow: 'hidden', pointerEvents: 'none', background: `linear-gradient(180deg, ${P.sky[0]} 0%, ${P.sky[2]} 55%, ${P.ground[0]} 62%, ${P.ground[1]} 100%)` }}
    >
      <canvas ref={canvasRef} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block' }} />
    </div>
  )
}
</file>

<file path="src/components/scenery/homeScenes/miniTrees.ts">
import type { Species } from '../../tree/procedural/species'

/*============================================================================*\
  miniTrees — [ใหม่ตามที่ระบุ] ต้นไม้ไกลบนเนินของฉาก 3 (ทุ่งหญ้าน้ำตก) = สายพันธุ์/สีเดียวกับต้นไม้ MBTI ของผู้เล่น (เล็กกว่า)
  ────────────────────────────────────────────────────────────────────────────
  ภาษาภาพเดียวกับต้นหลัก: ลำต้นแตกง่าม + พุ่มเป็นก้อนซ้อน (แสงซ้ายบน) + แต้มใบ/ดอกสีของสายพันธุ์
  ทรงตามรูปแบบต้น (broadleaf/weeping/column/cone/palm/bamboo) · tone() = ผสมไอฟ้าตามระยะ (ไกล = จางลงนิดหน่อย)
  วาดลงชั้นนิ่งครั้งเดียว (ไม่วาดซ้ำทุกเฟรม)
\*============================================================================*/

type Ctx = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D
const TAU = Math.PI * 2

function hex2rgb(hex: string): [number, number, number] {
  const n = parseInt(hex.slice(1, 7), 16)
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
}
/** ผสมสี a → b (t 0..1) */
export function mixHex(a: string, b: string, t: number): string {
  const [r1, g1, b1] = hex2rgb(a), [r2, g2, b2] = hex2rgb(b)
  const m = (x: number, y: number) => Math.round(x + (y - x) * t)
  return `rgb(${m(r1, r2)},${m(g1, g2)},${m(b1, b2)})`
}
const toHex = (c: string) => {
  if (c.startsWith('#')) return c.slice(0, 7)
  const [r, g, b] = c.match(/\d+/g)!.map(Number)
  return `#${[r, g, b].map((v) => v.toString(16).padStart(2, '0')).join('')}`
}

export interface MiniTreeOpts {
  /** ผสมไอฟ้า: tone(สี) → สีหลังผสม */
  tone: (hex: string) => string
  rnd: () => number
}

function trunk(c: Ctx, x: number, y: number, h: number, w: number, color: string, fork: boolean, o: MiniTreeOpts) {
  const lean = (o.rnd() - 0.5) * w * 0.8
  c.fillStyle = o.tone(mixHex(color, '#2a2018', 0.2))
  c.beginPath()
  c.moveTo(x - w * 0.6, y)
  c.quadraticCurveTo(x - w * 0.35, y - h * 0.5, x - w * 0.25 + lean, y - h)
  c.lineTo(x + w * 0.25 + lean, y - h)
  c.quadraticCurveTo(x + w * 0.35, y - h * 0.5, x + w * 0.6, y)
  c.closePath(); c.fill()
  if (fork) {
    c.strokeStyle = c.fillStyle; c.lineCap = 'round'; c.lineWidth = w * 0.4
    c.beginPath(); c.moveTo(x + lean, y - h * 0.75); c.lineTo(x + lean - w * 1.6, y - h * 1.15); c.stroke()
    c.beginPath(); c.moveTo(x + lean, y - h * 0.7); c.lineTo(x + lean + w * 1.5, y - h * 1.1); c.stroke()
  }
  return lean
}

/** ก้อนพุ่มนุ่ม: ไล่แสงซ้ายบน → เงาขวาล่าง */
function clump(c: Ctx, x: number, y: number, r: number, light: string, mid: string, dark: string) {
  const g = c.createRadialGradient(x - r * 0.4, y - r * 0.45, r * 0.1, x, y, r * 1.1)
  g.addColorStop(0, light); g.addColorStop(0.55, mid); g.addColorStop(1, dark)
  c.fillStyle = g
  c.beginPath(); c.arc(x, y, r, 0, TAU); c.fill()
}

/** แต้มใบ/ดอกเล็กๆ ทั่วพุ่ม (แบบแต้มใบของต้นหลัก) */
function daubs(c: Ctx, cx: number, cy: number, rx: number, ry: number, colors: string[], n: number, size: number, o: MiniTreeOpts) {
  for (let i = 0; i < n; i++) {
    const a = o.rnd() * TAU, d = Math.sqrt(o.rnd())
    const x = cx + Math.cos(a) * rx * d, y = cy + Math.sin(a) * ry * d
    c.fillStyle = o.tone(colors[Math.floor(o.rnd() * colors.length)])
    c.beginPath(); c.ellipse(x, y, size, size * 0.6, o.rnd() * Math.PI, 0, TAU); c.fill()
  }
}

/** ต้นไม้ไกล 1 ต้น (x, y = โคน · r = รัศมีพุ่ม) */
export function drawMiniSpeciesTree(c: Ctx, x: number, y: number, r: number, sp: Species, o: MiniTreeOpts) {
  const leaves = sp.leafColors.map(toHex)
  const flowers = (sp.flowers?.colors ?? []).map(toHex)
  const base = leaves[0]
  const light = o.tone(mixHex(leaves[Math.min(1, leaves.length - 1)], '#fff8e0', 0.25))
  const mid = o.tone(base)
  const dark = o.tone(mixHex(base, '#1b2a20', 0.35))
  const trunkCol = toHex(sp.trunkColor)
  // เงาบนพื้น
  c.fillStyle = 'rgba(30,50,30,.18)'
  c.beginPath(); c.ellipse(x + r * 0.15, y, r * 0.9, r * 0.18, 0, 0, TAU); c.fill()

  switch (sp.form) {
    case 'cone': {
      trunk(c, x, y, r * 0.5, r * 0.18, trunkCol, false, o)
      for (let k = 0; k < 4; k++) {
        const ty = y - r * 0.35 - k * r * 0.5, tw = r * (1 - k * 0.2)
        c.fillStyle = k % 2 ? mid : dark
        c.beginPath(); c.moveTo(x - tw, ty); c.quadraticCurveTo(x, ty - r * 0.9, x + tw, ty); c.quadraticCurveTo(x, ty + r * 0.12, x - tw, ty); c.fill()
        daubs(c, x - tw * 0.25, ty - r * 0.25, tw * 0.45, r * 0.15, [leaves[leaves.length - 1], ...(sp.tipColors ?? [])], 6, r * 0.09, o)
      }
      return
    }
    case 'column': {
      trunk(c, x, y, r * 0.5, r * 0.16, trunkCol, false, o)
      const cy = y - r * 1.5
      for (const [dx, dy, rr] of [[0, r * 0.6, 0.42], [0, 0, 0.46], [0, -r * 0.6, 0.38]] as const) clump(c, x + dx, cy + dy, r * rr, light, mid, dark)
      daubs(c, x - r * 0.1, cy, r * 0.35, r * 0.95, [...leaves, ...(sp.tipColors ?? [])], 26, r * 0.08, o)
      return
    }
    case 'palm': {
      const lean = (o.rnd() - 0.5) * r * 0.4
      c.strokeStyle = o.tone(trunkCol); c.lineWidth = r * 0.14; c.lineCap = 'round'
      c.beginPath(); c.moveTo(x, y); c.quadraticCurveTo(x + lean * 0.3, y - r, x + lean, y - r * 1.8); c.stroke()
      for (let k = 0; k < 7; k++) {
        const a = Math.PI * (1.05 + (k / 6) * 0.9)
        c.strokeStyle = k % 2 ? mid : dark; c.lineWidth = r * 0.12
        c.beginPath(); c.moveTo(x + lean, y - r * 1.8); c.quadraticCurveTo(x + lean + Math.cos(a) * r * 0.7, y - r * 2.1 + Math.sin(a) * r * 0.2, x + lean + Math.cos(a) * r * 1.1, y - r * 1.7 - Math.sin(a) * -r * 0.3); c.stroke()
      }
      return
    }
    case 'bamboo': {
      for (let k = 0; k < 4; k++) {
        const sx = x + (k - 1.5) * r * 0.22, sh = r * (1.8 + o.rnd() * 0.6)
        c.strokeStyle = o.tone(k % 2 ? leaves[0] : mixHex(leaves[0], '#ffffff', 0.15)); c.lineWidth = r * 0.08
        c.beginPath(); c.moveTo(sx, y); c.lineTo(sx + (o.rnd() - 0.5) * r * 0.2, y - sh); c.stroke()
      }
      daubs(c, x, y - r * 1.6, r * 0.7, r * 0.5, leaves, 22, r * 0.12, o)
      return
    }
    default: {
      // broadleaf / weeping: ลำต้นแตกง่าม + พุ่มก้อนซ้อน (พุ่มกลมถ้าสายพันธุ์เป็นทรงกลม)
      const lean = trunk(c, x, y, r * 0.95, r * 0.2, trunkCol, true, o)
      const cx = x + lean, cy = y - r * (sp.roundCrown ? 1.6 : 1.5)
      const n = 6
      const parts: [number, number, number][] = []
      for (let k = 0; k < n; k++) {
        const a = (k / n) * TAU + o.rnd() * 0.5
        parts.push([cx + Math.cos(a) * r * 0.5, cy + Math.sin(a) * r * (sp.roundCrown ? 0.45 : 0.35), r * (0.42 + o.rnd() * 0.12)])
      }
      parts.push([cx, cy - r * 0.1, r * 0.55])
      parts.sort((p, q) => p[1] - q[1])
      // ดอกเด่น (เช่น จาคารันดาม่วง) → สีพื้นพุ่มใช้สีดอก/ใบหลักของสายพันธุ์
      for (const [px, py, pr] of parts) clump(c, px, py, pr, light, mid, dark)
      daubs(c, cx, cy, r * 0.85, r * 0.7, leaves, 44, r * 0.09, o)
      if (flowers.length) daubs(c, cx, cy - r * 0.1, r * 0.8, r * 0.6, flowers, Math.round(20 * Math.min(3, sp.flowers!.amount)), r * 0.07, o)
      // ไฮไลต์ซ้ายบน
      c.fillStyle = 'rgba(255,248,220,.22)'
      c.beginPath(); c.ellipse(cx - r * 0.3, cy - r * 0.35, r * 0.4, r * 0.22, -0.4, 0, TAU); c.fill()
      if (sp.form === 'weeping') {
        c.strokeStyle = mid; c.lineWidth = r * 0.06; c.lineCap = 'round'
        for (let k = 0; k < 9; k++) {
          const sx = cx + (k / 8 - 0.5) * r * 1.6
          c.beginPath(); c.moveTo(sx, cy + r * 0.1); c.quadraticCurveTo(sx + r * 0.05, cy + r * 0.5, sx - r * 0.02, cy + r * (0.7 + o.rnd() * 0.3)); c.stroke()
        }
      }
    }
  }
}
