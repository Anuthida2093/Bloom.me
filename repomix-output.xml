/* ═══════════════════════════════════════════════════════════════
   StepJourneyGame.css — layout เต็มจอ (fullscreenGame ผ่าน GameShell.tsx)
   ───────────────────────────────────────────────────────────────
   .step-journey-game คือ children ตัวเดียวใน .game-shell__stage ซึ่งตอนนี้ (fullscreenGame)
   ไม่มี max-width/padding แล้ว (ดู GameShell.css .game-shell__body--fullscreen) จึงต้องขยาย
   เต็ม 100% เองที่นี่
   ═══════════════════════════════════════════════════════════════ */

.step-journey-game {
  position: relative;
  width: 100%;
  /* min-height ไม่ใช่ height ตายตัว — เผื่อจอแคบที่เนื้อหาเรียงต่อกันแนวตั้งสูงเกิน 100% ได้
     (ดู .game-shell__body--fullscreen ใน GameShell.css ที่ scroll ให้แทนการตัดทิ้ง) */
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* ── สถานะโหลด/เลือกจุดหมาย (ยังไม่มีแผนที่เต็มจอให้แสดง) — เว้น padding เองเพราะ
   .game-shell__stage แบบเต็มจอไม่มี padding ให้แล้ว ── */
.step-journey-game--center {
  align-items: center;
  justify-content: center;
  padding: 24px;
  overflow-y: auto;
  box-sizing: border-box;
  gap: 12px;
}

.step-journey-game__loading { padding: 24px 0; font-size: 13px; color: var(--glass-w-72); }
.step-journey-game__failed-notice { margin-bottom: 4px; }

/* ── สถานะแผนที่ — เต็มจอจริง ── */
.step-journey-game__map-viewport {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  touch-action: none;
}

.step-journey-game__map-zoom {
  position: absolute;
  inset: 0;
  transform-origin: 0 0;
  transition: transform 0.4s ease;
}

.step-journey-game__refollow-btn {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 8;
  padding: 7px 16px;
  border-radius: 99px;
  border: none;
  background: rgba(10, 22, 16, 0.65);
  backdrop-filter: blur(6px);
  color: var(--fixed-white);
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}
.step-journey-game__refollow-btn:hover { background: rgba(10, 22, 16, 0.8); }

/* ── แผงสถิติ + ปุ่มควบคุม ชิดขวา แนวเดียวกัน (ลอยทับมุมขวาบนของแผนที่) ──
   [แก้รอบนี้ — feedback รอบ 2] top เดิมคือ 12px ชนกับปุ่มปิดลอย (.game-shell__close--floating,
   top:12px เหมือนกัน) พอดี ตั้งแต่เปลี่ยนแถบหัวเป็น pill ลอย (ไม่กินพื้นที่ layout อีกต่อไป —
   ดู GameShell.css) ต้องเว้น top ให้พ้นปุ่มปิด 44px + ระยะห่างเอง แทนที่จะพึ่ง header bar เดิม
   เว้นให้อัตโนมัติ — bottom เพิ่ม buffer จาก +12px เป็น +20px กันชนขอบบนของ action menu bar
   แน่นเกินไปในบางความสูงจอ */
.step-journey-game__side-panel {
  position: absolute;
  top: 64px;
  right: 12px;
  bottom: calc(var(--gpf-safe-bottom, 100px) + 20px);
  z-index: 7;
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 14.2rem;
  overflow-y: auto;
}

.step-journey-game__controls {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  border-radius: 16px;
  background: rgba(10, 22, 16, 0.55);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

/* [แก้รอบนี้] ปุ่มซิงก์ (ไอคอนล้วน) + ช่องกรอกก้าว อยู่แถวเดียวกัน แทนการซ้อนกันเป็นบล็อก
   ตามที่ระบุ — ประหยัดพื้นที่แนวตั้งกว่าเดิมมาก */
.step-journey-game__sync-row { display: flex; gap: 8px; align-items: center; }
.step-journey-game__sync-btn {
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, var(--g200, #B7E4C7), var(--g300, #95D5B2));
  color: #1B4332;
  font-size: 17px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.step-journey-game__sync-btn:hover:not(:disabled) { transform: translateY(-2px); }
.step-journey-game__sync-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

.step-journey-game__step-input { flex: 1; min-width: 0; width: auto; }

.step-journey-game__sync-error { margin: 0; }

.step-journey-game__exit-btn {
  align-self: center;
  background: none;
  border: none;
  color: var(--glass-w-55, rgba(255, 255, 255, 0.55));
  font-size: 11px;
  text-decoration: underline;
  cursor: pointer;
  padding: 4px;
}
.step-journey-game__exit-btn:hover { color: var(--fixed-white); }

/* ── มือถือจอแคบ — ทับกันไม่ไหวถ้าลอยชิดขวาต่อ เปลี่ยนเป็นเรียงเต็มความกว้างใต้แผนที่แทน ── */
@media (max-width: 520px) {
  .step-journey-game__map-viewport { flex: 1 1 auto; min-height: 220px; }

  .step-journey-game__side-panel {
    position: static;
    width: 100%;
    max-height: none;
    overflow-y: visible;
    padding: 12px;
    box-sizing: border-box;
  }
}
