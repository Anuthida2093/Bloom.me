<file path="src/components/leaderboard/leaderboardRow.css">
/* ==========================================================================
   1. Leaderboard Row Hover & Animation (โค้ดเดิมของคุณ)
   ========================================================================== */

/* แถวผู้เล่น — ใช้ร่วมกันทั้งใน Leaderboard.tsx (modal เต็ม) และ LeaderboardPanel.tsx
   (panel ข้างจอ) ขนาด/padding ต่างกันไปตาม inline style ของแต่ละที่ แต่พฤติกรรม hover
   เหมือนกัน: พื้นหลังเข้มขึ้นเล็กน้อย + ขยับเข้าซ้าย-ขวานิดหน่อย + ชื่อขยายเบาๆ */
.leaderboard-row {
  cursor: pointer;
  transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}

.leaderboard-row:hover {
  --lc-bg-4: rgba(6, 93, 46, 0.1);
  background-color: var(--lc-bg-4) !important;
  transform: translateX(2px);
}

.leaderboard-row:active {
  transform: translateX(2px) scale(0.985);
}

.leaderboard-row__name {
  display: inline-block;
  transition: transform 0.15s ease;
  transform-origin: left center;
}

.leaderboard-row:hover .leaderboard-row__name {
  transform: scale(1.05);
}

/* ==========================================================================
   2. Custom Scrollbar (ตกแต่งแถบเลื่อนให้มินิมอล ไม่ทับเนื้อหา)
   ========================================================================== */

.leaderboard-scroll-area {
  scrollbar-width: thin;
  --lc-c-3: rgba(6, 93, 46, 0.25);
  scrollbar-color: var(--lc-c-3) transparent;
  -webkit-overflow-scrolling: touch;
}

.leaderboard-scroll-area::-webkit-scrollbar {
  width: 4px;
}

.leaderboard-scroll-area::-webkit-scrollbar-track {
  background: transparent;
}

.leaderboard-scroll-area::-webkit-scrollbar-thumb {
  --lc-bg-2: rgba(6, 93, 46, 0.25);
  background-color: var(--lc-bg-2);
  border-radius: 10px;
}

.leaderboard-scroll-area::-webkit-scrollbar-thumb:hover {
  --lc-bg-1: rgba(6, 93, 46, 0.4);
  background-color: var(--lc-bg-1);
}

/* ==========================================================================
   3. Sidebar Layout & Positioning (แก้ปัญหาทับ Navbar + เว้นระยะ 1cm)
   ========================================================================== */

.left-sidebar-container,
.leaderboard-panel-container {
  margin-top: 1cm !important; /* เว้นระยะจาก Navbar ลงมา 1 เซนติเมตร */
  max-height: calc(100vh - 1cm - 20px) !important; /* คุมความสูงไม่ให้ล้นหน้าจอ */
  z-index: 10; /* ตั้งค่าให้อยู่ต่ำกว่า Navbar (Navbar ควรใช้ z-index: 100+) */
}

/* ==========================================================================
   4. Accessibility & Responsive Design (Mobile / iPad)
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  .leaderboard-row,
  .leaderboard-row__name {
    transition: none;
  }
  .leaderboard-row:hover {
    transform: none;
  }
  .leaderboard-row:hover .leaderboard-row__name {
    transform: none;
  }
}

/* รองรับ แท็บเล็ต (iPad) */
@media (max-width: 1024px) {
  .left-sidebar-container,
  .leaderboard-panel-container {
    margin-top: 0.8cm !important;
    max-height: calc(100vh - 0.8cm - 16px) !important;
  }
}

/* รองรับ มือถือ (Mobile) */
@media (max-width: 768px) {
  .left-sidebar-container,
  .leaderboard-panel-container {
    margin-top: 0.5cm !important;
    width: 190px !important;
  }

  .leaderboard-panel-container.collapsed {
    width: 36px !important;
  }
}
</file>

