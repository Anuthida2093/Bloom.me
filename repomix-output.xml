    font-size: 12px;
    padding: 8px 12px;
    max-width: 60%;
    white-space: normal;
    text-align: left;
    line-height: 1.3;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   [ใหม่] หน้าสรุปเมื่อบันทึกของวันนี้ครบแล้ว
   ═══════════════════════════════════════════════════════════════════════════ */
