/* เลเยอร์ครอบหน้าจอแบบ Full Screen Overlay */
.gratitude-shield-page {
  position: absolute;
  inset: 0;
  z-index: 800;
  overflow: hidden;
}

/* ปุ่มปิดหน้าจอหลัก (มุมขวาบน) */
.gratitude-shield-page__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 30;
  width: 36px;
  height: 36px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-18);
  color: var(--fixed-white);
  cursor: pointer;
  font-size: 15px;
}

/* ปุ่มดูประวัติย้อนหลัง (มุมซ้ายบน) สไตล์ Frosted Glass */
.gratitude-shield-page__history-btn {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 30;
  padding: 9px 16px;
  border-radius: 99px;
  --lc-border-7: rgba(255, 209, 102, 0.5);
  border: 1px solid var(--lc-border-7);
  background: var(--glass-b-35);
  backdrop-filter: blur(8px);
  --lc-text-8: #ffe8b8;
  color: var(--lc-text-8);
  font-family: 'Fredoka One', sans-serif;
  font-size: 11.5px;
  cursor: pointer;
}

/* ปรับแต่งปุ่มประวัติสำหรับหน้าจอขนาดเล็ก/มือถือ (กว้างไม่เกิน 480px) */
@media (max-width: 480px) {
  .gratitude-shield-page__history-btn {
    font-size: 10px;
    padding: 8px 12px;
    max-width: 60%;
    white-space: normal;
    text-align: left;
    line-height: 1.3;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   [ใหม่] หน้าสรุปเมื่อทำเควสของวันนี้ครบแล้ว
   ───────────────────────────────────────────────────────────────────────────
   ดีไซน์อ้างอิงจากสเปกที่ให้มา (การ์ดขาวลอยกลางจอ ไอคอนโล่ ปุ่มไล่สีทอง)
   แต่ย้ายจาก inline style มาไว้ในไฟล์ CSS ตามแนวทางของโปรเจกต์ เพื่อให้มี
   :hover / :focus-visible / โหมดมืด และไม่ต้องแทรก <style> ใหม่ทุกครั้งที่ mount
   ═══════════════════════════════════════════════════════════════════════════ */
.gratitude-shield-page--done {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  --lc-bg-6: rgba(30, 20, 5, 0.85);
  background: var(--lc-bg-6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.gratitude-shield-done {
  width: 100%;
  max-width: 400px;
  padding: 40px 32px;
  border-radius: 28px;
  background: var(--bg-card);
  box-shadow: 0 24px 60px var(--glass-b-40);
  text-align: center;
}

.gratitude-shield-done__icon {
  font-size: 64px;
  line-height: 1;
  animation: gratitudeShieldFloat 3s ease-in-out infinite;
}

/* ลอยขึ้น-ลงเบาๆ ด้วย transform อย่างเดียว (composited ไม่แตะ layout) */
@keyframes gratitudeShieldFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}

.gratitude-shield-done__title {
  margin-top: 16px;
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  --lc-text-5: #FFB020;
  color: var(--lc-text-5);
}

.gratitude-shield-done__body {
  margin: 8px 0 24px;
  font-size: var(--fs-sm);
  line-height: var(--lh-body);
  color: var(--text-sub);
}

.gratitude-shield-done__actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.gratitude-shield-done__btn {
  padding: 12px;
  border-radius: 16px;
  border: none;
  background: var(--n100);
  color: var(--text-sub);
  font-family: var(--font-display);
  font-size: var(--fs-md);
  cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-out-soft), filter var(--dur-fast) ease;
}
.gratitude-shield-done__btn:hover { filter: brightness(1.05); }
.gratitude-shield-done__btn:active { transform: scale(0.97); }

.gratitude-shield-done__btn--primary {
  padding: 14px;
  --lc-bg-1: #FFD166;
  --lc-bg-2: #FFB020;
  background: linear-gradient(135deg, var(--lc-bg-1), var(--lc-bg-2));
  --lc-text-3: #4A2C0A;
  color: var(--lc-text-3);
  --lc-shadow-4: rgba(255, 176, 32, 0.4);
  box-shadow: 0 8px 20px var(--lc-shadow-4);
}

.gratitude-shield-done__btn--ghost {
  background: transparent;
  color: var(--text-muted);
}
