/* ═══ แผงข้อมูลต้นไม้ (TreeInfoPanel.tsx) ในคอลัมน์ขวาของหน้า Home ═══
   ใช้หน้าตา .tree-of-life__tooltip เดิม แต่ไม่ลอยเหนือโคนต้นแล้ว — วางตามคอลัมน์ขวาปกติ */
.tree-info-panel {
