    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- [แก้รอบนี้ — เฟส 3] เดิม `npx cap add android` รอบแรกรันก่อนมี android/healthfitness.config.json
         จึงตกไป fallback "ประกาศทุก permission" ของปลั๊กอิน (ดู README ของ @capacitor/health-fitness) —
         ตัดเหลือเฉพาะที่ config.json (permissions.STEPS = "Read") ต้องใช้จริงตรงนี้ด้วยมือ เพราะ hook
         ของปลั๊กอินมีแต่ฟังก์ชัน "เพิ่ม" permission ที่ขาด ไม่มีฟังก์ชัน "ลบ" permission ที่เกินออก
         (ดู node_modules/@capacitor/health-fitness/hooks/capacitorCopyHealthFitnessConfigs.js) — ถ้า
         รัน `npx cap sync android` ใหม่ในเครื่องอื่นที่มี config.json อยู่แล้วตั้งแต่ต้น จะไม่เกิดปัญหานี้ -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY"/>
</manifest>
