.balanced-nutrients__btn--primary:hover:not(:disabled) { transform: translateY(-2px); }
.balanced-nutrients__btn--primary:disabled { opacity: 0.6; cursor: default; }

.balanced-nutrients__hint { font-size: 12px; opacity: 0.75; margin-top: 12px; }

.balanced-nutrients__toast {
