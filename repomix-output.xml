<file path="src/components/profile/DoubleCardTile.tsx">
import { useState } from 'react'
import { useQueryClient } from '@tanstack/react-query'
import { DOUBLE_CARD_HOURS, DOUBLE_CARD_ICON } from '../../config/stepChest'
import { consumeDoubleCard } from '../../services/api/progression.api'
import { ApiError } from '../../services/http'
import { queryKeys } from '../../services/queryKeys'
import { formatRemainingTh, useCountdown } from '../../hooks/useCountdown'
import './ProfileTokens.css'

/*============================================================================*\
  DoubleCardTile — [ใหม่ตามที่ระบุ] "การ์ดคูณสอง" ในคลังไอเทม (ได้จากหีบสมบัติเควสก้าว)
  กด "ใช้" → ยืนยันอีกครั้ง → เซิร์ฟเวอร์เริ่มนับ 12 ชม. (เหรียญ/EXP จากเควสทุกเควส ×2 ระหว่างนั้น)
  ระหว่างการ์ดทำงาน: แสดงเวลาที่เหลือ และใช้ใบใหม่ซ้อนไม่ได้ (กันเสียการ์ดฟรี)
\*============================================================================*/

export default function DoubleCardTile({ count, activeUntil }: { count: number; activeUntil: string | null }) {
  const queryClient = useQueryClient()
  const remainingMs = useCountdown(activeUntil)
  const active = remainingMs > 0
  const [confirming, setConfirming] = useState(false)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState<string | null>(null)

  if (count <= 0 && !active) return null

  const use = async () => {
    if (busy) return
    setBusy(true)
    setError(null)
    try {
      await consumeDoubleCard()
      setConfirming(false)
      void queryClient.invalidateQueries({ queryKey: queryKeys.progression })
    } catch (err) {
      setError(err instanceof ApiError ? err.userMessage : 'ใช้การ์ดไม่สำเร็จ ลองอีกครั้ง')
    } finally {
      setBusy(false)
    }
  }

  return (
    <div className={`double-tile${active ? ' double-tile--active' : ''}`}>
      {count > 0 && <span className="double-tile__count">{count}</span>}
      <img src={DOUBLE_CARD_ICON} alt="" className="double-tile__img" />
      <span className="double-tile__name">การ์ดคูณสอง</span>
      {active ? (
        <small className="double-tile__hint double-tile__hint--on">กำลังทำงาน · เหลือ {formatRemainingTh(remainingMs)}</small>
      ) : (
        <small className="double-tile__hint">รางวัลเควส ×2 นาน {DOUBLE_CARD_HOURS} ชม.</small>
      )}
      {!active && count > 0 && (confirming ? (
        <div className="double-tile__confirm">
          <small>เริ่มนับ {DOUBLE_CARD_HOURS} ชม. ทันที?</small>
          <div className="double-tile__confirm-row">
            <button type="button" className="double-tile__use" onClick={() => void use()} disabled={busy}>
              {busy ? '…' : 'ยืนยัน'}
            </button>
            <button type="button" className="double-tile__use double-tile__use--ghost" onClick={() => setConfirming(false)} disabled={busy}>
              ไม่ใช่ตอนนี้
            </button>
          </div>
        </div>
      ) : (
        <button type="button" className="double-tile__use" onClick={() => setConfirming(true)}>ใช้</button>
      ))}
      {error && <small className="double-tile__error" role="alert">{error}</small>}
    </div>
  )
}
</file>

<file path="src/components/profile/ExchangeCards.tsx">
import { BADGE_ICONS, ITEM_ICONS } from '../../config/iconAssets'
import { DECORATION_ITEM_META } from '../../config/decorationItems'
import { EXCHANGE_REQUIREMENTS, exchangeCardLabel, exchangeItemName, tierLabel } from '../../config/exchangeItems'
import './ProfileTokens.css'

/*============================================================================*\
  ExchangeCards — "การ์ดแลกซื้อไอเทม" ในคลังไอเทม (เก็บเป็นการ์ด ไม่ใช่ตัวไอเทมตรงๆ)
  ────────────────────────────────────────────────────────────────────────────
  หน้าตาการ์ดสะสม: กรอบทอง + รูปไอเทมปลายทาง + "การ์ดแลกซื้อ<ชื่อ>" + จำนวนใบ (ตัวเลข)
  ปุ่ม [แลกซื้อ] ใต้การ์ด → ไปป็อปอัปสินค้าในร้านค้าทันที
\*============================================================================*/

function ItemArt({ code, className }: { code: string; className: string }) {
  const img = ITEM_ICONS[code]
  return img
    ? <img src={img} alt="" className={className} />
    : <span className={`${className} exchange-card__emoji`} aria-hidden="true">{DECORATION_ITEM_META[code]?.emoji ?? '🎁'}</span>
}

function CardFace({ code, count }: { code: string; count: number }) {
  const req = EXCHANGE_REQUIREMENTS[code]
  return (
    <span className={`exchange-card exchange-card--${(req?.tier ?? 'RARE').toLowerCase()}`}>
      {/* [แก้ตามที่ระบุ] จำนวนที่มีเป็นตัวเลขตรงๆ (ได้ 1 = "1", ได้ 7 = "7") ไม่ใช่ที่มี/ที่ต้องใช้ */}
      <span className="exchange-card__count">{count}</span>
      <img src={BADGE_ICONS.item} alt="" className="exchange-card__seal" />
      <span className="exchange-card__art"><ItemArt code={code} className="exchange-card__art-img" /></span>
      <span className="exchange-card__name">{exchangeCardLabel(code)}</span>
      {req && <span className="exchange-card__tier">{tierLabel(req.tier)}</span>}
    </span>
  )
}

interface ExchangeCardsProps {
  cards: [string, number][]
  /** ไปหน้าร้านค้าแล้วเปิดป็อปอัปสินค้านั้นทันที */
  onOpenShopItem?: (itemCode: string) => void
}

/** การ์ดแลกซื้อในคลังไอเทม (แท็บ "ทั้งหมด"/"การ์ดแลกซื้อไอเทม") — ยังไม่มีการ์ด = ไม่แสดงอะไร
 *  แต่ละใบ: รูปไอเทม · "การ์ดแลกซื้อ<ชื่อ>" · จำนวนที่มี · ปุ่ม [แลกซื้อ] → ป็อปอัปสินค้าในร้าน */
export default function ExchangeCards({ cards, onOpenShopItem }: ExchangeCardsProps) {
  if (cards.length === 0) return null
  return (
    <div className="profile-tokens">
      <div className="profile-tokens__title">🎴 การ์ดแลกซื้อไอเทม</div>
      <div className="profile-tokens__grid">
        {cards.map(([code, count]) => (
          <div key={code} className="profile-tokens__cell">
            <CardFace code={code} count={count} />
            <button
              type="button"
              className="profile-tokens__exchange"
              onClick={() => onOpenShopItem?.(code)}
              aria-label={`แลกซื้อ${exchangeItemName(code)} (มีการ์ด ${count} ใบ)`}
            >
              แลกซื้อ
            </button>
          </div>
        ))}
      </div>
    </div>
  )
}
