        {/* List */}
        <div
          style={{
            flex: 1,
            overflowY: 'auto',
            padding: '6px 8px',
          }}
          className="no-scroll"
        >
          {sorted.map((p, i) => {
            const pt = MBTI_TREE_THEME[p.mbtiType];

            return (
              <div
                key={p.id}
                className="leaderboard-row"
                onClick={() => onPlayerClick(p)}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 4,/* แก้ตามที่ระบุ: gap: 6 → gap: 8 ให้ช่องว่างระหว่างไอคอนและข้อความมากขึ้น */
                  padding: '7px 6px',
                  borderRadius: 10,
                  marginBottom: 4,
                  background:
                    i < 3
