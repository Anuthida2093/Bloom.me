  รอบก่อน — ระบบเดิน "ข้าม 7 แผนที่ตามลำดับ") ด้วยโมเดลใหม่ที่ง่ายกว่า: ผู้เล่นเลือกแผนที่
  ปลายทาง "ใบเดียว" จาก 8 ใบแล้วเดินข้ามแผนที่ใบนั้นใบเดียวจบ ไม่ใช่ไล่เดินข้าม 8 แผนที่ตามลำดับ
  (ดูสรุปท้ายบทสนทนาที่อธิบายว่าทำไมถึงตีความประโยคต้นฉบับแบบนี้)
\*============================================================================*/

/** นิยามข้อมูล 1 แผนที่ (จาก 8 ใบทั้งหมด) — entryPct/exitPct/waypoints เป็นพิกัด % ของภาพ
 *  (0-100, สี่เหลี่ยมจัตุรัส) วัดจากตาเปล่าคร่าวๆ — ยังไม่ได้วัดละเอียดจาก Figma ดูสรุปท้าย
 *  บทสนทนา */
export interface MapDef {
  id: string
  order: number
  name: string
  /** path ไปไฟล์ภาพจริงใน public/assets/images/mini-game/vitality-steps/ */
  artAsset: string
  waypoints: { x: number; y: number }[]
  entryPct: { x: number; y: number }
  exitPct: { x: number; y: number }
}

export type JourneyStatus = 'IN_PROGRESS' | 'COMPLETED_EARLY' | 'COMPLETED_ON_TIME' | 'COMPLETED_LATE' | 'FAILED'

/** ทริปเดินของผู้เล่น 1 คน 1 รอบ — client-only mock เท่านั้นในเฟสนี้ (ยังไม่มีตาราง journeys
 *  จริงฝั่ง backend) เก็บใน mockDb.ts เหมือน activeJourney field เดิม
 *
 * [เฟสนี้ — ตัดสินใจง่ายกว่าแผนต้นฉบับ] currentMapId เท่ากับ destinationMapId เสมอ (ไม่มีกลไก
 * ไล่เดินข้ามหลายแผนที่ตามลำดับในเฟสนี้ — เลือกปลายทางเดียวแล้วเดินข้ามแผนที่ใบนั้นใบเดียวจบ)
 * เก็บ 2 ฟิลด์แยกกันไว้เผื่ออนาคตอยากทำ "ทริปหลายด่านต่อกัน" จริงจัง จะได้ไม่ต้อง migrate ชนิด
 * ข้อมูลใหม่อีกรอบ */
export interface JourneyRecord {
  id: string
  userId: string
  destinationMapId: string
  currentMapId: string
  progressOnCurrentMapSteps: number
  startedAt: string
  /** เวลาหมดเขต — ให้ 3 วันต่อ 1 แผนที่ (ดู DEFAULT_JOURNEY_DEADLINE_DAYS ใน journeyRules.ts)
   *  ค่านี้ยังไม่ใช่ตัวเลขที่ balance มาแล้วจริงจัง เป็นจุดเริ่มต้นที่สมเหตุสมผลเท่านั้น */
  deadlineAt: string
  status: JourneyStatus
}

