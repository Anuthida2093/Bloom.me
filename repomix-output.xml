          margin-top: 16px; animation: questGateShadow 4s ease-in-out infinite;
        }
        .quest-gate-view__quote {
          margin-top: 24px; color: ${TEXT_11}; font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600;
          background: var(--glass-b-40); padding: 8px 20px; border-radius: var(--r-pill);
          backdrop-filter: blur(8px); border: 1px solid ${theme.itemBorder}55;
        }
        .quest-gate-view__safety-link {
  margin-top: 14px;
  border: none;
  background: transparent;
  --lc-text-1: #ffb3c6;
  color: var(--lc-text-1);
  font-size: var(--fs-xs);
  text-decoration: underline;
  cursor: pointer;
}
        @keyframes questGateFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-18px); } }
        @keyframes questGateShadow { 0%,100% { transform: scale(1); opacity: .5; } 50% { transform: scale(.8); opacity: .25; } }

        .quest-gate-view__fab { position: absolute; bottom: 24px; left: 24px; z-index: 20; }
        .quest-gate-view__fab-main {
          width: 64px; height: 64px; border-radius: 50%;
          background: linear-gradient(135deg, ${theme.fabFrom}, ${theme.fabTo});
          border: 3px solid var(--fixed-white); color: var(--fixed-white); font-size: 26px;
          display: flex; align-items: center; justify-content: center;
          box-shadow: 0 8px 20px ${theme.fabTo}88; cursor: pointer; position: relative; z-index: 2;
          transition: transform .3s var(--ease-spring);
        }
        .quest-gate-view__fab-menu {
          position: absolute; bottom: 74px; left: 8px;
          display: flex; flex-direction: column-reverse; gap: 12px; pointer-events: none;
        }
        .quest-gate-view__fab.open .quest-gate-view__fab-menu { pointer-events: auto; }
        .quest-gate-view__fab-item {
          position: relative; width: 48px; height: 48px; border-radius: 50%;
