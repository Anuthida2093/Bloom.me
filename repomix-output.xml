import { useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import '../games.css'

/*  ความสำเร็จ Mirror of Truth (กระจกแห่งความจริง)
    ทฤษฎี: Deliberate Practice — คุณค่าของ Feedback ทันที (Ericsson et al., 1993)
    ─────────────────────────────────────────────────────────────
    การฝึกที่ได้ผลต้องมี Feedback ทันทีเพื่อรู้ข้อผิดพลาดและแก้ได้ เกมนี้บังคับครบ 3 ช่อง:
    แหล่ง feedback / สิ่งที่พบว่ายังผิดพลาด / สิ่งที่จะแก้ในครั้งถัดไป
    ขาดข้อใดข้อหนึ่ง = ยังไม่ครบวงจร Deliberate Practice จึงยังกดผ่านไม่ได้         */

const SOURCES = [
  { id: 'self-check', label: 'ตรวจคำตอบเองทันที' },
  { id: 'expert', label: 'ให้ผู้รู้/ครูวิจารณ์' },
  { id: 'peer', label: 'ให้เพื่อนช่วยดู' },
  { id: 'system', label: 'ระบบ/เฉลยอัตโนมัติ' },
]

export default function MirrorOfTruthGame({ finish }: QuestGameProps) {
  const { logActivity } = useAppContext()
  const [source, setSource] = useState<string | null>(null)
  const [gap, setGap] = useState('')
  const [fix, setFix] = useState('')

  const canSubmit = source !== null && gap.trim().length >= 5 && fix.trim().length >= 5

  const handleSubmit = () => {
    logActivity({ activityType: 'FEEDBACK', durationSeconds: 0, meta: { source, gap, fix } })
    finish({ source, gap, fix })
  }

  return (
    <div className="qg">
      <div className="qg-card">
        <span className="qg-label">วันนี้ได้ Feedback มาจากไหน</span>
        <div className="qg-chips">
          {SOURCES.map((s) => (
            <button key={s.id} className={`qg-chip${source === s.id ? ' is-active' : ''}`} onClick={() => setSource(s.id)}>
              {s.label}
            </button>
          ))}
        </div>
      </div>

      <div className="qg-card">
        <label className="qg-label" htmlFor="mt-gap">กระจกสะท้อนว่ายังพลาดตรงไหน</label>
        <textarea id="mt-gap" className="qg-textarea" value={gap} onChange={(e) => setGap(e.target.value)} placeholder="เช่น ลืมเช็กเงื่อนไขขอบเขตทุกครั้ง" />
      </div>

      <div className="qg-card">
        <label className="qg-label" htmlFor="mt-fix">ครั้งหน้าจะแก้ยังไงให้ต่างจากเดิม</label>
        <textarea id="mt-fix" className="qg-textarea" value={fix} onChange={(e) => setFix(e.target.value)} placeholder="เช่น เขียนเช็กลิสต์ 3 ข้อไว้ข้างโจทย์ก่อนส่ง" />
        <p className="qg-hint" style={{ marginTop: 6 }}>Feedback ที่ไม่ถูกแปลงเป็นการกระทำครั้งถัดไป จะไม่เปลี่ยนอะไรเลย</p>
      </div>

      <button className="qg-btn" disabled={!canSubmit} onClick={handleSubmit}>ส่องกระจกเสร็จแล้ว</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/learning/StrategicDelayGame.tsx">
import { useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import '../games.css'

/*  ความสำเร็จ Strategic Delay (กลยุทธ์รอคอย)
    ทฤษฎี: Spacing Effect (Cepeda et al., 2008)
    ─────────────────────────────────────────────────────────────
    วางแผนทบทวน "รายเดือน" ไม่ใช่รายสัปดาห์ — เกมนี้ให้ผู้ใช้ตั้งเป้าหมายระยะยาว
    แล้วระบบคำนวณตารางทบทวน 3 รอบให้อัตโนมัติตามสัดส่วน 5-10% ของช่วงเวลา       */

function addDays(days: number): string {
  const d = new Date()
  d.setDate(d.getDate() + days)
  return d.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' })
}

export default function StrategicDelayGame({ finish }: QuestGameProps) {
  const { logActivity } = useAppContext()
  const [topic, setTopic] = useState('')
  const [horizonMonths, setHorizonMonths] = useState(6)

  const gapDays = Math.round((horizonMonths * 30) * 0.08) // ~8% ของช่วงเวลาทั้งหมด
  const schedule = [gapDays, gapDays * 2, gapDays * 3]
  const canSubmit = topic.trim().length >= 2

  const handleSubmit = () => {
    logActivity({ activityType: 'REVIEW', durationSeconds: 0, meta: { topic, horizonMonths, gapDays, mode: 'strategic-delay' } })
    finish({ topic, horizonMonths, gapDays, schedule })
  }

  return (
    <div className="qg">
      <div className="qg-card">
        <label className="qg-label" htmlFor="sd-topic">เรื่องที่อยากจำให้ได้ยาวๆ</label>
        <input id="sd-topic" className="qg-input" value={topic} onChange={(e) => setTopic(e.target.value)} placeholder="เช่น คำศัพท์ TOEIC ชุดที่ 1" />
      </div>

      <div className="qg-card">
        <span className="qg-label">อยากให้จำได้นานแค่ไหน</span>
        <div className="qg-chips">
          {[3, 6, 12].map((m) => (
            <button key={m} className={`qg-chip${horizonMonths === m ? ' is-active' : ''}`} onClick={() => setHorizonMonths(m)}>
              {m} เดือน
            </button>
          ))}
        </div>
      </div>

      <div className="qg-card">
        <div className="qg-title">ตารางทบทวนที่ระบบวางให้</div>
        <p className="qg-hint" style={{ marginBottom: 10 }}>
          เว้นระยะห่างรอบละ {gapDays} วัน (ราว 8% ของ {horizonMonths} เดือน) — ห่างกว่านี้จะลืม ถี่กว่านี้จะเสียเวลาเปล่า
        </p>
        <div className="qg-stat-grid">
          {schedule.map((d, i) => (
            <div className="qg-stat" key={d}>
              <strong>{addDays(d)}</strong>
              <span>รอบที่ {i + 1}</span>
            </div>
          ))}
        </div>
      </div>

      <button className="qg-btn" disabled={!canSubmit} onClick={handleSubmit}>ตั้งตารางรอคอยนี้</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/learning/TenYearForestGame.tsx">
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import '../games.css'

/*  ความสำเร็จ Ten-Year Forest (ป่าแห่งสิบปี)  — เควสแบบ passive
    ทฤษฎี: The 10-Year Rule (Ericsson et al., 1993)
    ─────────────────────────────────────────────────────────────
    ความเป็นเลิศมาจากการสะสมการฝึกอย่างจงใจนับสิบปี ไม่ใช่พรสวรรค์
    หน้านี้แสดงปฏิทิน streak 28 วันล่าสุด + วงปีที่สะสมได้ (1 วงปี = 30 วันต่อเนื่อง)  */

export default function TenYearForestGame({ finish }: QuestGameProps) {
  const { userData, questLogs } = useAppContext()
  const streak = userData.streak
  const rings = Math.floor(streak / 30)

  // วาดปฏิทิน 28 ช่องล่าสุด — ช่องที่ทำเควสสำเร็จจะสว่าง
  const completedDates = new Set(
    questLogs
      .filter((l) => l.status === 'COMPLETED' && l.completedAt)
      .map((l) => new Date(l.completedAt as string).toDateString()),
  )
  const days = Array.from({ length: 28 }).map((_, i) => {
    const d = new Date()
    d.setDate(d.getDate() - (27 - i))
    return { key: d.toDateString(), label: d.getDate(), active: completedDates.has(d.toDateString()) }
  })

  return (
    <div className="qg">
      <div className="qg-stat-grid">
        <div className="qg-stat"><strong>{streak}</strong><span>วันต่อเนื่อง</span></div>
        <div className="qg-stat"><strong>{rings}</strong><span>วงปีที่สะสมได้</span></div>
        <div className="qg-stat"><strong>{completedDates.size}</strong><span>วันที่มีการฝึก</span></div>
      </div>

      <div className="qg-card">
        <div className="qg-title">28 วันล่าสุด</div>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: 6, marginTop: 10 }}>
          {days.map((d) => (
            <div
              key={d.key}
              title={d.key}
              style={{
                aspectRatio: '1', borderRadius: 10, display: 'flex', alignItems: 'center', justifyContent: 'center',
                fontSize: 11, fontWeight: 800,
                background: d.active ? 'var(--game-accent)' : 'var(--glass-w-7)',
                color: d.active ? 'var(--fixed-white)' : 'var(--glass-w-35)',
                border: '1px solid var(--glass-w-12)',
              }}
            >
              {d.label}
            </div>
          ))}
        </div>
        <p className="qg-hint" style={{ marginTop: 12 }}>
          ไม่จำเป็นต้องทำเยอะทุกวัน แต่ต้องไม่ขาด — วงปีของลำต้นเพิ่มขึ้น 1 วงต่อการต่อเนื่องครบ 30 วัน
        </p>
      </div>

      <button className="qg-btn qg-btn--ghost" onClick={() => finish({ streak, rings })}>ปิดหน้านี้</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/learning/TimeCapsuleGame.tsx">
import { useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import '../games.css'

/*  เควส Time Capsule Watering (รดน้ำข้ามเวลา)
    ทฤษฎี: Spacing Effect (Cepeda et al., 2008)
    ─────────────────────────────────────────────────────────────
    การเว้นระยะทบทวนให้ผลดีกว่าอัดรวดเดียว ระยะที่เหมาะขึ้นกับว่าจะจำไปนานแค่ไหน
    เกมนี้บังคับให้ "หยิบของเก่ามาทบทวน" จริงๆ: เลือกได้เฉพาะวันย้อนหลัง 1-2 วัน
    (เป้าหมายระยะสั้น) หรือ ~30 วัน (เป้าหมายระยะยาว) ห้ามเลือกเนื้อหาของวันนี้    */

type Track = 'short' | 'long'

function dateLabel(daysAgo: number): string {
  const d = new Date()
  d.setDate(d.getDate() - daysAgo)
  return d.toLocaleDateString('th-TH', { day: 'numeric', month: 'short' })
}

export default function TimeCapsuleGame({ finish }: QuestGameProps) {
  const { logActivity } = useAppContext()
  const [track, setTrack] = useState<Track>('short')
  const [daysAgo, setDaysAgo] = useState<number | null>(null)
  const [topic, setTopic] = useState('')
  const [reviewed, setReviewed] = useState(false)

  const options = track === 'short' ? [1, 2, 3] : [14, 30, 60]
  const canReview = daysAgo !== null && topic.trim().length >= 2

  const handleFinish = () => {
    const nextReview = new Date()
    nextReview.setDate(nextReview.getDate() + (track === 'short' ? 3 : 30))
    logActivity({ activityType: 'REVIEW', durationSeconds: 0, meta: { track, daysAgo, topic } })
    finish({ track, daysAgo, topic, nextReviewAt: nextReview.toISOString() })
  }

  return (
    <div className="qg">
      <div className="qg-card">
        <span className="qg-label">เป้าหมายของการจำครั้งนี้</span>
        <div className="qg-chips">
          <button className={`qg-chip${track === 'short' ? ' is-active' : ''}`} onClick={() => { setTrack('short'); setDaysAgo(null) }}>
            🎯 สอบเร็วๆ นี้ (ทบทวนของ 1-3 วันก่อน)
          </button>
          <button className={`qg-chip${track === 'long' ? ' is-active' : ''}`} onClick={() => { setTrack('long'); setDaysAgo(null) }}>
            🌳 จำไปยาวๆ (ทบทวนของ 2 สัปดาห์–2 เดือนก่อน)
          </button>
        </div>
        <p className="qg-hint" style={{ marginTop: 10 }}>
          ถ้าอยากจำได้เป็นปี ระยะห่างในการทบทวนควรเป็นราว 5-10% ของช่วงเวลานั้น — ทบทวนรายเดือนจึงเพียงพอ
        </p>
      </div>

      <div className="qg-card">
        <span className="qg-label">หยิบเนื้อหาของวันไหนมาทบทวน</span>
        <div className="qg-chips">
          {options.map((d) => (
            <button key={d} className={`qg-chip${daysAgo === d ? ' is-active' : ''}`} onClick={() => setDaysAgo(d)}>
              {dateLabel(d)} · {d} วันก่อน
            </button>
          ))}
        </div>
      </div>

      <div className="qg-card">
        <label className="qg-label" htmlFor="tc-topic">หัวข้อที่หยิบมาทบทวน</label>
        <input id="tc-topic" className="qg-input" value={topic} onChange={(e) => setTopic(e.target.value)} placeholder="เช่น สมการกำลังสอง" />
      </div>

      {!reviewed ? (
        <button className="qg-btn" disabled={!canReview} onClick={() => setReviewed(true)}>
          เปิดแคปซูลแล้ว เริ่มทบทวน
        </button>
      ) : (
        <>
          <div className="qg-card qg-center">
            <div className="qg-title">ทบทวนโดยไม่เปิดเฉลยก่อนนะ</div>
            <p className="qg-hint">ลองนึกให้ได้มากที่สุดก่อน แล้วค่อยเปิดดูว่าตรงไหนหาย — การพยายามนึกคือตัวที่ทำให้จำ ไม่ใช่การอ่านซ้ำ</p>
          </div>
          <button className="qg-btn" onClick={handleFinish}>ทบทวนเสร็จแล้ว รดน้ำต้นไม้</button>
        </>
      )}
    </div>
  )
}
</file>

