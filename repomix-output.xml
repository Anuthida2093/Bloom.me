import type { MoodEntryData } from '../../../types'
import type { OracleCard } from './oracleCardData'
import { seededRandom } from '../../../utils/seededRandom'

/*============================================================================*\
  oracleMessageGenerator.ts — [ไฟล์ใหม่] เครื่องปั้นข้อความให้กำลังใจ "1,000+ แบบไม่ซ้ำ"
  ────────────────────────────────────────────────────────────────────────────
  ตามที่ขอ: ห้ามเรียก API เสียเงิน/ละเมิดลิขสิทธิ์ — ใช้วิธี Combinatorics แทน
  เขียนคลัง "ประโยคย่อย" 3 ชุดแยกตามอารมณ์ (prefix / core / suffix) แล้วสุ่มผสมกัน
  แบบ deterministic (seed เดิม = ข้อความเดิมเป๊ะ กันข้อความกระพริบเปลี่ยนตอน re-render)
  จำนวนชุดค่าผสมต่ออารมณ์ = prefixes.length × cores.length × suffixes.length
