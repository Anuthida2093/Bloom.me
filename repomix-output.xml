import { useEffect, useRef, useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import { playSfx } from '../../../../utils/audioPlayer'
import '../games.css'
import './PureWaterGame.css'

/*  เควส Pure Water (น้ำพุหล่อเลี้ยงราก)
    ทฤษฎี: Hydration & Cognitive Performance — ขาดน้ำเพียง 1-2% ความจำ
    การประมวลผล และสมาธิลดลงอย่างมีนัยสำคัญ
    ─────────────────────────────────────────────────────────────
    ออกแบบให้ "กดค้างเท่ากับเวลาที่ดื่มจริง" (3 วินาที) แทนปุ่มกดยืนยันครั้งเดียว
    เพราะปุ่มกดครั้งเดียวกดผ่านได้โดยไม่ต้องลุกไปดื่มจริง — การต้องถือค้างพร้อมยกแก้ว
    ทำให้ผู้ใช้ต้องมีแก้วอยู่ในมือจริงๆ และแก้วบนจอจะค่อยๆ ว่างลงตามเวลาที่กดค้าง    */

const DRINK_MS = 3000

export default function PureWaterGame({ finish }: QuestGameProps) {
  const { logActivity, settings } = useAppContext()
  const [progress, setProgress] = useState(0)
  const [holding, setHolding] = useState(false)
  const [glasses, setGlasses] = useState(0)
  const rafRef = useRef<number | null>(null)
  const startRef = useRef(0)

  useEffect(() => {
    if (!holding) return
    startRef.current = performance.now() - progress * DRINK_MS
    const tick = (now: number) => {
      const p = Math.min(1, (now - startRef.current) / DRINK_MS)
      setProgress(p)
      if (p >= 1) {
        setHolding(false)
        setGlasses((g) => g + 1)
        setProgress(0)
        playSfx('WATER_DROP', { volume: settings.sfxVolume, enabled: settings.soundEnabled })
        return
      }
      rafRef.current = requestAnimationFrame(tick)
    }
    rafRef.current = requestAnimationFrame(tick)
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current) }
    // progress ตั้งใจไม่ใส่ใน deps — อ่านแค่ตอนเริ่ม effect (กดค้างใหม่) เท่านั้น ถ้าใส่ไว้
    // effect จะรีสตาร์ตทุกครั้งที่ setProgress ใน tick() ทำงาน ทำให้ raf loop กระตุกทุกเฟรม
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [holding, settings.sfxVolume, settings.soundEnabled])

  const release = () => {
    setHolding(false)
    setProgress(0)
  }

  const handleFinish = () => {
    logActivity({ activityType: 'HYDRATION', durationSeconds: glasses * 3, meta: { glasses } })
    finish({ glasses })
  }

  return (
    <div className="qg qg-center">
      <div className="pure-water__glass" aria-hidden="true">
        <div className="pure-water__water" style={{ height: `${(1 - progress) * 100}%` }} />
        <div className="pure-water__shine" />
      </div>

      <div className="qg-title">{glasses > 0 ? `ดื่มไปแล้ว ${glasses} แก้ว` : 'ยกแก้วขึ้นมา แล้วกดค้างไว้ขณะดื่ม'}</div>

      <button
        className="qg-btn"
        style={{ maxWidth: 260 }}
        onPointerDown={() => setHolding(true)}
        onPointerUp={release}
        onPointerLeave={release}
        onPointerCancel={release}
      >
        {holding ? 'กำลังดื่ม... อย่าเพิ่งปล่อย' : 'กดค้างขณะดื่ม'}
      </button>

      <div className="qg-card">
        <p className="qg-hint">
          น้ำ 1 แก้วเต็มทันทีหลังตื่นนอนช่วยชดเชยน้ำที่เสียไประหว่างหลับ 6-8 ชั่วโมง
          และเป็นตัวกระตุ้นระบบเผาผลาญให้ร่างกายตื่นตัว
        </p>
      </div>

      <button className="qg-btn" disabled={glasses === 0} onClick={handleFinish}>
        {glasses === 0 ? 'ยังไม่ได้ดื่มเลย' : 'บันทึกการดื่มน้ำ'}
      </button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/physical/SoilRestorationGame.tsx">
import { useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import '../games.css'

/*  ความสำเร็จ Soil Restoration (ฟื้นฟูหน้าดิน / ตัดจอก่อนนอน)
    ทฤษฎี: Blue Light & Melatonin Suppression
    ─────────────────────────────────────────────────────────────
    แสงสีฟ้าจากจอยับยั้งการหลั่งเมลาโทนิน ทำให้ร่างกายไม่พร้อมพักผ่อน
    เกมนี้ให้ตั้ง "เวลานอนจริง" แล้วคำนวณเวลาเริ่มตัดจอ (ก่อนนอน 1-2 ชม.) ให้อัตโนมัติ
    ค่าที่ได้ถูกส่งเข้า setScreenCurfew() ซึ่ง QuestSection จะใช้ล็อกเควสเรียนช่วงดึก
    (ต้องเพิ่มคอลัมน์ users.bedtime + users.curfewHours — ดู docs/DB_CHANGES.md ข้อ 1) */

function shiftTime(hhmm: string, minusHours: number): string {
  const [h, m] = hhmm.split(':').map(Number)
  const total = (h * 60 + m - minusHours * 60 + 1440) % 1440
  return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`
}

export default function SoilRestorationGame({ finish }: QuestGameProps) {
  const { logActivity, setScreenCurfew } = useAppContext()
  const [bedtime, setBedtime] = useState('23:00')
  const [curfewHours, setCurfewHours] = useState(1)
  const curfewStart = shiftTime(bedtime, curfewHours)

  const handleSubmit = () => {
    setScreenCurfew({ bedtime, curfewHours })
    logActivity({ activityType: 'SCREEN_CURFEW', durationSeconds: curfewHours * 3600, meta: { bedtime, curfewStart } })
    finish({ bedtime, curfewHours, curfewStart })
  }

  return (
    <div className="qg">
      <div className="qg-card">
        <label className="qg-label" htmlFor="sr-bedtime">คืนนี้ตั้งใจจะเข้านอนกี่โมง</label>
        <input id="sr-bedtime" className="qg-input" type="time" value={bedtime} onChange={(e) => setBedtime(e.target.value)} />
      </div>

      <div className="qg-card">
        <span className="qg-label">จะตัดจอก่อนนอนกี่ชั่วโมง</span>
        <div className="qg-chips">
          {[1, 2].map((h) => (
            <button key={h} className={`qg-chip${curfewHours === h ? ' is-active' : ''}`} onClick={() => setCurfewHours(h)}>
              {h} ชั่วโมง
            </button>
          ))}
        </div>
      </div>

      <div className="qg-card qg-center">
        <div className="qg-title">โหมดตัดจอเริ่ม {curfewStart} น.</div>
        <p className="qg-hint">
          ตั้งแต่เวลานี้เป็นต้นไป ระบบจะล็อกเควสเรียนที่ใช้พลังงานสูงและเตือนให้วางจอ
          เพื่อให้เมลาโทนินหลั่งได้ตามปกติ รากแก้วจะได้ฟื้นตัวตลอดคืน
        </p>
      </div>

      <button className="qg-btn" onClick={handleSubmit}>ตั้งเวลาตัดจอ</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/games.css">
/* ═══════════════════════════════════════════════════════════════
   games.css — สไตล์กลางที่ไฟล์เกมทุกเควสใช้ร่วมกัน (prefix .qg-)
   แก้ที่นี่ที่เดียว หน้าตาเกมทุกเควสเปลี่ยนตามทั้งหมด
   ═══════════════════════════════════════════════════════════════ */

.qg { display: flex; flex-direction: column; gap: 14px; width: 100%; }

.qg-card {
  border-radius: 20px;
  background: var(--glass-w-7);
  border: 1px solid var(--glass-w-14);
  padding: 18px;
  backdrop-filter: blur(8px);
}

.qg-label {
  display: block;
  font-size: 12px;
  font-weight: 800;
  color: var(--glass-w-72);
  margin-bottom: 6px;
}
.qg-hint { font-size: 11.5px; line-height: 1.7; color: var(--glass-w-50); }

.qg-input,
.qg-textarea,
.qg-select {
  width: 100%;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1.5px solid var(--glass-w-20);
  background: var(--glass-b-24);
  color: var(--fixed-white);
  font-family: inherit;
  font-size: 13.5px;
  outline: none;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}
.qg-textarea { resize: vertical; min-height: 92px; line-height: 1.7; }
.qg-input:focus,
.qg-textarea:focus,
.qg-select:focus {
  border-color: var(--game-accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--game-accent) 30%, transparent);
}
.qg-input::placeholder, .qg-textarea::placeholder {
  --lc-text-12: rgba(255, 255, 255, 0.32);
  color: var(--lc-text-12);
}
.qg-select option {
  --lc-bg-11: #12332A;
  background: var(--lc-bg-11);
  color: var(--fixed-white);
}

.qg-btn {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 99px;
  background: linear-gradient(135deg, var(--fixed-white), var(--game-accent-bg));
  --lc-text-10: #10281F;
  color: var(--lc-text-10);
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 15px;
  cursor: pointer;
  box-shadow: 0 10px 26px var(--glass-b-30);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.qg-btn:hover:not(:disabled) { transform: translateY(-2px); }
.qg-btn:disabled { opacity: 0.42; cursor: not-allowed; box-shadow: none; }

.qg-btn--ghost {
  background: var(--glass-w-9);
  color: var(--glass-w-85);
  border: 1px solid var(--glass-w-22);
  box-shadow: none;
  font-size: 13.5px;
}

.qg-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.qg-chip {
  padding: 9px 15px;
  border-radius: 99px;
  border: 1.5px solid var(--glass-w-22);
  background: var(--glass-w-6);
  --lc-text-9: rgba(255, 255, 255, 0.78);
  color: var(--lc-text-9);
  font-family: inherit;
  font-weight: 700;
  font-size: 12.5px;
  cursor: pointer;
  transition: all 0.18s ease;
}
.qg-chip:hover { background: var(--glass-w-14); }
.qg-chip.is-active {
  border-color: var(--game-accent);
  background: var(--game-accent);
  color: var(--fixed-white);
}

/* ── วงแหวนจับเวลา ── */
.qg-ring-wrap {
  position: relative;
  width: min(60vw, 208px);
  height: min(60vw, 208px);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qg-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
.qg-ring__track { fill: none; stroke: var(--glass-w-13); stroke-width: 5; }
.qg-ring__fill {
  fill: none;
  stroke: var(--game-accent);
  stroke-width: 5;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.5s linear;
  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--game-accent) 60%, transparent));
}
.qg-ring__center { text-align: center; }
.qg-ring__value {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: clamp(26px, 8vw, 38px);
  color: var(--fixed-white);
  letter-spacing: 1px;
}
.qg-ring__label { font-size: 11.5px; color: var(--glass-w-55); margin-top: 2px; }

/* ── ดาวให้คะแนน ── */
.qg-stars { display: flex; gap: 4px; }
.qg-stars button {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 25px;
  line-height: 1;
  padding: 2px;
  color: var(--glass-w-20);
  transition: transform 0.15s ease, color 0.15s ease;
}
.qg-stars button.is-on {
  --lc-text-7: #F6C445;
  color: var(--lc-text-7);
  --lc-c-8: rgba(246, 196, 69, 0.5);
  text-shadow: 0 0 12px var(--lc-c-8);
}
.qg-stars button:hover { transform: scale(1.16); }

/* ── แถบความคืบหน้า ── */
.qg-progress {
  height: 9px;
  border-radius: 99px;
  background: var(--glass-w-14);
  overflow: hidden;
}
.qg-progress__fill {
  height: 100%;
  border-radius: 99px;
  background: var(--game-accent);
  transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ── ป้ายสถานะ ── */
.qg-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 13px;
  border-radius: 99px;
  font-size: 11.5px;
  font-weight: 800;
  background: var(--glass-w-12);
  color: var(--glass-w-80);
}
.qg-tag--warn {
  --lc-bg-5: rgba(255, 196, 100, 0.16);
  background: var(--lc-bg-5);
  --lc-text-6: #FFD9A8;
  color: var(--lc-text-6);
}
.qg-tag--ok {
  --lc-bg-3: rgba(111, 207, 151, 0.18);
  background: var(--lc-bg-3);
  --lc-text-4: #B7EFC5;
  color: var(--lc-text-4);
}
.qg-tag--danger {
  --lc-bg-1: rgba(239, 71, 111, 0.18);
  background: var(--lc-bg-1);
  --lc-text-2: #FFB3C6;
  color: var(--lc-text-2);
}

.qg-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.qg-stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); gap: 10px; }
.qg-stat {
  border-radius: 16px;
  background: var(--glass-w-7);
  border: 1px solid var(--glass-w-12);
  padding: 13px 10px;
  text-align: center;
}
.qg-stat strong {
  display: block;
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-weight: 400;
  font-size: 21px;
  color: var(--fixed-white);
}
.qg-stat span { font-size: 10.5px; color: var(--glass-w-55); }

.qg-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 16px;
  color: var(--fixed-white);
  margin-bottom: 4px;
}
.qg-center { text-align: center; }
</file>

<file path="src/components/quest/games/GameShell.css">
/* ═══════════════════════════════════════════════════════════════
   GameShell.css — ห้องเล่นเควสเต็มกรอบเขียว
   [กติกาสำคัญ] absolute + inset:0 → ครอบเฉพาะ .gameplay-frame
   (ซึ่งเป็น position:relative) ไม่ทะลุออกนอกกรอบเขียวเด็ดขาด
   ═══════════════════════════════════════════════════════════════ */

.game-shell {
  position: absolute;
  inset: 0;
  z-index: 800;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  --lc-bg-11: #123528;
  --lc-bg-12: #0C2A20;
  --lc-bg-13: #071A14;
  background: linear-gradient(165deg, var(--lc-bg-11) 0%, var(--lc-bg-12) 55%, var(--lc-bg-13) 100%);
  --lc-text-14: #EAF4EE;
  color: var(--lc-text-14);
  font-family: 'Nunito', 'Mali', sans-serif;
  --game-accent: var(--g600);
  --lc-c-15: #D8F3DC;
  --game-accent-bg: var(--lc-c-15);
}

.game-shell__scenery {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(60% 45% at 22% 12%, color-mix(in srgb, var(--game-accent) 40%, transparent), transparent 70%),
    radial-gradient(55% 45% at 82% 88%, color-mix(in srgb, var(--game-accent) 28%, transparent), transparent 72%);
  opacity: 0.55;
  filter: blur(30px);
  pointer-events: none;
}

/* ── หัวเรื่อง ── */
.game-shell__header {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px 12px 58px; /* เว้นซ้าย 58px ให้ปุ่มเต็มจอของ GameplayFrame */
  border-bottom: 1px solid var(--glass-w-10);
}
.game-shell__heading { display: flex; align-items: center; gap: 12px; min-width: 0; }
.game-shell__icon {
  font-size: 30px;
  filter: drop-shadow(0 4px 10px var(--glass-b-35));
  flex-shrink: 0;
}
.game-shell__title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 18px;
  color: var(--fixed-white);
  line-height: 1.25;
}
.game-shell__subtitle {
  font-size: 11px;
  --lc-text-10: rgba(234, 244, 238, 0.55);
  color: var(--lc-text-10);
}
.game-shell__close {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-14);
  color: var(--fixed-white);
  font-size: 14px;
  cursor: pointer;
  transition: background 0.18s ease, transform 0.18s ease;
}
.game-shell__close:hover { background: var(--glass-w-28); transform: scale(1.08); }
.game-shell__close:focus-visible { outline: 2px solid var(--game-accent); outline-offset: 2px; }

/* ── เนื้อหา ── */
.game-shell__body {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16px 18px 26px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}
.game-shell__brief {
  width: 100%;
  max-width: 620px;
  border-radius: 16px;
  border: 1px dashed var(--glass-w-22);
  background: var(--glass-w-5);
  padding: 12px 16px;
}
.game-shell__howto {
  font-size: 12.5px;
  line-height: 1.8;
  --lc-text-9: rgba(234, 244, 238, 0.85);
  color: var(--lc-text-9);
}
.game-shell__theory {
  margin-top: 6px;
  font-size: 10.5px;
  --lc-text-8: rgba(234, 244, 238, 0.45);
  color: var(--lc-text-8);
  line-height: 1.6;
}

.game-shell__stage { width: 100%; max-width: 620px; flex: 1; }

/* ── ฉากรับรางวัล ── */
.game-shell__reward {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px 22px;
}
.game-shell__reward-drops { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.game-shell__reward-drops span {
  position: absolute;
  top: -30px;
  font-size: 17px;
  animation: gameShellDrop 1.6s ease-in both;
}
@keyframes gameShellDrop {
  0%   { transform: translateY(0) rotate(0); opacity: 0; }
  15%  { opacity: 1; }
  100% { transform: translateY(70vh) rotate(220deg); opacity: 0; }
}
.game-shell__reward-icon { font-size: 54px; }
.game-shell__reward-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 24px;
  color: var(--fixed-white);
  margin: 6px 0 4px;
}
.game-shell__reward-text {
  font-size: 13px;
  --lc-text-7: rgba(234, 244, 238, 0.72);
  color: var(--lc-text-7);
  margin-bottom: 22px;
  max-width: 340px;
  line-height: 1.7;
}
.game-shell__reward-cards { display: flex; gap: 12px; margin-bottom: 24px; }
.game-shell__reward-cards div {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 110px;
  padding: 14px 18px;
  border-radius: 18px;
  background: var(--glass-w-10);
  border: 1px solid var(--glass-w-16);
  font-size: 10.5px;
  --lc-text-6: rgba(234, 244, 238, 0.6);
  color: var(--lc-text-6);
  animation: gameShellCardPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.game-shell__reward-cards div:nth-child(2) { animation-delay: 0.12s; }
.game-shell__reward-cards span { font-size: 24px; }
.game-shell__reward-cards strong {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-weight: 400;
  font-size: 20px;
  color: var(--fixed-white);
}
@keyframes gameShellCardPop {
  from { opacity: 0; transform: translateY(12px) scale(0.8); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.game-shell__claim {
  min-width: 220px;
  padding: 15px 28px;
  border: none;
  border-radius: 99px;
  background: linear-gradient(135deg, var(--fixed-white), var(--game-accent-bg));
  --lc-text-5: #0B241B;
  color: var(--lc-text-5);
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 16px;
  cursor: pointer;
  box-shadow: 0 12px 30px var(--glass-b-35);
  transition: transform 0.15s ease;
}
.game-shell__claim:hover { transform: translateY(-2px); }

/* ── ยืนยันออกกลางคัน ── */
.game-shell__confirm {
  position: absolute;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  --lc-bg-4: rgba(5, 18, 13, 0.76);
  background: var(--lc-bg-4);
  backdrop-filter: blur(8px);
}
.game-shell__confirm-card {
  width: 100%;
  max-width: 330px;
  border-radius: 22px;
  --lc-bg-3: #12332A;
  background: var(--lc-bg-3);
  border: 1px solid var(--glass-w-16);
  padding: 26px 22px;
  text-align: center;
}
.game-shell__confirm-icon { font-size: 32px; margin-bottom: 8px; }
.game-shell__confirm-card p {
  font-size: 13px;
  line-height: 1.75;
  --lc-text-2: rgba(234, 244, 238, 0.82);
  color: var(--lc-text-2);
  margin-bottom: 18px;
}
.game-shell__confirm-actions { display: flex; gap: 8px; }
.game-shell__confirm-actions button {
  flex: 1;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid var(--glass-w-20);
  background: var(--glass-w-7);
  --lc-text-1: rgba(234, 244, 238, 0.82);
  color: var(--lc-text-1);
  font-family: inherit;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
}
.game-shell__confirm-actions .is-primary {
  background: var(--game-accent);
  border-color: var(--game-accent);
  color: var(--fixed-white);
}

@media (max-width: 520px) {
  .game-shell__header { padding: 14px 14px 10px 54px; }
  .game-shell__body { padding: 14px 14px 22px; }
  .game-shell__title { font-size: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .game-shell__reward-drops span,
  .game-shell__reward-cards div { animation: none; }
}
</file>

<file path="src/components/quest/games/GameShell.tsx">
import { useState, type ReactNode } from 'react'
import type { QuestDef } from '../../../config/questCatalog'
import type { QuestPlayPayload } from '../../../types.mental'
import { useEscapeKey } from '../../../hooks/useEscapeKey'
import { useLockBodyScroll } from '../../../hooks/useLockBodyScroll'
import { useAppContext } from '../../../context/AppContext'
import { playSfx } from '../../../utils/audioPlayer'
import './GameShell.css'

/*============================================================================*\
  GameShell — "ห้องเล่นเควสเต็มกรอบเขียว"   [แทนที่การ์ดเล็กกลางจอแบบเดิม]
  ────────────────────────────────────────────────────────────────────────────
  ตามที่ระบุ: ป๊อปอัพที่เล่นเกมต้องเป็นแบบเต็มจอ "ในกรอบเขียว" เท่านั้น ไม่ทะลุจอทั้งหมด
  → ทั้ง shell ใช้ position:absolute; inset:0 ซึ่งจะไปยึดกับ .gameplay-frame ที่เป็น
    position:relative อยู่แล้ว จึงครอบเต็มกรอบเขียวพอดี ไม่ล้นออกไปทับ Navbar/Sidebar

  ของเดิม (QuestPlayModal) เป็นการ์ด maxWidth:460px ลอยกลางจอ ทำให้เกมทุกเควสถูกบีบ
  อยู่ในกล่องแคบๆ เขียนมินิเกมจริงไม่ได้ — shell นี้เปิดพื้นที่เต็มกรอบให้แต่ละเควส
  ไปออกแบบหน้าตาของตัวเองได้อิสระ (ดูไฟล์เกมแต่ละอันใน games/learning, games/physical)

  หน้าที่ของ shell: หัวเรื่อง + ทฤษฎีอ้างอิง + ปุ่มปิด + ฉากรับรางวัลหลังเล่นจบ
  หน้าที่ของไฟล์เกม: เนื้อในล้วนๆ เรียก finish(payload) เมื่อเล่นจบ
\*============================================================================*/

interface GameShellApi {
  finish: (payload?: QuestPlayPayload) => void
  accent: string
  accentBg: string
}

interface GameShellProps {
  quest: QuestDef
  accent: string
  accentBg: string
  /** เรียกตอนเล่นจบจริง (ก่อนหน้ารับรางวัล) — ผู้เรียกใช้เอาไปอัปเดต state/backend */
  onComplete: (questCode: string, payload?: QuestPlayPayload) => void
  onClose: () => void
  /** true = เควสบังคับ (ความเสี่ยงปานกลาง/สูง) ต้องยืนยันก่อนออกกลางคัน */
  forced?: boolean
  children: (api: GameShellApi) => ReactNode
}

export default function GameShell({ quest, accent, accentBg, onComplete, onClose, forced = false, children }: GameShellProps) {
  useLockBodyScroll()
  const { settings } = useAppContext()
  const sfxOpts = { volume: settings.sfxVolume, enabled: settings.soundEnabled }

  const [stage, setStage] = useState<'playing' | 'reward'>('playing')
  const [confirmExit, setConfirmExit] = useState(false)

  // [แก้] รีเซ็ต stage/confirmExit ระหว่าง render ทันทีที่ quest.code เปลี่ยน แทนการ setState
  // ใน effect (react-hooks/set-state-in-effect) — แพทเทิร์น "ปรับ state เมื่อ prop เปลี่ยน"
  const [prevQuestCode, setPrevQuestCode] = useState(quest.code)
  if (quest.code !== prevQuestCode) {
    setPrevQuestCode(quest.code)
    setStage('playing')
    setConfirmExit(false)
  }

  const requestClose = () => {
    if (stage === 'playing' && forced) {
      setConfirmExit(true)
      return
    }
    onClose()
  }

  useEscapeKey(() => {
    if (confirmExit) setConfirmExit(false)
    else requestClose()
  })

  const finish = (payload?: QuestPlayPayload) => {
    playSfx('QUEST_SUCCESS', sfxOpts)
    onComplete(quest.code, payload)
    setStage('reward')
  }

  const claim = () => {
    playSfx('REWARD_CLAIM', sfxOpts)
    onClose()
  }

  return (
    <div className="game-shell" style={{ '--game-accent': accent, '--game-accent-bg': accentBg } as React.CSSProperties}>
      <div className="game-shell__scenery" aria-hidden="true" />

      <header className="game-shell__header">
        <div className="game-shell__heading">
          <span className="game-shell__icon">{quest.icon}</span>
          <div>
            <div className="game-shell__title">{quest.titleTh}</div>
            <div className="game-shell__subtitle">{quest.title}</div>
          </div>
        </div>
        <button className="game-shell__close" onClick={requestClose} title="ปิด" aria-label={`ปิดเควส ${quest.titleTh}`}>✕</button>
      </header>

      {stage === 'playing' ? (
        <div className="game-shell__body">
          <div className="game-shell__brief">
            <p className="game-shell__howto">{quest.howTo}</p>
            {quest.theory && <p className="game-shell__theory">อ้างอิง: {quest.theory}</p>}
          </div>

          <div className="game-shell__stage">
            {children({ finish, accent, accentBg })}
          </div>
        </div>
      ) : (
        <div className="game-shell__reward">
          <div className="game-shell__reward-drops" aria-hidden="true">
            {Array.from({ length: 14 }).map((_, i) => (
              <span key={i} style={{ left: `${(i * 7.1) % 100}%`, animationDelay: `${i * 0.09}s` }}>
                {i % 2 === 0 ? '⭐' : '💧'}
              </span>
            ))}
          </div>
          <div className="game-shell__reward-icon">🎉</div>
          <div className="game-shell__reward-title">เควสสำเร็จแล้ว</div>
          <p className="game-shell__reward-text">ต้นไม้ของคุณเพิ่งได้รับพลังจากสิ่งที่คุณทำเมื่อครู่</p>
          <div className="game-shell__reward-cards">
            <div><span>🪙</span><strong>+{quest.coinReward}</strong>เหรียญละอองดาว</div>
            <div><span>⭐</span><strong>+{quest.expReward}</strong>EXP</div>
          </div>
          <button className="game-shell__claim" onClick={claim}>รับรางวัล</button>
        </div>
      )}

      {confirmExit && (
        <div className="game-shell__confirm">
          <div className="game-shell__confirm-card">
            <div className="game-shell__confirm-icon">🥀</div>
            <p>เควสนี้เป็นเควสฟื้นฟูที่ระบบเลือกไว้ให้ ถ้าออกตอนนี้จะยังไม่นับว่าสำเร็จนะ</p>
            <div className="game-shell__confirm-actions">
              <button className="is-primary" onClick={() => setConfirmExit(false)}>ทำต่อ</button>
              <button onClick={onClose}>ออกก่อน</button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/components/quest/games/GenericConfirmGame.tsx">
import { useState } from 'react'
import type { QuestGameProps } from '../../../types.mental'
import './games.css'

/*  GenericConfirmGame — หน้าจอสำรองสำหรับเควสที่ยังไม่มีไฟล์เกมของตัวเอง
    ไม่ใช่ปุ่ม "ทำสำเร็จ" ลอยๆ แต่บังคับให้ผู้ใช้ยืนยันว่าทำจริงก่อน (accountability)
    ถ้าเพิ่มเควสใหม่แล้วยังไม่ได้เขียนไฟล์เกม ระบบจะตกมาที่หน้านี้แทนการพัง          */

