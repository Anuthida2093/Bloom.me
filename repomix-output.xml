        .quest-gate-view__fab-item:hover:not(:disabled) { background: ${theme.fabTo}; }
        .quest-gate-view__fab.open .quest-gate-view__fab-item { transform: scale(1) translateY(0); opacity: 1; }
        .quest-gate-view__done-badge, .quest-gate-view__lock-badge {
          position: absolute; top: -4px; right: -4px; width: 16px; height: 16px; border-radius: 50%;
          font-size: 9px; display: flex; align-items: center; justify-content: center;
        }
        .quest-gate-view__done-badge { background: var(--g500); color: var(--fixed-white); }
        .quest-gate-view__lock-badge { background: var(--glass-b-60); }

        @media (prefers-reduced-motion: reduce) {
          .quest-gate-view__icon, .quest-gate-view__shadow { animation: none; }
