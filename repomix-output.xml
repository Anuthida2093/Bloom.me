<file path="src/components/tree/MiniTree.css">
.mini-tree-wrap {
  display: inline-block;
  line-height: 0;
}

/* "หายใจ" เบาๆ ทั้งต้น — scale ขึ้นลงช้าๆ ผูกกับขอบล่างเป็นจุดหมุน (ต้นไม้ไม่ลอยขึ้นจากพื้น) */
.mini-tree-wrap--breathing {
  transform-origin: center bottom;
  animation: miniTreeBreathe 3.6s ease-in-out infinite;
}

@keyframes miniTreeBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

/* ใบไม้ไหวเบาๆ (แค่ทรงพุ่ม ลำต้นไม่ขยับ) — คนละจังหวะเวลากับ breathing ข้างบน
   (คาบเวลา/easing ต่างกัน) เพื่อให้ดูเป็นธรรมชาติ ไม่ใช่ล็อกจังหวะเดียวกันทื่อๆ */
.mini-tree__crown--swaying {
  animation: miniTreeSway 2.8s ease-in-out infinite;
}

@keyframes miniTreeSway {
  0%, 100% { transform: rotate(-1.4deg); }
  50% { transform: rotate(1.4deg); }
}

/* เคารพ prefers-reduced-motion — ปิดแอนิเมชันให้คนที่ตั้งค่านี้ไว้ในระบบ */
@media (prefers-reduced-motion: reduce) {
  .mini-tree-wrap--breathing,
  .mini-tree__crown--swaying {
    animation: none;
  }
}
</file>

<file path="src/components/tree/MiniTree.tsx">
import { MBTI_TREE_THEME, type MbtiTreeTheme } from '../../types'
import './MiniTree.css'

interface MiniTreeProps {
  theme?: MbtiTreeTheme
  size?: number
  full?: boolean
  /** เปิด idle animation (หายใจ/ใบไม้ไหวเบาๆ) — ปิดได้ถ้าต้องโชว์หลายสิบต้นพร้อมกันแล้วกลัวหนักเครื่อง */
  animated?: boolean
}

export default function MiniTree({ theme = MBTI_TREE_THEME.INFP, size = 80, full = false, animated = true }: MiniTreeProps) {
  const s = size;
  const h = full ? s * 1.3 : s;
  const cx = s / 2;

  const r1 = s * 0.36;
  const r2 = s * 0.28;
  const r3 = s * 0.22;

  const trunkW = s * 0.12;
  const trunkH = s * 0.28;
  const ty = h * 0.55;

  // จุดหมุน/สเกลของทรงพุ่ม (crown) — ใช้พิกัด px จริงแทนคำว่า "center" เพราะ
  // transform-origin แบบเปอร์เซ็นต์บน SVG element มีพฤติกรรมไม่ตรงกันระหว่างเบราว์เซอร์
  // เก่าๆ (ต้องพึ่ง transform-box: fill-box เพิ่ม) พิกัด px ตรงๆ ชัวร์กว่าและเข้าใจง่ายกว่า
  const crownOriginX = cx;
  const crownOriginY = ty - r1 * 0.6;

  return (
    // wrapper div ทำหน้าที่ "หายใจ" (scale ทั้งต้นเบาๆ) — แยกจาก <g> ใน SVG ที่ทำหน้าที่
    // "ใบไม้ไหว" (rotate เฉพาะทรงพุ่ม) เพื่อให้ 2 แอนิเมชันซ้อนกันแบบเป็นธรรมชาติ ไม่ล็อกจังหวะเดียวกัน
    <div className={`mini-tree-wrap ${animated ? 'mini-tree-wrap--breathing' : ''}`} style={{ width: s, height: h }}>
      <svg
        viewBox={`0 0 ${s} ${h}`}
        width={s}
        height={h}
        xmlns="http://www.w3.org/2000/svg"
      >
        <radialGradient
          id={`lg${s}`}
          cx="40%"
          cy="35%"
          r="60%"
        >
          <stop
            offset="0%"
            stopColor={
              theme.leaves[2] ?? theme.leaves[0]
            }
            stopOpacity="1"
          />
        </radialGradient>

        {/* Shadow */}
        <ellipse
          cx={cx}
          cy={h - 4}
          rx={s * 0.3}
          ry={4}
          fill="var(--glass-b-12)"
        />

        {/* Pot */}
        {full && (
          <>
            <path
              d={`
                M${cx - s * 0.18} ${ty + trunkH * 0.4}
                Q${cx - s * 0.22} ${ty + trunkH * 0.8}
                ${cx} ${ty + trunkH * 0.9}
                Q${cx + s * 0.22} ${ty + trunkH * 0.8}
                ${cx + s * 0.18} ${ty + trunkH * 0.4}
                Z
              `}
              fill={theme.pot}
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill={theme.pot}
              opacity=".8"
            />

            <ellipse
              cx={cx}
              cy={ty + trunkH * 0.4}
              rx={s * 0.2}
              ry={s * 0.06}
              fill="var(--glass-b-15)"
            />
          </>
        )}

        {/* Trunk — ไม่ขยับ (ลำต้นควรนิ่ง มีแต่ทรงพุ่มที่ไหว) */}
        <rect
          x={cx - trunkW / 2}
          y={ty - trunkH * 0.1}
          width={trunkW}
          height={trunkH}
          rx={trunkW / 2}
          fill={theme.trunk}
        />

        {/* Trunk highlight */}
        <rect
          x={cx - trunkW * 0.2}
          y={ty}
          width={trunkW * 0.3}
          height={trunkH * 0.7}
          rx={trunkW * 0.15}
          fill="var(--glass-w-22)"
        />

        {/* ── ทรงพุ่ม (ใบ+ดอก) ทั้งหมดอยู่ใน <g> เดียว ให้ไหวไปด้วยกันเป็นก้อนเดียว ── */}
        <g
          className={animated ? 'mini-tree__crown mini-tree__crown--swaying' : 'mini-tree__crown'}
          style={{ transformOrigin: `${crownOriginX}px ${crownOriginY}px` }}
        >
          {/* Leaves — layered circles for depth */}
          <circle
            cx={cx}
            cy={ty - r1 * 0.6}
            r={r1}
            fill={`url(#lg${s})`}
          />

          <circle
            cx={cx - r2 * 0.5}
            cy={ty - r1 * 0.2}
            r={r2}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".9"
          />

          <circle
            cx={cx + r2 * 0.5}
            cy={ty - r1 * 0.25}
            r={r2 * 0.85}
            fill={theme.leaves[1] ?? theme.leaves[0]}
            opacity=".85"
          />

          {/* Crown highlight */}
          <circle
            cx={cx - r3 * 0.3}
            cy={ty - r1 * 0.8}
            r={r3 * 0.7}
            fill={theme.leaves[2] ?? theme.leaves[0]}
            opacity=".55"
          />

          <circle
            cx={cx - r3 * 0.4}
            cy={ty - r1 * 0.85}
            r={r3 * 0.35}
            fill="var(--glass-w-30)"
          />

          {/* Flowers */}
          {theme.flowers.slice(0, 3).map((fc, i) => {
            const fx =
              cx + [-r1 * 0.4, r1 * 0.3, r1 * 0.05][i];

            const fy =
              ty - r1 * [0.95, 0.75, 1.15][i];

            return (
              <g key={i}>
                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.055}
                  fill={fc}
                />

                <circle
                  cx={fx}
                  cy={fy}
                  r={s * 0.025}
                  fill="var(--glass-w-70)"
                />
              </g>
            );
          })}
        </g>
      </svg>
    </div>
  );
}
</file>

<file path="src/components/tree/TreeSummaryModal.css">
/* TreeSummaryModal.css — [แก้ตามที่ระบุ] แผงคำอธิบาย MBTI ลอยข้างต้นไม้ (ไม่ใช่ modal
   กึ่งกลางจอทับต้นไม้แบบเดิม) — ดู TreeSummaryModal.tsx

   [ตำแหน่ง] desktop/tablet (>768px): ลอยชิดขวาจอ กึ่งกลางแนวตั้ง เว้นระยะพ้นคอลัมน์ปุ่ม
   ลอยขวาบน (.right-action-buttons ที่ top:95px;right:16px กว้าง ~2cm/75px) เพื่อไม่ให้ซ้อน
   ทับกัน — มือถือ (≤768px) ไม่มีที่ว่างด้านข้างพอ เปลี่ยนเป็นแผ่นลอยชิดขอบล่างแทน (เต็ม
   ความกว้างลบระยะขอบ) แบบเดียวกับ pattern bottom-sheet ที่ใช้ทั่วระบบ */
.tree-mbti-panel {
  position: fixed;
  top: 50%;
  right: 110px;
  transform: translateY(-50%);
  width: min(320px, calc(100vw - 32px));
  max-height: calc(100vh - 190px);
  overflow-y: auto;
  animation: treeMbtiPanelInRight .32s cubic-bezier(.22,1,.36,1) both;
}
@keyframes treeMbtiPanelInRight {
  from { opacity: 0; transform: translateY(-50%) translateX(16px); }
  to   { opacity: 1; transform: translateY(-50%) translateX(0); }
}

@media (max-width: 768px) {
  /* [แก้ตามที่ระบุ — พบจากการวัดจริงในเบราว์เซอร์] เดิม +12px เหลือช่องว่างจริงกับ
     ActionMenuBar แค่ ~2px (วัดจริง: bottom ของแผง 187px vs top ของแถบเมนู 189px ที่จอสูง
     279px) แทบชนกัน ขยับขึ้นเพิ่มอีกเกือบ 3 เท่า (+32px) ให้เห็นช่องว่างชัดเจนจริงจากขอบจอ */
  .tree-mbti-panel {
    top: auto;
    bottom: calc(var(--gpf-safe-bottom, 100px) + 32px);
    right: 16px;
    left: 16px;
    width: auto;
    max-height: 50vh;
    transform: none;
    animation-name: treeMbtiPanelInBottom;
  }
  @keyframes treeMbtiPanelInBottom {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
}

/* [แก้ตามที่ระบุ — เอฟเฟกต์ขอบ] เลือกทำ "เส้นขอบไล่เฉด + glow เรืองจางๆ ที่หายใจเบาๆ"
   (ไม่ใช้ shimmer เคลื่อนที่ เพราะจะรบกวนสายตาระหว่างอ่านคำอธิบายยาวๆ) ทำด้วย CSS ล้วน:
   .ring เป็นกล่องนอกพื้นหลังไล่เฉดฟ้า→เขียว (มีความหมายผสมสีฟ้าตามที่ระบุ + สีเขียวของธีม
   ต้นไม้ให้กลมกลืน) หนา 2px แล้วเว้น padding ให้ .inner ทึบด้านในบังจนเหลือแค่ขอบบางๆ —
   วิธีนี้ได้เส้นขอบไล่เฉดจริงโดยไม่ต้องพึ่ง border-image ที่เบราว์เซอร์บางตัวจัดการมุมโค้งได้
   ไม่สวย ส่วน glow มาจาก box-shadow สีฟ้าอ่อนที่ pulse ความเข้มขึ้น-ลงช้าๆ (คีย์เฟรมเดียว
   กับแนวคิด treeSummaryLeafSway ของโมดัลเดิม) */
.tree-mbti-panel__ring {
  position: relative;
  border-radius: 26px;
  padding: 2px;
  background: linear-gradient(135deg, #7DD3FC 0%, #BAE6FD 45%, var(--g300) 100%);
  animation: treeMbtiGlowPulse 3.2s ease-in-out infinite;
}
@keyframes treeMbtiGlowPulse {
  0%, 100% { box-shadow: 0 0 14px rgba(125, 211, 252, .35), 0 14px 40px var(--glass-b-20); }
  50%      { box-shadow: 0 0 26px rgba(125, 211, 252, .55), 0 14px 40px var(--glass-b-20); }
}

.tree-mbti-panel__inner {
  position: relative;
  border-radius: 24px;
  background: linear-gradient(165deg, #EFF9FF 0%, var(--g50) 100%);
  padding: 22px 20px 20px;
}

.tree-mbti-panel__close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 32px;
  height: 32px;
  border-radius: 99px;
  border: none;
  background: var(--glass-b-8);
  cursor: pointer;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tree-mbti-panel__close:hover { background: var(--glass-b-15); }

@keyframes treeMbtiLeafSway {
  0%, 100% { transform: rotate(-6deg); }
  50%      { transform: rotate(6deg); }
}
.tree-mbti-panel__leaf { display: inline-block; animation: treeMbtiLeafSway 2.4s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .tree-mbti-panel, .tree-mbti-panel__ring, .tree-mbti-panel__leaf { animation: none; }
}
</file>

<file path="src/components/ui/Button.tsx">
import type { ButtonHTMLAttributes, ReactNode } from 'react'
import './ui.css'

/*============================================================================*\
  Button — [ไฟล์ใหม่] ปุ่มมาตรฐานของทั้งแอป
  ────────────────────────────────────────────────────────────────────────────
  เดิมปุ่มถูกเขียนใหม่ทุกไฟล์ด้วย inline style ซึ่งทำให้:
    • ไม่มี :hover / :active / :focus-visible (inline style ทำไม่ได้)
    • ไม่รู้จักโหมดมืด
    • ขนาด ความมน และเงา ไม่ตรงกันเลยสักปุ่ม
  ปุ่มนี้แก้ทั้งสามข้อในตัวเดียว และรองรับคีย์บอร์ดครบตั้งแต่ต้น

  variant:
    primary — การกระทำหลักของหน้า (1 ปุ่มต่อหน้าเท่านั้น)
    soft    — การกระทำรอง
    ghost   — ยกเลิก / ปิด / ข้าม
    rune    — ปุ่มในฉากเวทมนตร์ (ขอบเรืองแสง)
    danger  — การกระทำที่ย้อนกลับไม่ได้
\*============================================================================*/

type ButtonVariant = 'primary' | 'soft' | 'ghost' | 'rune' | 'danger'
type ButtonSize = 'sm' | 'md' | 'lg'

interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
  children: ReactNode
  variant?: ButtonVariant
  size?: ButtonSize
  /** ขยายเต็มความกว้างของพาเรนต์ */
  block?: boolean
  /** ไอคอนนำหน้าข้อความ — ควรเป็น <img>/<svg> ไม่ใช่ emoji เมื่อขึ้นโปรดักชัน */
  leading?: ReactNode
}

export default function Button({
  children, variant = 'soft', size = 'md', block = false, leading,
  className = '', type = 'button', ...rest
}: ButtonProps) {
  const classes = [
    'ui-btn', `ui-btn--${variant}`, `ui-btn--${size}`,
    block ? 'ui-btn--block' : '', className,
  ].filter(Boolean).join(' ')

  return (
    <button type={type} className={classes} {...rest}>
      {leading && <span className="ui-btn__leading">{leading}</span>}
      {children}
    </button>
  )
}
</file>

