/* ═══════════════════════════════════════════════════════════════
   BalancedNutrientsQuest.css — เควส "แคลอรี่ตาม BMI" (Balanced Nutrients)
   ───────────────────────────────────────────────────────────────
   [สำคัญ] position:absolute; inset:0 — ครอบเฉพาะ "กรอบเขียว" เหมือนเควสสุขภาพจิตทุกไฟล์
   ═══════════════════════════════════════════════════════════════ */

.balanced-nutrients {
  position: absolute;
  inset: 0;
  z-index: 800;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(120% 90% at 50% 0%, #D08C34 0%, #8C5A24 45%, #4A2E12 100%);
  color: var(--fixed-white);
  font-family: 'Nunito', 'Mali', sans-serif;
}

.balanced-nutrients__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 30;
  width: 44px;
  height: 44px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-16);
  color: var(--fixed-white);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, transform 0.18s ease;
}
.balanced-nutrients__close:hover { background: var(--glass-w-30); transform: scale(1.08); }

.balanced-nutrients__content {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 460px;
  max-height: calc(100% - 32px);
  overflow-y: auto;
  /* [แก้ตามที่ระบุ] เลื่อนขึ้นลงได้แต่ไม่แสดงแถบเลื่อน */
  scrollbar-width: none;
  -ms-overflow-style: none;
  /* [แก้บั๊ก — ตามที่ระบุ] เดิม padding-bottom 32px คงที่ ไม่เผื่อ ActionMenuBar (ลอยทับอยู่
     นอก .gameplay-frame, z-index:1000) ทำให้ปุ่ม "แนบรูปยืนยัน"/รางวัลที่จะได้รับเลื่อนลงไป
     โดนบังอยู่หลังแถบเมนู — pattern เดียวกับที่แก้ VitalityStepsQuest.css จุดเดียวกันไปแล้ว
     (เพิ่ม padding ที่เนื้อหาข้างใน ไม่ใช่ลดขนาดกล่องนอก) */
  padding: 90px 22px calc(var(--gpf-safe-bottom, 100px) + 20px);
  text-align: center;
  box-sizing: border-box;
}

.balanced-nutrients__title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 22px;
  margin-bottom: 6px;
}
.balanced-nutrients__flavor {
  font-size: 13px;
  line-height: 1.7;
  opacity: 0.88;
  max-width: 340px;
  margin: 0 auto 18px;
}

/* [เพิ่มรอบนี้ — ตามสเปกใหม่] รูป body type ล้อมด้วยวงแหวนแคลอรี่ (SVG circular progress) */
.balanced-nutrients__ring-wrap {
  position: relative;
  width: 150px;
  height: 150px;
  margin: 0 auto 14px;
}
.balanced-nutrients__ring-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.balanced-nutrients__ring-track {
  fill: none;
  stroke: rgba(255,255,255,0.18);
  stroke-width: 8;
}
.balanced-nutrients__ring-fill {
  fill: none;
  stroke: #B7E4C7;
  stroke-width: 8;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.6s cubic-bezier(.22,1,.36,1);
}
.balanced-nutrients__body-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  height: 78%;
  object-fit: contain;
  filter: drop-shadow(0 6px 14px rgba(0,0,0,.35));
}

.balanced-nutrients__calorie-value {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 26px;
  color: var(--fixed-white);
  margin-bottom: 4px;
}
.balanced-nutrients__calorie-value span { font-size: 14px; font-family: 'Nunito', sans-serif; opacity: 0.8; }
.balanced-nutrients__calorie-missing { font-size: 13px; color: rgba(255, 255, 255, 0.8); padding: 4px 0; }
.balanced-nutrients__calorie-note { font-size: 11px; opacity: 0.65; margin: 4px 0 18px; line-height: 1.5; }

/* [ใหม่ — เลิก mock auto-approve] error จาก analyzeFoodPhoto() จริง */
.balanced-nutrients__analysis-error {
  font-size: 12px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 196, 100, 0.14);
  border: 1px solid rgba(255, 196, 100, 0.3);
  border-radius: 12px;
  padding: 10px 14px;
  margin: 0 0 16px;
}

/* [เพิ่มรอบนี้ — ตามสเปกใหม่] การ์ดมื้ออาหาร เช้า/เที่ยง/เย็น แยกช่องชัดเจน */
.balanced-nutrients__meals {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}
.balanced-nutrients__meal-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 10px 6px;
  border-radius: 16px;
  border: 1.5px dashed rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.06);
}
.balanced-nutrients__meal-card.is-done {
  border-style: solid;
  border-color: #B7E4C7;
  background: rgba(183,228,199,0.12);
}
.balanced-nutrients__meal-photo {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 12px;
}
.balanced-nutrients__meal-cam-btn {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12px;
  border: none;
  background: rgba(255,255,255,0.1);
  color: var(--fixed-white);
  font-size: 22px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .15s ease;
}
.balanced-nutrients__meal-cam-btn:hover { background: rgba(255,255,255,0.2); }
.balanced-nutrients__meal-label { font-size: 12px; font-weight: 700; opacity: 0.9; }
.balanced-nutrients__meal-done-badge { font-size: 10px; color: #B7E4C7; font-weight: 700; }

.balanced-nutrients__verifying-spinner {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.balanced-nutrients__verifying-spinner::before {
  content: '';
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: var(--fixed-white);
  animation: balancedNutrientsSpin 0.8s linear infinite;
}
@keyframes balancedNutrientsSpin { to { transform: rotate(360deg); } }

.balanced-nutrients__btn {
  width: 100%;
  min-height: 50px;
  padding: 14px;
  border: none;
  border-radius: 16px;
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 16px;
  cursor: pointer;
  transition: transform .15s ease;
