.safety-net__contact-icon { font-size: 26px; flex-shrink: 0; }
.safety-net__contact-text { display: flex; flex-direction: column; gap: 2px; }
.safety-net__contact-text strong {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-weight: 400;
  font-size: 16px;
  color: var(--fixed-white);
}
.safety-net__contact-text small { font-size: 11.5px; color: var(--glass-w-75); }

.safety-net__meanwhile {
  border-radius: 20px;
  border: 1px solid var(--glass-w-14);
  background: var(--glass-w-6);
  padding: 18px;
  margin-bottom: 18px;
}
.safety-net__meanwhile-title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 15px;
  color: var(--fixed-white);
  margin-bottom: 6px;
}
.safety-net__meanwhile p {
  font-size: 12.5px;
  line-height: 1.8;
  --lc-text-3: rgba(245, 236, 239, 0.7);
  color: var(--lc-text-3);
  margin-bottom: 13px;
}
.safety-net__meanwhile button {
  width: 100%;
  padding: 13px;
  border: none;
  border-radius: 99px;
  background: var(--glass-w-92);
  --lc-text-2: #241A2C;
  color: var(--lc-text-2);
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 14.5px;
  cursor: pointer;
}

.safety-net__disclaimer {
  font-size: 11px;
  line-height: 1.75;
  --lc-text-1: rgba(245, 236, 239, 0.45);
  color: var(--lc-text-1);
  padding: 0 10px;
}

@media (prefers-reduced-motion: reduce) {
  .safety-net__aura, .safety-net__box { animation: none; }
}
/* [แก้ตามที่ระบุ] ใช้รูป Medical Box.png แทนอีโมจิ 🧰 */
/* [แก้ตามที่ระบุ] กล่องพยาบาลใหญ่ขึ้น + อยู่ต่ำจากขอบบน 90px — ไฟล์ Medical Box.png (796x434) มีขอบโปร่งใส
   บน ~11% ล่าง ~13% จึงหักด้วย margin ติดลบให้ตัวกล่องจริงเริ่มที่ 90px พอดี */
.safety-net { align-items: flex-start; padding-top: 90px; padding-bottom: calc(var(--gpf-safe-bottom, 90px) + 16px); }
.safety-net__box { font-size: 0; line-height: 0; margin-bottom: 8px; }
.safety-net__box-img {
  width: min(320px, 78vw); height: auto; display: block;
  margin: calc(min(320px, 78vw) * -0.061) auto calc(min(320px, 78vw) * -0.072);
  filter: drop-shadow(0 10px 20px rgba(0,0,0,.3));
}
