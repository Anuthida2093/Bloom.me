<file path="src/components/quest/games/learning/GuardianOfRestGame.tsx">
import { useEffect, useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import { OWL_AVATAR_ICON } from '../../../../config/iconAssets'
import { REST_LOG_CHANGED_EVENT, activeRest, loadRestSessions, restTotals, completedFullRestToday } from '../../../../utils/restLog'
import { isQuestDoneNow } from '../../../../utils/questCompletion'
import '../games.css'
import './RestReminder.css'

/*  ผู้พิทักษ์การพักผ่อน (Guardian of Rest)
    ─────────────────────────────────────────────────────────────
    หน้าจอแสดงแค่ "นกฮูก" + "เวลาพักผ่อนที่ทำได้" — ไม่โชว์ตัวเลขตั้งต้น (90/15)
    เบื้องหลัง: หยั่งรากลึกจดจ่อครบช่วง → เริ่มจับเวลาพักอัตโนมัติ (utils/restLog.ts) ครบแล้วบันทึกทันที
    โดยตัวจับเวลาของหยั่งรากลึกยังเดินต่อ ไม่ถูกหยุด
    [แก้ตามที่ระบุ] พักครบ 15 นาทีเต็ม (รอบพักจบจริง) → ปุ่มรับรางวัลโผล่ กดรับได้วันละครั้ง (finish)
    ยังไม่ครบ/รับแล้ว → ดูอย่างเดียว ปิดด้วย exit                                                          */

function mmss(ms: number): string {
  const s = Math.max(0, Math.ceil(ms / 1000))
  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`
}

export default function GuardianOfRestGame({ exit, finish }: QuestGameProps) {
  const { userData, questLogs } = useAppContext()
  const [nowMs, setNowMs] = useState(() => Date.now())
  const [sessions, setSessions] = useState(() => loadRestSessions(userData.id))

  // นาฬิกาเดินทุกวินาที (แสดงเวลาพักที่เหลือ) + โหลดใหม่เมื่อหยั่งรากลึกเริ่มรอบพัก
  useEffect(() => {
    const tick = window.setInterval(() => setNowMs(Date.now()), 1000)
    const reload = () => setSessions(loadRestSessions(userData.id))
    window.addEventListener(REST_LOG_CHANGED_EVENT, reload)
    return () => { window.clearInterval(tick); window.removeEventListener(REST_LOG_CHANGED_EVENT, reload) }
  }, [userData.id])

  const active = activeRest(sessions, nowMs)
  const { todayMinutes, totalMinutes } = restTotals(sessions, nowMs)
  const claimedToday = isQuestDoneNow(questLogs, 'know-guardian-of-rest')
  const restDone = completedFullRestToday(sessions, nowMs)
  const remaining = active ? new Date(active.startedAt).getTime() + active.minutes * 60_000 - nowMs : 0

  return (
    <div className="qg">
      <div className="qg-card qg-center rest-timer">
        <div className={`rest-owl rest-owl--big${active ? '' : ' rest-owl--awake'}`} aria-hidden="true">
          <img src={OWL_AVATAR_ICON} alt="" className="rest-owl__img" />
          {active && <span className="rest-owl__zzz">Zzz</span>}
        </div>

        {active && (
          <>
            <div className="rest-timer__phase">กำลังพักผ่อน…</div>
            <div className="rest-timer__clock" role="timer" aria-live="off">{mmss(remaining)}</div>
          </>
        )}

        <div className="rest-timer__total">
          <span>เวลาพักผ่อนที่ทำได้วันนี้</span>
          <strong>{todayMinutes} นาที</strong>
        </div>
        {totalMinutes > todayMinutes && <p className="qg-hint">สะสมทั้งหมด {totalMinutes} นาที</p>}
      </div>

      {restDone && !claimedToday && (
        <button className="qg-btn" onClick={() => finish({ restMinutes: todayMinutes })}>พักครบ 15 นาทีแล้ว รับรางวัล</button>
      )}
      {!restDone && !claimedToday && (
        <p className="qg-hint">{active ? 'พักให้ครบเวลาก่อนนะ แล้วกลับมารับรางวัลที่นี่' : 'จดจ่อในโหมดจดจ่อให้ครบ 90 นาที ระบบจะเริ่มจับเวลาพัก 15 นาทีให้เอง'}</p>
      )}
      {claimedToday && <p className="qg-hint">รับรางวัลการพักผ่อนของวันนี้แล้ว 🦉</p>}
      <button className="qg-btn qg-btn--ghost" onClick={exit}>ปิดหน้านี้</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/learning/MirrorOfTruthGame.tsx">
import { useMemo, useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import { findQuestByCode } from '../../../../config/questCatalog'
import '../games.css'

/*  [นำกลับมาตามที่ระบุ] เควสเสริม "กระจกแห่งความจริง" (Mirror of Truth)
    ─────────────────────────────────────────────────────────────
    ย้อนดูเควสที่ทำสำเร็จวันนี้ แล้วตอบตรงๆ ว่ารู้สึกยังไงหลังทำแต่ละเควส — บันทึกผ่าน
    submitQuestFeedback() ท่อเดียวกับป้าย QuestFeedbackPrompt (badge "Mirror of Truth" และ
    บันทึกใน "ป่าแห่งสิบปี" จึงนับรวมกันอัตโนมัติ)                                      */

type Reaction = 'good' | 'neutral' | 'bad'

const REACTIONS: { value: Reaction; emoji: string; label: string }[] = [
  { value: 'good', emoji: '👍', label: 'ดี' },
  { value: 'neutral', emoji: '😐', label: 'เฉยๆ' },
  { value: 'bad', emoji: '👎', label: 'ไม่ค่อยดี' },
]

const SELF_CODE = 'know-mirror-of-truth'

export default function MirrorOfTruthGame({ finish }: QuestGameProps) {
  const { questLogs, submitQuestFeedback } = useAppContext()
  const [answers, setAnswers] = useState<Record<string, Reaction>>({})
  /** [แก้ตามที่ระบุ] พิมพ์ความรู้สึก/สิ่งที่ได้เรียนรู้เพิ่มได้ */
  const [note, setNote] = useState('')

  /** เควสที่ทำสำเร็จวันนี้ (ไม่รวมตัวเอง) — เควสที่ทำซ้ำหลายรอบแสดงครั้งเดียว ใช้รอบล่าสุด */
  const todaysQuests = useMemo(() => {
    const todayStr = new Date().toDateString()
    const byCode = new Map<string, { code: string; title: string; completedAt: string }>()
    for (const l of questLogs) {
      const code = l.quest?.code
      if (!code || code === SELF_CODE || l.status !== 'COMPLETED' || !l.completedAt) continue
      if (new Date(l.completedAt).toDateString() !== todayStr) continue
      const prev = byCode.get(code)
      if (prev && prev.completedAt >= l.completedAt) continue
      byCode.set(code, { code, title: findQuestByCode(code)?.titleTh ?? l.quest?.title ?? code, completedAt: l.completedAt })
    }
    return [...byCode.values()]
  }, [questLogs])

  const answeredCount = Object.keys(answers).length

  const handleSubmit = () => {
    for (const q of todaysQuests) {
      const reaction = answers[q.code]
      if (reaction) submitQuestFeedback(q.code, q.completedAt, reaction)
    }
    finish({ feelings: answers, note: note.trim() })
  }

  return (
    <div className="qg">
      <div className="qg-card">
        <div className="qg-title">วันนี้รู้สึกยังไงกับสิ่งที่ทำไป?</div>
        <p className="qg-hint">ตอบตามจริง ไม่มีคำตอบถูกผิด ความรู้สึกหลังเรียนช่วยบอกว่าวิธีไหนเหมาะกับเรา</p>
      </div>

      {todaysQuests.length === 0 ? (
        <div className="qg-card">
          <p className="qg-hint">วันนี้ยังไม่มีเควสที่ทำสำเร็จ ลองทำเควสสักอันก่อน แล้วกลับมาส่องกระจกอีกครั้ง</p>
        </div>
      ) : (
        todaysQuests.map((q) => (
          <div className="qg-card" key={q.code}>
            <span className="qg-label">{q.title}</span>
            <div className="qg-chips">
              {REACTIONS.map((r) => (
                <button
                  key={r.value}
                  type="button"
                  className={`qg-chip${answers[q.code] === r.value ? ' is-active' : ''}`}
                  onClick={() => setAnswers((prev) => ({ ...prev, [q.code]: r.value }))}
                  aria-pressed={answers[q.code] === r.value}
                >
                  {r.emoji} {r.label}
                </button>
              ))}
            </div>
          </div>
        ))
      )}

      <div className="qg-card">
        <label className="qg-label" htmlFor="mot-note">อยากบอกอะไรกับตัวเองหลังเรียนวันนี้?</label>
        <textarea
          id="mot-note"
          className="qg-textarea"
          value={note}
          onChange={(e) => setNote(e.target.value)}
          maxLength={500}
          placeholder="เช่น วันนี้จดจ่อได้ดีขึ้น แต่ยังลืมเรื่องสูตรอยู่บ้าง"
        />
      </div>

      <button className="qg-btn" disabled={answeredCount === 0 && !note.trim()} onClick={handleSubmit}>ส่องกระจกเสร็จแล้ว</button>
    </div>
  )
}
</file>

<file path="src/components/quest/games/learning/RestReminder.css">
/* ═══ นกฮูกพักผ่อน (ผู้พิทักษ์การพักผ่อน / ป็อปอัปเตือนพัก) ═══ */
.rest-owl { position: relative; display: flex; justify-content: center; }
.rest-owl__img {
  width: 150px; height: 150px; object-fit: contain;
  filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.3)) saturate(0.9);
  animation: restOwlBreathe 3.2s ease-in-out infinite;
  transform-origin: 50% 90%;
}
.rest-owl--big .rest-owl__img { width: min(220px, 56vw); height: min(220px, 56vw); }
.rest-owl--awake .rest-owl__img { animation: restOwlHop 0.7s cubic-bezier(.34, 1.56, .64, 1) both; filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.3)); }
@keyframes restOwlBreathe { 0%, 100% { transform: scale(1, 1) rotate(-3deg); } 50% { transform: scale(1.03, 0.97) rotate(-3deg); } }
@keyframes restOwlHop { 0% { transform: translateY(16px) scale(0.85); } 60% { transform: translateY(-10px) scale(1.04); } 100% { transform: none; } }
.rest-owl__zzz {
  position: absolute; top: 4px; right: calc(50% - 90px);
  font-family: var(--font-display); font-size: 26px; font-weight: 700; color: #7b8dd8;
  text-shadow: 0 2px 0 #fff;
  animation: restZzz 2.4s ease-in-out infinite;
}
.rest-owl--big .rest-owl__zzz { right: calc(50% - 120px); font-size: 32px; }
@keyframes restZzz {
  0% { opacity: 0; transform: translate(0, 10px) scale(0.7); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translate(18px, -26px) scale(1.15); }
}

/* หน้าตัวจับเวลาพัก */
.rest-timer { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
.rest-timer__phase { font-family: var(--font-display); font-size: 18px; }
.rest-timer__clock { font-family: 'Fredoka One', var(--font-display); font-size: 44px; line-height: 1; }
@media (prefers-reduced-motion: reduce) { .rest-owl__img, .rest-owl__zzz { animation: none; } }
.rest-timer__total { display: flex; flex-direction: column; align-items: center; gap: 2px; font-family: var(--font-display); font-size: 15px; }
.rest-timer__total strong { font-size: 34px; line-height: 1.1; }
</file>

<file path="src/components/quest/games/learning/RestReminderPopup.tsx">
import { createPortal } from 'react-dom'
import { OWL_AVATAR_ICON } from '../../../../config/iconAssets'
import '../../../shop/ShopItemDialog.css'
import './RestReminder.css'

/*============================================================================*\
  RestReminderPopup — ป็อปอัปแจ้งเตือนการพักผ่อน (เปิด-ปิดได้) ใช้ร่วมกันระหว่าง
  "ผู้พิทักษ์การพักผ่อน" (ตัวจับเวลาพัก) และ "หยั่งรากลึก" (ครบช่วงจดจ่อ / ครบช่วงพัก)
    kind 'rest'  = ครบเวลาอ่าน/จดจ่อ → ได้เวลาพัก N นาที
    kind 'back'  = พักครบแล้ว → กลับมาเรียนต่อได้
\*============================================================================*/

export type RestReminderKind = 'rest' | 'back'

interface RestReminderPopupProps {
  kind: RestReminderKind
  restMinutes: number
  onClose: () => void
}

export default function RestReminderPopup({ kind, restMinutes, onClose }: RestReminderPopupProps) {
  return createPortal(
    <div className="shop-dialog" role="alertdialog" aria-modal="true" aria-labelledby="rest-reminder-title" style={{ zIndex: 3000 }} onClick={onClose}>
      <div className="shop-dialog__card" onClick={(e) => e.stopPropagation()}>
        <div className={`rest-owl${kind === 'back' ? ' rest-owl--awake' : ''}`} aria-hidden="true">
          <img src={OWL_AVATAR_ICON} alt="" className="rest-owl__img" />
          {kind === 'rest' && <span className="rest-owl__zzz">Zzz</span>}
        </div>
        <h2 id="rest-reminder-title" className="shop-dialog__title">
          {kind === 'rest' ? `ได้เวลาพัก ${restMinutes} นาทีแล้ว` : 'พักครบแล้ว!'}
        </h2>
        <p className="shop-dialog__body">
          {kind === 'rest'
            ? 'วางหนังสือ หลับตา ยืดเส้น หรือเดินเล่น ห้ามเล่นมือถือนะ สมองกำลังจัดเก็บสิ่งที่เรียนมา'
            : 'สมองได้พักฟื้นแล้ว พร้อมกลับมาจดจ่อรอบต่อไป'}
        </p>
        <div className="shop-dialog__actions">
          <button type="button" className="soft-btn soft-btn--gold" onClick={onClose} autoFocus>
            {kind === 'rest' ? 'เริ่มพัก' : 'ตกลง'}
          </button>
        </div>
      </div>
    </div>,
    document.body,
  )
}
