/* ═══════════════════════════════════════════════════════════════
   SafetyNetPage.css — กล่องพยาบาลเวทมนตร์ (High Risk Safety Net)
   โทนอุ่นนุ่ม ไม่ใช่สีแดงฉุกเฉิน เพื่อไม่ให้ผู้ใช้ตกใจซ้ำ
   ═══════════════════════════════════════════════════════════════ */

.safety-net {
  position: absolute;
  inset: 0;
  z-index: 880;
  overflow-y: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26px 18px;
  --lc-bg-10: #3A2A3E;
  --lc-bg-11: #241A2C;
  --lc-bg-12: #120C18;
  background: radial-gradient(120% 85% at 50% 0%, var(--lc-bg-10) 0%, var(--lc-bg-11) 48%, var(--lc-bg-12) 100%);
  --lc-text-13: #F5ECEF;
  color: var(--lc-text-13);
  font-family: 'Nunito', 'Mali', sans-serif;
}

.safety-net__aura {
  position: absolute;
  inset: -25%;
  --lc-bg-9: rgba(255, 179, 198, 0.5);
  background: radial-gradient(38% 32% at 50% 26%, var(--lc-bg-9), transparent 70%);
  opacity: 0.4;
  filter: blur(50px);
  pointer-events: none;
  animation: safetyPulse 6s ease-in-out infinite;
}
@keyframes safetyPulse {
  0%, 100% { opacity: 0.32; }
  50%      { opacity: 0.5; }
}

.safety-net__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 10;
  width: 34px;
  height: 34px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-14);
  color: var(--fixed-white);
  cursor: pointer;
  font-size: 14px;
}

.safety-net__inner {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 470px;
  text-align: center;
}

.safety-net__box {
  font-size: 52px;
  --lc-shadow-8: rgba(255, 179, 198, 0.45);
  filter: drop-shadow(0 8px 22px var(--lc-shadow-8));
  animation: safetyFloat 4.5s ease-in-out infinite;
}
@keyframes safetyFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-9px); }
}

.safety-net__inner h1 {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 23px;
  color: var(--fixed-white);
