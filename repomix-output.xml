<file path="src/utils/resetLocalData.ts">
/*============================================================================*\
  resetLocalData.ts — ล้างข้อมูลทดลองเก่าทั้งหมดในเครื่อง "ครั้งเดียว" ก่อนแอปเริ่มทำงาน
  ────────────────────────────────────────────────────────────────────────────
  โหมด mock เก็บทุกอย่างใน localStorage ของเบราว์เซอร์ (บัญชีจำลอง/เควส/มื้ออาหาร/ไดอะรี่/โพสอิท/
  ก้าว/การตั้งค่า ...) — ก่อนนำ UI ไปให้ผู้ใช้ทดลอง ต้องเริ่มจากศูนย์ทุกเครื่อง
  ทำงานเมื่อ DATA_VERSION ในเครื่องไม่ตรงกับค่านี้ → ล้าง localStorage + sessionStorage ทั้งหมด แล้วจำเวอร์ชันไว้
  (เปิดครั้งต่อไปไม่ล้างซ้ำ ข้อมูลที่ผู้ทดลองสร้างใหม่อยู่ครบ)
  ต้องการล้างทุกเครื่องอีกรอบ (เช่นเริ่มรอบทดสอบใหม่) → เปลี่ยนค่า DATA_VERSION
  ต้อง import เป็นบรรทัดแรกของ main.tsx — ให้ล้างก่อนโมดูลอื่นอ่าน localStorage ไปเก็บไว้
\*============================================================================*/

const DATA_VERSION = 'user-test-2026-10-06'
const VERSION_KEY = 'bloom:data-version'

try {
  if (window.localStorage.getItem(VERSION_KEY) !== DATA_VERSION) {
    window.localStorage.clear()
    window.sessionStorage.clear()
    window.localStorage.setItem(VERSION_KEY, DATA_VERSION)
  }
} catch {
  /* storage ปิด (โหมดส่วนตัวบางเบราว์เซอร์) — ไม่มีข้อมูลเก่าให้ล้างอยู่แล้ว */
}

export {}
