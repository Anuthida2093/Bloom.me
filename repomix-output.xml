/** ผู้เล่นที่ยังไม่มีผล MBTI — ต้นไม้ใบรูปไข่ทั่วไป */
export function speciesOf(mbti: MbtiType | null | undefined): Species {
  return (mbti && SPECIES[mbti]) || DEFAULT_SPECIES
}

