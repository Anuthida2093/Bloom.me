.crash {
  min-height: 60vh;
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
}
.crash__card {
  max-width: 460px; width: 100%;
  padding: 28px;
  border-radius: var(--r-lg);
  background: var(--bg-card);
  border: 1px solid var(--border);
  box-shadow: var(--sh-card);
  text-align: center;
}
.crash__title { font-size: var(--fs-xl); margin-bottom: 10px; color: var(--text); }
.crash__body  { font-size: var(--fs-sm); color: var(--text-sub); line-height: var(--lh-body); }
.crash__actions { display: flex; gap: 10px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
.crash__btn {
  padding: 10px 18px; border-radius: var(--r-pill);
  border: 1px solid var(--border-mid); background: transparent;
  color: var(--text-sub); font-size: var(--fs-sm); font-weight: 600;
}
.crash__btn--primary {
  background: linear-gradient(135deg, var(--g600), var(--g700));
  border-color: transparent; color: var(--fixed-white); box-shadow: var(--sh-btn);
}
.crash__details {
  margin-top: 18px; text-align: left;
  font-size: var(--fs-xs); color: var(--text-muted);
}
.crash__details pre {
  margin-top: 8px; padding: 10px; border-radius: var(--r-sm);
  background: var(--n100); overflow-x: auto; white-space: pre-wrap; word-break: break-word;
}
