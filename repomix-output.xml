          .learning-quest-map__side-toggle-img { width: 48px; height: 48px; }
          .learning-quest-map__sidebar { top: 112px; right: 8px; width: min(190px, calc(100% - 16px)); border-radius: 16px; max-height: calc(100% - 112px - var(--gpf-safe-bottom, 0px) - 12px); }
          .learning-quest-map__sidebar-head { padding: 9px 12px; font-size: 14px; }
          .learning-quest-map__sidebar-list { gap: 6px; padding: 0 8px 10px; }
          .learning-quest-map__side-item { min-height: 44px; font-size: 12.5px; gap: 6px; padding: 4px 8px 4px 4px; }
          .learning-quest-map__side-icon, .learning-quest-map__side-icon img { width: 32px; height: 32px; }
        }
        @media (max-width: 300px) {
          .learning-quest-map__side-item { min-height: 40px; font-size: 12px; gap: 6px; }
          .learning-quest-map__side-icon, .learning-quest-map__side-icon img { width: 28px; height: 28px; }
        }

        @media (prefers-reduced-motion: reduce) {
          .learning-quest-map__node-badge, .learning-quest-map__node-wrap, .learning-quest-map__owl,
          .learning-quest-map__sidebar, .learning-quest-map__sidebar--open { animation: none; transition: none; }
        }
      `}</style>
    </div>
  )
}

/** Fallback กรณีจำนวนเควสเกิน 5 */
function generateFallbackPosition(index: number, total: number): { x: number; y: number } {
  const marginY = 12
  const usableY = 100 - marginY * 2
  const t = total <= 1 ? 0.5 : index / (total - 1)
  const y = 100 - marginY - t * usableY
  const wave = Math.sin(t * Math.PI * 1.6)
  const x = 48 + wave * 18
  return { x, y }
}
