            )
          })}
        </div>
        <button className="quest-gate-view__fab-main" onClick={() => setIsMenuOpen((v) => !v)} title="เลือกเควส">
          {isMenuOpen ? '✕' : '📋'}
        </button>
      </div>

      <style>{`
        .quest-gate-view {
          position: absolute; inset: 0; z-index: 10; overflow: hidden;
          display: flex; align-items: center; justify-content: center;
        }
        .quest-gate-view__center { position: relative; z-index: 5; text-align: center; display: flex; flex-direction: column; align-items: center; }
        .quest-gate-view__icon {
          font-size: 120px; line-height: 1;
