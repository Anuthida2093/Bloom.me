# ═══════════════════════════════════════════════════════════════════════════
#  .env.example — คัดลอกเป็น .env แล้วแก้ค่าตามสภาพแวดล้อมของคุณ
#  (Vite อ่านเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ เท่านั้น)
# ═══════════════════════════════════════════════════════════════════════════

# ที่อยู่ของ API — ระหว่างพัฒนาให้ตั้ง proxy ใน vite.config.ts ชี้ไป backend
VITE_API_BASE_URL=/api

# mock = ใช้ข้อมูลจำลองใน src/services/mock/ (ทำงานได้โดยไม่ต้องมี backend)
# live = ยิงไปที่ VITE_API_BASE_URL จริง
#
# วันที่ backend พร้อม: เปลี่ยนบรรทัดนี้เป็น live เท่านั้น
# ไม่ต้องแก้คอมโพเนนต์แม้แต่ไฟล์เดียว
VITE_API_MODE=mock

# ─────────────────────────────────────────────────────────────────────────
# Google Fit REST API (เควส "ก้าวเพื่อสุขภาพ" — src/services/stepTracking.ts)
# ต้องสร้าง OAuth 2.0 Client ID (ประเภท "Web application") ที่ Google Cloud Console ก่อน:
#   1. console.cloud.google.com → สร้างโปรเจกต์ (หรือใช้โปรเจกต์เดิม)
#   2. เปิดใช้งาน "Fitness API" ใน API Library
#   3. OAuth consent screen → ตั้งค่าเบื้องต้น (external/internal, scope
#      fitness.activity.read)
#   4. Credentials → Create Credentials → OAuth client ID → Web application
#   5. เพิ่ม Authorized JavaScript origins + Authorized redirect URIs เป็น URL จริงของเว็บนี้
#      (เช่น http://localhost:5173 ตอน dev, โดเมนจริงตอน production)
#   6. คัดลอก Client ID มาใส่ด้านล่างนี้
# ไม่ตั้งค่า = ระบบข้ามไปใช้ DeviceMotion (นับก้าวจากเซนเซอร์เครื่อง) อัตโนมัติ ไม่ error
VITE_GOOGLE_FIT_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# AI Vision — วิเคราะห์รูปอาหาร (เควส "แคลอรี่ตาม BMI" — src/services/aiSummaryService.ts)
# ต้องมี API key จาก platform.openai.com (Settings → API keys)
# [คำเตือนความปลอดภัย] คีย์นี้ถูกเรียกใช้ตรงจากฝั่ง client (ยังไม่มี backend proxy) —
# เหมาะสำหรับเดโม/ทดสอบเท่านั้น ห้ามใช้คีย์จริงที่มีวงเงินสูงในโปรดักชันแบบนี้
VITE_AI_VISION_API_KEY=
# โมเดลที่ต้องรองรับ image input เท่านั้น — ไม่ตั้งค่า = ใช้ gpt-4o-mini
VITE_AI_VISION_MODEL=gpt-4o-mini