  /** [Mock ตามที่ขอ] เพศตัวละครที่ใช้เลือกวิดีโอ+เสียง — ไม่มี field นี้อยู่ใน User model ของ
   *  backend เลย (ไม่ใช่สิ่งที่ระบบเก็บจริง) เป็นแค่ตัวแปร mock ฝั่ง client ล้วนๆ */
  gender: MockGender
  /** เรียกตอนวิดีโอเดินเล่นจบจริง (onEnded) + fade out เสร็จแล้ว ให้ผู้เรียกใช้เคลียร์ isTransitioning */
  onComplete: () => void
}

const FADE_MS = 320

/**
 * TransitionOverlay — [แก้ตามคำขอเพิ่มเติม] เอฟเฟกต์ "เดินไป node ถัดไป" ตอนทำเควสหมวด
 * ความรู้สำเร็จ
 *
 * [แก้ไขสำคัญ] เดิมเข้าใจผิดว่า owl-walk.mp3 คือเสียงประกอบวิดีโอเดินนี้ — ตามที่ระบุมา
 * ชัดเจนแล้วว่า "owl-walk.mp3 ใช้สำหรับตอนนกฮูกเคลื่อนที่ไปอันต่อไป" (คนละจุดกับวิดีโอ
 * ตัวละครเดินนี้) ส่วนวิดีโอ Girl.mp4/Boy.mp4 ต้องใช้เสียงเฉพาะของตัวเอง (Girl.mp3/Boy.mp3)
 * แทน — ย้ายเสียงเดินของนกฮูกไปให้ LearningQuestMap.tsx จัดการแล้ว (ดูที่นั่น)
 *
 * ยังคงเล่นวิดีโอ "เต็มความยาวคลิปจริง" เสมอ (ฟัง onEnded ของ <video> จริง ไม่ hardcode
 * ระยะเวลา) เหมือนที่แก้ไว้รอบก่อน — แค่เปลี่ยนไฟล์เสียงที่เล่นคู่กันเท่านั้น
 */
export default function TransitionOverlay({ active, gender, onComplete }: TransitionOverlayProps) {
  const videoRef = useRef<HTMLVideoElement | null>(null)
  const audioRef = useRef<HTMLAudioElement | null>(null)
  const [isClosing, setIsClosing] = useState(false)

  if (!active) return null

  // [หมายเหตุ] Boy.mp4/Boy.mp3 ยังไม่มีไฟล์จริงในโปรเจกต์ — ต้องเอาไปวางไว้ที่
  // public/assets/videos/Boy.mp4 และ public/assets/sounds/Boy.mp3 เอง (Girl.mp4/Girl.mp3
  // มีไฟล์จริงพร้อมใช้งานแล้ว) โค้ดอ้างอิง path ทั้งคู่ไว้รอแล้ว
  const videoSrc = gender === 'male' ? '/assets/videos/Boy.mp4' : '/assets/videos/Girl.mp4'
  const audioSrc = gender === 'male' ? '/assets/sounds/Boy.mp3' : '/assets/sounds/Girl.mp3'

  const handleVideoPlay = () => {
    audioRef.current?.play().catch(() => {})
  }

  const handleVideoEnded = () => {
    audioRef.current?.pause()
    setIsClosing(true)
    // รอ fade-out สั้นๆ เล่นจบก่อนค่อยแจ้งผู้เรียกใช้ว่าจบจริง (กันภาพกระตุกตัดฉับ)
    window.setTimeout(onComplete, FADE_MS)
  }

  return (
    <div className={isClosing ? 'transition-overlay transition-overlay--closing' : 'transition-overlay'}>
      <div className="transition-overlay__backdrop-blur" />
      <video
        ref={videoRef}
        className="transition-overlay__video"
        src={videoSrc}
        autoPlay
        muted
        playsInline
        onPlay={handleVideoPlay}
        onEnded={handleVideoEnded}
      />
      {/* [ตามที่ขอ] เสียงประกอบเฉพาะของวิดีโอนี้ (Girl.mp3/Boy.mp3) — คนละไฟล์กับ owl-walk.mp3 */}
      <audio ref={audioRef} src={audioSrc} />
      <div className="transition-overlay__vignette" />

      <style>{`
        .transition-overlay {
          position: absolute; inset: 0; z-index: 15; overflow: hidden;
          opacity: 0;
          animation: transitionOverlayFadeIn ${FADE_MS}ms ease-out forwards;
        }
        .transition-overlay--closing {
          animation: transitionOverlayFadeOut ${FADE_MS}ms ease-in forwards;
        }
        @keyframes transitionOverlayFadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes transitionOverlayFadeOut { from { opacity: 1; } to { opacity: 0; } }

        .transition-overlay__backdrop-blur {
          position: absolute; inset: -10%; z-index: 0;
          backdrop-filter: blur(6px) brightness(1.05); -webkit-backdrop-filter: blur(6px) brightness(1.05);
        }
        .transition-overlay__video {
          position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: center;
        }
        .transition-overlay__vignette {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  --lc-bg-1: rgba(5,15,10,.55);
  background: radial-gradient(circle at 50% 45%, transparent 40%, var(--lc-bg-1) 100%);
}
        @media (prefers-reduced-motion: reduce) {
          .transition-overlay, .transition-overlay--closing { animation: none; opacity: 1; }
        }
      `}</style>
    </div>
  )
}
