  transition: transform 0.16s ease, background 0.16s ease;
}
.safety-net__contact:hover { transform: translateY(-2px); background: var(--glass-w-13); }
.safety-net__contact--primary {
  --lc-bg-4: #FF8FA8;
  --lc-bg-5: #E4577A;
  background: linear-gradient(135deg, var(--lc-bg-4), var(--lc-bg-5));
  border-color: transparent;
  --lc-shadow-6: rgba(228, 87, 122, 0.4);
