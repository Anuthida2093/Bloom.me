import type { PostData } from '../../types'
import PostCard from './PostCard'

/*============================================================================*\
  PostListPage — [ไฟล์ใหม่ — ฟีเจอร์สตอรี่] หน้ารายการโพสต์ใช้ซ้ำ 3 จุดจาก sidebar grid:
  "โพสต์ปิดโปรไฟล์" (ของฉันที่ตั้งไม่ระบุตัวตน) / "ที่ถูกใจ" / "รีโพสต์"
