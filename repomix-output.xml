/** ลิงก์ขาวขีดเส้นใต้บนการ์ดกระจก (เช่น "สมัครสมาชิก", "เข้าสู่ระบบ") */
export const authLinkStyle: CSSProperties = { color: 'var(--lb-card-text)', fontWeight: 800, textDecoration: 'underline' }

