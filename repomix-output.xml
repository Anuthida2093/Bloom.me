// @vitest-environment jsdom
import { describe, expect, it } from 'vitest'
import { crossGrowthMultiplier, crossPenalty } from '../crossGrowth'
import type { QuestCategory, QuestLogEntry } from '../../types'

const DAY = 24 * 60 * 60 * 1000
const now = Date.UTC(2026, 9, 22, 12)
const log = (category: QuestCategory, daysAgo: number) => ({
  id: `${category}-${daysAgo}`, status: 'COMPLETED', userId: 'u', questId: 'q', logDate: null,
  quest: { code: 'q', category }, completedAt: new Date(now - daysAgo * DAY).toISOString(),
}) as QuestLogEntry

describe('crossGrowth (ทั้ง 3 ด้านมีผลต่อกันเล็กน้อย)', () => {
  it('ไม่ลดภายใน 4 วัน · ขาด 5-9 วันลด 5% · 10 วันขึ้นไปลด 10% · ผู้เล่นใหม่ไม่ลด', () => {
    expect(crossPenalty(null)).toBe(0)
    expect(crossPenalty(4)).toBe(0)
    expect(crossPenalty(5)).toBe(0.05)
    expect(crossPenalty(9)).toBe(0.05)
    expect(crossPenalty(10)).toBe(0.1)
    expect(crossPenalty(60)).toBe(0.1)
  })

  it('จับคู่เป็นวง: สุขภาพ→ความรู้, ความรู้→จิตใจ, จิตใจ→สุขภาพ', () => {
    const logs = [log('HEALTH', 12), log('KNOWLEDGE', 6), log('EMOTION', 1)]
    expect(crossGrowthMultiplier('KNOWLEDGE', logs, now)).toBeCloseTo(0.9) // ขาดสุขภาพ 12 วัน
    expect(crossGrowthMultiplier('EMOTION', logs, now)).toBeCloseTo(0.95) // ขาดความรู้ 6 วัน
    expect(crossGrowthMultiplier('HEALTH', logs, now)).toBe(1) // ทำจิตใจเมื่อวาน
  })
})

describe('isSeriousMode (มีผลเฉพาะโหมดจริงจัง)', () => {
  it('โหมดปกติ (ค่าเริ่มต้น/ไม่เคยตั้งค่า) = ไม่จริงจัง · เปิดโหมดความเข้มงวด = จริงจัง', async () => {
    const { isSeriousMode } = await import('../crossGrowth')
    window.localStorage.removeItem('bloom:settings')
    expect(isSeriousMode()).toBe(false)
    window.localStorage.setItem('bloom:settings', JSON.stringify({ strictMode: false }))
    expect(isSeriousMode()).toBe(false)
    window.localStorage.setItem('bloom:settings', JSON.stringify({ strictMode: true }))
    expect(isSeriousMode()).toBe(true)
    window.localStorage.removeItem('bloom:settings')
  })
})
</file>

<file path="src/config/__tests__/groundFertility.test.ts">
import { describe, expect, it } from 'vitest'
import {
  BARREN_DAYS, GRASS_FRESH_DAYS, daysSinceLastHealthQuest, groundDryness, groundStage, knowledgeGrowthMultiplier,
} from '../groundFertility'
import type { QuestLogEntry } from '../../types'

const DAY = 24 * 60 * 60 * 1000

describe('groundFertility', () => {
  it('keeps grass fresh for new players and for the first few days', () => {
    expect(groundDryness(null)).toBe(0)
    expect(groundDryness(0)).toBe(0)
    expect(groundDryness(GRASS_FRESH_DAYS)).toBe(0)
  })

  it('dries out day by day and becomes barren soil after BARREN_DAYS', () => {
    const d5 = groundDryness(5), d9 = groundDryness(9)
    expect(d5).toBeGreaterThan(0)
    expect(d9).toBeGreaterThan(d5)
    expect(groundDryness(BARREN_DAYS)).toBe(1)
    expect(groundDryness(40)).toBe(1)
    expect(groundStage(0)).toBe('lush')
    expect(groundStage(groundDryness(5))).toBe('wilting')
    expect(groundStage(groundDryness(4))).toBe('lush')
    expect(groundStage(groundDryness(8))).toBe('dry')
    expect(groundStage(groundDryness(10))).toBe('barren') // บทที่ 2: ขาด 10 วันขึ้นไป = ทรุดโทรม
    expect(groundStage(1)).toBe('barren')
  })

  it('slows tree growth only slightly on poor soil (wilting -5%, barren -10%)', () => {
    expect(knowledgeGrowthMultiplier(0)).toBe(1)
    expect(knowledgeGrowthMultiplier(groundDryness(5))).toBeCloseTo(0.95)
    expect(knowledgeGrowthMultiplier(1)).toBeCloseTo(0.9)
    expect(knowledgeGrowthMultiplier(groundDryness(9))).toBeLessThan(1)
  })

  it('counts days since the latest completed HEALTH quest only', () => {
    const now = Date.UTC(2026, 8, 26, 12)
    const log = (category: 'HEALTH' | 'KNOWLEDGE', daysAgo: number, status: 'COMPLETED' | 'IN_PROGRESS' = 'COMPLETED') => ({
      id: `${category}-${daysAgo}`, status, userId: 'u', questId: 'q', logDate: null,
      quest: { code: 'q', category }, completedAt: new Date(now - daysAgo * DAY).toISOString(),
    }) as QuestLogEntry
    expect(daysSinceLastHealthQuest([], now)).toBeNull()
    expect(daysSinceLastHealthQuest([log('HEALTH', 8), log('HEALTH', 3), log('KNOWLEDGE', 0), log('HEALTH', 1, 'IN_PROGRESS')], now)).toBe(3)
  })
})
</file>

