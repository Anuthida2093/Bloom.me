/* ═══════════════════════════════════════════════════════════════
   BalancedNutrientsQuest.css — เควส "แคลอรี่ตาม BMI" (Balanced Nutrients)
   ───────────────────────────────────────────────────────────────
   [สำคัญ] position:absolute; inset:0 — ครอบเฉพาะ "กรอบเขียว" เหมือนเควสสุขภาพจิตทุกไฟล์
   ═══════════════════════════════════════════════════════════════ */

.balanced-nutrients {
  position: absolute;
  inset: 0;
  z-index: 800;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(120% 90% at 50% 0%, #D08C34 0%, #8C5A24 45%, #4A2E12 100%);
  color: var(--fixed-white);
  font-family: 'Nunito', 'Mali', sans-serif;
}

.balanced-nutrients__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 30;
  width: 44px;
  height: 44px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-16);
  color: var(--fixed-white);
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, transform 0.18s ease;
}
.balanced-nutrients__close:hover { background: var(--glass-w-30); transform: scale(1.08); }

.balanced-nutrients__content {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 460px;
  max-height: calc(100% - 32px);
  overflow-y: auto;
  /* [แก้บั๊ก — ตามที่ระบุ] เดิม padding-bottom 32px คงที่ ไม่เผื่อ ActionMenuBar (ลอยทับอยู่
     นอก .gameplay-frame, z-index:1000) ทำให้ปุ่ม "แนบรูปยืนยัน"/รางวัลที่จะได้รับเลื่อนลงไป
     โดนบังอยู่หลังแถบเมนู — pattern เดียวกับที่แก้ VitalityStepsQuest.css จุดเดียวกันไปแล้ว
     (เพิ่ม padding ที่เนื้อหาข้างใน ไม่ใช่ลดขนาดกล่องนอก) */
  padding: 90px 22px calc(var(--gpf-safe-bottom, 100px) + 20px);
  text-align: center;
  box-sizing: border-box;
}

.balanced-nutrients__title {
  font-family: 'Fredoka One', 'Mali', sans-serif;
