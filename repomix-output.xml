}

/* ต้นไม้ประจำ MBTI (MiniTree) หัวแผงข้อมูลต้นไม้ — กึ่งกลาง */
.tree-info-panel__tree { display: flex; justify-content: center; margin-bottom: 6px; }

/* [แก้ตามที่ระบุ] ธีมมืด: ตัวหนังสือในแผงข้อมูลต้นไม้เป็นสีขาวทั้งหมด — รวมชื่อต้นไม้ (เดิมสีประจำ MBTI)
   ตัวเลข % สถิติ (เดิมสีตามหมวด) และคำเตือน (!important ทับสี inline style ของแต่ละจุด) */
[data-theme="dark"] .tree-info-panel .tree-of-life__tooltip-sheet,
[data-theme="dark"] .tree-info-panel .tree-of-life__tooltip-sheet * { color: var(--fixed-white) !important; }
[data-theme="dark"] .tree-info-panel .tree-of-life__tooltip-warn { background: color-mix(in srgb, var(--orange) 22%, transparent); }

/* ═══ แผงแจ้งเตือน (NotificationPanel.tsx) — กรอบเดียวกับแผงข้อมูลต้นไม้ (InfoFramePanel) ═══ */
.notification-panel__empty { text-align: center; padding: 24px 0; font-size: var(--fs-sm); opacity: .75; color: var(--ti-text); }
.notification-panel__item { align-items: center; }
.notification-panel__item--clickable { cursor: pointer; transition: transform .15s ease, filter .15s ease; }
.notification-panel__item--clickable:hover { transform: translateX(3px); filter: brightness(1.04); }
.notification-panel__icon { width: 52px; height: 46px; object-fit: contain; flex-shrink: 0; }
.notification-panel__icon--emoji { font-size: 34px; line-height: 1; text-align: center; }
.notification-panel__text { font-size: 14px; line-height: 1.5; color: var(--ti-text); }
.notification-panel__time { font-size: 11.5px; margin-top: 2px; color: var(--ti-text); opacity: .7; }
/* [เพิ่มตามที่ระบุ] อ่านแล้ว/ยังไม่อ่าน — ยังไม่อ่าน: พื้นเข้มขึ้น + ขอบทอง + จุดแจ้งมุมขวา
   อ่านแล้ว: พื้นจางลง ตัวหนังสือจางลงเล็กน้อย (ธีมมืดตัวหนังสือยังขาวล้วน) */
.notification-panel__item { position: relative; }
.notification-panel__item--unread {
  border: 2px solid color-mix(in srgb, var(--coin) 70%, var(--g600));
  box-shadow: 0 3px 10px var(--glass-b-15);
}
.notification-panel__item--unread::after {
  content: '';
  position: absolute; top: 8px; right: 8px;
  width: 9px; height: 9px; border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 2px var(--ti-row);
}
.notification-panel__item--read { background: transparent; opacity: .72; }


/* ═══ [แก้ตามที่ระบุ] ก้อนหินบนพื้นดิน — ทานเกินแคลอรี่ที่กำหนดติดต่อกันหลายวัน ═══ */
.tree-of-life__rocks { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
/* [แก้ตามที่ระบุ] ก้อนหินใหญ่ขึ้น (เดิม 38-66px) + กอหญ้าขึ้นทับฐาน */
.tree-of-life__rock {
  position: absolute;
  width: calc(clamp(54px, 7.5vw, 96px) * var(--rock-scale, 1));
  transform: translate(-50%, -50%);
  animation: treeOfLifeRockDrop .7s cubic-bezier(.22, 1.4, .36, 1) both;
}
.tree-of-life__rock-img {
  display: block; width: 100%; height: auto;
  filter: drop-shadow(0 6px 6px rgba(0, 0, 0, .35));
}
.tree-of-life__rock-grass {
  position: absolute; left: -12%; bottom: -8%;
  width: 124%; height: 46%;
  pointer-events: none;
}
@keyframes treeOfLifeRockDrop {
  from { opacity: 0; transform: translate(-50%, calc(-50% - 40px)); }
  to   { opacity: 1; transform: translate(-50%, -50%); }
}
@media (prefers-reduced-motion: reduce) { .tree-of-life__rock { animation: none; } }

/* ═══ [แก้ตามที่ระบุ] เควสสำเร็จ: ออร่ารอบต้นไม้ + ต้นไม้ขยายขึ้นนิดหน่อยแล้วกลับขนาดเดิม ═══ */
/* [แก้ตามที่ระบุ] หลังผงละอองโปรยลงมา → ตัวต้นไม้ (ลำต้น+พุ่ม ไม่รวมพื้นหญ้า) ขยายใหญ่ขึ้นชัดๆ (~10%)
   แล้วค่อยกลับขนาดเดิมอย่างนุ่มนวล — การ "โตจริง" ยังเป็นไปตามเกณฑ์เลเวลเดิม (buildTreeModel) */
.tree-of-life__stack--celebrate .tree-of-life__canvas:not(.tree-of-life__canvas--ground):not(.tree-of-life__canvas--meadow):not(.tree-of-life__canvas--meadow-front) {
  transform-origin: 50% 84%;
  animation: treeOfLifeCelebrate 1.6s cubic-bezier(.45, 0, .25, 1) 1s both;
  will-change: transform;
}
@keyframes treeOfLifeCelebrate {
  0%   { transform: scale(1); }
  42%  { transform: scale(1.1); }
  62%  { transform: scale(1.085); }
  78%  { transform: scale(1.095); }
  100% { transform: scale(1); }
}
/* แสงออร่าเปล่งออกมาจากตัวต้นไม้ระหว่างขยาย — ชั้นแสงอยู่ "หลัง" ต้นไม้ (::before มาก่อน canvas)
   ใช้แค่ opacity/transform จึงลื่น ไม่มีวงแหวน ไม่มีสีส้มจัด (ขาวอมทองนวล) */
.tree-of-life__stack--celebrate::before {
  content: '';
  position: absolute;
  left: 50%; top: 46%;
  width: min(92vw, 760px); height: min(92vh, 760px);
  transform: translate(-50%, -50%) scale(.6);
  border-radius: 50%;
  pointer-events: none;
  background:
    radial-gradient(circle, rgba(255, 252, 230, .75) 0%, rgba(255, 240, 180, .38) 30%, rgba(255, 240, 180, .12) 52%, transparent 70%),
    repeating-conic-gradient(from 0deg, rgba(255, 248, 210, .22) 0deg 6deg, transparent 6deg 20deg);
  -webkit-mask-image: radial-gradient(circle, #000 25%, transparent 70%);
  mask-image: radial-gradient(circle, #000 25%, transparent 70%);
  opacity: 0;
  animation: treeOfLifeAuraFromTree 1.9s ease-out 1s both;
}
@keyframes treeOfLifeAuraFromTree {
  0%   { opacity: 0; transform: translate(-50%, -50%) scale(.6) rotate(0deg); }
  30%  { opacity: 1; }
  70%  { opacity: .75; }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.15) rotate(18deg); }
}
/* [แก้ตามที่ระบุ] ผงละอองเล็กมากๆ (จุดกลม + ดาวสี่แฉก) สีทองนวล โปรยลงใส่ต้นไม้ แล้วจางหาย */
.tree-of-life__stardust { position: absolute; inset: 0; z-index: 6; pointer-events: none; overflow: hidden; }
.tree-of-life__stardust-grain {
  position: absolute; top: -3%;
  border-radius: 50%;
  background: #FFF6C8;
  box-shadow: 0 0 3px 1px rgba(255, 236, 160, .85);
  opacity: 0;
  animation-name: treeOfLifeStardustFall, treeOfLifeStardustTwinkle;
  animation-timing-function: cubic-bezier(.35, .1, .55, 1), ease-in-out;
  animation-fill-mode: both, none;
  animation-iteration-count: 1, infinite;
}
.tree-of-life__stardust-grain--star {
  border-radius: 0;
  background: #FFF0A8;
  clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  box-shadow: none;
  filter: drop-shadow(0 0 2px rgba(255, 240, 170, .95));
}
@keyframes treeOfLifeStardustFall {
  0%   { opacity: 0; transform: translate(0, 0); }
  15%  { opacity: 1; }
  75%  { opacity: .9; }
  100% { opacity: 0; transform: translate(var(--drift, 0px), var(--land, 60vh)); }
}
@keyframes treeOfLifeStardustTwinkle {
  0%, 100% { filter: brightness(1); }
  50%      { filter: brightness(1.6); }
}
@media (prefers-reduced-motion: reduce) {
  .tree-of-life__stack--celebrate .tree-of-life__canvas, .tree-of-life__stack--celebrate::before { animation: none; }
  .tree-of-life__stardust { display: none; }
}

/* แถบปรับขนาดไอเทมตกแต่ง (โผล่เมื่อแตะเลือก) — ปุ่มนูนนุ่มกดง่ายบนมือถือ */
.tree-of-life__decoration-toolbar {
  position: absolute; left: 50%; top: calc(100% + 8px); transform: translateX(-50%);
  display: flex; align-items: center; gap: 6px; padding: 4px 6px; z-index: 60;
  border-radius: 99px; pointer-events: auto; white-space: nowrap;
  background: rgba(255, 255, 255, 0.82);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.22);
}
.tree-of-life__decoration-toolbar button {
  width: 34px; height: 34px; border: none; border-radius: 50%; cursor: pointer;
  font-family: var(--font-display); font-size: 20px; line-height: 1; color: #1b4332;
  background: linear-gradient(180deg, #ffffff, #c8ecd3);
  box-shadow: 0 3px 0 #74c69d, inset 0 2px 0 #fff;
}
.tree-of-life__decoration-toolbar button:active:not(:disabled) { transform: translateY(2px); box-shadow: 0 1px 0 #74c69d; }
.tree-of-life__decoration-toolbar button:disabled { opacity: 0.4; cursor: not-allowed; }
/* [แก้ตามที่ระบุ] ปุ่ม "เก็บ" (แตะไอเทม) — ไม่มีปุ่ม −/+ และตัวเลข % แล้ว */
.tree-of-life__decoration-toolbar .tree-of-life__decoration-store { width: auto; min-width: 64px; height: 36px; padding: 0 16px; border-radius: 99px; font-size: 16px; }
/* กดค้างแล้ว = กำลังย่อ/ขยาย — เส้นประ + แสงรอบไอเทมบอกว่าเข้าโหมดนี้แล้ว (ไม่โชว์ตัวเลข) */
.tree-of-life__decoration-item--resizing { outline: 2px dashed rgba(255, 255, 255, .85); outline-offset: 4px; border-radius: 12px; filter: drop-shadow(0 0 10px rgba(255, 236, 160, .9)); }
.tree-of-life__decoration-item--draggable { touch-action: none; -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }

/* ประกายวิบวับบนดอกไม้/ประกายดาวของต้นไม้ (ProceduralTreeCanvas → .tree-glints) */
.tree-glints { position: absolute; top: 0; bottom: 0; pointer-events: none; z-index: 3; }
.tree-glint {
  position: absolute; transform: translate(-50%, -50%) scale(0); opacity: 0;
  background: radial-gradient(circle, #ffffff 0 18%, rgba(255, 250, 215, 0.9) 30%, rgba(255, 240, 180, 0) 70%);
  clip-path: polygon(50% 0, 58% 42%, 100% 50%, 58% 58%, 50% 100%, 42% 58%, 0 50%, 42% 42%);
  filter: drop-shadow(0 0 4px rgba(255, 245, 200, 0.95));
  animation: treeGlint 3s ease-in-out infinite;
}
@keyframes treeGlint {
  0%, 62%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(0) rotate(0deg); }
  74% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(25deg); }
  86% { opacity: 0.7; transform: translate(-50%, -50%) scale(0.6) rotate(45deg); }
}
@media (prefers-reduced-motion: reduce) { .tree-glints { display: none; } }
