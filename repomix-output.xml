import { useState } from 'react'
import type { QuestDef } from '../../config/questCatalog'

const C_1 = '#3a2254'
const C_2 = '#170d24'
const C_3 = '#0a0512'
const C_4 = '#9b59d0'
const BORDER_5 = '#b785f5'
const C_6 = '#2a1635'
const C_7 = '#1e4d3a'
const C_8 = '#0d2a1f'
