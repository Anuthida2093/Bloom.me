/* ═══════════════════════════════════════════════════════════════
   ScreeningPage.css — แบบคัดกรองภาวะซึมเศร้า
   โทนกลางคืนสงบ ไม่ใช้สีแดงเตือนภัย เพื่อไม่ให้ผู้ทำรู้สึกถูกตัดสิน
   ═══════════════════════════════════════════════════════════════ */

.screening {
  position: absolute;
  inset: 0;
  z-index: 860;
  overflow-y: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26px 18px;
  --lc-bg-18: #23324D;
  --lc-bg-19: #172238;
  --lc-bg-20: #0B1220;
  background: radial-gradient(110% 80% at 50% 0%, var(--lc-bg-18) 0%, var(--lc-bg-19) 50%, var(--lc-bg-20) 100%);
  --lc-text-21: #E8EDF7;
  color: var(--lc-text-21);
  font-family: 'Nunito', 'Mali', sans-serif;
  --lc-c-22: #9B8FD8;
  --risk-accent: var(--lc-c-22);
}

.screening__glow {
  position: absolute;
  inset: -25%;
  background: radial-gradient(40% 35% at 50% 30%, color-mix(in srgb, var(--risk-accent) 55%, transparent), transparent 70%);
  opacity: 0.3;
  filter: blur(50px);
  transition: background 0.8s ease;
  pointer-events: none;
}

.screening__close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 10;
  width: 34px;
  height: 34px;
  border-radius: 99px;
  border: none;
  background: var(--glass-w-14);
  color: var(--fixed-white);
  cursor: pointer;
  font-size: 14px;
}

.screening__card {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 470px;
  border-radius: 26px;
  --lc-bg-17: rgba(14, 24, 41, 0.82);
  background: var(--lc-bg-17);
  border: 1px solid var(--glass-w-13);
  backdrop-filter: blur(16px);
  padding: 30px 26px 24px;
  text-align: center;
  box-shadow: 0 26px 70px var(--glass-b-50);
  animation: screeningIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes screeningIn {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: translateY(0); }
}

.screening__icon { font-size: 42px; margin-bottom: 8px; }
.screening__card h1 {
  font-family: 'Fredoka One', 'Mali', sans-serif;
  font-size: 23px;
  color: var(--fixed-white);
  margin-bottom: 8px;
}
.screening__reason {
  font-size: 13.5px;
  line-height: 1.85;
  --lc-text-16: rgba(232, 237, 247, 0.82);
  color: var(--lc-text-16);
  margin-bottom: 16px;
}

.screening__notice {
  border-radius: 16px;
  background: var(--glass-w-6);
  border: 1px solid var(--glass-w-12);
  padding: 14px 16px;
  margin-bottom: 20px;
  text-align: left;
}
.screening__notice p {
  font-size: 12.5px;
  line-height: 1.8;
  --lc-text-15: rgba(232, 237, 247, 0.72);
  color: var(--lc-text-15);
}
.screening__notice p + p { margin-top: 6px; }
.screening__notice strong { color: var(--fixed-white); }

/* ── คำถาม ── */
.screening__progress {
  height: 4px;
  border-radius: 99px;
  background: var(--glass-w-12);
  overflow: hidden;
  margin-bottom: 16px;
}
.screening__progress div {
  height: 100%;
  border-radius: 99px;
  background: var(--risk-accent);
  transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.screening__step {
  font-size: 11.5px;
