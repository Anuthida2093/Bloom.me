  left: 50%;
  transform: translateX(-50%);
  z-index: 40;
  background: rgba(10, 20, 10, 0.85);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 99px;
  padding: 10px 20px;
  font-size: 13px;
  white-space: nowrap;
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
}
