.shop-dialog__need { margin: 0; font-size: 16px; line-height: 1.5; }
.shop-dialog__need b { color: #b45309; }
.shop-dialog__hint { margin: 0; font-size: 12px; line-height: 1.5; opacity: 0.8; }
.shop-dialog__error { margin: 0; font-size: 13px; color: #b91c1c; }

.shop-dialog__costs { display: flex; flex-direction: column; gap: 8px; width: 100%; margin-top: 6px; }
.shop-dialog__cost {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; border-radius: 14px;
  background: rgba(255, 255, 255, 0.6);
  box-shadow: inset 0 0 0 1.5px rgba(245, 179, 1, 0.55);
  font-size: 15px; text-align: left;
}
[data-theme="dark"] .shop-dialog__cost { background: rgba(255, 255, 255, 0.1); }
.shop-dialog__cost img { width: 34px; height: 34px; object-fit: contain; flex-shrink: 0; }
.shop-dialog__cost span { flex: 1; min-width: 0; }
.shop-dialog__cost em { font-style: normal; font-size: 12px; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
