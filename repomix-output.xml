import { useEffect, useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import { playSfx } from '../../../../utils/audioPlayer'
import '../games.css'

/*  เควส Photosynthesis (สังเคราะห์แสง / รับแดดยามเช้า)  — ใช้กับ Sunlit Root ด้วย
    ทฤษฎี: Circadian Rhythm & Serotonin Hypothesis
    ─────────────────────────────────────────────────────────────
    แสงเช้าตั้งค่านาฬิกาชีวภาพ กระตุ้นเซโรโทนิน และทำให้คืนนั้นหลับดีขึ้น
    เกมนี้ตรวจ "ช่วงเวลาจริง" ด้วย: ถ้าไม่ได้อยู่ในช่วง 05:00-10:00 ระบบจะเตือนว่า
    ได้ประโยชน์ไม่เต็มที่ (แต่ยังทำได้ ไม่บล็อก เพราะบางคนตื่นสายโดยจำเป็น)
    ต้องรับแดดครบอย่างน้อย 10 นาทีถึงกดจบได้ และหยุดนับถ้าสลับแท็บ                 */

const MIN_SECONDS = 10 * 60
const TARGET_SECONDS = 15 * 60

export default function PhotosynthesisGame({ finish }: QuestGameProps) {
  const { logActivity, settings } = useAppContext()
  const [seconds, setSeconds] = useState(0)
  const [running, setRunning] = useState(false)
  const hour = new Date().getHours()
  const isMorning = hour >= 5 && hour < 10

  useEffect(() => {
    if (!running) return
    const id = window.setInterval(() => {
      setSeconds((s) => {
        const next = s + 1
        if (next === MIN_SECONDS) playSfx('SPARKLE_CHIME', { volume: settings.sfxVolume, enabled: settings.soundEnabled })
        if (next >= TARGET_SECONDS) setRunning(false)
        return Math.min(next, TARGET_SECONDS)
      })
    }, 1000)
    return () => window.clearInterval(id)
  }, [running, settings.sfxVolume, settings.soundEnabled])

  const pct = seconds / TARGET_SECONDS
  const circumference = 2 * Math.PI * 44
  const mm = String(Math.floor(seconds / 60)).padStart(2, '0')
  const ss = String(seconds % 60).padStart(2, '0')
  const canFinish = seconds >= MIN_SECONDS

  const handleFinish = () => {
    logActivity({ activityType: 'SUNLIGHT', durationSeconds: seconds, meta: { startHour: hour, isMorning } })
    finish({ minutes: Math.round(seconds / 60), isMorning })
  }

  return (
    <div className="qg qg-center">
      <span className={`qg-tag${isMorning ? ' qg-tag--ok' : ' qg-tag--warn'}`}>
        {isMorning
          ? `ตอนนี้ ${hour}:00 น. — ช่วงเวลาทองของแสงเช้าพอดี`
          : `ตอนนี้ ${hour}:00 น. — เลยช่วงเช้าแล้ว แสงยังดีต่อร่างกาย แต่ผลต่อนาฬิกาชีวภาพจะน้อยลง`}
      </span>

      <div className="qg-ring-wrap">
        <svg viewBox="0 0 100 100" className="qg-ring">
          <circle cx="50" cy="50" r="44" className="qg-ring__track" />
          <circle cx="50" cy="50" r="44" className="qg-ring__fill" strokeDasharray={circumference} strokeDashoffset={circumference * (1 - pct)} />
        </svg>
        <div className="qg-ring__center">
          <div style={{ fontSize: 34, lineHeight: 1 }}>{seconds > 0 ? '🌞' : '🌤️'}</div>
          <div className="qg-ring__value">{mm}:{ss}</div>
          <div className="qg-ring__label">เป้าหมาย 10-15 นาที</div>
        </div>
      </div>

      <div className="qg-card">
        <p className="qg-hint">
          ออกไปนอกอาคารหรือยืนริมหน้าต่างที่แดดส่องถึง ไม่ต้องมองดวงอาทิตย์ตรงๆ
          ถอดแว่นกันแดดออกถ้าอยู่ในที่ปลอดภัย เพื่อให้แสงเข้าถึงจอประสาทตาได้เต็มที่
        </p>
      </div>

      <button className="qg-btn qg-btn--ghost" onClick={() => setRunning((r) => !r)}>
        {running ? 'หยุดพักไว้ก่อน' : seconds > 0 ? 'รับแดดต่อ' : 'เริ่มรับแดด'}
      </button>
      <button className="qg-btn" disabled={!canFinish} onClick={handleFinish}>
        {canFinish ? 'อาบแดดครบแล้ว รดน้ำผืนหญ้า' : `อีก ${Math.ceil((MIN_SECONDS - seconds) / 60)} นาทีถึงเกณฑ์`}
      </button>
    </div>
  )
}
