  --n100:       rgba(255,255,255,.08);
  --n200:       rgba(255,255,255,.13);
  --n300:       #4A6B52;
  --n500:       #7EAD8C;
  --n700:       #B8D4C0;
  --n900:       #E8F5EC;
  --b50:        #1F1810;
  --b100:       #2E2014;
  --g50:        #0F1E15;
  --g100:       #152A1C;
  --sh-card:    0 2px 12px rgba(0,0,0,.4), 0 1px 3px rgba(0,0,0,.3);
  --sh-hover:   0 8px 28px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.3);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  font-size: var(--fs-md);
  line-height: var(--lh-body);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  transition: background .25s ease, color .25s ease;
}

h1, h2, h3, h4, .display {
  font-family: var(--font-display);
  line-height: var(--lh-tight);
  font-weight: 700;
}
h1 { font-size: var(--fs-3xl); }
h2 { font-size: var(--fs-2xl); }
h3 { font-size: var(--fs-xl); }
h4 { font-size: var(--fs-lg); }

button { font-family: var(--font-body); cursor: pointer; }
input, select, textarea { font-family: var(--font-body); }

/* [ใหม่] โฟกัสคีย์บอร์ดต้องมองเห็นได้เสมอ — เกณฑ์ขั้นต่ำก่อนขึ้นโปรดักชัน */
:focus-visible {
  outline: 2px solid var(--ae-glow);
  outline-offset: 2px;
  border-radius: 4px;
}

::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--g200); border-radius: 99px; }
.no-scroll::-webkit-scrollbar { display: none; }
.no-scroll { scrollbar-width: none; }

.card {
  background: var(--bg-card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  border: 1px solid var(--border);
}

.glass {
  background: rgba(255,255,255,.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
[data-theme="dark"] .glass {
  background: rgba(25,42,30,.82);
}

.tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 10px; border-radius: var(--r-pill);
  font-size: 11px; font-weight: 700;
}

/* Butterfly animation */
@keyframes flutter {
  0%   { transform: translate(0,0) rotate(-10deg); }
  25%  { transform: translate(12px,-8px) rotate(10deg); }
  50%  { transform: translate(24px,4px) rotate(-8deg); }
  75%  { transform: translate(12px,-12px) rotate(12deg); }
  100% { transform: translate(0,0) rotate(-10deg); }
}
.butterfly { animation: flutter 3s ease-in-out infinite; }

/* Post-it wobble */
@keyframes wobble {
  0%,100% { transform: rotate(-3deg); }
  50%      { transform: rotate(3deg); }
}

/* Coin bounce */
@keyframes coinPop {
  0%   { transform: scale(0) translateY(0); opacity:1; }
  70%  { transform: scale(1.2) translateY(-30px); opacity:1; }
  100% { transform: scale(1) translateY(-60px); opacity:0; }
}
.coin-pop { animation: coinPop .7s ease forwards; }

/* Responsive */
@media (max-width: 640px)  { .hide-mobile  { display: none !important; } }
@media (min-width: 641px)  { .show-mobile  { display: none !important; } }
@media (max-width: 900px)  { .hide-tablet  { display: none !important; } }
@media (min-width: 901px)  { .show-tablet  { display: none !important; } }

/* ─── V3 Micro-interaction keyframes ─── */

/* Floating reward text (+EXP / +Coin) */
@keyframes floatUp {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  60%  { opacity: 1; transform: translateY(-52px) scale(1.12); }
  100% { opacity: 0; transform: translateY(-80px) scale(.9); }
}
.float-up { animation: floatUp 1.4s cubic-bezier(.2,.8,.4,1) forwards; }

/* Confetti piece fall */
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg) scale(1);   opacity: 1; }
  100% { transform: translateY(90px) rotate(var(--cr,540deg)) scale(.5); opacity: 0; }
}

/* Sparkle placed-item burst */
@keyframes sparklePop {
  0%   { transform: scale(0) rotate(0deg);   opacity: 1; }
  55%  { transform: scale(1.3) rotate(180deg); opacity: 1; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}
.sparkle-dot { animation: sparklePop .7s ease forwards; }

/* Firefly float at night */
@keyframes fireflyFloat {
  0%,100% { opacity: 0;   transform: translate(0, 0); }
  40%     { opacity: .85; transform: translate(var(--ffx, 12px), var(--ffy, -16px)); }
  70%     { opacity: .6;  transform: translate(calc(var(--ffx, 12px)*.6), var(--ffy, -16px)); }
}

/* Star twinkle */
@keyframes twinkle {
  0%,100% { opacity: .25; transform: scale(.8); }
  50%     { opacity: 1;   transform: scale(1.3); }
}

/* Sun ray pulse */
@keyframes sunrayPulse {
  0%,100% { opacity: .18; }
  50%     { opacity: .32; }
}

/* Celebration modal pop-in */
@keyframes celebPop {
  0%  { transform: scale(0) rotate(-12deg); opacity: 0; }
  65% { transform: scale(1.08) rotate(3deg); opacity: 1; }
  82% { transform: scale(.96) rotate(-1deg); }
  100%{ transform: scale(1) rotate(0deg); opacity: 1; }
}

/* Slide up from bottom */
@keyframes slideUp {
  0%   { transform: translateY(30px); opacity: 0; }
  100% { transform: translateY(0);    opacity: 1; }
}
.slide-up { animation: slideUp .5s cubic-bezier(.2,.8,.4,1) forwards; }

/* Treasure chest lid open */
@keyframes chestLid {
  0%   { transform: rotateX(0deg) translateY(0); }
  100% { transform: rotateX(-110deg) translateY(-4px); }
}

/* Speaker icon bounce on change */
@keyframes speakerPulse {
  0%,100% { transform: scale(1); }
  40%     { transform: scale(1.45) rotate(-8deg); }
  70%     { transform: scale(.9)  rotate(5deg); }
}
.speaker-pulse { animation: speakerPulse .45s ease; }

/* Item sparkle ring */
@keyframes sparkleRing {
  0%   { transform: scale(.6); opacity: 1; }
  100% { transform: scale(2.2); opacity: 0; }
}
.sparkle-ring { animation: sparkleRing .65s ease-out forwards; }

/* Celebrate confetti rain (position randomly via --cx CSS var) */
@keyframes confettiRain {
  0%   { transform: translateX(var(--cx,0px)) translateY(-20px) rotate(0deg); opacity: 1; }
  100% { transform: translateX(calc(var(--cx,0px) + var(--csx,0px))) translateY(120px) rotate(var(--cr,420deg)); opacity: 0; }
}

/* ════════════════════════════════════════════════════════════════════════════
   [ใหม่] เคารพ prefers-reduced-motion ระดับโกลบอล
   ────────────────────────────────────────────────────────────────────────────
   เดิมทำไว้เฉพาะจุด (TreeOfLife.css กับทูลทิปบน Dashboard) แต่มีอนิเมชันอีกหลายสิบตัว
   ที่ยังวิ่งอยู่ สำหรับแอปสุขภาพจิตนี่ไม่ใช่แค่มารยาท — ผู้ใช้ที่เวียนศีรษะจากการเคลื่อนไหว
   คือกลุ่มที่ทับซ้อนกับกลุ่มเป้าหมายโดยตรง
   ════════════════════════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
</file>

