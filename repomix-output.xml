/* ═══════════════════════════════════════════════════════════════
   โหมด 1: กล้องเต็มจอ 100% (รองรับทั้งแนวตั้งมือถือ และแนวนอน Tablet/PC)
   ═══════════════════════════════════════════════════════════════ */
.camera-fullscreen-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh; /* [แก้] มือถือ: 100vh สูงกว่าจอที่เห็นจริง (แถบ URL) ปุ่มล่างจึงหลุดจอ */
  background-color: #000;
  z-index: 999999; /* เปลี่ยนเป็นเลขเยอะๆ เพื่อให้แน่ใจว่าลอยอยู่บนสุดจริงๆ */
