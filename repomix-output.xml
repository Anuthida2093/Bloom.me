import './RouteFallback.css'

/*============================================================================*\
  RouteFallback — [ไฟล์ใหม่] หน้าจอระหว่างโหลด bundle ของแต่ละ route
  ────────────────────────────────────────────────────────────────────────────
  จำเป็นเมื่อแยก bundle ตาม route ด้วย React.lazy — ถ้าไม่มีตัวนี้ ผู้ใช้จะเห็น
  จอว่างเปล่าระหว่างดาวน์โหลด ซึ่งบนเน็ตมือถือช้าอาจนานหลายวินาที

  ตั้งใจให้ "เงียบ" — วงกลมหมุนเรียบๆ ไม่มีข้อความชวนอ่าน เพราะถ้าโหลดเร็ว
  ข้อความจะกะพริบผ่านตาแล้วหายไป ซึ่งรบกวนมากกว่าช่วย
\*============================================================================*/

export default function RouteFallback() {
  return (
    <div className="route-fallback" role="status" aria-label="กำลังโหลด">
      <span className="route-fallback__ring" />
    </div>
  )
}
