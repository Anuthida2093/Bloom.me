<file path="src/utils/stepJourneyDays.ts">
/*============================================================================*\
  stepJourneyDays.ts — ก้าวที่บันทึกเข้า "ทริปที่เดินอยู่" แยกตามวัน (เก็บในเครื่อง)
  ────────────────────────────────────────────────────────────────────────────
  ใช้เป็นฐานเทียบตอนซิงค์ก้าวรวมทั้งวัน (Google Fit/Health) กันนับซ้ำ + เพดานก้าวที่นับเข้าทริป
  [เปลี่ยนรอบนี้] ทริปเป็นรายวันแล้ว — วันที่เดินครบเป้า (สะสมสู่ 21 วัน) ย้ายไปเก็บกับบัญชีที่
  services/api/progression.api.ts (ไม่หายเมื่อเปลี่ยนเครื่อง) ไฟล์นี้เหลือแค่ตัวช่วยของทริปปัจจุบัน
\*============================================================================*/

import { bangkokDateString } from './progression'

const KEY = 'bloom.stepJourney.days'

interface JourneyDaysState {
  journeyId: string
  /** ก้าวที่เดินได้ในแต่ละวัน (YYYY-MM-DD → ก้าว) */
  steps: Record<string, number>
  /** วันที่เดินครบเป้าหมายแล้ว */
  doneDays: string[]
}

/** วันตามเวลาไทย — ตรงกับวันทริป (localDateKey) และเส้นตายเที่ยงคืนเวลาไทย */
function todayKey(): string {
  return bangkokDateString()
}

function read(): JourneyDaysState | null {
  try {
    const raw = localStorage.getItem(KEY)
    return raw ? (JSON.parse(raw) as JourneyDaysState) : null
  } catch { return null }
}

function write(state: JourneyDaysState | null): void {
  try {
    if (state) localStorage.setItem(KEY, JSON.stringify(state))
    else localStorage.removeItem(KEY)
  } catch { /* storage ปิดอยู่ */ }
}

function stateFor(journeyId: string): JourneyDaysState {
  const s = read()
  return s && s.journeyId === journeyId ? s : { journeyId, steps: {}, doneDays: [] }
}

export function getTodayJourneySteps(journeyId: string): number {
  return stateFor(journeyId).steps[todayKey()] ?? 0
}

/** บันทึกก้าวที่เพิ่มขึ้นวันนี้ → คืนจำนวนก้าวที่นับเข้าความคืบหน้าของทริปได้ (ไม่เกินเป้าหมายรายวัน) */
export function recordJourneySteps(journeyId: string, delta: number, dailyTarget: number): { countable: number } {
  const s = stateFor(journeyId)
  const day = todayKey()
  const before = s.steps[day] ?? 0
  const after = before + Math.max(0, delta)
  s.steps[day] = after
  const countable = Math.max(0, Math.min(after, dailyTarget) - Math.min(before, dailyTarget))
  if (after >= dailyTarget && !s.doneDays.includes(day)) s.doneDays.push(day)
  write(s)
  return { countable }
}

/** เริ่มทริปใหม่/รับรางวัลแล้ว → ล้างก้าวของทริปเดิม */
export function resetStepJourneyDays(journeyId?: string): void {
  write(journeyId ? { journeyId, steps: {}, doneDays: [] } : null)
}

/** ก้าวจริงที่เดินได้ในวันที่ระบุของทริปนี้ (ไม่ตัดที่เป้า) — ใช้แสดงผล/บันทึกเข้าบัญชีตอนเปิดหน้าสรุปย้อนหลัง */
export function getJourneyDaySteps(journeyId: string, date: string): number {
  return stateFor(journeyId).steps[date] ?? 0
}
</file>

<file path="src/utils/strideDistance.ts">
import type { Gender } from '../types'

/*============================================================================*\
  strideDistance.ts — ระยะทางจากจำนวนก้าว โดยประมาณความยาวก้าวจากส่วนสูง
    ระยะทาง (ม.) = ก้าว × (ส่วนสูง cm × ค่าคงที่เพศ) / 100
    ค่าคงที่: หญิง 0.413 · ชาย 0.415 · ไม่ทราบเพศ = ค่าเฉลี่ย 0.414
  ส่วนสูงไม่มี/ผิดปกติ → คืน null (ให้ผู้เรียกซ่อนค่าระยะทาง ไม่เดาส่วนสูงแทน)
\*============================================================================*/

export const STRIDE_FACTOR: Record<Gender, number> = { FEMALE: 0.413, MALE: 0.415 }
const STRIDE_FACTOR_UNKNOWN = 0.414

export function strideLengthMeters(heightCm: number, gender: Gender | null | undefined): number {
  return (heightCm * (gender ? STRIDE_FACTOR[gender] : STRIDE_FACTOR_UNKNOWN)) / 100
}

export function stepsToDistanceMeters(
  steps: number, heightCm: number | null | undefined, gender: Gender | null | undefined,
): number | null {
  if (!heightCm || !Number.isFinite(heightCm) || heightCm <= 0) return null
  return Math.max(0, steps) * strideLengthMeters(heightCm, gender)
}

/** แสดงผล: < 1 กม. เป็นเมตร, ตั้งแต่ 1 กม. เป็นกิโลเมตรทศนิยม 2 ตำแหน่ง */
export function formatDistance(meters: number): string {
  return meters < 1000 ? `${Math.round(meters)} ม.` : `${(meters / 1000).toFixed(2)} กม.`
}
</file>

<file path="src/utils/timeCapsules.ts">
/*============================================================================*\
  timeCapsules.ts — นัดทบทวนจากเควส "แคปซูลเวลา" (know-content-review)
  ────────────────────────────────────────────────────────────────────────────
  เก็บในเครื่องแยกตามบัญชี (เหมือนมื้ออาหาร/ไดอะรี่) + ส่งซ้ำไปใน payload ของ quest log ด้วย
  (backend ยังไม่มีคอลัมน์ payload/ตารางนัดหมาย — ดู docs/PROGRESSION_API.md)
  ถึงเวลาแล้ว → ป็อปอัพเตือนทันทีที่ล็อกอิน/เปิดหน้า Home (TimeCapsuleReminder.tsx)
\*============================================================================*/

export interface TimeCapsule {
  id: string
  /** เวลาที่ต้องเตือน (ISO) */
  at: string
  /** เป้าหมาย Active Focus ของวันที่ตั้ง (ถ้ามี) */
  goal: string | null
  /** หัวข้อที่ลืมจากเทกระเป๋าความจำผ่านเสียง */
  topics: string[]
  createdAt: string
  /** ทบทวนแล้ว (ไม่เตือนอีก) */
  doneAt?: string | null
  /** เลื่อนการเตือนไปถึงเวลานี้ */
  snoozedUntil?: string | null
}

export const TIME_CAPSULES_CHANGED_EVENT = 'bloom:time-capsules-changed'

function key(userId: string): string {
  return `bloom:time-capsules:${userId}`
}

export function loadTimeCapsules(userId: string): TimeCapsule[] {
  try {
    const raw = window.localStorage.getItem(key(userId))
    return raw ? (JSON.parse(raw) as TimeCapsule[]) : []
  } catch { return [] }
}

function save(userId: string, list: TimeCapsule[]): void {
  try {
    window.localStorage.setItem(key(userId), JSON.stringify(list))
    window.dispatchEvent(new CustomEvent(TIME_CAPSULES_CHANGED_EVENT))
  } catch { /* storage เต็ม/ปิด — ยังมีสำเนาใน payload ของ quest log */ }
}

export function addTimeCapsules(userId: string, items: Omit<TimeCapsule, 'id' | 'createdAt'>[]): TimeCapsule[] {
  const now = new Date().toISOString()
  const created = items.map((it, i) => ({ ...it, id: `tc-${Date.now()}-${i}`, createdAt: now }))
  save(userId, [...loadTimeCapsules(userId), ...created])
  return created
}

/** แคปซูลที่ถึงเวลาเตือนแล้ว (ยังไม่ทบทวน และไม่อยู่ในช่วงเลื่อน) */
export function dueTimeCapsules(userId: string, now: Date = new Date()): TimeCapsule[] {
  const t = now.getTime()
  return loadTimeCapsules(userId)
    .filter((c) => !c.doneAt && new Date(c.at).getTime() <= t && (!c.snoozedUntil || new Date(c.snoozedUntil).getTime() <= t))
    .sort((a, b) => a.at.localeCompare(b.at))
}

/** แคปซูลที่ยังรออยู่ (ไว้โชว์ในหน้าเควส) */
export function upcomingTimeCapsules(userId: string, now: Date = new Date()): TimeCapsule[] {
  return loadTimeCapsules(userId)
    .filter((c) => !c.doneAt && new Date(c.at).getTime() > now.getTime())
    .sort((a, b) => a.at.localeCompare(b.at))
}

export function markTimeCapsulesDone(userId: string, ids: string[]): void {
  const at = new Date().toISOString()
  save(userId, loadTimeCapsules(userId).map((c) => (ids.includes(c.id) ? { ...c, doneAt: at } : c)))
}

export function snoozeTimeCapsules(userId: string, ids: string[], minutes: number): void {
  const until = new Date(Date.now() + minutes * 60_000).toISOString()
  save(userId, loadTimeCapsules(userId).map((c) => (ids.includes(c.id) ? { ...c, snoozedUntil: until } : c)))
}
</file>

<file path="src/utils/uiSounds.ts">
import { isSfxSuppressed } from './sfxGate'
/**
 * uiSounds.ts
 * ────────────
 * [Method 1: Web Audio API] เสียง UI ทั่วไปที่ "สังเคราะห์สด" ด้วย oscillator ไม่พึ่งไฟล์
 * เสียงเลย (ต่างจาก audioPlayer.ts ที่เล่นไฟล์ .mp3 จริง) เหมาะกับเสียงคลิก/ปุ่มสั้นๆ ที่ไม่
 * คุ้มจะโหลดไฟล์แยก — เบา เร็ว ไม่มี network request
 *
 * เป็น util ล้วนๆ ไม่ผูกกับ React ใดๆ (เรียกได้จากทุกที่) — เช็ค mute state ผ่าน flag
 * ภายในไฟล์นี้เอง (setUiSoundsMuted) แทนที่จะให้ผู้เรียกใช้ต้องส่ง mute เข้ามาเองทุกครั้ง —
 * AudioContext.tsx เป็นคนซิงค์ค่านี้ให้อัตโนมัติทุกครั้งที่ settings.soundEnabled เปลี่ยน
 */

let isMuted = false

/** เรียกจาก AudioContext.tsx ทุกครั้งที่ settings.soundEnabled เปลี่ยน — ไม่ต้องเรียกเองตรงๆ */
export function setUiSoundsMuted(muted: boolean): void {
  isMuted = muted
}

let sharedCtx: AudioContext | null = null

/** สร้าง AudioContext แบบ lazy — เบราว์เซอร์ส่วนใหญ่ต้องรอ user gesture ก่อนถึงจะสร้าง/
 *  resume ได้ ฟังก์ชันนี้เลยไม่ถูกเรียกตอน module โหลด แต่รอถึงตอนมีเสียงจริงต้องเล่นก่อน */
function getAudioContext(): AudioContext | null {
  if (typeof window === 'undefined') return null
  const AudioContextCtor = window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext
  if (!AudioContextCtor) return null
  if (!sharedCtx) sharedCtx = new AudioContextCtor()
  if (sharedCtx.state === 'suspended') sharedCtx.resume().catch(() => {})
  return sharedCtx
}

interface ToneOptions {
  frequency: number
  duration: number
  type?: OscillatorType
  volume?: number
  /** ไล่ความถี่จากค่าเริ่มต้นไปยังค่านี้ตลอดช่วงเสียง (ทำให้ได้เสียง "ป๊อบ"/"สไลด์" แทนเสียงนิ่งๆ) */
  frequencyEnd?: number
}

function playTone({ frequency, duration, type = 'sine', volume = 0.12, frequencyEnd }: ToneOptions): void {
  if (isMuted || isSfxSuppressed()) return
  try {
    const ctx = getAudioContext()
    if (!ctx) return

    const oscillator = ctx.createOscillator()
    const gainNode = ctx.createGain()

    oscillator.type = type
    oscillator.frequency.setValueAtTime(frequency, ctx.currentTime)
    if (frequencyEnd !== undefined) {
      oscillator.frequency.exponentialRampToValueAtTime(Math.max(1, frequencyEnd), ctx.currentTime + duration)
    }

    // Envelope แบบ exponential decay ให้เสียงจางหายลื่นๆ ไม่ตัดห้วน
    gainNode.gain.setValueAtTime(volume, ctx.currentTime)
    gainNode.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration)

    oscillator.connect(gainNode)
    gainNode.connect(ctx.destination)

    oscillator.start(ctx.currentTime)
    oscillator.stop(ctx.currentTime + duration)
  } catch {
    // no-op — กันแอปพังถ้า Web Audio API ใช้ไม่ได้ในบางสภาพแวดล้อม (เช่น เบราว์เซอร์เก่ามาก)
  }
}

/**
 * uiSounds — เรียกใช้ตรงๆ จากทุก component ได้เลย เช่น `uiSounds.click()` ตอนกดปุ่มยืนยัน
 * ทั่วไป ไม่ต้อง import AudioContext หรือเช็ค mute เอง (เช็คให้อัตโนมัติในไฟล์นี้แล้ว)
 */
export const uiSounds = {
  /** เสียงคลิกสั้นๆ กลางๆ — ใช้กับปุ่มทั่วไป, ปุ่มยืนยันใน Modal */
  click: (): void => playTone({ frequency: 660, duration: 0.09, type: 'sine', volume: 0.1 }),

  /** เสียง "ป๊อบ" สูงขึ้นเล็กน้อย — ใช้ตอนเปิดอะไรใหม่ๆ ขึ้นมา (เปิด modal, เลือกไอเทม) */
  pop: (): void => playTone({ frequency: 520, frequencyEnd: 880, duration: 0.14, type: 'triangle', volume: 0.12 }),

  /** เสียงยกเลิก/ปิด — โทนต่ำลง สั้น ให้ความรู้สึก "ถอยออก" */
  cancel: (): void => playTone({ frequency: 400, frequencyEnd: 220, duration: 0.16, type: 'sawtooth', volume: 0.08 }),

  /** เสียงแจ้งเตือนน่ารัก "ปริ๊ง-ปริ๊ง" สองโน้ตไล่ขึ้น — ใช้ตอน toast ข่าวเพื่อนเด้งเข้ามา */
  chime: (): void => {
    playTone({ frequency: 988, frequencyEnd: 1319, duration: 0.12, type: 'triangle', volume: 0.09 })
    window.setTimeout(() => playTone({ frequency: 1319, frequencyEnd: 1760, duration: 0.18, type: 'sine', volume: 0.08 }), 110)
  },
}
</file>

