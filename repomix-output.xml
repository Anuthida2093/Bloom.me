import { useCallback, useEffect, useState } from 'react'
import type { QuestGameProps } from '../../../../types.mental'
import { useAppContext } from '../../../../context/AppContext'
import { useBreathingSession, PATTERN_478, PHASE_LABEL } from '../../../../hooks/useBreathingSession'
import BreathingVisual from '../../shared/BreathingVisual'
import { playSfx, startLoopingSfx, stopLoopingSfx } from '../../../../utils/audioPlayer'
import '../games.css'

const C_1 = '#8FE3B8'
const C_2 = 'rgba(143,227,184,.5)'

/*  ความสำเร็จ Mindful Breeze (สายลมแห่งสติ)
    ทฤษฎี: Parasympathetic Nervous System Activation — หายใจเข้าลึกออกยาว
    ลดคอร์ติซอล ดึงสมาธิกลับมา
    ─────────────────────────────────────────────────────────────
    ใช้เครื่องยนต์เดียวกับเควสทอดสมอใจ (useBreathingSession + BreathingVisual)
    ต่างกันที่ความยาว: เควสนี้เลือกได้ 3 หรือ 5 นาที ตามเอกสารหมวดสุขภาพ
    ระบบจะแนะนำเควสนี้ขึ้นมาเองในวันที่ Daily Learning Check-in ให้คะแนน
    "การจดจ่อ" หรือ "การพักผ่อนสมอง" ต่ำ                                          */

export default function MindfulBreezeGame({ finish }: QuestGameProps) {
  const { logActivity, settings } = useAppContext()
  const [minutes, setMinutes] = useState<3 | 5>(3)
  const [started, setStarted] = useState(false)

  const handleFinish = useCallback(() => {
    playSfx('SPARKLE_CHIME', { volume: settings.sfxVolume, enabled: settings.soundEnabled })
  }, [settings.sfxVolume, settings.soundEnabled])

  const session = useBreathingSession({
    totalMs: minutes * 60_000,
    pattern: PATTERN_478,
    onFinish: handleFinish,
  })

  useEffect(() => {
    if (!started) return
    startLoopingSfx('BGM_FOREST', { volume: settings.sfxVolume * 0.28, enabled: settings.soundEnabled })
    return () => stopLoopingSfx('BGM_FOREST')
  }, [started, settings.sfxVolume, settings.soundEnabled])

  const submit = () => {
    logActivity({
      activityType: 'BREATHING',
      durationSeconds: Math.round(session.elapsedMs / 1000),
      meta: { pattern: '4-7-8', cycles: session.cycles, quest: 'mindful-breeze' },
    })
    finish({ minutes, cycles: session.cycles })
  }

  if (!started) {
    return (
      <div className="qg qg-center">
        <div style={{ fontSize: 46 }}>🍃</div>
        <div className="qg-title">เลือกความยาวของสายลม</div>
        <div className="qg-chips" style={{ justifyContent: 'center' }}>
          {([3, 5] as const).map((m) => (
            <button key={m} className={`qg-chip${minutes === m ? ' is-active' : ''}`} onClick={() => setMinutes(m)}>
              {m} นาที
            </button>
          ))}
        </div>
        <p className="qg-hint">หายใจเข้า 4 วิ กลั้น 7 วิ ผ่อนออก 8 วิ — ทำตามวงกลมไปเรื่อยๆ ไม่ต้องฝืน</p>
        <button className="qg-btn" onClick={() => { setStarted(true); session.start() }}>เริ่มรับสายลม</button>
      </div>
    )
  }

  const remainingSec = Math.ceil(session.remainingMs / 1000)

  return (
    <div className="qg qg-center" style={{ '--anchor-accent': C_1, '--anchor-glow': C_2 } as React.CSSProperties}>
      <span className="qg-tag">เหลืออีก {Math.floor(remainingSec / 60)}:{String(remainingSec % 60).padStart(2, '0')}</span>

      <BreathingVisual
        phase={session.phase}
        phaseProgress={session.phaseProgress}
        phaseRemainingSec={session.phaseRemainingSec}
        sessionProgress={session.progress}
        mode="leaves"
        dimmed={session.autoPaused}
      />

      <div className="qg-title">{PHASE_LABEL[session.phase]}</div>
      <span className="qg-tag">หายใจครบ {session.cycles} รอบ</span>
      {session.autoPaused && <span className="qg-tag qg-tag--warn">หยุดนับไว้แล้ว — กลับมาที่หน้าต่างนี้เพื่อทำต่อ</span>}

      <button className="qg-btn" disabled={!session.finished} onClick={submit}>
        {session.finished ? 'สงบขึ้นแล้ว รดน้ำผืนหญ้า' : 'ยังหายใจไม่ครบเวลา'}
      </button>
    </div>
  )
}
</file>

