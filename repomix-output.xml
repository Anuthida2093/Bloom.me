.potion-page__theory {
  font-size: 10.5px;
  --lc-text-1: rgba(240, 233, 250, 0.38);
  color: var(--lc-text-1);
  text-align: center;
  line-height: 1.6;
  max-width: 420px;
}

@media (max-width: 520px) {
  .potion-page__inner { padding: 42px 14px 22px; }
  .potion-cauldron { width: 138px; height: 108px; }
}

@media (prefers-reduced-motion: reduce) {
  .potion-cauldron__bubbles span,
  .potion-cauldron--stirring .potion-cauldron__emoji { animation: none; }
}
