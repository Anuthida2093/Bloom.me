export type QuestTabId = 'knowledge' | 'physical' | 'mental'

/** ระดับพลังงานที่เควสเรียกร้องจากผู้ใช้ — HIGH จะถูกล็อกอัตโนมัติเมื่อความเสี่ยงสูง */
